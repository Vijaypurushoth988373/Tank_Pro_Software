        End Try

        Try
            If shellOcc IsNot Nothing Then
                CreateLegSupportReferencePlanes(invApp, shellOcc, angle_LS_1, angle_LS_2)
            End If
        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try

        '==================================================
        ' UPDATE MW PIPE & LIFTING LUG PARTS (SAFE)
