    Private Function PlaceEllipsoidalHead(invApp As Inventor.Application, asmDoc As AssemblyDocument, headFilePath As String) As ComponentOccurrence

        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition

        ' ✅ Correct way
        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim matrix As Inventor.Matrix = tg.CreateMatrix() ' Identity matrix → origin

        Dim occ As ComponentOccurrence =
        asmDef.Occurrences.Add(headFilePath, matrix)

        Return occ

