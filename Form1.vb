                If Not IO.File.Exists(gasketPath) Then
                    gasketPath = SelectInventorFile("Select Gasket File")
                End If
                '-------------------------------
                ' TOP COVER (ADNOC)
                '-------------------------------
                topCoverPath = IO.Path.Combine(clientFolder, "PT_NO_3_TANK_TOP_COVER_PLATE_AD.ipt")
                If Not IO.File.Exists(topCoverPath) Then
                    topCoverPath = SelectInventorFile("Select Top Cover File")
