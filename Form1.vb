    Public Function PlaceAndConstrainTopCoverLLAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, topCoverOcc As ComponentOccurrence, projectFolder As String, angle1 As Double, angle2 As Double, offsetMm As Double) As ComponentOccurrence

        '==================================================
        ' BUILD FILE PATH
        '==================================================
        Dim llAsmPath As String = IO.Path.Combine(projectFolder, "Adnoc\TOP_COVER_LL_ASSEMBLY.iam")
        If Not IO.File.Exists(llAsmPath) Then
            Throw New Exception("TOP_COVER_LL_ASSEMBLY not found: " & llAsmPath)
        End If

        '==================================================
        ' PLACE LL ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim llOcc As ComponentOccurrence = asmDef.Occurrences.Add(llAsmPath, tg.CreateMatrix())
        llOcc.Grounded = False

        '==================================================
        ' FIND PAD PLATE OCCURRENCE
        '==================================================
        Dim padOcc As ComponentOccurrence = Nothing

        For Each subOcc As ComponentOccurrence In llOcc.SubOccurrences

            If subOcc.Name.ToUpper().Contains("PAD_PLATE_FOR_TOP_LIFTING_LUG") Then
                padOcc = subOcc
                Exit For
            End If

        Next

        If padOcc Is Nothing Then
            Throw New Exception("PAD_PLATE_FOR_TOP_LIFTING_LUG not found.")
        End If

        '==================================================
        ' BUILD DYNAMIC PLANE NAMES
        '==================================================
        Dim anglePlaneName As String = "LL_Plane_" & CInt(angle1).ToString()
        Dim perpPlaneName As String = "LL_Plane_" & CInt(angle2).ToString()


        '==================================================
        ' GET PLANES FROM TOP COVER
        '==================================================
        Dim topDef As PartComponentDefinition = topCoverOcc.Definition
        Dim anglePlane As WorkPlane = topDef.WorkPlanes.Item(anglePlaneName)
        Dim perpPlane As WorkPlane = topDef.WorkPlanes.Item(perpPlaneName)
        Dim topXZ As WorkPlane = topDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' GET PAD PLANES
        '==================================================
        Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim padXY As WorkPlane = padOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim padYZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("YZ Plane")

        '==================================================
        ' CREATE GEOMETRY PROXIES
        '==================================================
        Dim topXZp, padXZ_subP, padXZ_mainP As Object
        Dim anglePlaneP As Object
        Dim perpPlaneP As Object
        Dim padXY_subP, padXY_mainP As Object
        Dim padYZ_subP, padYZ_mainP As Object

        topCoverOcc.CreateGeometryProxy(topXZ, topXZp)

        padOcc.CreateGeometryProxy(padXZ, padXZ_subP)
        llOcc.CreateGeometryProxy(padXZ_subP, padXZ_mainP)


        topCoverOcc.CreateGeometryProxy(anglePlane, anglePlaneP)

        padOcc.CreateGeometryProxy(padXY, padXY_subP)
        llOcc.CreateGeometryProxy(padXY_subP, padXY_mainP)


        topCoverOcc.CreateGeometryProxy(perpPlane, perpPlaneP)

        padOcc.CreateGeometryProxy(padYZ, padYZ_subP)
        llOcc.CreateGeometryProxy(padYZ_subP, padYZ_mainP)


        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================

        ' 1️⃣ Seating constraint
        cons.AddFlushConstraint(topXZp, padXZ_mainP, 0)

        ' 2️⃣ Angle alignment
        cons.AddFlushConstraint(anglePlaneP, padXY_mainP, 0)

        ' 3️⃣ Perpendicular offset positioning
        Dim offsetCm As Double = offsetMm / 10.0

        cons.AddMateConstraint(perpPlaneP, padYZ_mainP, offsetCm)


        '==================================================
        ' UPDATE ASSEMBLY
        '==================================================
        asmDoc.Update()

        Return llOcc

    End Function

    Public Sub PatternTopCoverLLAssembly_X(invApp As Inventor.Application, asmDoc As AssemblyDocument, baseLLOcc As ComponentOccurrence,
    patternCount As Integer, spacingMm As Double)

        '==================================================
        ' Safety checks
        '==================================================
        If asmDoc Is Nothing Then
            Throw New Exception("❌ AssemblyDocument is Nothing")
        End If

        If baseLLOcc Is Nothing Then
            Throw New Exception("❌ LL assembly occurrence is Nothing")
        End If

        '==================================================
        ' Assembly definition
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition

        '==================================================
        ' Seed occurrence collection
        '==================================================
        Dim seedOccs As ObjectCollection = invApp.TransientObjects.CreateObjectCollection()
        seedOccs.Add(baseLLOcc)

        '==================================================
        ' Pattern direction → GLOBAL X AXIS
        '==================================================
        Dim xAxis As WorkAxis = asmDef.WorkAxes.Item("Z Axis")

        '==================================================
        ' Pattern spacing (mm → cm)
        ' Example: 2 × 308 mm = 616 mm
        '==================================================
        Dim spacingCm As Double = spacingMm / 10.0

        '==================================================
        ' Create Rectangular Occurrence Pattern
        ' SAME STRUCTURE AS WORKING LADDER FUNCTION
        '==================================================
        Dim patt As RectangularOccurrencePattern

        patt = asmDef.OccurrencePatterns.AddRectangularPattern(seedOccs, xAxis, True, spacingCm,
        patternCount, Nothing, False, 0, 1)

        patt.Name = "TOP_COVER_LL_PATTERN"

        '==================================================
        ' Final update
        '==================================================
        asmDoc.Update()

    End Sub

    Public Function CreateTankLegSupportAssembly_StepByStep(invApp As Inventor.Application, projectFolder As String) As AssemblyDocument

        '==================================================
        ' 0️⃣ Create New Sub Assembly
        '==================================================
        Dim asmTemplate As String = invApp.FileManager.GetTemplateFile(DocumentTypeEnum.kAssemblyDocumentObject, SystemOfMeasureEnum.kMetricSystemOfMeasure)
        Dim legAsm As AssemblyDocument = invApp.Documents.Add(DocumentTypeEnum.kAssemblyDocumentObject, asmTemplate, False)

        legAsm.DisplayName = "TANK_LEG_SUPPORT_ASMBY"

        Dim asmDef As AssemblyComponentDefinition = legAsm.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' Paths
        '==================================================
        Dim basePlatePath As String = IO.Path.Combine(projectFolder, "PT_NO_10_BASE_PLATE_FOR_LEG_SUPPORT.ipt")

        Dim legSupportPath As String = IO.Path.Combine(projectFolder, "PT_NO_7_LEG_SUPPORT.ipt")

        If Not IO.File.Exists(basePlatePath) Then
            Throw New Exception("❌ Base Plate file missing: " & basePlatePath)
        End If

        If Not IO.File.Exists(legSupportPath) Then
            Throw New Exception("❌ Leg Support file missing: " & legSupportPath)
        End If

        '==================================================
        ' 1️⃣ PLACE BASE PLATE
        '==================================================
        Dim baseOcc As ComponentOccurrence = asmDef.Occurrences.Add(basePlatePath, tg.CreateMatrix())
        baseOcc.Name = "BASE_PLATE"
        baseOcc.Grounded = False

        '==================================================
        ' 1️⃣ CONSTRAIN BASE PLATE TO ORIGIN
        '==================================================

        ' Assembly Origin Planes
        Dim asmYZ As WorkPlane = asmDef.WorkPlanes.Item("YZ Plane")
        Dim asmXZ As WorkPlane = asmDef.WorkPlanes.Item("XZ Plane")
        Dim asmXY As WorkPlane = asmDef.WorkPlanes.Item("XY Plane")

        ' Base Plate Planes
        Dim baseYZ As WorkPlane = baseOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim baseXZ As WorkPlane = baseOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim baseXY As WorkPlane = baseOcc.Definition.WorkPlanes.Item("XY Plane")

        ' Proxies
        Dim asmYZp, asmXZp, asmXYp As Object
        Dim baseYZp, baseXZp, baseXYp As Object

        legAsm.ComponentDefinition.Occurrences.Item(1).CreateGeometryProxy(baseYZ, baseYZp)

        baseOcc.CreateGeometryProxy(baseYZ, baseYZp)
        baseOcc.CreateGeometryProxy(baseXZ, baseXZp)
        baseOcc.CreateGeometryProxy(baseXY, baseXYp)

        ' Flush Constraints
        cons.AddFlushConstraint(asmYZ, baseYZp, 0)
        cons.AddFlushConstraint(asmXZ, baseXZp, 0)
        cons.AddFlushConstraint(asmXY, baseXYp, 0)

        '==================================================
        ' 2️⃣ PLACE LEG SUPPORT PART
        '==================================================
        Dim legOcc As ComponentOccurrence = asmDef.Occurrences.Add(legSupportPath, tg.CreateMatrix())
        legOcc.Name = "LEG_SUPPORT"
        legOcc.Grounded = False

        '==================================================
        ' 2️⃣ CONSTRAIN LEG SUPPORT TO BASE PLATE
        '==================================================

        ' BASE PLATE WORK PLANES
        Dim bpWP4 As WorkPlane = baseOcc.Definition.WorkPlanes.Item("Work Plane4")
        Dim bpWP2 As WorkPlane = baseOcc.Definition.WorkPlanes.Item("Work Plane2")
        Dim bpWP3 As WorkPlane = baseOcc.Definition.WorkPlanes.Item("Work Plane3")

        ' LEG SUPPORT PLANES
        Dim legStart As WorkPlane = legOcc.Definition.WorkPlanes.Item("Start Plane")
        Dim legLeft As WorkPlane = legOcc.Definition.WorkPlanes.Item("Left Plane")
        Dim legBottom As WorkPlane = legOcc.Definition.WorkPlanes.Item("Bottom Plane")

        ' Proxies
        Dim bpWP4p, bpWP2p, bpWP3p As Object
        Dim legStartP, legLeftP, legBottomP As Object

        baseOcc.CreateGeometryProxy(bpWP4, bpWP4p)
        baseOcc.CreateGeometryProxy(bpWP2, bpWP2p)
        baseOcc.CreateGeometryProxy(bpWP3, bpWP3p)

        legOcc.CreateGeometryProxy(legStart, legStartP)
        legOcc.CreateGeometryProxy(legLeft, legLeftP)
        legOcc.CreateGeometryProxy(legBottom, legBottomP)

        '--------------------------------------------------
        ' 2️⃣ c) BASE_PLATE (WP4) → LEG_SUPPORT (Start Plane)
        '--------------------------------------------------
        cons.AddFlushConstraint(bpWP4p, legStartP, 0)

        '--------------------------------------------------
        ' 2️⃣ d) BASE_PLATE (WP2) → LEG_SUPPORT (Left Plane)
        ' Offset = 50 mm → 5 cm
        '--------------------------------------------------
        Dim offsetCm As Double = 50 / 10.0
        cons.AddFlushConstraint(bpWP2p, legLeftP, offsetCm)

        '--------------------------------------------------
        ' 2️⃣ e) BASE_PLATE (WP3) → LEG_SUPPORT (Bottom Plane)
        '--------------------------------------------------
        cons.AddMateConstraint(bpWP3p, legBottomP, -offsetCm)

        '==================================================
        ' FINAL UPDATE
        '==================================================
        legAsm.Update()

        Return legAsm

    End Function

