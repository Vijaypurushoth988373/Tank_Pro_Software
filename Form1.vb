    Public Function PlaceAndConstrainCommonRFPad(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, rfPadPath As String, offsetMm As Double) As ComponentOccurrence
        '==================================================
        ' VALIDATE FILE
        '==================================================
        If Not IO.File.Exists(rfPadPath) Then
            Throw New Exception("COMMON_RF_PAD file not found.")
        End If


        '==================================================
        ' SETUP
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' PLACE RF PAD
        '==================================================
        Dim padOcc As ComponentOccurrence = asmDef.Occurrences.Add(rfPadPath, tg.CreateMatrix())
        padOcc.Name = "COMMON_RF_PAD"

        '==================================================
        ' SHELL REFERENCES
        '==================================================
        Dim shellDef = CType(shellOcc.Definition, PartComponentDefinition)
        Dim shellYAxis = shellDef.WorkAxes.Item("Y Axis")
        Dim shellXY = shellDef.WorkPlanes.Item("XY Plane")
        Dim shellXZ = shellDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' PAD REFERENCES
        '==================================================
        Dim padDef = CType(padOcc.Definition, PartComponentDefinition)
        Dim padZAxis = padDef.WorkAxes.Item("Z Axis")
        Dim padXZ = padDef.WorkPlanes.Item("XZ Plane")
        Dim padXY = padDef.WorkPlanes.Item("XY Plane")

        '==================================================
        ' CREATE PROXIES
        '==================================================
        Dim shellYAxisProxy As Object
        Dim shellXYProxy As Object
        Dim shellXZProxy As Object

        Dim padZAxisProxy As Object
        Dim padXZProxy As Object
        Dim padXYProxy As Object

        shellOcc.CreateGeometryProxy(shellYAxis, shellYAxisProxy)
        shellOcc.CreateGeometryProxy(shellXY, shellXYProxy)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZProxy)

        padOcc.CreateGeometryProxy(padZAxis, padZAxisProxy)
        padOcc.CreateGeometryProxy(padXZ, padXZProxy)
        padOcc.CreateGeometryProxy(padXY, padXYProxy)

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================
        cons.AddMateConstraint(shellYAxisProxy, padZAxisProxy, 0)

        If SelectedClient = "ADNOC" Then
            cons.AddFlushConstraint(shellXYProxy, padXZProxy, 0)
        ElseIf SelectedClient = "QATAR" Then
            cons.AddMateConstraint(shellXYProxy, padXZProxy, 0)
        End If

        Dim offsetCm As Double = offsetMm / 10.0
        cons.AddFlushConstraint(shellXZProxy, padXYProxy, offsetCm)
        asmDoc.Update()

        Return padOcc

    End Function

