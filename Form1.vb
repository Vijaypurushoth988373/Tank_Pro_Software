    Private Sub UpdateDipPipeTabs()

        Dim dipCount As Integer = 0

        '==================================================
        ' COUNT DIP PIPE FROM GRID
        '==================================================
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows
            If row.IsNewRow Then Continue For
            If row.Cells("REMARKS").Value Is Nothing Then Continue For
            Dim remark As String = row.Cells("REMARKS").Value.ToString().Trim().ToUpper()
            If remark = "DIP PIPE" Then
                dipCount += 1
            End If
        Next

        '==================================================
        ' CONTROL TAB VISIBILITY (NO ADD/DELETE)
        '==================================================

        ' First hide all
        TabPage_Dip1.Parent = Nothing
        TabPage_Dip2.Parent = Nothing
        TabPage_Dip3.Parent = Nothing
        TabPage_Dip4.Parent = Nothing

        ' Show based on count
        If dipCount >= 1 Then TabPage_Dip1.Parent = TC_Dip_Pipe
        If dipCount >= 2 Then TabPage_Dip2.Parent = TC_Dip_Pipe
        If dipCount >= 3 Then TabPage_Dip3.Parent = TC_Dip_Pipe
        If dipCount >= 4 Then TabPage_Dip4.Parent = TC_Dip_Pipe

    End Sub

