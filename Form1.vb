            LockCell(row, "Y_MM", "-")

            UnlockCell(row, "RADIUS_MM")
            UnlockCell(row, "ANGLE_DEG")

        ElseIf placementType = "XY DIRECTION" Then

            'Lock Radius/Angle and show "-"
            LockCell(row, "RADIUS_MM", "-")
            LockCell(row, "ANGLE_DEG", "-")

            UnlockCell(row, "X_MM")
            UnlockCell(row, "Y_MM")

