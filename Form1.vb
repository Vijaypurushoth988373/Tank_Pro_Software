    Public Sub CreateStudBoltReferencePlanes(partDoc As PartDocument, angleDeg As Double)

        '==================================================
        ' SAFETY CHECK
        '==================================================
        If partDoc Is Nothing Then
            Throw New Exception("Part document not available.")
        End If

        Dim compDef As PartComponentDefinition = partDoc.ComponentDefinition


        '==================================================
        ' PLANE NAMES
        '==================================================
        Dim planeName1 As String = "SB_Plane_" & CInt(angleDeg)
        Dim planeName2 As String = "SB_Plane_" & CInt(angleDeg + 90)

        '==================================================
        ' DELETE EXISTING PLANES IF PRESENT
        '==================================================
        DeleteWorkPlaneIfExists(compDef, planeName1)
        DeleteWorkPlaneIfExists(compDef, planeName2)

        '==================================================
        ' BASE REFERENCES
        '==================================================
        Dim basePlane As WorkPlane = compDef.WorkPlanes.Item("YZ Plane")
        Dim axis As WorkAxis = compDef.WorkAxes.Item("Y Axis")

        '==================================================
        ' CREATE FIRST ANGLED PLANE
        '==================================================
        Dim angleRad As Double = angleDeg * Math.PI / 180.0
        Dim angledPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(axis, basePlane, -angleRad)
        angledPlane.Name = planeName1

        '==================================================
        ' CREATE PERPENDICULAR PLANE
        '==================================================
        Dim perpAngleRad As Double = (angleDeg + 90) * Math.PI / 180.0
        Dim perpPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(axis, basePlane, -perpAngleRad)
        perpPlane.Name = planeName2

        '==================================================
        ' UPDATE PART
        '==================================================
        partDoc.Update()

    End Sub

    Private Sub DeleteWorkPlaneIfExists(compDef As PartComponentDefinition, planeName As String)

        For Each wp As WorkPlane In compDef.WorkPlanes
            If wp.Name.ToUpper() = planeName.ToUpper() Then
                Try
                    wp.Delete()
                Catch
                End Try
                Exit For
            End If
        Next

    End Sub

    Public Function PlaceAndConstrainStud_Bolt_With_Washer_QATAR(invApp As Inventor.Application, asmDoc As AssemblyDocument, topCoverOcc As ComponentOccurrence, folderPath As String) As ComponentOccurrence

        '==================================================
