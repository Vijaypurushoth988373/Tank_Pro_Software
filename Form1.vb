    Public Function PlaceAndConstrainRingFlange(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, ringFlangePath As String) As ComponentOccurrence

        '==================================================
        ' VALIDATE FILE
        '==================================================
        If Not IO.File.Exists(ringFlangePath) Then
            Throw New Exception("Ring Flange file not found: " & ringFlangePath)
        End If

        '==================================================
        ' PLACE RING FLANGE
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim ringOcc As ComponentOccurrence = asmDef.Occurrences.Add(ringFlangePath, tg.CreateMatrix())
        ringOcc.Grounded = False


        '==================================================
        ' SHELL REFERENCES
        '==================================================
        Dim shellDef As PartComponentDefinition = shellOcc.Definition
        Dim shellYAxis As WorkAxis = shellDef.WorkAxes.Item("Y Axis")
        Dim shellYZ As WorkPlane = shellDef.WorkPlanes.Item("YZ Plane")
        Dim shellTopPlane As WorkPlane = shellDef.WorkPlanes.Item("SHELL_TOP_PLANE")


        '==================================================
        ' RING FLANGE REFERENCES
        '==================================================
        Dim rfDef As PartComponentDefinition = ringOcc.Definition
        Dim rfYAxis As WorkAxis = rfDef.WorkAxes.Item("Y Axis")
        Dim rfYZ As WorkPlane = rfDef.WorkPlanes.Item("YZ Plane")
        Dim rfXZ As WorkPlane = rfDef.WorkPlanes.Item("XZ Plane")


        '==================================================
        ' CREATE PROXIES – SHELL
        '==================================================
        Dim shellYAxisProxy As Object
        Dim shellYZProxy As Object
        Dim shellTopProxy As Object

        shellOcc.CreateGeometryProxy(shellYAxis, shellYAxisProxy)
        shellOcc.CreateGeometryProxy(shellYZ, shellYZProxy)
        shellOcc.CreateGeometryProxy(shellTopPlane, shellTopProxy)


        '==================================================
        ' CREATE PROXIES – RING FLANGE
        '==================================================
        Dim rfYAxisProxy As Object
        Dim rfYZProxy As Object
        Dim rfXZProxy As Object

        ringOcc.CreateGeometryProxy(rfYAxis, rfYAxisProxy)
        ringOcc.CreateGeometryProxy(rfYZ, rfYZProxy)
        ringOcc.CreateGeometryProxy(rfXZ, rfXZProxy)


        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================

        '1️⃣ Y-Axis Mate
        cons.AddMateConstraint(shellYAxisProxy, rfYAxisProxy, 0)

        '2️⃣ YZ Plane Flush
        cons.AddFlushConstraint(shellYZProxy, rfYZProxy, 0)

        '3️⃣ Shell Top Plane ↔ RF XZ Mate
        cons.AddMateConstraint(shellTopProxy, rfXZProxy, 0)


        '==================================================
        ' UPDATE
        '==================================================
        asmDoc.Update()

        Return ringOcc

    End Function

