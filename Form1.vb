    Public Function PlaceAndConstrainStepRung(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, stepRungPath As String) As ComponentOccurrence

        '==================================================
        ' VALIDATE FILE
        '==================================================
        If Not IO.File.Exists(stepRungPath) Then
