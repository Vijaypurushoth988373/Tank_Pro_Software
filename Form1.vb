    Public Shared Sub AddNotesFromDGV(oSheet As Inventor.Sheet, dgvNotes As DataGridView)

        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim oTG As TransientGeometry = inv.TransientGeometry
        Dim oNotes As GeneralNotes = oSheet.DrawingNotes.GeneralNotes

        '-----------------------------------------
        ' Clear existing notes
        '-----------------------------------------
        For Each n As GeneralNote In oNotes
            n.Delete()
        Next

        '-----------------------------------------
        ' Start position
        '-----------------------------------------
        Dim startX As Double = oSheet.TitleBlock.RangeBox.MinPoint.X - 19.5
        Dim startY As Double = oSheet.TitleBlock.RangeBox.MaxPoint.Y + 32
        Dim currY As Double = startY

        '-----------------------------------------
        ' Title
        '-----------------------------------------
        Dim titleNote As GeneralNote = oNotes.AddFitted(oTG.CreatePoint2d(startX, currY), "NOTES:")
        currY -= titleNote.FittedTextHeight + 0.6

        '-----------------------------------------
        ' Add notes from DGV
        '-----------------------------------------
        For Each row As DataGridViewRow In dgvNotes.Rows
            If row.IsNewRow Then Continue For
            Dim seq As String = Convert.ToString(row.Cells("COL_SEQ").Value)
            Dim noteText As String = Convert.ToString(row.Cells("COL_NOTE").Value)
            If String.IsNullOrWhiteSpace(noteText) Then Continue For
            Dim fullText As String = seq & ". " & noteText.Trim()
            Dim note As GeneralNote = oNotes.AddFitted(oTG.CreatePoint2d(startX, currY), fullText)
            currY -= note.FittedTextHeight + 0.25
        Next

    End Sub

    Public Shared Function GetOrCreateDrawingDocument(templatePath As String, drawingSavePath As String) As Inventor.DrawingDocument

        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim actDoc As Inventor.Document = inv.ActiveDocument

        Select Case actDoc.DocumentType

            Case DocumentTypeEnum.kDrawingDocumentObject
                Return CType(actDoc, Inventor.DrawingDocument)

            Case DocumentTypeEnum.kAssemblyDocumentObject

                If IO.File.Exists(drawingSavePath) Then
                    Return CType(inv.Documents.Open(drawingSavePath, True), Inventor.DrawingDocument)
                End If

                Dim newDraw As Inventor.DrawingDocument = inv.Documents.Add(DocumentTypeEnum.kDrawingDocumentObject, templatePath, True)
                newDraw.SaveAs(drawingSavePath, False)
                Return newDraw

            Case Else
                Throw New Exception("Open an Assembly or Drawing document.")

        End Select

    End Function

    Public Shared Function CreateGASheet2(oDrawDoc As Inventor.DrawingDocument, templatePath As String) As Inventor.Sheet

        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim templateDoc As Inventor.DrawingDocument = inv.Documents.Open(templatePath, False)
        Dim sheet2 As Inventor.Sheet = templateDoc.Sheets.Item(1).CopyTo(oDrawDoc)

        sheet2.Name = "GA : 2"
        sheet2.Activate()

        templateDoc.Close(False)

        Return sheet2

    End Function

    Public Shared Function OpenMainAssembly(assemblyPath As String) As Inventor.AssemblyDocument

        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Return CType(inv.Documents.Open(assemblyPath, False), Inventor.AssemblyDocument)

    End Function

    Public Shared Function PlaceGAFrontView(oSheet As Inventor.Sheet, oAsm As Inventor.AssemblyDocument) As Inventor.DrawingView

        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        ' Clear existing views on Sheet-2
        For Each v As Inventor.DrawingView In oSheet.DrawingViews
            v.Delete()
        Next

        Dim frontView As Inventor.DrawingView = oSheet.DrawingViews.AddBaseView(oAsm, oTG.CreatePoint2d(0, 0), 1.0, ViewOrientationTypeEnum.kFrontViewOrientation, DrawingViewStyleEnum.kHiddenLineDrawingViewStyle)

        frontView.Name = "ELEVATION"

        Return frontView

    End Function

    Public Shared Sub ScaleAndPositionGAFrontView(oSheet As Inventor.Sheet, frontView As Inventor.DrawingView)

        '------------------------------------------------
        ' Get Inventor Application & TransientGeometry
        '------------------------------------------------
        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        '------------------------------------------------
        ' FIXED SCALE → 1:20
        '------------------------------------------------
        frontView.Scale = 0.0667   ' 1:20

        '------------------------------------------------
        ' Sheet Size
        '------------------------------------------------
        Dim sheetW As Double = oSheet.Width
        Dim sheetH As Double = oSheet.Height

        '------------------------------------------------
        ' Position for GA Sheet (Sheet-2)
        ' Center-Left area
        '------------------------------------------------
        frontView.Position = oTG.CreatePoint2d(9, 26)

        '------------------------------------------------
        ' Optional: Rename view (only once)
        '------------------------------------------------
        If frontView.Name = "" Then
            frontView.Name = "GA_FRONT_VIEW"
        End If

    End Sub

    Public Shared Sub PlaceGATopView(oSheet As Inventor.Sheet, frontView As Inventor.DrawingView)

        '------------------------------------------------
        ' Inventor objects
        '------------------------------------------------
        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        '------------------------------------------------
        ' Get Assembly from Front View (SAFE WAY)
        '------------------------------------------------
        Dim oAsm As Inventor.AssemblyDocument = CType(frontView.ReferencedDocumentDescriptor.ReferencedDocument, Inventor.AssemblyDocument)

        '------------------------------------------------
        ' Sheet size
        '------------------------------------------------
        Dim sheetW As Double = oSheet.Width
        Dim sheetH As Double = oSheet.Height

        '------------------------------------------------
        ' Create TOP view (Independent)
        '------------------------------------------------
        Dim topView As Inventor.DrawingView = oSheet.DrawingViews.AddBaseView(oAsm, oTG.CreatePoint2d(0, 0), 0.0667, ViewOrientationTypeEnum.kTopViewOrientation, DrawingViewStyleEnum.kHiddenLineRemovedDrawingViewStyle)

        '------------------------------------------------
        ' Position TOP view (Above Front View)
        '------------------------------------------------
        topView.Position = oTG.CreatePoint2d(24, 33)

        '------------------------------------------------
        ' Naming (stable)
        '------------------------------------------------
        topView.Name = "GA_TOP_VIEW"

    End Sub

    Public Shared Sub AddGASideView(oSheet As Inventor.Sheet, frontView As Inventor.DrawingView)

        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")

        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        Dim sidePos As Inventor.Point2d = oTG.CreatePoint2d(frontView.Position.X + frontView.Width + 6, frontView.Position.Y)

        Dim sideView As Inventor.DrawingView = oSheet.DrawingViews.AddProjectedView(frontView, sidePos, DrawingViewStyleEnum.kHiddenLineDrawingViewStyle, frontView.Scale)

        sideView.Name = "SIDE VIEW"
    End Sub

    Public Shared Function CreateSectionSketch_Horizontal(elevView As Inventor.DrawingView) As Inventor.DrawingSketch

        Dim inv As Inventor.Application = CType(Marshal.GetActiveObject("Inventor.Application"), Inventor.Application)

        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        '------------------------------------------------
        ' Create sketch on elevation view
        '------------------------------------------------
        Dim secSketch As Inventor.DrawingSketch =
        elevView.Sketches.Add()

        secSketch.Edit()

        '------------------------------------------------
        ' HORIZONTAL section cut through view center
        ' View coordinates are view-relative
        '------------------------------------------------
        Dim yCut As Double = 0.0                      ' Horizontal cut at center
        Dim xLeft As Double = -700
        Dim xRight As Double = 700

        secSketch.SketchLines.AddByTwoPoints(oTG.CreatePoint2d(xLeft, yCut), oTG.CreatePoint2d(xRight, yCut))

        secSketch.ExitEdit()

        Return secSketch

    End Function

    Public Shared Function CreateGASectionView(oSheet As Inventor.Sheet, elevView As Inventor.DrawingView) As Inventor.SectionDrawingView

        Dim inv As Inventor.Application = CType(Marshal.GetActiveObject("Inventor.Application"), Inventor.Application)
        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        '------------------------------------------------
        ' 1) Create section sketch
        '------------------------------------------------
        Dim secSketch As Inventor.DrawingSketch = CreateSectionSketch_Horizontal(elevView)

        '------------------------------------------------
        ' 2) Create section view (aligned initially)
        '------------------------------------------------
        Dim secView As Inventor.SectionDrawingView = oSheet.DrawingViews.AddSectionView(elevView, secSketch, oTG.CreatePoint2d(0, 0), DrawingViewStyleEnum.kHiddenLineDrawingViewStyle)

        '------------------------------------------------
        ' 3) Naming
        '------------------------------------------------
        secView.Name = "S1-S1"

        Return secView

    End Function

    Public Shared Sub BreakSectionAlignment(secView As Inventor.DrawingView)

        '------------------------------------------------
        ' Break alignment safely (ALL versions)
        '------------------------------------------------
        If secView.Aligned Then
            secView.Aligned = False
        End If

    End Sub

    Public Shared Sub PositionGASectionView(secView As Inventor.DrawingView, oSheet As Inventor.Sheet)

        Dim inv As Inventor.Application = CType(Marshal.GetActiveObject("Inventor.Application"), Inventor.Application)
        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        Dim sheetW As Double = oSheet.Width
        Dim sheetH As Double = oSheet.Height

        '----------------------------------------------------
        ' Free placement (example: right-middle area)
        '----------------------------------------------------
        secView.Position = oTG.CreatePoint2d(sheetW * 0.75, sheetH * 0.45)

    End Sub

