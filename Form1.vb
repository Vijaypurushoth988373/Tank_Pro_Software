        '==================================================
        If Not String.IsNullOrWhiteSpace(folderPath) AndAlso IO.Directory.Exists(folderPath) Then
            CurrentProjectFolder = folderPath
            SaveAllVerticalProjectInputs(CurrentProjectFolder, Me, Form2, Form3, Form4, Form5, Form6, NewProjForm)
            Debug.Print($"✅ Inputs saved to: {folderPath}")
        Else
            Debug.Print($"⚠ SaveProjectInputs skipped — folderPath = '{folderPath}'")
        End If

        Dim headPath As String = ""
        Dim shellPath As String = ""
        Dim curbPath As String = ""
        Dim ringFlangePath As String = ""
        Dim gasketPath As String = ""
        Dim topCoverPath As String = ""

        '------------------------------------------
        ' HEAD
        '------------------------------------------
        Try
            If RB_LB_EH.Checked Then
                headPath = IO.Path.Combine(folderPath, "PT_NO_2_2_1_ELLIPSOIDL_HEAD.ipt")

                If Not IO.File.Exists(headPath) Then
                    headPath = SelectInventorFile("Select Ellipsoidal Head File")
                End If

            ElseIf RB_LB_TH.Checked Then
                headPath = IO.Path.Combine(folderPath, "PT_NO_2_TORISPHERICAL_HEAD.ipt")

                If Not IO.File.Exists(headPath) Then
                    headPath = SelectInventorFile("Select Torispherical Head File")
                End If

            End If

        Catch ex As Exception
            headPath = SelectInventorFile("Select Head File")
        End Try

        '------------------------------------------
        ' SHELL
        '------------------------------------------
        Try
            shellPath = IO.Path.Combine(folderPath, "PT_NO_1_TANK_SHELL_PLATE.ipt")

            If Not IO.File.Exists(shellPath) Then
                shellPath = SelectInventorFile("Select Tank Shell Plate File")
            End If
        Catch ex As Exception
            shellPath = SelectInventorFile("Select Tank Shell Plate File")
        End Try

        '==================================================
        ' DECLARE ONCE at the top of your Sub
        ' (remove any existing Dim for these same names
        '  further down in the code)
        '==================================================
        Dim projectRoot As String = String.Empty
        Dim flangeInch As Integer = 0
        Dim flangeSch As String = String.Empty
        Dim bodyFlangePath As String = String.Empty
        Dim blindFlangePath As String = String.Empty
        Dim gasketBFPath As String = String.Empty
        Dim bodyFlangeOcc As ComponentOccurrence = Nothing
        Dim gasketBFOcc As ComponentOccurrence = Nothing
        Dim blindFlangeOcc As ComponentOccurrence = Nothing

        '==================================================
        ' CLIENT-SPECIFIC COMPONENTS
        '==================================================

        ' Get project root from active Inventor project
        projectRoot = IO.Path.GetDirectoryName(invApp.DesignProjectManager.ActiveDesignProject.FullFileName)

        ' Get flange size from your form (adapt control name as needed)
        flangeInch = CInt(cmb_FlangeSize.SelectedItem)   ' e.g. 10,12..24
        flangeSch = cmb_FlangeSch.Text.Trim()           ' e.g. "STD","XS","40"

        ' Paths returned by reference
        bodyFlangePath = String.Empty
        blindFlangePath = String.Empty
        gasketBFPath = String.Empty

        ResolveAndUpdateBodyFlangeComponents(invApp, flangeInch, flangeSch, projectRoot, bodyFlangePath, blindFlangePath, gasketBFPath)

        If RB_RT_BF.Checked Then

            '==================================================
            ' RB_RT_BF MODE — Body Flange / Gasket / Blind Flange
            ' Mutually exclusive with Top Cover / Curb Angle /
            ' Ring Flange / Top Plate Gasket for all clients.
            '==================================================

            ' Get project root from active Inventor project
            projectRoot = IO.Path.GetDirectoryName(invApp.DesignProjectManager.ActiveDesignProject.FullFileName)

            ' Read flange size from form

            If Not Integer.TryParse(cmb_FlangeSize.Text.Trim(), flangeInch) Then
                MessageBox.Show("❌ Please select a valid Flange Size.", "RB/RT Body Flange")
                Exit Sub
            End If

            Dim validSizes() As Integer = {10, 12, 14, 16, 18, 20, 24}
            If Not validSizes.Contains(flangeInch) Then
                MessageBox.Show($"❌ Flange size {flangeInch}"" is not supported (10–24 inch only).",
                        "RB/RT Body Flange")
                Exit Sub
            End If

            ' Read schedule from form
            flangeSch = cmb_FlangeSch.Text.Trim()
            If String.IsNullOrWhiteSpace(flangeSch) Then
                MessageBox.Show("❌ Please select a Flange Schedule.", "RB/RT Body Flange")
                Exit Sub
            End If

            ' Resolve paths + update parameter B on Body Flange
            bodyFlangePath = String.Empty
            blindFlangePath = String.Empty
            gasketBFPath = String.Empty

            ResolveAndUpdateBodyFlangeComponents(invApp, flangeInch, flangeSch, projectRoot, bodyFlangePath, blindFlangePath, gasketBFPath)

            ' Place the three components at origin
            bodyFlangeOcc = Nothing
            gasketBFOcc = Nothing
            blindFlangeOcc = Nothing

            'PlaceBodyFlangeComponents(invApp, asmDoc, bodyFlangePath, blindFlangePath, gasketBFPath, bodyFlangeOcc, gasketBFOcc, blindFlangeOcc)

            ' TODO: ConstrainBodyFlangeComponents(...) goes here next

        Else

            '==================================================
            ' STANDARD MODE — Top Cover / Curb Angle / Ring Flange
            ' Only runs when RB_RT_BF is NOT checked
            '==================================================

            If SelectedClient = "ARAMCO" Then
                '-------------------------------
                ' CURB ANGLE (ARAMCO)
                '-------------------------------
                curbPath = IO.Path.Combine(folderPath, "PT_NO_4_CURB_ANGLE.ipt")
                If Not IO.File.Exists(curbPath) Then
                    curbPath = SelectInventorFile("Select Curb Angle File")
                End If
                '-------------------------------
                ' TOP COVER (ARAMCO)
                '-------------------------------
                topCoverPath = IO.Path.Combine(folderPath, "PT_NO_3_TANK_TOP_COVER_PLATE.ipt")
                If Not IO.File.Exists(topCoverPath) Then
                    topCoverPath = SelectInventorFile("Select Top Cover File")
                End If

            ElseIf SelectedClient = "ADNOC" Then
                '-------------------------------
                ' RING FLANGE (ADNOC)
                '-------------------------------
                ringFlangePath = IO.Path.Combine(clientFolder, "RING_FLANGE_FOR_TOP_COVER_PLATE.ipt")
                If Not IO.File.Exists(ringFlangePath) Then
                    ringFlangePath = SelectInventorFile("Select Ring Flange File")
