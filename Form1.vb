    Private Sub CreateDimensions(invApp As Inventor.Application)

        '==================================================
        ' 1) Validate Inventor
        '==================================================
        If invApp Is Nothing Then
            MessageBox.Show("Inventor is not running.")
            Exit Sub
        End If

        '==================================================
        ' 2) Validate Active Document
        '==================================================
        If invApp.ActiveDocument Is Nothing OrElse
       invApp.ActiveDocument.DocumentType <> DocumentTypeEnum.kDrawingDocumentObject Then

            MessageBox.Show("Please activate a Drawing document.")
            Exit Sub
        End If

        '==================================================
        ' 3) Get Drawing
        '==================================================
        Dim oDrawDoc As DrawingDocument = CType(invApp.ActiveDocument, DrawingDocument)
        Dim oSheet As Sheet = oDrawDoc.ActiveSheet
        Dim oView As DrawingView = oSheet.DrawingViews.Item(1)

        '==================================================
        ' 2) Get Referenced Model
        '==================================================
        Dim oModelDoc As Document = oView.ReferencedDocumentDescriptor.ReferencedDocument

        '==================================================
        ' 3) Find Edges by Attribute
        '==================================================
        Dim objsTop As ObjectCollection = oModelDoc.AttributeManager.FindObjects("DIM", "TOP")
        Dim objsBottom As ObjectCollection = oModelDoc.AttributeManager.FindObjects("DIM", "BOTTOM")

        If objsTop.Count = 0 OrElse objsBottom.Count = 0 Then
            MessageBox.Show("TOP or BOTTOM edge attribute not found.")
            Exit Sub
        End If

        Dim edgeTop As Edge = CType(objsTop.Item(1), Edge)
        Dim edgeBottom As Edge = CType(objsBottom.Item(1), Edge)

        '==================================================
        ' 4) Promote Edges to DrawingCurves
        '==================================================
        Dim drawCurvesTop As DrawingCurvesEnumerator = oView.DrawingCurves(edgeTop)
        Dim drawCurvesBottom As DrawingCurvesEnumerator = oView.DrawingCurves(edgeBottom)
        Dim dcTop As DrawingCurve = drawCurvesTop.Item(1)
        Dim dcBottom As DrawingCurve = drawCurvesBottom.Item(1)

        '==================================================
        ' 5) Create Geometry Intents
        '==================================================
        Dim giTop As GeometryIntent = oSheet.CreateGeometryIntent(dcTop)
        Dim giBottom As GeometryIntent = oSheet.CreateGeometryIntent(dcBottom)

        '==================================================
        ' 6) Dimension Text Position
        '==================================================
        Dim tg As TransientGeometry = InventorApp.TransientGeometry
        Dim textPt As Point2d = tg.CreatePoint2d(oView.Left + (oView.Width / 2), oView.Top + 3)

        '==================================================
        ' 7) Create Linear Dimension
        '==================================================
        Dim genDims As GeneralDimensions = oSheet.DrawingDimensions.GeneralDimensions
        Dim oDim As GeneralDimension = genDims.AddLinear(textPt, giTop, giBottom)
        oDim.Text.FormattedText = "<DimensionValue/> mm"

    End Sub

