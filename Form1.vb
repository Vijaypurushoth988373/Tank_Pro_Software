    Public Sub ConstrainManwayHandle(asmDoc As AssemblyDocument, handleOcc As ComponentOccurrence, coverOcc As ComponentOccurrence, offsetMm As Double, isHandle1 As Boolean)

        Dim cons = asmDoc.ComponentDefinition.Constraints
        Dim offsetCm = offsetMm / 10.0

        ' HANDLE PLANES
        Dim hYZ As WorkPlane = handleOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim hXZ As WorkPlane = handleOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim hXY As WorkPlane = handleOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim hYZp, hXZp, hXYp As Object
        handleOcc.CreateGeometryProxy(hYZ, hYZp)
        handleOcc.CreateGeometryProxy(hXZ, hXZp)
        handleOcc.CreateGeometryProxy(hXY, hXYp)

        ' COVER PLATE PLANES
        Dim cYZ As WorkPlane = coverOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim cXZ As WorkPlane = coverOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim cXY As WorkPlane = coverOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim cYZp, cXZp, cXYp As Object
        coverOcc.CreateGeometryProxy(cYZ, cYZp)
        coverOcc.CreateGeometryProxy(cXZ, cXZp)
        coverOcc.CreateGeometryProxy(cXY, cXYp)

        '=========================
        ' APPLY CONSTRAINT RULES
        '=========================

        ' 1️⃣ Handle (YZ) -> Cover (XZ)
        cons.AddMateConstraint(hYZp, cXZp, 0)

        ' 2️⃣ Handle orientation rotates based on which handle
        If isHandle1 Then
            cons.AddMateConstraint(hXZp, cYZp, 0)   'Flush for Handle1
        Else
            cons.AddMateConstraint(hXZp, cYZp, 0)    'Mate for Handle2
        End If

        ' 3️⃣ XY offset from center
        If isHandle1 Then
            cons.AddMateConstraint(hXYp, cXYp, 23)
        Else
            cons.AddMateConstraint(hXYp, cXYp, -23)
        End If

    End Sub

    Public Sub CreateLiftingLugReferencePlanes(invApp As Inventor.Application, shellOcc As ComponentOccurrence, angle1Deg As Double, angle2Deg As Double)

        '==================================================
        ' Get shell PART definition
        '==================================================
        Dim shellDoc As PartDocument = CType(shellOcc.Definition.Document, PartDocument)

        Dim compDef As PartComponentDefinition = shellDoc.ComponentDefinition

        '==================================================
        ' Exactly TWO angles
        '==================================================
        Dim angles As Double() = {angle1Deg, angle2Deg}

        For Each ang As Double In angles

            Dim planeName As String = $"LL_Plane_{ang}"

            '--------------------------------------------------
            ' Check if plane already exists
            '--------------------------------------------------
            Dim existingPlane As WorkPlane = Nothing

            For Each wp As WorkPlane In compDef.WorkPlanes
                If wp.Name = planeName Then
                    existingPlane = wp
                    Exit For
                End If
            Next

            If existingPlane IsNot Nothing Then
                existingPlane.Visible = False
                Continue For
            End If

            '--------------------------------------------------
            ' Convert angle to radians
            '--------------------------------------------------
            Dim angleRad As Double = ang * Math.PI / 180.0

            '--------------------------------------------------
            ' Axis & base plane
            '-------------------------------------------------
            Dim rotAxis As WorkAxis = compDef.WorkAxes.Item("Y Axis")

            Dim basePlane As WorkPlane = compDef.WorkPlanes.Item("YZ Plane")

            '--------------------------------------------------
            ' Create angled work plane
            '--------------------------------------------------
            Dim newPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(rotAxis, basePlane, -angleRad)
            newPlane.Name = planeName
            newPlane.Visible = False

        Next

        shellDoc.Update()

    End Sub

    Public Sub CreateNozzleStiffenerReferencePlanes(invApp As Inventor.Application, nozAsmOcc As ComponentOccurrence, angle1Deg As Double, angle2Deg As Double)

        '==================================================
        ' nozAsmOcc is an Assembly Occurrence
        ' Get its Assembly Definition
        '==================================================
        Dim nozAsmDef As AssemblyComponentDefinition =
        CType(nozAsmOcc.Definition, AssemblyComponentDefinition)

        '==================================================
        ' Find PIPE occurrence inside Nozzle Assembly
        '==================================================
        Dim pipeOcc As ComponentOccurrence = Nothing

        For Each occ As ComponentOccurrence In nozAsmDef.Occurrences
            If occ.Name.ToUpper().Contains("PIPE") Then
                pipeOcc = occ
                Exit For
            End If
        Next

        If pipeOcc Is Nothing Then
            Throw New Exception("❌ PIPE part not found inside Nozzle Assembly!")
        End If

        '==================================================
        ' Get PIPE PartDocument
        '==================================================
        Dim pipeDoc As PartDocument = CType(pipeOcc.Definition.Document, PartDocument)

        Dim compDef As PartComponentDefinition = pipeDoc.ComponentDefinition

        '==================================================
        ' Angles
        '==================================================
        Dim angles As Double() = {angle1Deg, angle2Deg}

        For Each ang As Double In angles

            Dim planeName As String = $"STIFFENER_PLANE_{ang}"

            '--------------------------------------------------
            ' Check if plane already exists
            '--------------------------------------------------
            For Each wp As WorkPlane In compDef.WorkPlanes
                If wp.Name = planeName Then
                    wp.Visible = False
                    GoTo NextAngle
                End If
            Next

            '--------------------------------------------------
            ' Convert angle to radians
            '--------------------------------------------------
            Dim angleRad As Double = ang * Math.PI / 180.0

            '--------------------------------------------------
            ' Axis & Base Plane
            '--------------------------------------------------
            Dim rotAxis As WorkAxis = compDef.WorkAxes.Item("Y Axis")

            Dim basePlane As WorkPlane = compDef.WorkPlanes.Item("YZ Plane")

            '--------------------------------------------------
            ' Create Work Plane
            '--------------------------------------------------
            Dim newPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(rotAxis, basePlane, angleRad)

            newPlane.Name = planeName
            newPlane.Visible = False

NextAngle:
        Next

        '==================================================
        ' Update Pipe Part
        '==================================================
        pipeDoc.Update()

    End Sub

