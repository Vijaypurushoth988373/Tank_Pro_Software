    Function PlaceShell(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellFilePath As String) As ComponentOccurrence

        Dim asmDef = asmDoc.ComponentDefinition
        Dim tg = invApp.TransientGeometry
        Dim mat = tg.CreateMatrix()

        Dim shellOcc As ComponentOccurrence = asmDef.Occurrences.Add(shellFilePath, mat)

        Return shellOcc

    End Function

    Private Sub FlushShellToHead_UsingPlanes(asmDoc As AssemblyDocument, headOcc As ComponentOccurrence, shellOcc As ComponentOccurrence, axialOffsetMm As Double)

        Dim asmDef = asmDoc.ComponentDefinition
        Dim constraints = asmDef.Constraints

        ' Assembly origin planes
        Dim asmXY = asmDef.WorkPlanes.Item("XY Plane")
        Dim asmYZ = asmDef.WorkPlanes.Item("YZ Plane")
        Dim asmXZ = asmDef.WorkPlanes.Item("XZ Plane")

        ' Shell planes
        Dim shellDef = shellOcc.Definition
        Dim shellXY = shellDef.WorkPlanes.Item("XY Plane")
        Dim shellYZ = shellDef.WorkPlanes.Item("YZ Plane")
        Dim shellXZ = shellDef.WorkPlanes.Item("XZ Plane")

        ' Create proxies
        Dim shellXYProxy As Object
        Dim shellYZProxy As Object
        Dim shellXZProxy As Object

        shellOcc.CreateGeometryProxy(shellXY, shellXYProxy)
        shellOcc.CreateGeometryProxy(shellYZ, shellYZProxy)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZProxy)

        ' mm → cm
        Dim offsetCm As Double = axialOffsetMm / 10

        ' 🔒 ALL FLUSH CONSTRAINTS
        constraints.AddFlushConstraint(asmYZ, shellYZProxy, 0)          ' axis
        constraints.AddFlushConstraint(asmXZ, shellXZProxy, 0)          ' axis
        constraints.AddFlushConstraint(asmXY, shellXYProxy, offsetCm)   ' position

    End Sub

    Function PlaceAndAssembleShell(invApp As Inventor.Application, asmDoc As AssemblyDocument, headOcc As ComponentOccurrence, shellPath As String, axialOffsetMm As Double) As ComponentOccurrence

        Dim asmDef = asmDoc.ComponentDefinition
        Dim tg = invApp.TransientGeometry
        Dim mat = tg.CreateMatrix()

        ' Place shell ONCE
        Dim shellOcc As ComponentOccurrence = asmDef.Occurrences.Add(shellPath, mat)

        ' Constrain shell (your existing flush logic)
        FlushShellToHead_UsingPlanes(asmDoc, headOcc, shellOcc, axialOffsetMm)

        asmDoc.Update()

        Return shellOcc

    End Function

