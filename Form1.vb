    Private Sub CopyNozzleMarkToForm3(row As DataGridViewRow)

        If row Is Nothing Then Exit Sub

        '=====================================================
        ' ✅ Read Nozzle Mark
        '=====================================================
        Dim nozObj = row.Cells("Nozzle_Mark").Value
        If nozObj Is Nothing Then Exit Sub

        Dim nozzleMark As String = nozObj.ToString().Trim().ToUpper()

        '=====================================================
        ' ✅ Read Checkbox Value
        '=====================================================
        Dim stiffVal = row.Cells("Stiffener_Head").Value

        Dim isChecked As Boolean = False
        If stiffVal IsNot Nothing Then
            isChecked = CBool(stiffVal)
        End If

        '=====================================================
        ' ✅ Ensure Form3 is Open
        '=====================================================
        If StiffenerForm Is Nothing OrElse StiffenerForm.IsDisposed Then

            StiffenerForm = New Form3()

            ' 🔹 Make it appear exactly like Form1
            With StiffenerForm
                .StartPosition = FormStartPosition.Manual
                .Location = Me.Location
                .Size = Me.Size
                .WindowState = Me.WindowState
            End With

            StiffenerForm.Show()

        Else
            StiffenerForm.BringToFront()
            StiffenerForm.Activate()
        End If

        Dim grid As DataGridView = StiffenerForm.DGV_Stiffener

        '=====================================================
        ' ✅ ADD WHEN CHECKED
        '=====================================================
        If isChecked Then

            '--- Prevent duplicate nozzle mark
            For Each r As DataGridViewRow In grid.Rows
                If r.IsNewRow Then Continue For

                Dim existing = r.Cells("Nozzle_Mark_Stiff").Value
                If existing IsNot Nothing AndAlso
               existing.ToString().Trim().ToUpper() = nozzleMark Then
                    Exit Sub
                End If
            Next

            '✅ Add new row
            Dim newRowIndex As Integer = grid.Rows.Add()

            '=====================================================
            ' ✅ Fill Default Values
            '=====================================================
            grid.Rows(newRowIndex).Cells("Nozzle_Mark_Stiff").Value = nozzleMark

            grid.Rows(newRowIndex).Cells("Height_Stiff").Value = 200
            grid.Rows(newRowIndex).Cells("Dist_Stiff").Value = 60
            grid.Rows(newRowIndex).Cells("Angle_Stiff").Value = 90
            grid.Rows(newRowIndex).Cells("Number_Stiff").Value = 2
            grid.Rows(newRowIndex).Cells("Direction_Stiff").Value = "NORMAL"
            grid.Rows(newRowIndex).Cells("ANGLE_BW_STIFF").Value = 90

        Else

            '=================================================
            ' ✅ REMOVE WHEN UNCHECKED
            '=================================================
            For Each r As DataGridViewRow In grid.Rows
                If r.IsNewRow Then Continue For

                Dim existing = r.Cells("Nozzle_Mark_Stiff").Value
                If existing IsNot Nothing AndAlso
               existing.ToString().Trim().ToUpper() = nozzleMark Then

                    grid.Rows.Remove(r)
                    Exit For
                End If
            Next

        End If

    End Sub

