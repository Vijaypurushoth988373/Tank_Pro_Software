        elbowOcc.CreateGeometryProxy(elbowBottom, elbowBottomP)
        elbowOcc.CreateGeometryProxy(elbowAxis2, elbowAxis2P)
        elbowOcc.CreateGeometryProxy(elbowXZ, elbowXZP)

        '==============================
