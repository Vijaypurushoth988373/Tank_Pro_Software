            Dim skirtHt As Double = SkirtSupportData.Skirt_HT

            ' HEAD TYPE
            If RB_LB_TH.Checked Then
                skirtID = shellID + (2 * shellThk)
            Else
                skirtID = SkirtSupportData.Skirt_ID
            End If

            Dim doc As PartDocument = invApp.Documents.Open(skirtPath, False)
            Dim p = doc.ComponentDefinition.Parameters

            p.Item("ID").Expression = $"{skirtID} mm"
            p.Item("THK").Expression = $"{skirtThk} mm"
            p.Item("LENGTH").Expression = $"{skirtHt} mm"

            '==================================
            ' REVOLVE CUT FEATURE
            '==================================
            Dim revolveCut As PartFeature = doc.Features.Item("Revolve_Cut")

            If RB_LB_TH.Checked Then
                revolveCut.Suppressed = True
            Else
                revolveCut.Suppressed = False
            End If

            doc.Update()
            doc.Save()
            doc.Close(True)

        Catch ex As Exception
            MessageBox.Show(ex.Message)
        End Try

    End Sub

