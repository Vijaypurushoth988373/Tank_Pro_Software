    Public Sub UpdateLegAngleDerivedParameters(invapp As Inventor.Application, DerivedFilePath As String)
        '==================================================
        ' Validate file path
        '==================================================
        If invapp Is Nothing Then Exit Sub
        If String.IsNullOrWhiteSpace(DerivedFilePath) Then Exit Sub
        If Not IO.File.Exists(DerivedFilePath) Then Exit Sub

        Dim frm1 As Form1 = System.Windows.Forms.Application.OpenForms.OfType(Of Form1)().FirstOrDefault()
        Dim frm2 As Form2 = System.Windows.Forms.Application.OpenForms.OfType(Of Form2)().FirstOrDefault()

        If frm1 Is Nothing Then Exit Sub

        '=============================
        ' Variables
        '=============================
        Dim widthMm As Double
        Dim width1Mm As Double
        Dim supportThkMm As Double

        Dim bpLengthMm As Double
        Dim bpHeightMm As Double
        Dim bpThkMm As Double
        Dim holeDiaMm As Double

        Dim rfPadThkMm As Double
        Dim rfPadLenMm As Double
        Dim rfPadWidMm As Double
        Dim rfPadFilletMm As Double

        '=============================
        ' FORM2 OPEN → READ UI
        '=============================
        If frm2 IsNot Nothing Then

            Double.TryParse(frm2.txt_LegS_length.Text, widthMm)
            Double.TryParse(frm2.txt_LegS_width.Text, width1Mm)
            Double.TryParse(frm2.txt_LegS_thickness.Text, supportThkMm)

            Double.TryParse(frm2.txt_BaseP_length.Text, bpLengthMm)
            Double.TryParse(frm2.txt_BaseP_height.Text, bpHeightMm)
            Double.TryParse(frm2.txt_BaseP_thk.Text, bpThkMm)
            Double.TryParse(frm2.txt_BaseP_hole_dia.Text, holeDiaMm)

            Double.TryParse(frm2.txt_RFPad_Thk.Text, rfPadThkMm)
            Double.TryParse(frm2.txt_RFPad_length.Text, rfPadLenMm)
            Double.TryParse(frm2.txt_RFPad_height.Text, rfPadWidMm)
            Double.TryParse(frm2.txt_RFPad_Fillet.Text, rfPadFilletMm)

        Else
            '=============================
            ' FORM2 CLOSED → READ MODULE
            '=============================
            widthMm = BottomPlateData.LegAngle_LengthMm
            width1Mm = BottomPlateData.LegAngle_WidthMm
            supportThkMm = BottomPlateData.LegAngle_ThicknessMm

            bpLengthMm = BottomPlateData.BasePlate_LengthMm
            bpHeightMm = BottomPlateData.BasePlate_HeightMm
            bpThkMm = BottomPlateData.BasePlate_ThicknessMm
            holeDiaMm = BottomPlateData.BasePlate_HoleDiaMm

            rfPadThkMm = BottomPlateData.RFPad_ThicknessMm
            rfPadLenMm = BottomPlateData.RFPad_LengthMm
            rfPadWidMm = BottomPlateData.RFPad_HeightMm
            rfPadFilletMm = BottomPlateData.RFPad_FilletMm

        End If


        Try

            Dim partDoc As PartDocument = CType(invapp.Documents.Open(DerivedFilePath, False), PartDocument)

            Dim params As Parameters = partDoc.ComponentDefinition.Parameters

            '=============================
            ' FORM1 PARAMETERS
            '=============================
            params.Item("ID").Expression = frm1.txt_Shell_Inside_Dia.Text & " mm"
            params.Item("THK").Expression = frm1.txt_Shell_Finished_Thk.Text & " mm"
            params.Item("LENGTH").Expression = frm1.txt_Shell_Length.Text & " mm"
            params.Item("SF").Expression = frm1.txt_EH_SF.Text & " mm"

            params.Item("DIST_FROM_BOTTOM").Expression = frm1.txt_LLA_Base_To_TL.Text & " mm"
            params.Item("ANGLE_BW_LEGS").Expression = frm1.txt_LLA_Ang_bw.Text & " deg"
            params.Item("LS_HEIGHT").Expression = frm1.txt_LLA_Leg_Length.Text & " mm"

            '=============================
            ' LEG SECTION
            '=============================
            params.Item("WIDTH").Expression = widthMm & " mm"
            params.Item("WIDTH_1").Expression = width1Mm & " mm"
            params.Item("SUPPORT_THK").Expression = supportThkMm & " mm"

            '=============================
            ' BASE PLATE
            '=============================
            params.Item("BP_LENGTH").Expression = bpLengthMm & " mm"
            params.Item("BP_HEIGHT").Expression = bpHeightMm & " mm"
            params.Item("BP_THK").Expression = bpThkMm & " mm"
            params.Item("HOLE_DIA").Expression = holeDiaMm & " mm"

            '=============================
            ' RF PAD
            '=============================
            params.Item("RF_Pad_THK").Expression = rfPadThkMm & " mm"
            params.Item("RF_Pad_Length").Expression = rfPadLenMm & " mm"
            params.Item("RF_Pad_Width").Expression = rfPadWidMm & " mm"
            params.Item("RF_Pad_Fillet").Expression = rfPadFilletMm & " mm"

            '========================================
            ' GET DIAMETER FROM FORM1
            '========================================
            Dim dia As Double = 0
            Double.TryParse(txt_Shell_Inside_Dia.Text, dia)

            Dim xVal As Double = 0

            '========================================
            ' CALCULATE X VALUE
            '========================================
            Select Case dia

                Case 300 To 1199
                    xVal = 38

                Case 1200 To 1830
                    xVal = 50

                Case 1831 To 1980
                    xVal = 50

                Case 1981 To 2150
                    xVal = 45

                Case 2151 To 3000
                    xVal = 69

            End Select

            params.Item("X_Value").Expression = xVal & " mm"

            partDoc.Update()
            partDoc.Save()
            partDoc.Close(True)

        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try

    End Sub

