    Public Sub CreateTopCoverAngledPlane(invApp As Inventor.Application, topCoverOcc As ComponentOccurrence, angleDeg As Double, planeName As String)

        '==================================================
        ' Safety checks
        '==================================================
        If topCoverOcc Is Nothing Then
            Throw New Exception("❌ Top Cover occurrence is Nothing")
        End If

        '==================================================
        ' Get PART document of Top Cover
        '==================================================
        Dim topCoverDoc As PartDocument = CType(topCoverOcc.Definition.Document, PartDocument)
        Dim compDef As PartComponentDefinition = topCoverDoc.ComponentDefinition

        '==================================================
        ' Check if plane already exists
        '==================================================
        For Each wp As WorkPlane In compDef.WorkPlanes
            If wp.Name.Equals(planeName, StringComparison.OrdinalIgnoreCase) Then
                wp.Visible = False
                Exit Sub   ' ✅ Plane already exists → exit safely
            End If
        Next

        '==================================================
        ' Convert degrees → radians
        '==================================================
        Dim angleRad As Double = -(angleDeg * Math.PI / 180.0)

        '==================================================
        ' Reference axis & base plane
        '==================================================
        ' Rotation axis → Y Axis (vertical)
        Dim rotAxis As WorkAxis = compDef.WorkAxes.Item("Y Axis")

        ' Base plane → XZ Plane
        Dim basePlane As WorkPlane = compDef.WorkPlanes.Item("YZ Plane")

        '==================================================
        ' Create angled work plane
        '==================================================
        Dim angledPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(rotAxis, basePlane, angleRad)

        angledPlane.Name = planeName
        angledPlane.Visible = False

        '==================================================
        ' Final update
        '==================================================
        topCoverDoc.Update()

    End Sub

    Public Function PlaceAndConstrainGrabLadderRung(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String, offsetMm As Double, rungIndex As Integer) As ComponentOccurrence
        '==================================================

        ' File path
        '==================================================
        Dim rungPath As String
        rungPath = IO.Path.Combine(folderPath, "PT_NO_32_GRAB_LADDER_RUNG.ipt")

        If Not IO.File.Exists(rungPath) Then
            Throw New Exception("❌ Grab & Ladder Rung part not found: " & rungPath)
        End If

        '==================================================
        ' Assembly definition
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' Place rung
        '==================================================
        Dim rungOcc As ComponentOccurrence = asmDef.Occurrences.Add(rungPath, tg.CreateMatrix())
        rungOcc.Grounded = False
        rungOcc.Name = $"GRAB_LADDER_RUNG_{rungIndex}"

        '==================================================
        ' Shell reference planes
        '==================================================
        Dim shellDef = shellOcc.Definition
        Dim shellYZ As WorkPlane = shellDef.WorkPlanes.Item("YZ Plane")
        Dim shellZRef As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")
        Dim shellXY As WorkPlane = shellDef.WorkPlanes.Item("XY Plane")

        '==================================================
        ' Rung reference planes
        '==================================================
        Dim rungDef = rungOcc.Definition
        Dim rungWP1 As WorkPlane = rungDef.WorkPlanes.Item("Work Plane1")
        Dim rungWP2 As WorkPlane = rungDef.WorkPlanes.Item("Work Plane2")
        Dim rungWP4 As WorkPlane = rungDef.WorkPlanes.Item("Work Plane4")

        '==================================================
        ' Create geometry proxies – Shell
        '==================================================
        Dim shellYZp, shellZRefp, shellXYp As Object
        shellOcc.CreateGeometryProxy(shellYZ, shellYZp)
        shellOcc.CreateGeometryProxy(shellZRef, shellZRefp)
        shellOcc.CreateGeometryProxy(shellXY, shellXYp)

        '==================================================
        ' Create geometry proxies – Rung
        '==================================================
        Dim rungWP1p, rungWP2p, rungWP4p As Object
        rungOcc.CreateGeometryProxy(rungWP1, rungWP1p)
        rungOcc.CreateGeometryProxy(rungWP2, rungWP2p)
        rungOcc.CreateGeometryProxy(rungWP4, rungWP4p)

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================

        ' 1️⃣ Shell (YZ) → Rung (Work Plane1) → FLUSH
        cons.AddFlushConstraint(shellYZp, rungWP1p, 0)

        ' 2️⃣ Shell (MW_BOTTOM / MW_TOP) → Rung (Work Plane2)
        '     FLUSH with offset
        Dim offsetCm As Double = offsetMm / 10.0
        cons.AddFlushConstraint(shellZRefp, rungWP2p, offsetCm)

        '' 3️⃣ Shell (XY) → Rung (Work Plane4) → MATE
        'cons.AddMateConstraint(shellXYp, rungWP4p, 0.3)

        Dim shellWP1 As WorkPoint = shellDef.WorkPoints.Item("Work Point1")
        Dim rungWP7 As WorkPlane = rungDef.WorkPlanes.Item("Work Plane7")

        Dim shellWP1p As Object
        Dim rungWP7p As Object

        shellOcc.CreateGeometryProxy(shellWP1, shellWP1p)
        rungOcc.CreateGeometryProxy(rungWP7, rungWP7p)

        cons.AddMateConstraint(shellWP1p, rungWP7p, 0)

        '==================================================
        ' Final update
        '==================================================
        asmDoc.Update()

        Return rungOcc

    End Function

