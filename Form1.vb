        '==================================================
        ' STUD BOLT PLANES
        '==================================================
        Dim studDef As AssemblyComponentDefinition = studOcc.Definition
        Dim studXZ As WorkPlane = studDef.WorkPlanes.Item("XZ Plane")
        Dim studXY As WorkPlane = studDef.WorkPlanes.Item("XY Plane")
        Dim studWP1 As WorkPlane = studDef.WorkPlanes.Item("Work Plane2")

