    Function GetFlangeOccurrence(nozzleOcc As ComponentOccurrence) As ComponentOccurrence

        Dim nozAsmDef As AssemblyComponentDefinition = CType(nozzleOcc.Definition, AssemblyComponentDefinition)

        For Each occ As ComponentOccurrence In nozAsmDef.Occurrences
            If occ.Name.ToUpper().Contains("FLANGE") Then
                Return occ
            End If
        Next

        Throw New Exception("Flange occurrence not found in nozzle assembly.")

    End Function

    Sub ConstrainNozzleToEllipsoidalHead_XY(asmDoc As AssemblyDocument, headOcc As ComponentOccurrence, nozzleOcc As ComponentOccurrence, xMm As Double, yMm As Double)

        Dim cons As AssemblyConstraints = asmDoc.ComponentDefinition.Constraints

        '--------------------------------------
        ' Unit conversion (mm → cm)
        '--------------------------------------
        Dim xCm As Double = xMm / 10.0
        Dim yCm As Double = yMm / 10.0

        '--------------------------------------
        ' Head planes
        '--------------------------------------
        Dim headXY As WorkPlane = headOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim headXZ As WorkPlane = headOcc.Definition.WorkPlanes.Item("SF_Plane")

        Dim headYZ As WorkPlane = headOcc.Definition.WorkPlanes.Item("YZ Plane")

        '--------------------------------------
        ' Nozzle planes
        '--------------------------------------
        Dim nozXY As WorkPlane = nozzleOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim nozYZ As WorkPlane = nozzleOcc.Definition.WorkPlanes.Item("YZ Plane")

        '--------------------------------------
        ' Geometry proxies
        '--------------------------------------
        Dim headXYp, headXZp, headYZp As Object
        Dim nozXYp, nozYZp As Object

        headOcc.CreateGeometryProxy(headXY, headXYp)
        headOcc.CreateGeometryProxy(headXZ, headXZp)
        headOcc.CreateGeometryProxy(headYZ, headYZp)

        nozzleOcc.CreateGeometryProxy(nozXY, nozXYp)
        nozzleOcc.CreateGeometryProxy(nozYZ, nozYZp)

        '--------------------------------------
        ' 1️⃣ Seating (normal to head)
        '--------------------------------------
        cons.AddFlushConstraint(headXYp, nozXYp, -yCm)

        '--------------------------------------
        ' 2️⃣ ORIENTATION LOCK
        ' Head XZ ↔ Flange Work Plane2 (MATE)
        '--------------------------------------
        ' Get flange occurrence INSIDE nozzle assembly
        Dim flangeOcc As ComponentOccurrence = GetFlangeOccurrence(nozzleOcc)

        ' Get flange Work Plane2 (PART level)
        Dim flangeWP2 As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("Work Plane2")

        ' Step 1: proxy at nozzle assembly level
        Dim flangeWP2_nozP As Object
        flangeOcc.CreateGeometryProxy(flangeWP2, flangeWP2_nozP)

        ' Step 2: proxy that proxy into MAIN assembly level
        Dim flangeWP2_mainP As Object
        nozzleOcc.CreateGeometryProxy(flangeWP2_nozP, flangeWP2_mainP)

        cons.AddMateConstraint(headXZp, flangeWP2_mainP, 0)

        '--------------------------------------
        ' 3️⃣ Position in X/Y (centered to hole)
        '--------------------------------------
        cons.AddFlushConstraint(headYZp, nozYZp, xCm)

    End Sub

    Function AddPipeToNozzleAssembly(invApp As Inventor.Application, nozAsm As AssemblyDocument, pipePath As String) As ComponentOccurrence


        If nozAsm Is Nothing Then
            Throw New Exception("Nozzle assembly is Nothing")
        End If

        If Not System.IO.File.Exists(pipePath) Then
            Throw New Exception("Pipe file not found: " & pipePath)
        End If

        'nozAsm.Activate()

        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition

        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim mat As Inventor.Matrix = tg.CreateMatrix()
        mat.SetToIdentity()

        Dim pipeOcc As ComponentOccurrence = asmDef.Occurrences.Add(pipePath, mat)

        Return pipeOcc

    End Function

    Sub ConstrainPipeToNozzleOriginPlanes(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence)

        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition

        Dim cons As AssemblyConstraints = asmDef.Constraints

        Dim asmXY As WorkPlane = asmDef.WorkPlanes.Item("XY Plane")
        Dim asmYZ As WorkPlane = asmDef.WorkPlanes.Item("YZ Plane")
        Dim asmXZ As WorkPlane = asmDef.WorkPlanes.Item("XZ Plane")

        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim pipeXZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim pipeXYp, pipeYZp, pipeXZp As Object

        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        pipeOcc.CreateGeometryProxy(pipeXZ, pipeXZp)

        cons.AddFlushConstraint(asmXY, pipeXYp, 0)
        cons.AddFlushConstraint(asmYZ, pipeYZp, 0)
        cons.AddFlushConstraint(asmXZ, pipeXZp, 0)

    End Sub

