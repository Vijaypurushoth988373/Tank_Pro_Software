    Private Sub cmb_CA_Size_SelectedIndexChanged(sender As Object, e As EventArgs) Handles cmb_CA_Size.SelectedIndexChanged

        '===================================================
        ' 1️⃣ Read Vessel ID
        '===================================================
        Dim idValue As Double = CDbl(txt_CA_ID.Text)

        '===================================================
        ' 2️⃣ Read Curb Angle Size String
        ' Example: "60 x 60"
        '===================================================
        Dim caSize As String = cmb_CA_Size.Text.Trim()

        If caSize = "" Then Exit Sub

        '===================================================
        ' 3️⃣ Split the size
        '===================================================
        Dim parts() As String = caSize.Split("x"c)

        If parts.Length <> 2 Then
            MessageBox.Show("❌ Invalid Curb Angle format. Use: 60 x 60")
            Exit Sub
        End If

        '===================================================
        ' 4️⃣ Extract Values
        '===================================================
        Dim legLength As Double = CDbl(parts(0).Trim())   '60
        'Dim thickness As Double = CDbl(parts(2).Trim())   '6

        '===================================================
        ' 5️⃣ Calculate OD
        ' OD = ID + (2 × legLength)
        '===================================================
        Dim odValue As Double = idValue + (2 * legLength)

        '===================================================
        ' 6️⃣ Assign to TextBoxes
        '===================================================
        txt_CA_OD.Text = odValue.ToString("0")
        'txt_CA_THK.Text = thickness.ToString("0")
        txt_CA_Length.Text = legLength.ToString("0")

    End Sub

