    Public Sub ConstrainNozzleToTopCover(asmDoc As AssemblyDocument, targetOcc As ComponentOccurrence, nozzleOcc As ComponentOccurrence, radiusMm As Double, angleDeg As Double,
                                     nozzleName As String, Optional remarks As String = "", Optional dipAngleDeg As Double = 0)

        Dim cons As AssemblyConstraints = asmDoc.ComponentDefinition.Constraints

        '--------------------------------------------------
        ' Get target part document safely
        '--------------------------------------------------
        Dim targetPartDoc As PartDocument = Nothing

        Try
            targetPartDoc = CType(targetOcc.Definition.Document, PartDocument)
        Catch
        End Try

        If targetPartDoc Is Nothing Then
            Try
                targetPartDoc = CType(targetOcc.ReferencedDocumentDescriptor.ReferencedDocument, PartDocument)
            Catch ex As Exception
                Debug.WriteLine("ConstrainNozzleToTopCover: Could not get part doc: " & ex.Message)
                Exit Sub
            End Try
        End If

        If targetPartDoc Is Nothing Then Exit Sub

        Dim targetPartDef As PartComponentDefinition = targetPartDoc.ComponentDefinition

        '==================================================
        ' RB_RT_BF MODE — Blind Flange constraints
        ' Blind Flange (BOTTOM_PLANE) → Nozzle Pipe (XZ)  : MATE
        ' Blind Flange (N1_X_Axis)   → Nozzle Pipe (X Axis) : MATE
        ' Blind Flange (N1_Y_Axis)   → Nozzle Pipe (Y Axis) : MATE
        '==================================================
        If RB_RT_BF.Checked Then

            ' Find PIPE inside nozzle subassembly
            Dim pipeOcc As ComponentOccurrence = Nothing
            For Each subOcc As ComponentOccurrence In nozzleOcc.SubOccurrences
                If subOcc.Name.ToUpper().Contains("PIPE") Then
                    pipeOcc = subOcc
                    Exit For
                End If
            Next

            If pipeOcc Is Nothing Then
                MessageBox.Show("❌ PIPE not found inside nozzle assembly for RB_RT_BF constraint.",
                            "ConstrainNozzleToTopCover")
                Exit Sub
            End If

            '--------------------------------------------------
            ' 1️⃣ BLIND FLANGE (BOTTOM_PLANE) → PIPE (XZ Plane) : MATE
            '--------------------------------------------------
            Try
                Dim bfBottomPlane As WorkPlane = targetPartDef.WorkPlanes.Item("BOTTOM_PLANE")
                Dim pipeXZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XZ Plane")
                Dim bfBottomProxy As Object
                Dim pipeXZ_subProxy As Object
                Dim pipeXZ_mainProxy As Object

                targetOcc.CreateGeometryProxy(bfBottomPlane, bfBottomProxy)
                pipeOcc.CreateGeometryProxy(pipeXZ, pipeXZ_subProxy)
                nozzleOcc.CreateGeometryProxy(pipeXZ_subProxy, pipeXZ_mainProxy)

                cons.AddMateConstraint(bfBottomProxy, pipeXZ_mainProxy, 0)
            Catch ex As Exception
                Debug.WriteLine("RB_RT_BF Nozzle Constraint 1 failed: " & ex.Message)
            End Try

            '--------------------------------------------------
            ' 2️⃣ BLIND FLANGE (N1_X_Axis) → PIPE (X Axis) : MATE
            '--------------------------------------------------
            Try
                Dim bfXAxis As WorkAxis = targetPartDef.WorkAxes.Item(nozzleName & "_X_Axis")
                Dim pipeXAxis As WorkAxis = pipeOcc.Definition.WorkAxes.Item("X Axis")
                Dim bfXAxisProxy As Object
                Dim pipeXAxis_sub As Object
                Dim pipeXAxis_main As Object

                targetOcc.CreateGeometryProxy(bfXAxis, bfXAxisProxy)
                pipeOcc.CreateGeometryProxy(pipeXAxis, pipeXAxis_sub)
                nozzleOcc.CreateGeometryProxy(pipeXAxis_sub, pipeXAxis_main)

                cons.AddMateConstraint(bfXAxisProxy, pipeXAxis_main, 0)
            Catch ex As Exception
                Debug.WriteLine("RB_RT_BF Nozzle Constraint 2 failed: " & ex.Message)
            End Try

            '--------------------------------------------------
            ' 3️⃣ BLIND FLANGE (N1_Y_Axis) → PIPE (Y Axis) : MATE
            '--------------------------------------------------
            Try
                Dim bfYAxis As WorkAxis = targetPartDef.WorkAxes.Item(nozzleName & "_Y_Axis")
                Dim pipeYAxis As WorkAxis = pipeOcc.Definition.WorkAxes.Item("Y Axis")
                Dim bfYAxisProxy As Object
                Dim pipeYAxis_sub As Object
                Dim pipeYAxis_main As Object

                targetOcc.CreateGeometryProxy(bfYAxis, bfYAxisProxy)
                pipeOcc.CreateGeometryProxy(pipeYAxis, pipeYAxis_sub)
                nozzleOcc.CreateGeometryProxy(pipeYAxis_sub, pipeYAxis_main)

                cons.AddMateConstraint(bfYAxisProxy, pipeYAxis_main, 0)
            Catch ex As Exception
                Debug.WriteLine("RB_RT_BF Nozzle Constraint 3 failed: " & ex.Message)
            End Try

            Exit Sub   ' ← skip all standard mode constraints below

        End If

        '==================================================
        ' Identify DIP PIPE
        '==================================================
        Dim isDipPipe As Boolean = remarks.ToUpper().Contains("DIP")

        '==================================================
        ' DIP PIPE SPECIAL CASE
        '==================================================
        If isDipPipe Then

            Dim planeName As String = "TOP_COVER_PLANE_" & angleDeg.ToString("0")
            Dim topAngPlane As WorkPlane = Nothing

            For Each wp As WorkPlane In targetPartDef.WorkPlanes
                If wp.Name.Equals(planeName, StringComparison.OrdinalIgnoreCase) Then
                    topAngPlane = wp
                    Exit For
                End If
            Next

            If topAngPlane Is Nothing Then
                Throw New Exception("❌ Dip pipe plane not found: " & planeName)
            End If

            Dim nozYZ As WorkPlane = nozzleOcc.Definition.WorkPlanes.Item("YZ Plane")
            Dim topAngPlaneP As Object
            Dim nozYZp As Object

            targetOcc.CreateGeometryProxy(topAngPlane, topAngPlaneP)
            nozzleOcc.CreateGeometryProxy(nozYZ, nozYZp)

            Dim angleRad As Double = 45.0 * Math.PI / 180.0
            cons.AddAngleConstraint(topAngPlaneP, nozYZp, angleRad)

            Dim topXZ As WorkPlane = targetPartDef.WorkPlanes.Item("XZ Plane")

            Dim rfPadOcc As ComponentOccurrence = Nothing
            For Each subOcc As ComponentOccurrence In nozzleOcc.SubOccurrences
                If subOcc.Name.ToUpper().Contains("RF_PAD") Then
                    rfPadOcc = subOcc
                    Exit For
                End If
            Next

            If rfPadOcc Is Nothing Then
                Throw New Exception("❌ RF PAD not found for Dip Pipe nozzle")
            End If

            Dim padXZ As WorkPlane = rfPadOcc.Definition.WorkPlanes.Item("XZ Plane")
            Dim topXZp As Object
            Dim padXZp As Object

            targetOcc.CreateGeometryProxy(topXZ, topXZp)
            rfPadOcc.CreateGeometryProxy(padXZ, padXZp)

            Dim offsetCm As Double = CDbl(txt_TP_THK.Text) / 10.0
            cons.AddFlushConstraint(topXZp, padXZp, offsetCm)

            Dim topAxisY_Dip As WorkAxis = targetPartDef.WorkAxes.Item("N4_Y_Axis")
            Dim nozAxisY_Dip As WorkAxis = nozzleOcc.Definition.WorkAxes.Item("Y Axis")
            Dim topAxisYDipP As Object
            Dim nozAxisYDipP As Object

            targetOcc.CreateGeometryProxy(topAxisY_Dip, topAxisYDipP)
            nozzleOcc.CreateGeometryProxy(nozAxisY_Dip, nozAxisYDipP)

            cons.AddMateConstraint(topAxisYDipP, nozAxisYDipP, 0)

            Exit Sub

        End If

        '==================================================
        ' NORMAL TOP NOZZLES
        '==================================================

        If SelectedClient = "ARAMCO" Then

            Dim tpXZ As WorkPlane = targetPartDef.WorkPlanes.Item("XZ Plane")
            Dim nozXZ As WorkPlane = nozzleOcc.Definition.WorkPlanes.Item("XZ Plane")
            Dim tpXZp As Object
            Dim nozXZp As Object

            targetOcc.CreateGeometryProxy(tpXZ, tpXZp)
            nozzleOcc.CreateGeometryProxy(nozXZ, nozXZp)
            cons.AddFlushConstraint(tpXZp, nozXZp, 0)

            Dim topAxisX_Normal As WorkAxis = targetPartDef.WorkAxes.Item(nozzleName & "_X_Axis")
            Dim nozAxisX_Normal As WorkAxis = nozzleOcc.Definition.WorkAxes.Item("X Axis")
            Dim topAxisXp As Object
            Dim nozAxisXp As Object

            targetOcc.CreateGeometryProxy(topAxisX_Normal, topAxisXp)
            nozzleOcc.CreateGeometryProxy(nozAxisX_Normal, nozAxisXp)
            cons.AddMateConstraint(topAxisXp, nozAxisXp, 0)

            Dim topAxisY_Normal As WorkAxis = targetPartDef.WorkAxes.Item(nozzleName & "_Y_Axis")
            Dim nozAxisY_Normal As WorkAxis = nozzleOcc.Definition.WorkAxes.Item("Y Axis")
            Dim topAxisYp As Object
            Dim nozAxisYp As Object

            targetOcc.CreateGeometryProxy(topAxisY_Normal, topAxisYp)
            nozzleOcc.CreateGeometryProxy(nozAxisY_Normal, nozAxisYp)
            cons.AddMateConstraint(topAxisYp, nozAxisYp, 0)

        ElseIf SelectedClient = "ADNOC" Then

            Dim pipeOcc2 As ComponentOccurrence = Nothing
            For Each subOcc As ComponentOccurrence In nozzleOcc.SubOccurrences
                If subOcc.Name.ToUpper().Contains("PIPE") Then
                    pipeOcc2 = subOcc
                    Exit For
                End If
            Next

            If pipeOcc2 Is Nothing Then
                Throw New Exception("❌ PIPE not found inside nozzle assembly.")
            End If

            Dim tpXZ2 As WorkPlane = targetPartDef.WorkPlanes.Item("XZ Plane")
            Dim pipeXZ2 As WorkPlane = pipeOcc2.Definition.WorkPlanes.Item("XZ Plane")
            Dim tpXZp2 As Object
            Dim pipeXZ_nozP As Object
            Dim pipeXZ_mainP As Object

            targetOcc.CreateGeometryProxy(tpXZ2, tpXZp2)
            pipeOcc2.CreateGeometryProxy(pipeXZ2, pipeXZ_nozP)
            nozzleOcc.CreateGeometryProxy(pipeXZ_nozP, pipeXZ_mainP)

            Dim topAxisX2 As WorkAxis = targetPartDef.WorkAxes.Item(nozzleName & "_X_Axis")
            Dim nozAxisX2 As WorkAxis = nozzleOcc.Definition.WorkAxes.Item("X Axis")
            Dim topAxisXp2 As Object
            Dim nozAxisXp2 As Object

            targetOcc.CreateGeometryProxy(topAxisX2, topAxisXp2)
            nozzleOcc.CreateGeometryProxy(nozAxisX2, nozAxisXp2)
            cons.AddMateConstraint(topAxisXp2, nozAxisXp2, 0)

            Dim topAxisY2 As WorkAxis = targetPartDef.WorkAxes.Item(nozzleName & "_Y_Axis")
            Dim nozAxisY2 As WorkAxis = nozzleOcc.Definition.WorkAxes.Item("Y Axis")
            Dim topAxisYp2 As Object
            Dim nozAxisYp2 As Object

            targetOcc.CreateGeometryProxy(topAxisY2, topAxisYp2)
            nozzleOcc.CreateGeometryProxy(nozAxisY2, nozAxisYp2)
            cons.AddMateConstraint(topAxisYp2, nozAxisYp2, 0)

        End If

    End Sub


    Public Sub ConstrainDipPipeStack_TopFlatHead(nozAsm As AssemblyDocument, flange1Occ As ComponentOccurrence, pipe1Occ As ComponentOccurrence, flange2Occ As ComponentOccurrence,
    gasketOcc As ComponentOccurrence, flange3Occ As ComponentOccurrence, pipe2Occ As ComponentOccurrence, nozzleName As String)

        Dim cons = nozAsm.ComponentDefinition.Constraints

        '==================================================
        ' ORIGIN → FLANGE1
        '==================================================
        ConstrainOriginToFlange1(nozAsm, flange1Occ, nozzleName)

        '==================================================
        ' FLANGE1 → PIPE1
        '==================================================
        ConstrainFlange1ToPipe1(nozAsm, flange1Occ, pipe1Occ, nozzleName)

        '==================================================
        ' PIPE1 → FLANGE2
        '==================================================
        ConstrainPipe1ToFlange2(nozAsm, pipe1Occ, flange2Occ, nozzleName)

        '==================================================
        ' FLANGE2 → GASKET
        '==================================================
        ConstrainFlange2ToGasket(nozAsm, flange2Occ, gasketOcc)

        '==================================================
        ' GASKET → FLANGE3
        '==================================================
        ConstrainGasketToFlange3(nozAsm, gasketOcc, flange3Occ)

        '==================================================
        ' FLANGE3 → PIPE2
        '==================================================
        ConstrainFlange3ToPipe2(nozAsm, flange3Occ, pipe2Occ, nozzleName)

    End Sub

    Private Sub ConstrainOriginToFlange1(nozAsm As AssemblyDocument, flange1Occ As ComponentOccurrence, nozzleName As String)

        Dim cons = nozAsm.ComponentDefinition.Constraints

        '==================================================
        ' GET ORIGIN PLANES (NO PROXY REQUIRED)
        '==================================================
        Dim originXZ = nozAsm.ComponentDefinition.WorkPlanes.Item("XZ Plane")
        Dim originYZ = nozAsm.ComponentDefinition.WorkPlanes.Item("YZ Plane")
        Dim originXY = nozAsm.ComponentDefinition.WorkPlanes.Item("XY Plane")

        '==================================================
        ' GET FLANGE PLANES
        '==================================================
        Dim flangeYZ = flange1Occ.Definition.WorkPlanes.Item("YZ Plane")
        Dim flangeXZ = flange1Occ.Definition.WorkPlanes.Item("XZ Plane")
        Dim flangeXY = flange1Occ.Definition.WorkPlanes.Item("XY Plane")

        '==================================================
        ' CREATE PROXIES ONLY FOR FLANGE OCCURRENCE
        '==================================================
        Dim fYZp, fXZp, fXYp As Object

        flange1Occ.CreateGeometryProxy(flangeYZ, fYZp)
        flange1Occ.CreateGeometryProxy(flangeXZ, fXZp)
        flange1Occ.CreateGeometryProxy(flangeXY, fXYp)

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================
        cons.AddFlushConstraint(originXZ, fYZp, 0)
        cons.AddFlushConstraint(originYZ, fXZp, 0)
        cons.AddMateConstraint(originXY, fXYp, 0)

    End Sub

    Private Sub ConstrainFlange1ToPipe1(nozAsm As AssemblyDocument, flange1Occ As ComponentOccurrence, pipe1Occ As ComponentOccurrence, nozzleName As String)

        Dim cons = nozAsm.ComponentDefinition.Constraints

        Dim flangeEnd = flange1Occ.Definition.WorkPlanes.Item(nozzleName & "_End_Plane")
        Dim pipeXZ = pipe1Occ.Definition.WorkPlanes.Item("XZ Plane")
        Dim flangeXZ = flange1Occ.Definition.WorkPlanes.Item("XZ Plane")
        Dim pipeYZ = pipe1Occ.Definition.WorkPlanes.Item("YZ Plane")
        Dim flangeXY = flange1Occ.Definition.WorkPlanes.Item("XY Plane")
        Dim pipeXY = pipe1Occ.Definition.WorkPlanes.Item("XY Plane")

        Dim fEndP, pXZP, fXZP, pYZP, fXYP, pXYP As Object

        flange1Occ.CreateGeometryProxy(flangeEnd, fEndP)
        pipe1Occ.CreateGeometryProxy(pipeXZ, pXZP)

        flange1Occ.CreateGeometryProxy(flangeXZ, fXZP)
        pipe1Occ.CreateGeometryProxy(pipeYZ, pYZP)

        flange1Occ.CreateGeometryProxy(flangeXY, fXYP)
        pipe1Occ.CreateGeometryProxy(pipeXY, pXYP)

        cons.AddFlushConstraint(fEndP, pXZP, 0)
        cons.AddFlushConstraint(fXZP, pYZP, 0)
        cons.AddMateConstraint(fXYP, pXYP, 0)

    End Sub

    Private Sub ConstrainPipe1ToFlange2(nozAsm As AssemblyDocument, pipe1Occ As ComponentOccurrence, flange2Occ As ComponentOccurrence, nozzleName As String)

        Dim cons = nozAsm.ComponentDefinition.Constraints

        Dim pipeEnd = pipe1Occ.Definition.WorkPlanes.Item("End_Plane")
        Dim flangeEnd = flange2Occ.Definition.WorkPlanes.Item(nozzleName & "_End_Plane")
        Dim pipeYZ = pipe1Occ.Definition.WorkPlanes.Item("YZ Plane")
        Dim flangeXZ = flange2Occ.Definition.WorkPlanes.Item("XZ Plane")
        Dim pipeXY = pipe1Occ.Definition.WorkPlanes.Item("XY Plane")
        Dim flangeXY = flange2Occ.Definition.WorkPlanes.Item("XY Plane")

        Dim pEndP, fEndP, pYZP, fXZP, pXYP, fXYP As Object

        pipe1Occ.CreateGeometryProxy(pipeEnd, pEndP)
        flange2Occ.CreateGeometryProxy(flangeEnd, fEndP)

        pipe1Occ.CreateGeometryProxy(pipeYZ, pYZP)
        flange2Occ.CreateGeometryProxy(flangeXZ, fXZP)

        pipe1Occ.CreateGeometryProxy(pipeXY, pXYP)
        flange2Occ.CreateGeometryProxy(flangeXY, fXYP)

        cons.AddMateConstraint(pEndP, fEndP, 0)
        cons.AddFlushConstraint(pYZP, fXZP, 0)
        cons.AddFlushConstraint(pXYP, fXYP, 0)

    End Sub

    Private Sub ConstrainFlange2ToGasket(nozAsm As AssemblyDocument, flange2Occ As ComponentOccurrence, gasketOcc As ComponentOccurrence)

        Dim cons = nozAsm.ComponentDefinition.Constraints

        Dim flangeYZ = flange2Occ.Definition.WorkPlanes.Item("YZ Plane")
