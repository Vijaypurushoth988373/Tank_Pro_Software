    Private Shared Function NormalizeFlangeClass(val As String) As String

        If String.IsNullOrWhiteSpace(val) Then Return ""

        val = val.Trim()

        ' Remove unwanted characters
        val = val.Replace("#", "")
        val = val.Replace("LB", "")
        val = val.Replace("LBS", "")
        val = val.Replace(" ", "")

        ' Always return as "150#"
        Return val & "#"

    End Function

