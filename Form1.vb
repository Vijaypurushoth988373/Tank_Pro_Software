    Private Function GetAsmOriginPlanes(asmDef As AssemblyComponentDefinition) As Object()

        Return New Object() {asmDef.WorkPlanes.Item(1), asmDef.WorkPlanes.Item(2), asmDef.WorkPlanes.Item(3)}

    End Function

    Private Function GetPartOriginPlanes(occ As ComponentOccurrence) As Object()

        Dim partDef As PartComponentDefinition = occ.Definition
        Return New Object() {partDef.WorkPlanes.Item(1), partDef.WorkPlanes.Item(2), partDef.WorkPlanes.Item(3)}

    End Function

    Private Sub ConstrainToOriginPlanes(asmDoc As AssemblyDocument, occ As ComponentOccurrence)

        occ.Grounded = False

        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim constraints As AssemblyConstraints = asmDef.Constraints

        '--------------------------------------
        ' Assembly Origin Planes (by Name)
        '--------------------------------------
        Dim asmXY As WorkPlane = asmDef.WorkPlanes.Item("XY Plane")
        Dim asmYZ As WorkPlane = asmDef.WorkPlanes.Item("YZ Plane")
        Dim asmXZ As WorkPlane = asmDef.WorkPlanes.Item("XZ Plane")

        '--------------------------------------
        ' Component Origin Planes (by Name)
        '--------------------------------------
        Dim partDef As PartComponentDefinition = occ.Definition

        Dim partXY As WorkPlane = partDef.WorkPlanes.Item("XY Plane")
        Dim partYZ As WorkPlane = partDef.WorkPlanes.Item("YZ Plane")
        Dim partXZ As WorkPlane = partDef.WorkPlanes.Item("XZ Plane")

        '--------------------------------------
        ' Create Geometry Proxies
        '--------------------------------------
        Dim proxyXY As Object
        Dim proxyYZ As Object
        Dim proxyXZ As Object

        occ.CreateGeometryProxy(partXY, proxyXY)
        occ.CreateGeometryProxy(partYZ, proxyYZ)
        occ.CreateGeometryProxy(partXZ, proxyXZ)

        '--------------------------------------
        ' Apply Constraints Based on Head Type
        '--------------------------------------

        'Ellipsoidal Head
        If RB_LB_EH.Checked Then

            constraints.AddFlushConstraint(asmXY, proxyXY, 0)
            constraints.AddFlushConstraint(asmYZ, proxyYZ, 0)
            constraints.AddFlushConstraint(asmXZ, proxyXZ, 0)

        End If


        'Torispherical Head
        If RB_LB_TH.Checked Then

            constraints.AddMateConstraint(asmXY, proxyXY, 0)
            constraints.AddFlushConstraint(asmYZ, proxyYZ, 0)
            constraints.AddMateConstraint(asmXZ, proxyXZ, 0)

        End If

    End Sub

    Sub PlaceAndFixEllipsoidalHead(invApp As Inventor.Application, asmDoc As AssemblyDocument, headFilePath As String)

        Dim occ As ComponentOccurrence = PlaceEllipsoidalHead(invApp, asmDoc, headFilePath)

        ConstrainToOriginPlanes(asmDoc, occ)

        occ.Grounded = False

        asmDoc.Update()
    End Sub

