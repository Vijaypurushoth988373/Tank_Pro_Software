    Public Sub PlaceAndConstrainManwayDavit_ADNOC(asmDoc As AssemblyDocument, nozzleM1Occ As ComponentOccurrence, davitAsmOcc As ComponentOccurrence)

        '==================================================
        ' CONSTRAINT COLLECTION
        '==================================================
        Dim cons = asmDoc.ComponentDefinition.Constraints

        '==================================================
        ' FIND BRACKET INSIDE DAVIT ASSEMBLY
        '==================================================
        Dim bracketOcc As ComponentOccurrence = Nothing
        For Each occ As ComponentOccurrence In davitAsmOcc.SubOccurrences
            If occ.Name.ToUpper().Contains("36_BRACKET_FOR_MD") Then
                bracketOcc = occ
                Exit For
            End If
        Next

        If bracketOcc Is Nothing Then
            Throw New Exception("❌ 36_BRACKET_FOR_MD not found inside davit assembly.")
        End If

        '==================================================
        ' NOZZLE M1 REFERENCES
        '==================================================
        Dim nozYAxis As WorkAxis = nozzleM1Occ.Definition.WorkAxes.Item("Y Axis")
        Dim nozXY As WorkPlane = nozzleM1Occ.Definition.WorkPlanes.Item("XY Plane")

        '==================================================
        ' FIND M1_FLANGE OCCURRENCE
        '==================================================
        Dim flangeOcc As ComponentOccurrence = Nothing

        For Each occ As ComponentOccurrence In nozzleM1Occ.SubOccurrences
            If occ.Name.ToUpper().Contains("M1_FLANGE") Then
                flangeOcc = occ
                Exit For
            End If
        Next

        If flangeOcc Is Nothing Then
            Throw New Exception("❌ M1_FLANGE not found inside nozzle assembly.")
        End If


        Dim flangeYZ As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("YZ Plane")

        '==================================================
        ' BRACKET REFERENCES
        '==================================================
        Dim bracketZ As WorkAxis = bracketOcc.Definition.WorkAxes.Item("Z Axis")
        Dim bracketXZ As WorkPlane = bracketOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim bracketXY As WorkPlane = bracketOcc.Definition.WorkPlanes.Item("XY Plane")

        '==================================================
        ' CREATE PROXIES
        '==================================================
        Dim nozYAxisProxy, nozXYProxy As Object
        Dim flangeYZProxy As Object
        nozzleM1Occ.CreateGeometryProxy(nozYAxis, nozYAxisProxy)
        nozzleM1Occ.CreateGeometryProxy(nozXY, nozXYProxy)
        flangeOcc.CreateGeometryProxy(flangeYZ, flangeYZProxy)

        Dim bracketZProxy, bracketXZProxy, bracketXYProxy As Object
        bracketOcc.CreateGeometryProxy(bracketZ, bracketZProxy)
        bracketOcc.CreateGeometryProxy(bracketXZ, bracketXZProxy)
        bracketOcc.CreateGeometryProxy(bracketXY, bracketXYProxy)


        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================

        '1️ Y Axis ↔ Z Axis
        cons.AddMateConstraint(nozYAxisProxy, bracketZProxy, 0)

        '2️ XY ↔ XZ
        cons.AddFlushConstraint(nozXYProxy, bracketXZProxy, 0)

        '3️ M1_FLANGE YZ ↔ XY
        cons.AddMateConstraint(flangeYZProxy, bracketXYProxy, 145 / 10)

        '==================================================
        ' FINAL UPDATE
        '==================================================
        asmDoc.Update()

    End Sub

    Public Sub PlaceAndConstrainManwayHandles(asmDoc As AssemblyDocument, coverOcc As ComponentOccurrence, handlePath As String, invApp As Inventor.Application)

        Dim asmDef = asmDoc.ComponentDefinition
