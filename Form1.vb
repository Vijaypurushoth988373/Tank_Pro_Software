        ' SHELL REFERENCES
        '==================================================
        Dim shellDef = shellOcc.Definition
        Dim shellYZ As WorkPlane = shellDef.WorkPlanes.Item("YZ Plane")
        Dim shellMID As WorkPlane = shellDef.WorkPlanes.Item("MID_PLANE")
        Dim shellXZ As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' STEP RUNG REFERENCES
        '==================================================
        Dim stepDef = stepOcc.Definition
        Dim stepMID As WorkPlane = stepDef.WorkPlanes.Item("MID_PLANE")
        Dim stepXY As WorkPlane = stepDef.WorkPlanes.Item("XY Plane")
        Dim stepXZ As WorkPlane = stepDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' CREATE GEOMETRY PROXIES – SHELL
        '==================================================
        Dim shellYZProxy As Object
        Dim shellMIDProxy As Object
        Dim shellXZProxy As Object

        shellOcc.CreateGeometryProxy(shellYZ, shellYZProxy)
        shellOcc.CreateGeometryProxy(shellMID, shellMIDProxy)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZProxy)

        '==================================================
        ' CREATE GEOMETRY PROXIES – STEP RUNG
        '==================================================
        Dim stepMIDProxy As Object
        Dim stepXYProxy As Object
        Dim stepXZProxy As Object

        stepOcc.CreateGeometryProxy(stepMID, stepMIDProxy)
        stepOcc.CreateGeometryProxy(stepXY, stepXYProxy)
        stepOcc.CreateGeometryProxy(stepXZ, stepXZProxy)

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================

        '1️⃣ YZ ↔ MID_PLANE
        cons.AddFlushConstraint(shellYZProxy, stepMIDProxy, 0)

        '2️⃣ MID_PLANE ↔ XY
        cons.AddFlushConstraint(shellMIDProxy, stepXYProxy, 0)

        '3️⃣ XZ ↔ XZ WITH OFFSET
        Dim offsetCm As Double = (CDbl(txt_SR_Dist_base.Text) / 10.0) - (CDbl(txt_EH_SF.Text) / 10.0)

        cons.AddFlushConstraint(shellXZProxy, stepXZProxy, offsetCm)

        '==================================================
        ' FINAL UPDATE
        '==================================================
        asmDoc.Update()

        Return stepOcc

    End Function

    Public Sub PatternGrabLadderRungs(invApp As Inventor.Application, asmDoc As AssemblyDocument, baseRungOcc As ComponentOccurrence, rungCount As Integer, spacingMm As Double)

        '==================================================
        ' Safety checks
        '==================================================
        If asmDoc Is Nothing Then
            Throw New Exception("❌ AssemblyDocument is Nothing")
        End If

        If baseRungOcc Is Nothing Then
            Throw New Exception("❌ Base rung occurrence is Nothing")
        End If

        '==================================================
        ' Assembly definition
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition

        '==================================================
        ' Seed occurrence collection
        '==================================================
        Dim seedOccs As ObjectCollection = invApp.TransientObjects.CreateObjectCollection()
        seedOccs.Add(baseRungOcc)

        '==================================================
        ' Pattern direction → GLOBAL Y AXIS
        '==================================================
        Dim yAxis As WorkAxis = asmDef.WorkAxes.Item("Y Axis")

        '==================================================
        ' Pattern spacing (mm → cm)
        '==================================================
        Dim spacingCm As Double = spacingMm / 10.0

        '==================================================
        ' ✅ Create Rectangular Occurrence Pattern
        ' ✅ SAME ORDER AS Pipe Support WORKING FUNCTION
        '==================================================
        Dim patt As RectangularOccurrencePattern
        patt = asmDef.OccurrencePatterns.AddRectangularPattern(seedOccs, yAxis, True, spacingCm, rungCount, Nothing, False, 0, 1)
        patt.Name = "GRAB_LADDER_RUNG_PATTERN"

        '==================================================
        ' Final update
        '==================================================
        asmDoc.Update()

    End Sub

