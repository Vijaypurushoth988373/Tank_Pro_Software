    Public Function PlaceAndConstrainGussetPlate_N8_QATAR(invApp As Inventor.Application, projectFolder As String) As ComponentOccurrence

        '==================================================
        ' NOZZLE N8 ASSEMBLY PATH
        '==================================================
        Dim nozAsmPath As String = IO.Path.Combine(projectFolder, "Nozzle_N8.iam")
        If Not IO.File.Exists(nozAsmPath) Then
            Throw New Exception("Nozzle_N8.iam not found.")
        End If


        '==================================================
        ' OPEN NOZZLE ASSEMBLY
        '==================================================
        Dim nozAsm As AssemblyDocument = CType(invApp.Documents.Open(nozAsmPath, False), AssemblyDocument)
        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' FIND PIPE OCCURRENCE
        '==================================================
        Dim pipeOcc As ComponentOccurrence = Nothing

        For Each occ As ComponentOccurrence In asmDef.Occurrences
            If occ.Name.ToUpper().Contains("PIPE") Then
                pipeOcc = occ
                Exit For
            End If
        Next

        If pipeOcc Is Nothing Then
            Throw New Exception("Pipe occurrence not found inside Nozzle_N8 assembly.")
        End If

        '==================================================
        ' FIND RF PAD OCCURRENCE
        '==================================================
        Dim rfPadOcc As ComponentOccurrence = Nothing
        For Each occ As ComponentOccurrence In asmDef.Occurrences
            If occ.Name.ToUpper().Contains("RF_PAD") Then
                rfPadOcc = occ
                Exit For
            End If
        Next

        If rfPadOcc Is Nothing Then
            Throw New Exception("RF Pad occurrence not found inside Nozzle_N8 assembly.")
        End If

        '==================================================
        ' GUSSET PLATE PATH
        '==================================================
        Dim gussetPath As String = IO.Path.Combine(projectFolder, "Qatar\40_GUSSET_PLATE_FOR_NOZZLE_N8.ipt")
        If Not IO.File.Exists(gussetPath) Then
            Throw New Exception("Gusset Plate file not found.")
        End If

        '==================================================
        ' PLACE GUSSET PLATE
        '==================================================
        Dim gussetOcc As ComponentOccurrence = asmDef.Occurrences.Add(gussetPath, tg.CreateMatrix())
        gussetOcc.Grounded = False
        gussetOcc.Name = "GUSSET_PLATE"

        '==================================================
        ' GET PIPE PLANES
        '==================================================
        Dim pipeDef As PartComponentDefinition = pipeOcc.Definition
        Dim pipeXY As WorkPlane = pipeDef.WorkPlanes.Item("XY Plane")
        Dim pipeYZ As WorkPlane = pipeDef.WorkPlanes.Item("YZ Plane")

        '==================================================
        ' GET RF PAD PLANES
        '==================================================
        Dim rfPadDef As PartComponentDefinition = rfPadOcc.Definition
        Dim rfPadXZ As WorkPlane = rfPadDef.WorkPlanes.Item("XZ Plane")


        '==================================================
        ' GET GUSSET PLANES
        '==================================================
        Dim gussetDef As PartComponentDefinition = gussetOcc.Definition
        Dim gussetXY As WorkPlane = gussetDef.WorkPlanes.Item("XY Plane")
        Dim gussetXZ As WorkPlane = gussetDef.WorkPlanes.Item("XZ Plane")
        Dim gussetWP1 As WorkPlane = gussetDef.WorkPlanes.Item("Work Plane1")

        '==================================================
        ' CREATE GEOMETRY PROXIES
        '==================================================
        Dim pipeXYp, pipeYZp As Object
        Dim rfPadXZp As Object
        Dim gussetXYp, gussetXZp, gussetWP1p As Object

        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)

        rfPadOcc.CreateGeometryProxy(rfPadXZ, rfPadXZp)

        gussetOcc.CreateGeometryProxy(gussetXY, gussetXYp)
        gussetOcc.CreateGeometryProxy(gussetXZ, gussetXZp)
        gussetOcc.CreateGeometryProxy(gussetWP1, gussetWP1p)

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================
        '1️⃣ Pipe XY ↔ Gusset XY (Flush)
        cons.AddFlushConstraint(pipeXYp, gussetXYp, 0)

        '2️⃣ RF Pad XZ ↔ Gusset XZ (Mate)
        cons.AddMateConstraint(rfPadXZp, gussetXZp, 0)

        '3️⃣ Pipe YZ ↔ Gusset WorkPlane1 (Mate offset)
        Dim offsetCm As Double = 84.138 / 10.0
        cons.AddMateConstraint(pipeYZp, gussetWP1p, offsetCm)

        '==================================================
        ' UPDATE ASSEMBLY
        '==================================================
        nozAsm.Update()

        Return gussetOcc

    End Function

