            Case "10"
                Select Case OD
                    Case 60.3 : THK = 2.8
                    Case 73 : THK = 3
                    Case 88.9 : THK = 3
                    Case 101.6 : THK = 3
                    Case 114.3 : THK = 3
                    Case 168.3 : THK = 3.4
                    Case 219.1 : THK = 3.8
                    Case 273 : THK = 4.2
                    Case 323.8 : THK = 4.6
                    Case 355.6 : THK = 6.4
                    Case 406.4 : THK = 6.4
                    Case 457 : THK = 6.4
                    Case 508 : THK = 6.4
                    Case 559 : THK = 6.4
                    Case 610 : THK = 6.4
                End Select

            Case "40"
                Select Case OD
                    Case 60.3 : THK = 3.9
                    Case 73 : THK = 5.2
                    Case 88.9 : THK = 5.5
                    Case 114.3 : THK = 6
                    Case 168.3 : THK = 7.1
                    Case 219.1 : THK = 8.2
                    Case 273 : THK = 9.3
                    Case 323.8 : THK = 10.3
                    Case 355.6 : THK = 11.1
                    Case 406.4 : THK = 12.7
                    Case 457 : THK = 14.3
                    Case 508 : THK = 15.1
                    Case 559 : THK = 17.5
                    Case 610 : THK = 19
                End Select

            Case "80"
                Select Case OD
                    Case 60.3 : THK = 5.5
                    Case 73 : THK = 7
                    Case 88.9 : THK = 7.6
                    Case 114.3 : THK = 8.6
                    Case 168.3 : THK = 11
                    Case 219.1 : THK = 12.7
                    Case 273 : THK = 15.1
                    Case 323.8 : THK = 17.5
                    Case 355.6 : THK = 19
                    Case 406.4 : THK = 21.4
                    Case 457 : THK = 23.8
                    Case 508 : THK = 26.2
                    Case 559 : THK = 28.6
                    Case 610 : THK = 31
                End Select

            Case "160"
                Select Case OD
                    Case 60.3 : THK = 8.7
                    Case 73 : THK = 9.5
                    Case 88.9 : THK = 11.1
                    Case 114.3 : THK = 13.5
                    Case 168.3 : THK = 18.3
                    Case 219.1 : THK = 23
                    Case 273 : THK = 28.6
                    Case 323.8 : THK = 33.3
                    Case 355.6 : THK = 35.7
                    Case 406.4 : THK = 40.5
                    Case 457 : THK = 45.2
                    Case 508 : THK = 50
                    Case 559 : THK = 54
