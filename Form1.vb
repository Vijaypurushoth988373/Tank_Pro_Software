        ' CREATE GEOMETRY PROXIES
        '==================================================
        Dim sbPlane3p, sbPlane93p, topXZp As Object
        Dim studXZp, studXYp, studWP1p As Object

        topCoverOcc.CreateGeometryProxy(sbPlane3, sbPlane3p)
        topCoverOcc.CreateGeometryProxy(sbPlane93, sbPlane93p)
        topCoverOcc.CreateGeometryProxy(topXZ, topXZp)

        studOcc.CreateGeometryProxy(studXZ, studXZp)
        studOcc.CreateGeometryProxy(studXY, studXYp)
        studOcc.CreateGeometryProxy(studWP1, studWP1p)

        '==================================================
        ' CONSTRAINT 1
        ' SB_Plane_3 ↔ XZ  (MATE)
        '==================================================
        cons.AddMateConstraint(sbPlane3p, studXZp, 0)

        '==================================================
