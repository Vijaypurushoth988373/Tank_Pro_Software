    Public Shared Sub AddRefSpecTable(oSheet As Inventor.Sheet, dgvRef As DataGridView)

        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry
        Dim TableContents As New List(Of String)

        '========================================================
        ' TABLE FORMAT
        '========================================================
        Dim colno As Integer = 2
        Dim tableTitle As String = " APPLICABLE STANDARD AND REFERENCE SPECIFICATION "

        '========================================================
        ' 1) READ ALL ROWS FROM DGV_REF_SPEC
        '========================================================
        For Each row As DataGridViewRow In dgvRef.Rows

            If row.IsNewRow Then Continue For

            Dim nameVal As String = Convert.ToString(row.Cells(0).Value)
            Dim refVal As String = Convert.ToString(row.Cells(1).Value)

            ' Skip empty rows
            If String.IsNullOrWhiteSpace(nameVal) And
           String.IsNullOrWhiteSpace(refVal) Then Continue For

            TableContents.Add(nameVal)
            TableContents.Add(refVal)

        Next

        '========================================================
        ' 2) DELETE OLD TABLE IF EXISTS
        '========================================================
        For Each T As Inventor.CustomTable In oSheet.CustomTables

            If T.Title.Trim() = tableTitle.Trim() Then
                T.Delete()
                Exit For
            End If

        Next

        '========================================================
        ' 4) INSERT POSITION (A2 Sheet)
        ' Change X,Y as needed
        '========================================================
        Dim insertPt As Inventor.Point2d = oTG.CreatePoint2d(48.4, 41)

        '========================================================
        ' 5) CREATE CUSTOM TABLE
        '=======================================================
        Dim refTable As Inventor.CustomTable = oSheet.CustomTables.Add(tableTitle, insertPt, colno, TableContents.Count / colno, {" ", " "}, TableContents.ToArray(), {6.0, 4.0})   ' Column Widths

        '========================================================
        ' 6) FORMAT TABLE
        '========================================================
        refTable.HeadingPlacement = HeadingPlacementEnum.kNoHeading
        refTable.Style.TableDirection = TableDirectionEnum.kTopDownDirection

        ' Column Alignment
        refTable.Columns.Item(1).ValueHorizontalJustification = HorizontalTextAlignmentEnum.kAlignTextLeft
        refTable.Columns.Item(2).ValueHorizontalJustification = HorizontalTextAlignmentEnum.kAlignTextLeft

    End Sub

