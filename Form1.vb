            Next
            Debug.Print($"   ClearTableRows: done → {tbl.Rows.Count} rows remain")
        Catch ex As Exception
            Debug.Print($"⚠ ClearTableRows failed: {ex.Message}")
        End Try
    End Sub

    '==================================================
    ' HELPER — UPDATE NOZZLE SCHEDULE TABLE
    '==================================================
    Private Sub UpdateNozzleTable(tables As Object)
        Try
            Dim tbl As Object = FindTable(tables, "NOZZLE")
            If tbl Is Nothing Then
                Debug.Print("⚠ Nozzle table not found.")
                Exit Sub
            End If

            ClearTableRows(tbl)

            Dim addedCount As Integer = 0

            For Each row As DataGridViewRow In DGV_NOZZLE_SCHEDULE_FINAL.Rows
                If row.IsNewRow Then Continue For

                Dim mark As String = SafeStr(row.Cells(0).Value)
                If mark = "" Then Continue For

                Dim newRow As Object = tbl.Rows.Add()

                '✅ Use .Value not .Text
                newRow.Item(1).Value = SafeStr(row.Cells(0).Value)   ' NOZZLE MARK
                newRow.Item(2).Value = SafeStr(row.Cells(1).Value)   ' SERVICE
                newRow.Item(3).Value = SafeStr(row.Cells(2).Value)   ' QTY
                newRow.Item(4).Value = SafeStr(row.Cells(3).Value)   ' SIZE NPS
                newRow.Item(5).Value = SafeStr(row.Cells(4).Value)   ' NOZZLE SCH
                newRow.Item(6).Value = SafeStr(row.Cells(5).Value)   ' NOZZLE THK
                newRow.Item(7).Value = SafeStr(row.Cells(6).Value)   ' FLANGE CLASS
                newRow.Item(8).Value = SafeStr(row.Cells(7).Value)   ' FLANGE TYPE
                newRow.Item(9).Value = SafeStr(row.Cells(8).Value)   ' RF PAD OD
                newRow.Item(10).Value = SafeStr(row.Cells(9).Value)   ' RF PAD THK
                newRow.Item(11).Value = SafeStr(row.Cells(10).Value)  ' WELD SIZE A
                newRow.Item(12).Value = SafeStr(row.Cells(11).Value)  ' WELD SIZE B
                newRow.Item(13).Value = SafeStr(row.Cells(12).Value)  ' WELD SIZE C
                newRow.Item(14).Value = SafeStr(row.Cells(13).Value)  ' REMARKS

                addedCount += 1
                Debug.Print($"   ✅ Nozzle row {addedCount}: {mark}")
            Next

            Debug.Print($"✅ Nozzle rows added: {addedCount}")

        Catch ex As Exception
            Debug.Print($"⚠ UpdateNozzleTable failed: {ex.Message}")
        End Try
    End Sub

