    Public Sub UpdateAllPipeIDParameters(invApp As Inventor.Application, folderPath As String)

        '==================================================
        ' Validate folder
        '==================================================
        If Not IO.Directory.Exists(folderPath) Then
            Throw New Exception("Nozzles folder not found: " & folderPath)
        End If

        '==================================================
        Dim pipeIDmm As Double = SafeDouble(txt_Shell_Inside_Dia.Text)

        '==================================================
        ' Loop through all PIPE files
        '==================================================
        Dim pipeFiles = IO.Directory.GetFiles(folderPath, "*PIPE*.ipt")

        For Each filePath In pipeFiles

            Try
                Dim partDoc As PartDocument = CType(invApp.Documents.Open(filePath, False), PartDocument)
                Dim params As Parameters = partDoc.ComponentDefinition.Parameters

                '==================================================
                ' Update ID parameter if exists
                '==================================================
                Try
                    params.Item("ID").Expression = pipeIDmm & " mm"
                Catch
                    Debug.Print("ID parameter missing in: " & filePath)
                End Try

                partDoc.Update()
                partDoc.Save()
                partDoc.Close(True)

            Catch ex As Exception

                Debug.Print("Failed updating: " & filePath)

            End Try

        Next

    End Sub

