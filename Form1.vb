    Public Sub FixVisibleFlangeQty()

        Dim invApp As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim drawDoc As DrawingDocument = invApp.ActiveDocument
        Dim oSheet As Sheet = drawDoc.Sheets.Item(5)

        If oSheet.PartsLists.Count = 0 Then Exit Sub

        Dim oPartsList As PartsList = oSheet.PartsLists.Item(1)

        Dim sizeCol As Integer = -1
        Dim descCol As Integer = -1
        Dim qtyCol As Integer = -1

        'Find columns
        For i As Integer = 1 To oPartsList.PartsListColumns.Count

            Dim title As String =
                oPartsList.PartsListColumns.Item(i).Title.ToUpper

            If title.Contains("SIZE") Then sizeCol = i
            If title.Contains("DESCRIPTION") Then descCol = i
            If title.Contains("QTY") Then qtyCol = i

        Next

        If sizeCol = -1 Or descCol = -1 Or qtyCol = -1 Then Exit Sub

        'Make QTY column static
        oPartsList.PartsListColumns.Item(qtyCol).Static = True

        'Count flanges by SIZE
        Dim sizeCount As New Dictionary(Of String, Integer)

        For Each row As PartsListRow In oPartsList.PartsListRows

            Dim desc As String = row.Item(descCol).Value.ToUpper
            Dim sizeText As String = row.Item(sizeCol).Value.Trim

            If desc.Contains("FLANGE") Then

                If sizeCount.ContainsKey(sizeText) Then
                    sizeCount(sizeText) += 1
                Else
                    sizeCount.Add(sizeText, 1)
                End If

            End If

        Next

        'Update only visible rows
        Dim processed As New HashSet(Of String)

        For Each row As PartsListRow In oPartsList.PartsListRows

            If Not row.Visible Then Continue For

            Dim desc As String = row.Item(descCol).Value.ToUpper
            Dim sizeText As String = row.Item(sizeCol).Value.Trim

            If desc.Contains("FLANGE") Then

                If Not processed.Contains(sizeText) Then

                    row.Item(qtyCol).Value =
                        sizeCount(sizeText).ToString()

                    processed.Add(sizeText)

                End If

            End If

        Next

        drawDoc.Update()

    End Sub

