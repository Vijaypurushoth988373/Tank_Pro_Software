    Public Sub ConstrainNozzleToTopFlatHead_XY(invApp As Inventor.Application, asmDoc As AssemblyDocument, targetOcc As ComponentOccurrence, nozzleOcc As ComponentOccurrence, xMm As Double, yMm As Double, remarks As String)

        Dim cons As AssemblyConstraints = asmDoc.ComponentDefinition.Constraints

        Dim xCm As Double = xMm / 10.0
        Dim yCm As Double = yMm / 10.0

        remarks = remarks.ToUpper()

        '==================================================
        ' RB_RT_BF MODE — Blind Flange constraints
        '==================================================
        If RB_RT_BF.Checked Then

            '--------------------------------------------------
            ' Find RF PAD inside nozzle sub-assembly
            '--------------------------------------------------
            Dim rfPadOcc As ComponentOccurrence = Nothing

            For Each subOcc As ComponentOccurrence In nozzleOcc.SubOccurrences
                If subOcc.Name.ToUpper.Contains("RF_PAD") Then
                    rfPadOcc = subOcc
                    Exit For
                End If
            Next

            '--------------------------------------------------
            ' FALLBACK: Get part doc from FullFileName
            ' Most reliable for any occurrence type
            '--------------------------------------------------
            Dim bfPartDoc As PartDocument = Nothing

            Try
                bfPartDoc = CType(targetOcc.ReferencedDocumentDescriptor.ReferencedDocument, PartDocument)
            Catch
                Try
                    bfPartDoc = CType(invApp.Documents.Open(
            targetOcc.ReferencedDocumentDescriptor.FullDocumentName, True), PartDocument)
                Catch ex As Exception
                    Debug.WriteLine("Could not get Blind Flange part doc: " & ex.Message)
                    Exit Sub
                End Try
            End Try

            If bfPartDoc Is Nothing Then
                Debug.WriteLine("Blind Flange part document is Nothing")
                Exit Sub
            End If

            Dim bfPartDef As PartComponentDefinition = bfPartDoc.ComponentDefinition

            '--------------------------------------------------
            ' 1️⃣ BLIND FLANGE (YZ) → NOZZLE RF_PAD (TOP_PLANE) : FLUSH
            '--------------------------------------------------
            Try
                If rfPadOcc IsNot Nothing Then
                    Dim bfYZPlane As Object = bfPartDef.WorkPlanes.Item("YZ Plane")
                    Dim bfYZ As Object
                    Dim padTopProxy_sub As Object
                    Dim padTopProxy_main As Object

                    targetOcc.CreateGeometryProxy(bfYZPlane, bfYZ)
                    rfPadOcc.CreateGeometryProxy(rfPadOcc.Definition.WorkPlanes.Item("TOP_PLANE"), padTopProxy_sub)
                    nozzleOcc.CreateGeometryProxy(padTopProxy_sub, padTopProxy_main)

                    cons.AddFlushConstraint(bfYZ, padTopProxy_main, 0)
                End If
            Catch ex As Exception
                Debug.WriteLine("RB_RT_BF Constraint 1 failed: " & ex.Message)
            End Try

            '--------------------------------------------------
            ' 2️⃣ BLIND FLANGE (XZ) → NOZZLE (YZ) : FLUSH (xCm offset)
            '--------------------------------------------------
            Try
                Dim bfXZPlane As Object = bfPartDef.WorkPlanes.Item("XZ Plane")
                Dim bfXZ As Object
                Dim nozYZp As Object

                targetOcc.CreateGeometryProxy(bfXZPlane, bfXZ)
                nozzleOcc.CreateGeometryProxy(nozzleOcc.Definition.WorkPlanes.Item("YZ Plane"), nozYZp)

                cons.AddFlushConstraint(bfXZ, nozYZp, xCm)
            Catch ex As Exception
                Debug.WriteLine("RB_RT_BF Constraint 2 failed: " & ex.Message)
            End Try

            '--------------------------------------------------
            ' 3️⃣ BLIND FLANGE (XY) → NOZZLE (XY) : MATE (-yCm offset)
            '--------------------------------------------------
            Try
                Dim bfXYPlane As Object = bfPartDef.WorkPlanes.Item("XY Plane")
                Dim bfXY As Object
                Dim nozXYp As Object

                targetOcc.CreateGeometryProxy(bfXYPlane, bfXY)
                nozzleOcc.CreateGeometryProxy(nozzleOcc.Definition.WorkPlanes.Item("XY Plane"), nozXYp)

                cons.AddMateConstraint(bfXY, nozXYp, -yCm)
            Catch ex As Exception
                Debug.WriteLine("RB_RT_BF Constraint 3 failed: " & ex.Message)
            End Try

            Exit Sub

        End If

        '==================================================
        ' STANDARD MODE — Top Cover / Head constraints
        '==================================================

        '==================================================
        ' 1️⃣ TARGET XY ↔ NOZZLE XY → MATE (Y OFFSET)
        '==================================================
        Dim targetXY = targetOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim nozXY = nozzleOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim targetXYp As Object
        Dim nozXYp2 As Object

        targetOcc.CreateGeometryProxy(targetXY, targetXYp)
        nozzleOcc.CreateGeometryProxy(nozXY, nozXYp2)
        cons.AddMateConstraint(targetXYp, nozXYp2, -yCm)

        '==================================================
        ' 2️⃣ TARGET YZ ↔ NOZZLE YZ → FLUSH (X OFFSET)
        '==================================================
        Dim targetYZ = targetOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim nozYZ = nozzleOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim targetYZp As Object
        Dim nozYZp2 As Object

        targetOcc.CreateGeometryProxy(targetYZ, targetYZp)
        nozzleOcc.CreateGeometryProxy(nozYZ, nozYZp2)
        cons.AddFlushConstraint(targetYZp, nozYZp2, xCm)

        '==================================================
        ' 3️⃣ SEATING CONSTRAINT (CLIENT-DEPENDENT)
        '==================================================
        Dim rfPadOccStd As ComponentOccurrence = Nothing
        Dim flange1Occ As ComponentOccurrence = Nothing
        Dim pipeOcc As ComponentOccurrence = Nothing

        For Each subOcc As ComponentOccurrence In nozzleOcc.SubOccurrences
            If subOcc.Name.ToUpper.Contains("RF_PAD") Then
                rfPadOccStd = subOcc
            ElseIf subOcc.Name.ToUpper.Contains("FLANGE1") Then
                flange1Occ = subOcc
            ElseIf subOcc.Name.ToUpper.Contains("PIPE") Then
                pipeOcc = subOcc
            End If
        Next

        Dim targetXZ = targetOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim targetXZp As Object
        targetOcc.CreateGeometryProxy(targetXZ, targetXZp)

        '--------------------------------------------------
        ' CASE 1️⃣ RF PAD EXISTS (ARAMCO + ADNOC)
        '--------------------------------------------------
        If rfPadOccStd IsNot Nothing Then

            Dim padTopPlane = rfPadOccStd.Definition.WorkPlanes.Item("TOP_PLANE")
            Dim padTopPlaneProxy_sub As Object
            Dim padTopPlaneProxy_main As Object

            rfPadOccStd.CreateGeometryProxy(padTopPlane, padTopPlaneProxy_sub)
            nozzleOcc.CreateGeometryProxy(padTopPlaneProxy_sub, padTopPlaneProxy_main)
            cons.AddMateConstraint(targetXZp, padTopPlaneProxy_main, 0)

            Exit Sub

        End If

        '--------------------------------------------------
        ' CASE 2️⃣ ADNOC DIP PIPE (NO RF PAD)
        '--------------------------------------------------
        If remarks.Contains("DIP PIPE") AndAlso SelectedClient = "ADNOC" AndAlso
       flange1Occ IsNot Nothing Then

            Dim flangeEndPlane = flange1Occ.Definition.WorkPlanes.Item("Work Plane2")
            Dim flangeEndPlaneProxy_sub As Object
            Dim flangeEndPlaneProxy_main As Object

            flange1Occ.CreateGeometryProxy(flangeEndPlane, flangeEndPlaneProxy_sub)
            nozzleOcc.CreateGeometryProxy(flangeEndPlaneProxy_sub, flangeEndPlaneProxy_main)
            cons.AddFlushConstraint(targetXZp, flangeEndPlaneProxy_main, 0)

            Exit Sub

        End If

        '--------------------------------------------------
        ' CASE 3️⃣ STANDARD NOZZLE (NO RF PAD)
        '--------------------------------------------------
        If pipeOcc Is Nothing Then
            Throw New Exception("Pipe occurrence not found inside nozzle assembly.")
        End If

        Dim pipeEndPlane = pipeOcc.Definition.WorkPlanes.Item("End_Plane")
        Dim targetEndPlane = targetOcc.Definition.WorkPlanes.Item("End_Plane")

        Dim pipeEndPlaneProxy_sub As Object
        Dim pipeEndPlaneProxy_main As Object
        Dim targetEndPlaneProxy As Object

        pipeOcc.CreateGeometryProxy(pipeEndPlane, pipeEndPlaneProxy_sub)
        nozzleOcc.CreateGeometryProxy(pipeEndPlaneProxy_sub, pipeEndPlaneProxy_main)
        targetOcc.CreateGeometryProxy(targetEndPlane, targetEndPlaneProxy)
        cons.AddMateConstraint(targetEndPlaneProxy, pipeEndPlaneProxy_main, 0)

    End Sub


    Public Sub PlaceAndConstrainVortexBreakerPlates(invApp As Inventor.Application, nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, folderPath As String)

        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' FILE PATH SELECTION (CLIENT BASED)
        '==================================================
        Dim plate1Path As String = ""
        Dim plate2Path As String = ""
        Dim plate3Path As String = ""

        If SelectedClient = "ARAMCO" Then

            plate1Path = IO.Path.Combine(folderPath, "PT_NO_39_VORTEX_BREAKER_PLATE_1.ipt")
            plate2Path = IO.Path.Combine(folderPath, "PT_NO_40_VORTEX_BREAKER_PLATE_2.ipt")

        ElseIf SelectedClient = "ADNOC" Then

            plate1Path = IO.Path.Combine(folderPath, "Adnoc\69_VORTEX_BREAKER_PLATE_1.ipt")
            plate2Path = IO.Path.Combine(folderPath, "Adnoc\70_VORTEX_BREAKER_PLATE_2.ipt")
            plate3Path = IO.Path.Combine(folderPath, "Adnoc\68_VORTEX_BREAKER_PLATE_1.ipt")

        ElseIf SelectedClient = "QATAR" Then

            'If 

            plate1Path = IO.Path.Combine(folderPath, "Qatar\PT_NO_59_VORTEX_BREAKER.ipt")

        End If


        '==================================================
        ' PIPE PLANES
        '==================================================
        Dim pipeDef = pipeOcc.Definition
        Dim pipeXY As WorkPlane = pipeDef.WorkPlanes.Item("XY Plane")
        Dim pipeYZ As WorkPlane = pipeDef.WorkPlanes.Item("YZ Plane")
        Dim pipeEnd As WorkPlane = pipeDef.WorkPlanes.Item("End_Plane")
        Dim pipeXYp, pipeYZp, pipeEndp As Object

        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        pipeOcc.CreateGeometryProxy(pipeEnd, pipeEndp)

        '==================================================
        ' PLATE-1
        '==================================================
        Dim plate1Occ As ComponentOccurrence = Nothing

        If SelectedClient = "ARAMCO" Then

            If IO.File.Exists(plate1Path) Then

                plate1Occ = asmDef.Occurrences.Add(plate1Path, tg.CreateMatrix())
                plate1Occ.Name = "VORTEX_BREAKER_PLATE_1"
                Dim p1Def = plate1Occ.Definition

                Dim p1XY = p1Def.WorkPlanes.Item("XY Plane")
                Dim p1YZ = p1Def.WorkPlanes.Item("YZ Plane")
                Dim p1XZ = p1Def.WorkPlanes.Item("XZ Plane")

                Dim p1XYp, p1YZp, p1XZp As Object

                plate1Occ.CreateGeometryProxy(p1XY, p1XYp)
                plate1Occ.CreateGeometryProxy(p1YZ, p1YZp)
                plate1Occ.CreateGeometryProxy(p1XZ, p1XZp)

                cons.AddMateConstraint(pipeXYp, p1XYp, 0)
                cons.AddMateConstraint(pipeYZp, p1YZp, 0)
                cons.AddFlushConstraint(pipeEndp, p1XZp, 6)

            End If

        ElseIf SelectedClient = "ADNOC" Then

            If IO.File.Exists(plate1Path) Then

                plate1Occ = asmDef.Occurrences.Add(plate1Path, tg.CreateMatrix())
                plate1Occ.Name = "VORTEX_BREAKER_PLATE_1"
                Dim p1Def = plate1Occ.Definition

                Dim p1XY = p1Def.WorkPlanes.Item("XY Plane")
                Dim p1YZ = p1Def.WorkPlanes.Item("YZ Plane")
                Dim p1XZ = p1Def.WorkPlanes.Item("XZ Plane")

                Dim p1XYp, p1YZp, p1XZp As Object

