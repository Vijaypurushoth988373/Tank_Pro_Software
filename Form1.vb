        ' CLIENT-SPECIFIC COMPONENTS
        '------------------------------------------
        If SelectedClient = "ARAMCO" Then

            If curbPath <> "" AndAlso IO.File.Exists(curbPath) Then
                UpdateCurbAngleParameters(invApp, curbPath)
            End If

            If topCoverPath <> "" AndAlso IO.File.Exists(topCoverPath) Then
                UpdateTopPlateparameters(invApp, topCoverPath)
