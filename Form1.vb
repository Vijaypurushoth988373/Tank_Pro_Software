    '==================================================
    ' HELPER — UPDATE TABLE BY MATCHING COL 1 TEXT → SET COL 2
    '==================================================
    Private Sub UpdateTableByTitle(tables As Object, titleKeyword As String, data As Dictionary(Of String, String))
        Try
            Dim tbl As Object = Nothing

            For Each t As Object In tables
                Try
                    If InStr(UCase(t.Title), UCase(titleKeyword)) > 0 Then
                        tbl = t
                        Exit For
                    End If
                Catch
                End Try
            Next

            If tbl Is Nothing Then
                Debug.Print($"⚠ Table '{titleKeyword}' not found.")
                Exit Sub
            End If

            Dim rowCount As Integer = CInt(tbl.Rows.Count)
            Debug.Print($"✅ Found table '{titleKeyword}' with {rowCount} rows.")

            For r As Integer = 1 To rowCount
                Try
                    Dim rowObj As Object = tbl.Rows.Item(r)
                    Dim col1Text As String = ""

                    Try
                        '✅ Use .Value not .Text
                        col1Text = rowObj.Item(1).Value.ToString().Trim()
                    Catch
                        Continue For
                    End Try

                    If col1Text = "" Then Continue For

                    For Each kvp As KeyValuePair(Of String, String) In data
                        If InStr(UCase(col1Text), UCase(kvp.Key)) > 0 OrElse
                       InStr(UCase(kvp.Key), UCase(col1Text)) > 0 Then
                            Try
                                '✅ Use .Value not .Text
                                rowObj.Item(2).Value = kvp.Value
                                Debug.Print($"   ✅ '{col1Text}' → '{kvp.Value}'")
                            Catch ex As Exception
                                Debug.Print($"   ⚠ Cannot set '{col1Text}': {ex.Message}")
                            End Try
                            Exit For
                        End If
                    Next

                Catch
                    Continue For
                End Try
            Next

        Catch ex As Exception
            Debug.Print($"⚠ UpdateTableByTitle '{titleKeyword}' failed: {ex.Message}")
        End Try
    End Sub

    '==================================================
    ' HELPER — FIND TABLE BY TITLE KEYWORD
    '==================================================
    Private Function FindTable(tables As Object, titleKeyword As String) As Object
        Try
            For Each tbl As Object In tables
                Try
                    If InStr(UCase(tbl.Title), UCase(titleKeyword)) > 0 Then
                        Return tbl
                    End If
                Catch
                End Try
            Next
        Catch ex As Exception
            Debug.Print($"⚠ FindTable '{titleKeyword}' failed: {ex.Message}")
        End Try
        Return Nothing
    End Function

