    Private _updatingLLA As Boolean = False

    Private Sub txt_Shell_Inside_Dia_TextChanged(sender As Object, e As EventArgs) Handles txt_Shell_Inside_Dia.TextChanged

        ' Prevent re-entry when setting txt_LLA_NOL triggers this event again
        If _updatingLLA Then Exit Sub

        Dim Dia As Double
        If Not Double.TryParse(txt_Shell_Inside_Dia.Text, Dia) Then Exit Sub

        Dim nol As Integer = 0

        If Dia >= 300 AndAlso Dia <= 600 Then
            nol = 3
        ElseIf Dia >= 601 Then
            nol = 4
        End If

        If nol > 0 Then
            _updatingLLA = True
            Try
                txt_LLA_NOL.Text = nol.ToString()
                txt_LLA_Ang_bw.Text = (360 / nol).ToString()
            Finally
                _updatingLLA = False
            End Try
        End If

        UpdateBasePlateFromDiameter()
        UpdateReinforcementRingDimensions()

    End Sub

    Private Function UpdateBasePlateFromDiameter() As Double

        Dim dia As Double
        If Not Double.TryParse(txt_Shell_Inside_Dia.Text, dia) Then Return 0

        Dim bpLength As Double = 0
        Dim bpHeight As Double = 0
        Dim bpThk As Double = 0
        Dim bolt As String = ""
        Dim xVal As Double = 0

        Select Case dia

            Case 300 To 600
                bpLength = 154
                bpHeight = 154
                bpThk = 10
                bolt = "M20"
                xVal = 38

            Case 601 To 915
                bpLength = 154
                bpHeight = 154
                bpThk = 10
                bolt = "M20"
                xVal = 38

            Case 916 To 1199
                bpLength = 154
                bpHeight = 154
                bpThk = 10
                bolt = "M20"
                xVal = 38

            Case 1200 To 1675
                bpLength = 204
                bpHeight = 204
                bpThk = 10
                bolt = "M25"
                xVal = 50

            Case 1676 To 1830
                bpLength = 204
                bpHeight = 204
                bpThk = 13
                bolt = "M25"
                xVal = 50

            Case 1831 To 1980
                bpLength = 254
                bpHeight = 254
                bpThk = 10
                bolt = "M25"
                xVal = 50

            Case 1981 To 2150
                bpLength = 254
                bpHeight = 254
                bpThk = 10
                bolt = "M25"
                xVal = 45

            Case 2151 To 3000
                bpLength = 254
                bpHeight = 254
                bpThk = 10
                bolt = "M25"
                xVal = 69

        End Select

        '==============================
        ' SAVE TO MODULE
        '==============================
        BottomPlateData.BasePlate_LengthMm = bpLength
        BottomPlateData.BasePlate_HeightMm = bpHeight
        BottomPlateData.BasePlate_ThicknessMm = bpThk
        'BottomPlateData.BasePlate_DistanceMm = xVal

        '==============================
        ' BOLT HOLE DIA
        '==============================
        Select Case bolt
            Case "M20"
                BottomPlateData.BasePlate_HoleDiaMm = 22 + 6   '20 + clearance
            Case "M25"
                BottomPlateData.BasePlate_HoleDiaMm = 27 + 6   '25 + clearance
        End Select

        '==============================
        ' UPDATE FORM2 IF OPEN
        '==============================
        Dim frm As Form2 = System.Windows.Forms.Application.OpenForms.OfType(Of Form2)().FirstOrDefault()

        If frm IsNot Nothing Then

            frm.txt_BaseP_length.Text = bpLength.ToString()
            frm.txt_BaseP_height.Text = bpHeight.ToString()
            frm.txt_BaseP_thk.Text = bpThk.ToString()
            frm.txt_BaseP_hole_dia.Text = BottomPlateData.BasePlate_HoleDiaMm.ToString()
        End If

        '==============================
        ' RETURN X VALUE
        '==============================
        Return xVal

    End Function

