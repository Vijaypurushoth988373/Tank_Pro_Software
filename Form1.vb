    Private Function GetHeadNozzleRadius() As Double

        Dim radiusFound As Boolean = False
        Dim baseRadius As Double = 0

        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For
            If row.Cells("RADIUS_MM").Value Is Nothing Then Continue For

            Dim r As Double
            If Not Double.TryParse(row.Cells("RADIUS_MM").Value.ToString(), r) Then Continue For

            If Not radiusFound Then
                baseRadius = r
                radiusFound = True
            Else
                ' 🔴 Safety check
                If Math.Abs(baseRadius - r) > 0.01 Then
                    'MessageBox.Show("Mismatch in Top Head Nozzle Radius values." & vbCrLf & "Expected: " & baseRadius & " mm" & vbCrLf & "Found: " & r & " mm",
                    '"Radius Mismatch", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                End If
            End If

        Next

        Return baseRadius

    End Function

    Private Sub UpdateTopPlateparameters(invapp As Inventor.Application, topCoverPath As String)

        '==================================================
        ' Validate file path
        '==================================================
        If Not IO.File.Exists(topCoverPath) Then
            Throw New Exception("Top Cover Plate part not found: " & topCoverPath)
        End If

        '==================================================
        ' Open Top Cover Plate (editable)
        '==================================================
        Dim topCoverDoc As PartDocument = CType(invapp.Documents.Open(topCoverPath, False), PartDocument)
        Dim params As Parameters = topCoverDoc.ComponentDefinition.Parameters

        '==================================================
        ' ARAMCO PARAMETERS
        '==================================================
        If SelectedClient = "ARAMCO" Then

            params.Item("OD").Expression = txt_TP_OD.Text & " mm"
            params.Item("THK").Expression = txt_TP_THK.Text & " mm"
            params.Item("MATERIAL").Value = cmb_TP_Mat.Text

            '==================================================
            ' ADNOC PARAMETERS
            '==================================================
        ElseIf SelectedClient = "ADNOC" Then

            params.Item("OD").Expression = txt_RF_R_OD.Text & " mm"
            params.Item("THK").Expression = txt_RF_THK.Text & " mm"
            params.Item("BCD").Expression = txt_RF_BCD.Text & " mm"
            params.Item("HOLE_DIA").Expression = txt_RF_HOLE_DIA.Text & " mm"
            params.Item("NO_OF_HOLES").Expression = txt_RF_NO_OF_HOLES.Text
            params.Item("MATERIAL").Value = txt_TCP_MAT.Text

        ElseIf SelectedClient = "QATAR" Then

            params.Item("OD").Expression = txt_RF_R_OD.Text & " mm"
            params.Item("THK").Expression = txt_RF_THK.Text & " mm"
            params.Item("BCD").Expression = txt_RF_BCD.Text & " mm"
            params.Item("HOLE_DIA").Expression = txt_RF_HOLE_DIA.Text & " mm"
            params.Item("NO_OF_HOLES").Expression = txt_RF_NO_OF_HOLES.Text
            params.Item("MATERIAL").Value = txt_TCP_MAT.Text

        End If

        '==================================================
        ' 2️⃣ LOOP THROUGH HEAD NOZZLES
        '==================================================
        '==================================================
        ' LOOP THROUGH HEAD NOZZLES
        '==================================================
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For

            '----------------------------------------------
            ' Read Nozzle Mark
            '----------------------------------------------
            Dim nozzleVal = row.Cells("NOZZLE_MARK").Value
            If nozzleVal Is Nothing Then Continue For

            Dim nozzleMark As String =
        nozzleVal.ToString.Trim.ToUpper()


            '----------------------------------------------
            ' Detect Placement Type
            '----------------------------------------------
            Dim placementType As String =
        row.Cells("PLACEMENT_TYPE_1").Value?.
        ToString.Trim.ToUpper()


            '==================================================
            ' CASE 1️⃣ RADIAL PLACEMENT
            '==================================================
            If placementType = "RADIAL" Then

                Dim radVal = row.Cells("RADIUS_MM").Value
                Dim angVal = row.Cells("ANGLE_DEG").Value

                If radVal Is Nothing Or angVal Is Nothing Then Continue For

                If radVal.ToString = "-" Or angVal.ToString = "-" Then Continue For

                Dim radParam As String = nozzleMark & "_RAD"
                Dim angParam As String = nozzleMark & "_ANG"

                Try
                    params.Item(radParam).Expression =
                radVal & " mm"
                Catch
                End Try

                Try
                    params.Item(angParam).Expression =
                angVal & " deg"
                Catch
                End Try

            End If


            '==================================================
            ' CASE 2️⃣ XY DIRECTION PLACEMENT (ADNOC)
            '==================================================
            If placementType = "XY DIRECTION" Then

                Dim xVal = row.Cells("X_MM").Value
                Dim yVal = row.Cells("Y_MM").Value

                If xVal Is Nothing Or yVal Is Nothing Then Continue For

                If xVal.ToString = "-" Or yVal.ToString = "-" Then Continue For

                Dim xParam As String = nozzleMark & "_X_DIST"
                Dim yParam As String = nozzleMark & "_Y_DIST"

                Try
                    params.Item(xParam).Expression =
                xVal & " mm"
                Catch
                    Debug.Print("Missing parameter: " & xParam)
                End Try

                Try
                    params.Item(yParam).Expression =
                yVal & " mm"
                Catch
                    Debug.Print("Missing parameter: " & yParam)
                End Try

            End If

        Next

        '==================================================
        ' Update, Save, Close
        '==================================================
        topCoverDoc.Update()
        topCoverDoc.Save()
        topCoverDoc.Close(False)

    End Sub

