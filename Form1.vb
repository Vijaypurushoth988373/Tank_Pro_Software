    Public Sub UpdateImpulsePlatePadDistances(invApp As Inventor.Application, impulsePlatePath As String)

        '==================================================
        ' Validate file
        '==================================================
        If Not IO.File.Exists(impulsePlatePath) Then
            Throw New Exception("❌ Impulse Plate not found: " & impulsePlatePath)
        End If

        '==================================================
        ' Open document silently
        '==================================================
        Dim partDoc As PartDocument = CType(invApp.Documents.Open(impulsePlatePath, False), PartDocument)
        Dim params As Parameters = partDoc.ComponentDefinition.Parameters

        '==================================================
        ' Loop Head Nozzle Grid
        '==================================================
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For
            If row.Cells("Nozzle_Mark").Value Is Nothing Then Continue For
            Dim nozzleName As String = row.Cells("Nozzle_Mark").Value.ToString().Trim().ToUpper()

            '==================================================
            ' Only apply for impulse-plate nozzles
            '==================================================
            If nozzleName <> "N1" AndAlso nozzleName <> "N7" AndAlso nozzleName <> "N10" Then Continue For

            '==================================================
            ' Read XY values
            '==================================================
            Dim xVal As Double
            Dim yVal As Double

            If Not Double.TryParse(row.Cells("X_MM").Value?.ToString(), xVal) Then Continue For
            If Not Double.TryParse(row.Cells("Y_MM").Value?.ToString(), yVal) Then Continue For

            '==================================================
            ' Parameter names
            '==================================================
            Dim xParamName As String = nozzleName & "_PAD_DIST_X"
            Dim yParamName As String = nozzleName & "_PAD_DIST_Y"

            '==================================================
            ' Update parameters safely
            '==================================================
            Try
                params.Item(xParamName).Expression = xVal & " mm"
            Catch
                Debug.Print("Missing parameter: " & xParamName)
            End Try

            Try
                params.Item(yParamName).Expression = yVal & " mm"
            Catch
                Debug.Print("Missing parameter: " & yParamName)
            End Try

        Next

        '==================================================
        ' Update & Save
        '==================================================
        partDoc.Update()
        partDoc.Save()
        partDoc.Close(True)

    End Sub

