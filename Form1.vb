        Select Case nps.Trim()

            Case "1/2''" : OD = 21.3
            Case "3/4''" : OD = 26.7
            Case "1''" : OD = 33.4
            Case "1 1/4''" : OD = 42.2
            Case "1 1/2''" : OD = 48.3
