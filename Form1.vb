    Public Sub PlacePipeSupportsPerDipPipe(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String)

        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' SHELL PLANES
        '==================================================
        Dim shellDef As PartComponentDefinition = shellOcc.Definition

        Dim shellYZ As WorkPlane = shellDef.WorkPlanes.Item("YZ Plane")
        Dim shellXZ As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")
        Dim shellXY As WorkPlane = shellDef.WorkPlanes.Item("XY Plane")

        Dim shellYZp, shellXZp, shellXYp As Object

        shellOcc.CreateGeometryProxy(shellYZ, shellYZp)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZp)
        shellOcc.CreateGeometryProxy(shellXY, shellXYp)

        '==================================================
        ' DIP PIPE COUNTER
        '==================================================
        Dim dipPipeIndex As Integer = 0

        '==================================================
        ' LOOP THROUGH GRID
        '==================================================
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For
            Dim remarks As String = If(row.Cells("REMARKS").Value, "").ToString().Trim().ToUpper()
            If Not remarks.Contains("DIP PIPE") Then Continue For
            dipPipeIndex += 1

            '==================================================
            ' GET NOZZLE NAME
            '==================================================
            Dim nozzleName As String = row.Cells("Nozzle_Mark").Value.ToString().Trim()

            '==================================================
            ' LOAD SUPPORT FROM INDEXED FOLDER
            '==================================================
            Dim supportPath As String = GetPipeSupportAssemblyPath(folderPath, dipPipeIndex)

            '==================================================
            ' PLACE SUPPORT
            '==================================================
            Dim psOcc As ComponentOccurrence = asmDef.Occurrences.Add(supportPath, tg.CreateMatrix())
            psOcc.Name = $"PIPE_SUPPORT_{nozzleName}"

            '==================================================
            ' SUPPORT PLANES
            '==================================================
            Dim psDef As AssemblyComponentDefinition = psOcc.Definition
            Dim psYZ As WorkPlane = psDef.WorkPlanes.Item("YZ Plane")
            Dim psXZ As WorkPlane = psDef.WorkPlanes.Item("XZ Plane")
            Dim psXY As WorkPlane = psDef.WorkPlanes.Item("XY Plane")
            Dim psYZp, psXZp, psXYp As Object

            psOcc.CreateGeometryProxy(psYZ, psYZp)
            psOcc.CreateGeometryProxy(psXZ, psXZp)
            psOcc.CreateGeometryProxy(psXY, psXYp)

            '==================================================
            ' APPLY CONSTRAINTS
            '==================================================
            cons.AddFlushConstraint(shellYZp, psYZp, 0)
            cons.AddFlushConstraint(shellXZp, psXYp, 0)
            cons.AddMateConstraint(shellXYp, psXZp, 0)

        Next

        asmDoc.Update()

    End Sub

    Public Sub ReplacePSAngleOccurrence(supportOcc As ComponentOccurrence, newAnglePath As String)

        Dim supportAsmDoc As AssemblyDocument = CType(supportOcc.Definition.Document, AssemblyDocument)
        Dim supportDef = supportAsmDoc.ComponentDefinition

        For Each occ As ComponentOccurrence In supportDef.Occurrences
            If occ.Name.ToUpper().Contains("PS_ANGLE") Then
                occ.Replace(newAnglePath, True)
                Exit For
            End If
        Next

        supportAsmDoc.Update()

    End Sub

    Public Sub CreateRectangularPattern_PipeSupport(invApp As Inventor.Application, asmDoc As AssemblyDocument, pipeSupportOcc As ComponentOccurrence)

        '==================================================
        ' Safety checks
        '==================================================
        If asmDoc Is Nothing Then
            Throw New Exception("❌ AssemblyDocument is Nothing")
        End If

        If pipeSupportOcc Is Nothing Then
            Throw New Exception("❌ Pipe Support occurrence is Nothing")
        End If

        '==================================================
        ' Assembly definition
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition

        '==================================================
        ' Seed occurrence collection
        '==================================================
        Dim seedOccs As ObjectCollection = invApp.TransientObjects.CreateObjectCollection()
        seedOccs.Add(pipeSupportOcc)

        '==================================================
        ' Pattern direction → GLOBAL Y AXIS
        '==================================================
        Dim yAxis As WorkAxis = asmDef.WorkAxes.Item("Y Axis")

        '==================================================
        ' Pattern parameters
        '==================================================
        Dim occurrenceCount As Integer = 2
        Dim spacingCm As Double = 1200.0 / 10.0   '  (mm → cm)

        '==================================================
        ' Create rectangular occurrence pattern
        '==================================================
        Dim patt As RectangularOccurrencePattern = asmDef.OccurrencePatterns.AddRectangularPattern(seedOccs, yAxis, False, spacingCm, occurrenceCount, Nothing, False, 0, 1)
        patt.Name = "PIPE_SUPPORT_RECT_PATTERN"

        '==================================================
        ' Final update
        '==================================================
        asmDoc.Update()

    End Sub

    Private Function ResolveBottomHeadRFPadMaster(projectFolder As String, xMm As Double, yMm As Double) As String
        '==================================================
        ' CENTER CASE
        '==================================================
        If xMm = 0 AndAlso yMm = 0 Then
            Return IO.Path.Combine(projectFolder, "RF_PAD_BH_2ND_QUADRANT.ipt")
        End If

        '==================================================
        ' AXES-INCLUSIVE QUADRANT LOGIC
        '==================================================

        ' 1st Quadrant (X >= 0, Y >= 0)
        If xMm >= 0 AndAlso yMm >= 0 Then
            Return IO.Path.Combine(projectFolder, "RF_PAD_BH_1ST_QUADRANT.ipt")

            ' 2nd Quadrant (X <= 0, Y > 0)
        ElseIf xMm <= 0 AndAlso yMm > 0 Then
            Return IO.Path.Combine(projectFolder, "RF_PAD_BH_2ND_QUADRANT.ipt")

            ' 3rd Quadrant (X < 0, Y <= 0)
        ElseIf xMm < 0 AndAlso yMm <= 0 Then
            Return IO.Path.Combine(projectFolder, "RF_PAD_BH_3RD_QUADRANT.ipt")

            ' 4th Quadrant (X > 0, Y < 0)
        Else
            Return IO.Path.Combine(projectFolder, "RF_PAD_BH_4TH_QUADRANT.ipt")
        End If

    End Function

    Private Sub TabControl1_SelectedIndexChanged(sender As Object, e As EventArgs) Handles TabControl1.SelectedIndexChanged

        '==================================================
        ' 1️⃣ Decide which diameter textbox to use
        '==================================================
        Dim insideDia As Double

        If RB_LB_EH.Checked Then
            If Not Double.TryParse(txt_EH_Inside_Dia.Text.Trim(), insideDia) Then Exit Sub

        ElseIf RB_LB_TH.Checked Then
            If Not Double.TryParse(txt_EH_Inside_Dia.Text.Trim(), insideDia) Then Exit Sub
        Else
            Exit Sub
        End If

        '==================================================
        ' 2️⃣ Update only Diameter fields across tabs
        '==================================================
        txt_Shell_Inside_Dia.Text = insideDia.ToString("0")
        txt_EH_1_Inside_Dia.Text = insideDia.ToString("0")
        'txt_TH_1_Inside_Dia.Text = insideDia.ToString("0")
        txt_CA_ID.Text = insideDia.ToString("0")

        '==================================================
        ' 3️⃣ Validate Curb Angle Size
        '==================================================
        Dim caSize As String = cmb_CA_Size.Text.Trim()
        If caSize = "" Then Exit Sub

        Dim parts() As String = caSize.Split("x"c)
        If parts.Length <> 2 Then
            MessageBox.Show("❌ Invalid Curb Angle format. Use: 60 x 60")
            Exit Sub
        End If

        '===================================================
        ' 4️⃣ Extract Values
        '===================================================
        Dim legLength As Double
        If Not Double.TryParse(parts(0).Trim(), legLength) Then Exit Sub

        '===================================================
        ' 5️⃣ Calculate OD
        '===================================================
        Dim odValue As Double = insideDia + (2 * legLength)
        Dim topCoverOD As Double = insideDia + legLength

        '===================================================
        ' 6️⃣ Assign to TextBoxes
        '===================================================
        txt_CA_OD.Text = odValue.ToString("0")
        txt_CA_Length.Text = legLength.ToString("0")
        txt_TP_OD.Text = topCoverOD.ToString("0")

        txt_LL_ID.Text = txt_EH_Inside_Dia.Text
        txt_LL_ST.Text = txt_EH_Nom_Thk.Text

        txt_PS_ad_Dia1.Text = txt_EH_Inside_Dia.Text
        txt_PS_ad_Thk1.Text = txt_EH_Nom_Thk.Text

        txt_PS_ad_Dia2.Text = txt_EH_Inside_Dia.Text
        txt_PS_ad_Thk2.Text = txt_EH_Nom_Thk.Text

        txt_PS_ad_Dia3.Text = txt_EH_Inside_Dia.Text
        txt_PS_ad_Thk3.Text = txt_EH_Nom_Thk.Text

    End Sub

