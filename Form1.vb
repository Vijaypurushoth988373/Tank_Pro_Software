            End If
        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try


        '==================================================
        ' RF PAD / BASE PLATE / LEG SUPPORT (SAFE)
        '==================================================
        Dim shellID As Double = 0.0

        '------------------------------------------
        ' Read Shell Inside Dia safely
        '------------------------------------------
        Try
            Double.TryParse(txt_Shell_Inside_Dia.Text, shellID)
