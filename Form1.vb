    '==================================================
    ' HELPER — UPDATE NOTES (SINGLE TEXT BLOCK)
    '==================================================
    Private Sub UpdateNotesTable(sheet As Object)
        Try
            Dim notes As Object = sheet.DrawingNotes

            '==================================================
            ' BUILD SINGLE COMBINED TEXT FROM ALL DGV ROWS
            '==================================================
            Dim combinedText As String = ""

            For Each row As DataGridViewRow In DGV_Notes.Rows
                If row.IsNewRow Then Continue For
                Dim seq As String = SafeStr(row.Cells(0).Value)
                Dim noteText As String = SafeStr(row.Cells(1).Value)
                If noteText = "" Then Continue For

                If combinedText <> "" Then combinedText &= vbCrLf
                If seq <> "" Then
                    combinedText &= seq & ". " & noteText
                Else
                    combinedText &= noteText
                End If
            Next

            '==================================================
            ' SET ALL TEXT INTO NOTE #1 (SINGLE BLOCK)
            '==================================================
            Try
                Dim note As Object = notes.Item(1)
                note.Text = combinedText
                Debug.Print($"✅ Notes updated as single block ({DGV_Notes.Rows.Count - 1} rows combined).")
            Catch ex As Exception
                Debug.Print($"⚠ Could not update note: {ex.Message}")
            End Try

        Catch ex As Exception
            Debug.Print($"⚠ UpdateNotesTable failed: {ex.Message}")
        End Try
    End Sub

