    Public Function PlaceAndConstrainSkirtSupportAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, projectFolder As String) As ComponentOccurrence

        '==================================================
        ' 1 Decide Skirt Type
        '==================================================
        Dim skirtType As Integer
        Dim skirtAsmPath As String
        Dim skirtPartName As String

        If Rbn_SS_Type_1.Checked Then
            skirtType = 1
        ElseIf Rbn_SS_Type_2.Checked Then
            skirtType = 2
        ElseIf Rbn_SS_Type_3.Checked Then
            skirtType = 3
        ElseIf Rbn_SS_Type_4.Checked Then
            skirtType = 4
        Else
            Throw New Exception("Please select Skirt Support Type")
        End If

        skirtAsmPath = IO.Path.Combine(projectFolder, "Skirt - " & skirtType, "Skirt_Assembly_Type_" & skirtType & ".iam")
        skirtPartName = "SKIRT_TYPE_" & skirtType

        '==================================================
        ' 2 Validate Assembly
        '==================================================
        If Not IO.File.Exists(skirtAsmPath) Then
            Throw New Exception("Skirt Assembly not found : " & skirtAsmPath)
        End If

        '==================================================
        ' 3 Place Assembly
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim matrix As Inventor.Matrix = tg.CreateMatrix()
        Dim skirtOcc As ComponentOccurrence = asmDef.Occurrences.Add(skirtAsmPath, matrix)
        skirtOcc.Grounded = False

        '==================================================
        ' 4 Shell WorkPlanes
        '==================================================
        Dim shellDef = shellOcc.Definition
        Dim shellYZ As WorkPlane = shellDef.WorkPlanes.Item("YZ Plane")
        Dim shellXY As WorkPlane = shellDef.WorkPlanes.Item("XY Plane")
        Dim shellXZ As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' 5 Skirt Assembly WorkPlanes
        '==================================================
        Dim skirtDef = skirtOcc.Definition
        Dim skirtYZ As WorkPlane = skirtDef.WorkPlanes.Item("YZ Plane")
        Dim skirtXY As WorkPlane = skirtDef.WorkPlanes.Item("XY Plane")

        '==================================================
        ' 6 Find Skirt Part inside Assembly
        '==================================================
        Dim skirtPartOcc As ComponentOccurrence = Nothing

        For Each occ As ComponentOccurrence In skirtOcc.SubOccurrences

            Dim nameUpper As String = occ.Definition.Document.DisplayName.ToUpper()
            If nameUpper.Contains(skirtPartName) Then
                skirtPartOcc = occ
                Exit For
            End If

        Next

        If skirtPartOcc Is Nothing Then
            Throw New Exception("Skirt Part not found in assembly")
        End If

        '==================================================
        ' 7 Top Plane of Skirt Part
        '==================================================
        Dim skirtTopPlane As WorkPlane = skirtPartOcc.Definition.WorkPlanes.Item("Top_Plane")

        '==================================================
        ' 8 Geometry Proxies
        '==================================================
        Dim shellYZp, shellXYp, shellXZp As Object
        Dim skirtYZp, skirtXYp As Object
        Dim skirtTopP, skirtTopMainP As Object

        shellOcc.CreateGeometryProxy(shellYZ, shellYZp)
        shellOcc.CreateGeometryProxy(shellXY, shellXYp)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZp)

        skirtOcc.CreateGeometryProxy(skirtYZ, skirtYZp)
        skirtOcc.CreateGeometryProxy(skirtXY, skirtXYp)

        skirtPartOcc.CreateGeometryProxy(skirtTopPlane, skirtTopP)
        skirtOcc.CreateGeometryProxy(skirtTopP, skirtTopMainP)

        Dim offset As Double = 0

        If RB_LB_TH.Checked Then
            offset = -25 / 10
        Else
            offset = 0
        End If

        '==================================================
        ' 9 Apply Constraints
        '==================================================
        cons.AddFlushConstraint(shellYZp, skirtYZp, 0)
        cons.AddFlushConstraint(shellXYp, skirtXYp, 0)
        cons.AddFlushConstraint(shellXZp, skirtTopMainP, offset)

        '==================================================
        ' 10 Update
        '==================================================
        asmDoc.Update()
        Return skirtOcc

    End Function

    Public Function PlaceAndConstrainTopCoverStiffener(invApp As Inventor.Application, asmDoc As AssemblyDocument, topCoverOcc As ComponentOccurrence, folderPath As String) As ComponentOccurrence

        '==================================================
        ' STIFFENER FILE PATH (DYNAMIC)
        '==================================================
        Dim stiffenerPath As String = IO.Path.Combine(folderPath, "TANK_SHELL_PLATE_BASE_TEST.ipt")

        If Not IO.File.Exists(stiffenerPath) Then
            Throw New Exception("❌ Top Cover Stiffener file not found: " & stiffenerPath)
        End If

        '==================================================
        ' PLACE STIFFENER
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim stiffenerOcc As ComponentOccurrence = asmDef.Occurrences.Add(stiffenerPath, tg.CreateMatrix())
        stiffenerOcc.Grounded = False

        '==================================================
        ' TOP COVER PLATE PLANES
        '==================================================
        Dim topDef = topCoverOcc.Definition

        Dim topYZ As WorkPlane = topDef.WorkPlanes.Item("YZ Plane")
        Dim topXY As WorkPlane = topDef.WorkPlanes.Item("XY Plane")
        Dim topXZ As WorkPlane = topDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' STIFFENER PLANES
        '==================================================
        Dim stiffDef = stiffenerOcc.Definition

        Dim stiffYZ As WorkPlane = stiffDef.WorkPlanes.Item("YZ Plane")
        Dim stiffXY As WorkPlane = stiffDef.WorkPlanes.Item("XY Plane")
        Dim stiffXZ As WorkPlane = stiffDef.WorkPlanes.Item("Top_Plane")

        '==================================================
        ' CREATE GEOMETRY PROXIES – TOP COVER
        '==================================================
        Dim topYZp, topXYp, topXZp As Object
        topCoverOcc.CreateGeometryProxy(topYZ, topYZp)
        topCoverOcc.CreateGeometryProxy(topXY, topXYp)
        topCoverOcc.CreateGeometryProxy(topXZ, topXZp)

        '==================================================
        ' CREATE GEOMETRY PROXIES – STIFFENER
        '==================================================
        Dim stiffYZp, stiffXYp, stiffXZp As Object
        stiffenerOcc.CreateGeometryProxy(stiffYZ, stiffYZp)
        stiffenerOcc.CreateGeometryProxy(stiffXY, stiffXYp)
        stiffenerOcc.CreateGeometryProxy(stiffXZ, stiffXZp)

        '==================================================
        ' APPLY CONSTRAINTS (EXACT ORDER)
        '==================================================

        ' 1️⃣ YZ ↔ YZ  (FLUSH)
        cons.AddMateConstraint(topYZp, stiffYZp, 0)

        ' 2️⃣ XY ↔ XY  (FLUSH)
        cons.AddMateConstraint(topXYp, stiffXYp, 0)

        ' 3️⃣ XZ ↔ XZ  (FLUSH)
        cons.AddFlushConstraint(topXZp, stiffXZp, 0)

        '==================================================
        ' FINAL UPDATE
        '==================================================
        asmDoc.Update()

        Return stiffenerOcc

    End Function

    Public Sub CreateManwayCoverPlate_AnglePlane_6Deg(invApp As Inventor.Application, coverOcc As ComponentOccurrence)

        '==================================================
        ' Get PART document & definition
        '==================================================
        Dim coverDoc As PartDocument = CType(coverOcc.Definition.Document, PartDocument)
        Dim compDef As PartComponentDefinition = coverDoc.ComponentDefinition

        '==================================================
        ' Plane name
        '==================================================
        Dim planeName As String = "MW_Cover_Angle_6Deg"

        '==================================================
        ' Avoid duplicate creation (REBUILD SAFE)
        '==================================================
        For Each wp As WorkPlane In compDef.WorkPlanes
            If wp.Name = planeName Then
                wp.Visible = False
                Exit Sub
            End If
        Next

        '==================================================
        ' Convert angle to radians
        '==================================================
        Dim angleDeg As Double = 6.0
        Dim angleRad As Double = angleDeg * Math.PI / 180.0

        '==================================================
        ' Reference axis & base plane
        '==================================================
        ' Rotate about Y Axis
        Dim rotAxis As WorkAxis = compDef.WorkAxes.Item("X Axis")

        ' Base reference plane (standard for rotation)
        Dim basePlane As WorkPlane = compDef.WorkPlanes.Item("XY Plane")

        '==================================================
        ' Create angled work plane
        '==================================================
        Dim angledPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(rotAxis, basePlane, angleRad)
        angledPlane.Name = planeName
        angledPlane.Visible = False

        '==================================================
        ' Final update
        '==================================================
        coverDoc.Update()

    End Sub

    Public Function PlaceAndConstrainManwayBoltAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, gasketOcc As ComponentOccurrence, coverOcc As ComponentOccurrence, folderPath As String) As ComponentOccurrence

        '==================================================
        ' ✅ SAFETY CHECK – MANWAY PRESENT OR NOT
        '==================================================
        If gasketOcc Is Nothing OrElse coverOcc Is Nothing Then
            Debug.Print("⚠ Manway gasket or cover not present → Skipping Bolt Assembly")
            Return Nothing
        End If

        '==================================================
        ' 1️⃣ BOLT ASSEMBLY PATH
        '==================================================
        Dim boltAsmPath As String = IO.Path.Combine(folderPath, "PT_NO_13_HEX_BOLT_2_NUTS_WITH_2_WASHER.iam")

        If Not IO.File.Exists(boltAsmPath) Then
            Debug.Print("⚠ Bolt assembly file not found → Skipping: " & boltAsmPath)
            Return Nothing
        End If

        '==================================================
        ' 2️⃣ PLACE BOLT ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim boltOcc As ComponentOccurrence = asmDef.Occurrences.Add(boltAsmPath, tg.CreateMatrix())
        boltOcc.Grounded = False
        boltOcc.Name = "MANWAY_BOLT_ASSEMBLY"

        '==================================================
        ' 3️⃣ GASKET REFERENCES (Mid_Face)
        '==================================================
        Dim gasketDef = gasketOcc.Definition
        Dim gasketMidFace As WorkPlane = Nothing

        Try
            gasketMidFace = gasketDef.WorkPlanes.Item("Mid_Face")
        Catch
            Debug.Print("⚠ Mid_Face plane not found in gasket → Skipping Bolt Assembly")
            boltOcc.Delete()
            Return Nothing
        End Try

        '==================================================
        ' 4️⃣ COVER REFERENCES
        '==================================================
        Dim coverDef = coverOcc.Definition

        Dim coverAxis2 As WorkAxis = Nothing
        Dim coverAnglePlane As WorkPlane = Nothing

        Try
            coverAxis2 = coverDef.WorkAxes.Item("Work Axis2")
            coverAnglePlane = coverDef.WorkPlanes.Item("MW_Cover_Angle_6Deg")
        Catch
            Debug.Print("⚠ Cover reference planes missing → Skipping Bolt Assembly")
            boltOcc.Delete()
            Return Nothing
        End Try

        '==================================================
        ' 5️⃣ BOLT REFERENCES
        '==================================================
        Dim boltDef = boltOcc.Definition

        Dim boltWP1 As WorkPlane = boltDef.WorkPlanes.Item("XZ Plane")
        Dim boltYAxis As WorkAxis = boltDef.WorkAxes.Item("Y Axis")
        Dim boltXY As WorkPlane = boltDef.WorkPlanes.Item("XY Plane")

        '==================================================
        ' 6️⃣ CREATE GEOMETRY PROXIES
        '==================================================
        Dim gasketMidFaceP As Object
        gasketOcc.CreateGeometryProxy(gasketMidFace, gasketMidFaceP)

        Dim coverAxis2p, coverAngleP As Object
        coverOcc.CreateGeometryProxy(coverAxis2, coverAxis2p)
        coverOcc.CreateGeometryProxy(coverAnglePlane, coverAngleP)

        Dim boltWP1p, boltYAxisP, boltXYp As Object
        boltOcc.CreateGeometryProxy(boltWP1, boltWP1p)
        boltOcc.CreateGeometryProxy(boltYAxis, boltYAxisP)
        boltOcc.CreateGeometryProxy(boltXY, boltXYp)

        '==================================================
        ' 7️⃣ APPLY CONSTRAINTS
        '==================================================

        '--------------------------------------------------
        ' ✅ 1️⃣ Mate – Gasket Mid_Face → Bolt Work Plane1
        '--------------------------------------------------
        cons.AddMateConstraint(gasketMidFaceP, boltWP1p, 0)

        '--------------------------------------------------
        ' 2️⃣ Mate – Cover Work Axis2 → Bolt Y Axis
        '--------------------------------------------------
        cons.AddMateConstraint(coverAxis2p, boltYAxisP, 0)

        '--------------------------------------------------
        ' 3️⃣ Angle – Cover 6° Plane → Bolt XY Plane
        '--------------------------------------------------
        Dim angleRad As Double = -6.0 * Math.PI / 180.0
        cons.AddAngleConstraint(coverAngleP, boltXYp, angleRad)

        '==================================================
        ' 8️⃣ FINAL UPDATE
        '==================================================
        asmDoc.Update()

        Return boltOcc

    End Function

    Public Sub CreateCircularPattern_PT_NO_13_Bolts(asmDoc As AssemblyDocument, seedBoltOcc As ComponentOccurrence, coverOcc As ComponentOccurrence)

        '==================================================
