    Public Function PlaceAndConstrainTankLegSupportAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String, legType As String) As ComponentOccurrence

        '==================================================
        ' VALIDATION
        '==================================================
        If invApp Is Nothing OrElse asmDoc Is Nothing OrElse shellOcc Is Nothing Then
            Throw New Exception("❌ Invalid Inventor references.")
        End If

        '==================================================
        ' USER INPUT
        '==================================================
        Dim angle1Deg As Double = CDbl(txt_LSA_Angle.Text)
        Dim angle2Deg As Double = (angle1Deg + 90.0) Mod 360.0
        Dim verticalOffsetCm As Double = CDbl(txt_LLA_Base_To_W_L.Text) / 10.0

        '==================================================
        ' SELECT LEG SUPPORT ASSEMBLY
        '==================================================
        Dim legAsmPath As String

        Select Case legType.ToUpper()
            Case "ANGLE"
                legAsmPath = IO.Path.Combine(folderPath, "Angle_Leg_Assembly.iam")
            Case "BEAM"
                legAsmPath = IO.Path.Combine(folderPath, "DRUM_BEAM_LEG_SUPPORT_ASSEMBLY.iam")
            Case Else
                Throw New Exception("❌ Invalid Leg Support Type: " & legType)
        End Select

        If Not IO.File.Exists(legAsmPath) Then
            Throw New Exception("❌ Leg Support Assembly not found: " & legAsmPath)
        End If

        '==================================================
        ' PLACE ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim legAsmOcc As ComponentOccurrence = asmDef.Occurrences.Add(legAsmPath, tg.CreateMatrix())
        legAsmOcc.Grounded = False

        '==================================================
        ' SHELL PLANES
        '==================================================
        Dim shellDef = shellOcc.Definition
        Dim shellPlane1 As WorkPlane = shellDef.WorkPlanes.Item($"LEG_Plane_{angle1Deg}")
        Dim shellPlane2 As WorkPlane = shellDef.WorkPlanes.Item($"LEG_Plane_{angle2Deg}")
        Dim shellXZ As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' BEAM SUB COMPONENT SEARCH ONLY
        '==================================================
        Dim legOcc As ComponentOccurrence = Nothing
        Dim padOcc As ComponentOccurrence = Nothing

        If legType.ToUpper() = "BEAM" Then

            Dim legKey As String = "BEAM_LEG_PLATE_1"
            Dim padKey As String = "PAD_PLATE_FOR_TANK_SUPPORT_DRUM"

            For Each occ As ComponentOccurrence In legAsmOcc.SubOccurrences

                Dim nameU As String = occ.Definition.Document.DisplayName.ToUpper()

                If legOcc Is Nothing AndAlso nameU.Contains(legKey) Then
                    legOcc = occ
                ElseIf padOcc Is Nothing AndAlso nameU.Contains(padKey) Then
                    padOcc = occ
                End If

                If legOcc IsNot Nothing AndAlso padOcc IsNot Nothing Then Exit For
            Next

            If legOcc Is Nothing OrElse padOcc Is Nothing Then
                Throw New Exception("❌ Required sub-components not found in leg assembly.")
            End If

        End If

        '==================================================
        ' GEOMETRY PROXIES
        '==================================================
        Dim shellPlane1P, shellPlane2P, shellXZp As Object
        shellOcc.CreateGeometryProxy(shellPlane1, shellPlane1P)
        shellOcc.CreateGeometryProxy(shellPlane2, shellPlane2P)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZp)

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================
        If legType.ToUpper() = "ANGLE" Then

            Dim shellYAxis As WorkAxis = shellDef.WorkAxes.Item("Y Axis")
            Dim legYAxis As WorkAxis = legAsmOcc.Definition.WorkAxes.Item("Y Axis")

            Dim shellYAxisP, legYAxisP As Object
            shellOcc.CreateGeometryProxy(shellYAxis, shellYAxisP)
            legAsmOcc.CreateGeometryProxy(legYAxis, legYAxisP)

            cons.AddMateConstraint(shellYAxisP, legYAxisP, 0)

            Dim shellYZ As WorkPlane = shellDef.WorkPlanes.Item("YZ Plane")
            Dim legYZ As WorkPlane = legAsmOcc.Definition.WorkPlanes.Item("YZ Plane")

            Dim shellYZP, legYZP As Object
            shellOcc.CreateGeometryProxy(shellYZ, shellYZP)
            legAsmOcc.CreateGeometryProxy(legYZ, legYZP)

            cons.AddFlushConstraint(shellYZP, legYZP, 0)

            Dim legXZ As WorkPlane = legAsmOcc.Definition.WorkPlanes.Item("XZ Plane")
            Dim legXZP As Object
            legAsmOcc.CreateGeometryProxy(legXZ, legXZP)

            cons.AddFlushConstraint(shellXZp, legXZP, 0)

        Else ' BEAM

            Dim legMid As WorkPlane = legOcc.Definition.WorkPlanes.Item("Mid Plane")
            Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")
            Dim padTop As WorkPlane = padOcc.Definition.WorkPlanes.Item("Top_Plane")

            Dim legMid_legP, legMid_mainP As Object
            legOcc.CreateGeometryProxy(legMid, legMid_legP)
            legAsmOcc.CreateGeometryProxy(legMid_legP, legMid_mainP)

            Dim padXZ_padP, padXZ_mainP As Object
            Dim padTop_padP, padTop_mainP As Object

            padOcc.CreateGeometryProxy(padXZ, padXZ_padP)
            legAsmOcc.CreateGeometryProxy(padXZ_padP, padXZ_mainP)

            padOcc.CreateGeometryProxy(padTop, padTop_padP)
            legAsmOcc.CreateGeometryProxy(padTop_padP, padTop_mainP)

            cons.AddFlushConstraint(shellPlane1P, legMid_mainP, 0)
            cons.AddMateConstraint(shellPlane2P, padXZ_mainP, 0)
            cons.AddMateConstraint(shellXZp, padTop_mainP, 0)

        End If

        '==================================================
        ' FINAL UPDATE
        '==================================================
        asmDoc.Update()

        Return legAsmOcc

    End Function

