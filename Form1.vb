    Private Function CalculatePipeLength_Head(currentRow As DataGridViewRow, nps As String, outsideProjMm As Double, flangeClass As String, remarks As String,
    Optional invApp As Inventor.Application = Nothing, Optional blindFlangeOcc As ComponentOccurrence = Nothing) As Double

        Dim pipeLengthMm As Double = 0
        remarks = remarks.Trim().ToUpper()

        '==================================================
        ' ✅ SPECIAL CASES (NO POPUP)
        '==================================================
        If remarks.Contains("DIP PIPE") Then

            If txt_DP_Length1.Text.Trim() <> "" Then
                Return CDbl(txt_DP_Length1.Text)
            Else
                Throw New Exception("Dip Pipe length is not specified.")
            End If

        End If

        If remarks.Contains("VORTEX BREAKER") Then

            Dim vbIndex As Integer = GetVortexBreakerIndex(currentRow)

            Select Case vbIndex

                Case 1
                    If Not Double.TryParse(txt_VB_Pipe_Length_1.Text, pipeLengthMm) Then
                        Throw New Exception("Invalid VB1 Pipe length")
                    End If

                Case 2
                    If Not Double.TryParse(txt_VB_Pipe_Length_2.Text, pipeLengthMm) Then
                        Throw New Exception("Invalid VB2 Pipe length")
                    End If

                Case 3
                    If Not Double.TryParse(txt_VB_Pipe_Length_3.Text, pipeLengthMm) Then
                        Throw New Exception("Invalid VB3 Pipe length")
                    End If

                Case Else
                    Throw New Exception("Unsupported Vortex Breaker index")

            End Select

            Return pipeLengthMm

        End If

        '==================================================
        ' ✅ NORMAL NOZZLES → AUTO CALCULATION
        '==================================================

        ' Get flange height from table
        Dim flangeHeightMm As Double = GetFlangeHeightMm(nps, flangeClass)

        If flangeHeightMm = 0 Then Return 0

        Dim topCoverThkMm As String
        '' Top cover thickness
        If SelectedClient = "ARAMCO" Then
            topCoverThkMm = txt_TP_THK.Text
        ElseIf SelectedClient = "ADNOC" Then
            topCoverThkMm = txt_RF_THK.Text
        ElseIf SelectedClient = "QATAR" Then
            topCoverThkMm = txt_RF_THK.Text
        End If

        ' Pipe Length formula — with a Blind Flange (RB_RT_BF), sum the
        ' Blind Flange height instead of the top cover thickness
        If RB_RT_BF.Checked AndAlso invApp IsNot Nothing AndAlso blindFlangeOcc IsNot Nothing Then
            Dim blindFlangeHeightMm As Double = MeasureBlindFlangeHeight(invApp, blindFlangeOcc)
            pipeLengthMm = outsideProjMm - flangeHeightMm + blindFlangeHeightMm
        Else
            pipeLengthMm = outsideProjMm - flangeHeightMm + CDbl(topCoverThkMm)
        End If

        pipeLengthMm = Math.Round(pipeLengthMm, 2)

        If pipeLengthMm < 0 Then pipeLengthMm = 0

        Return pipeLengthMm

    End Function

    Private Function GetVortexBreakerIndex(currentRow As DataGridViewRow) As Integer

        Dim vbIndex As Integer = 0

        For Each r As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If r.IsNewRow Then Continue For

            Dim remarks As String = If(r.Cells("REMARKS").Value, "").ToString().Trim().ToUpper()

            If remarks.Contains("VORTEX BREAKER") Then
                vbIndex += 1
            End If

            ' Stop when current row reached
            If r.Index = currentRow.Index Then Exit For

        Next

        Return vbIndex

    End Function

    Public Function CalculatePipeLength_Shell(nps As String, outsideProjMm As Double, flangeClass As String, isManway As Boolean, includeElbow As Boolean) As Double

        Dim pipeLengthMm As Double = outsideProjMm

        '==================================================
        ' MANWAY → DIRECT LENGTH
        '==================================================
        If isManway Then
            Return Math.Round(pipeLengthMm, 1)
        End If

        Dim flangeHeightMm As Double

        '==================================================
        ' ARAMCO LOGIC
        '==================================================
        If SelectedClient.ToUpper() = "ARAMCO" Then

            flangeHeightMm = GetFlangeHeightMm(nps, flangeClass)
            Dim shellID As Double = CDbl(txt_Shell_Inside_Dia.Text)
            pipeLengthMm -= flangeHeightMm
            pipeLengthMm -= (shellID / 2)

            '==================================================
            ' ADNOC LOGIC
            '==================================================
        ElseIf SelectedClient.ToUpper() = "ADNOC" Then

            If includeElbow Then
                pipeLengthMm -= GetElbowAmm(nps)
            End If

        ElseIf SelectedClient.ToUpper() = "QATAR" Then

            If includeElbow Then
                pipeLengthMm -= GetElbowAmm(nps)
            Else
                flangeHeightMm = GetFlangeHeightMm(nps, flangeClass)
                pipeLengthMm -= flangeHeightMm
            End If

        End If

        '==================================================
        ' ROUND VALUE
        '==================================================
        pipeLengthMm = Math.Round(pipeLengthMm, 3)

        '==================================================
        ' SAFETY CHECK
        '==================================================
        If pipeLengthMm < 0 Then
            pipeLengthMm = 0
        End If

        Return pipeLengthMm

    End Function

