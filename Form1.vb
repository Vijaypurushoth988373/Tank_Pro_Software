    Private Function FindOrCreatePlane(compDef As PartComponentDefinition, planeName As String) As WorkPlane
        For Each wp As WorkPlane In compDef.WorkPlanes
            If wp.Name = planeName Then Return wp
        Next

        Throw New Exception($"WorkPlane {planeName} not created before constraint!")
    End Function

    Public Function CreateAngledWorkPlane(compDef As PartComponentDefinition, nozzleIndex As String, angleDeg As Double, planeName As String, paramAngleName As String) As WorkPlane

        '==================================================
        ' ASSIGN / UPDATE NAMED ANGLE PARAMETER
        ' (paramAngleName is passed in explicitly so caller controls whether this is
        '  NZ_{index}_ANGLE for the main plane or NZ_{index}_ANGLE_PERP for the perp plane)
        '==================================================
        Dim params As Parameters = compDef.Parameters

        Try
            params.Item(paramAngleName).Expression = $"{angleDeg} deg"
        Catch
            params.UserParameters.AddByExpression(paramAngleName, $"{angleDeg} deg", UnitsTypeEnum.kDegreeAngleUnits)
        End Try

        '==================================================
        ' RE-WIRE EXISTING PLANE'S ANGLE TO THE PARAMETER, IF PLANE ALREADY EXISTS
        '==================================================
        For Each wp As WorkPlane In compDef.WorkPlanes
            If wp.Name = planeName Then
                wp.Visible = False

                Try
                    Dim existingDef As LinePlaneAndAngleWorkPlaneDef = CType(wp.Definition, LinePlaneAndAngleWorkPlaneDef)
                    ' Reference the named parameter BY NAME so the plane stays linked to it
                    ' (setting a numeric literal here would NOT stay in sync with future
                    '  edits to NZ_{nozzleIndex}_ANGLE / _PERP in the parameter table)
                    existingDef.Angle.Expression = paramAngleName
                Catch ex As Exception
                    MessageBox.Show("Could not re-link angle for existing plane '" & planeName & "': " & ex.Message, "CreateAngledWorkPlane")
                End Try

                compDef.Document.Update()
                Return wp
            End If
        Next

        '==================================================
        ' CREATE NEW ANGLED PLANE
        '==================================================

        ' Always use Y-axis & YZ-plane for rotation (unchanged from original)
        Dim yAxis As WorkAxis = compDef.WorkAxes.Item("Y Axis")
        Dim yzPlane As WorkPlane = compDef.WorkPlanes.Item("YZ Plane")

        Dim angRad As Double = angleDeg * Math.PI / 180.0

        '----------------------------------------------
        ' Create with a literal angle first (reliable, matches original behavior),
        ' then re-point its Definition.Angle at the named Parameter so it becomes
        ' fully parameter-driven going forward.
        '----------------------------------------------
        Dim newPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(yAxis, yzPlane, angRad)

        newPlane.Name = planeName
        newPlane.Visible = False

        Try
            Dim newDef As LinePlaneAndAngleWorkPlaneDef = CType(newPlane.Definition, LinePlaneAndAngleWorkPlaneDef)
            ' Reference the named parameter BY NAME so the plane stays linked to it going forward
            newDef.Angle.Expression = paramAngleName
        Catch ex As Exception
            MessageBox.Show("Plane '" & planeName & "' was created but could not be linked to parameter '" & paramAngleName & "': " & ex.Message, "CreateAngledWorkPlane")
        End Try

        compDef.Document.Update()

        Return newPlane

    End Function

    Public Sub ConstrainCoverPlateToManway(nozAsm As AssemblyDocument, nozOcc As ComponentOccurrence, coverOcc As ComponentOccurrence)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints

        '------------------------------------------
        ' Convert mm → cm
        '------------------------------------------
        Dim seatingOffsetCm As Double = -6.0 / 10.0    ' -6mm = -0.6cm

        '------------------------------------------
        ' Nozzle reference planes
        '------------------------------------------
        Dim nozDef = nozOcc.Definition
        Dim nozYZ As WorkPlane = nozDef.WorkPlanes.Item("YZ Plane")
        Dim nozXY As WorkPlane = nozDef.WorkPlanes.Item("XY Plane")
        Dim nozXZ As WorkPlane = nozDef.WorkPlanes.Item("XZ Plane")

        Dim nozYZp, nozXYp, nozXZp As Object
        nozOcc.CreateGeometryProxy(nozYZ, nozYZp)
        nozOcc.CreateGeometryProxy(nozXY, nozXYp)
        nozOcc.CreateGeometryProxy(nozXZ, nozXZp)

        '------------------------------------------
        ' COVER PLATE planes
        '------------------------------------------
        Dim covDef = coverOcc.Definition
        Dim covXY As WorkPlane = covDef.WorkPlanes.Item("XY Plane")
        Dim covXZ As WorkPlane = covDef.WorkPlanes.Item("XZ Plane")

        ' FIND END FACE in cover (one planar face)
        Dim endFace As Face = Nothing
        For Each f As Face In covDef.SurfaceBodies.Item(1).Faces
            If TypeOf f.Geometry Is Plane Then
                endFace = f
                Exit For
            End If
        Next

        If endFace Is Nothing Then Throw New Exception("❌ End face not found on cover plate")

        Dim covXYp, covXZp, endFaceP As Object
        coverOcc.CreateGeometryProxy(covXY, covXYp)
        coverOcc.CreateGeometryProxy(covXZ, covXZp)
        coverOcc.CreateGeometryProxy(endFace, endFaceP)

        '==========================================
        ' APPLY CONSTRAINTS
        '==========================================

        ' 1️⃣ Cover XY ↔ Nozzle YZ → FLUSH
        cons.AddFlushConstraint(covXYp, nozYZp, 0)

        ' 2️⃣ Cover XZ ↔ Nozzle XY → FLUSH
        cons.AddFlushConstraint(covXZp, nozXYp, 0)

        ' 3️⃣ Cover End Face ↔ Nozzle XZ → FLUSH with –6mm offset
        cons.AddFlushConstraint(endFaceP, nozXZp, seatingOffsetCm)

    End Sub

    Public Sub PlaceAndConstrainManwayCover(asmDoc As AssemblyDocument, gasketOcc As ComponentOccurrence, coverOcc As ComponentOccurrence)

        Dim cons = asmDoc.ComponentDefinition.Constraints

        '-------------------------------------------
