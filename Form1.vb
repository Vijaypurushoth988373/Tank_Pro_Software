    Public Sub AddVortexBreaker_NozzleFromDGV(invApp As Inventor.Application, folderPath As String, dgv As DataGridView)

        '==================================================
        ' LOOP THROUGH ALL NOZZLES
        '==================================================
        For Each row As DataGridViewRow In dgv.Rows

            If row.IsNewRow Then Continue For

            '--------------------------------------------------
            ' Read nozzle name + remarks
            '--------------------------------------------------
            Dim nozzleMark As String = row.Cells("Nozzle_Mark").Value.ToString().Trim().ToUpper()
            Dim remarks As String = row.Cells("REMARKS").Value.ToString().Trim().ToUpper()

            '==================================================
            ' ✅ Only if Vortex Breaker required
            '==================================================
            If Not remarks.Contains("VORTEX BREAKER") Then Continue For

            Debug.Print("✅ Vortex Breaker Required for: " & nozzleMark)

            '==================================================
            ' OPEN THAT NOZZLE SUB-ASSEMBLY
            '==================================================
            Dim nozzleAsmPath As String = IO.Path.Combine(folderPath, "Nozzle_" & nozzleMark & ".iam")

            If Not IO.File.Exists(nozzleAsmPath) Then
                Debug.Print("⚠ Nozzle Assembly Not Found: " & nozzleAsmPath)
                Continue For   ' ✅ Skip instead of throwing error
            End If

            Dim nozAsm As AssemblyDocument = CType(invApp.Documents.Open(nozzleAsmPath, False), AssemblyDocument)

            '==================================================
            ' FIND PIPE INSIDE THAT NOZZLE
            '==================================================
            Dim pipeOcc As ComponentOccurrence = Nothing

            For Each occ As ComponentOccurrence In nozAsm.ComponentDefinition.Occurrences

                If occ.Name.ToUpper().Contains("_PIPE") Then
                    pipeOcc = occ
                    Exit For
                End If

            Next

            If pipeOcc Is Nothing Then
                Debug.Print("⚠ PIPE Not Found inside Nozzle: " & nozzleMark)
                Continue For
            End If

            '==================================================
            ' ✅ CALL YOUR EXISTING SUB FUNCTION
            '==================================================
            If nozzleMark = "N4" Then
                PlaceAndConstrainVortexBreakerPlates_N4(invApp, nozAsm, pipeOcc, folderPath)
            Else
                PlaceAndConstrainVortexBreakerPlates(invApp, nozAsm, pipeOcc, folderPath)
            End If

            nozAsm.Update()
            Debug.Print("✅ Vortex Breaker Plates Placed for: " & nozzleMark)

        Next

    End Sub

