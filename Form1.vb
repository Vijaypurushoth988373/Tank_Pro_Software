    Private Enum VesselSize
        None
        Small
        Medium
        Large
    End Enum

    Private Function GetVesselSizeFromEHInsideDia() As VesselSize

        Dim dia As Double
        If Not Double.TryParse(txt_EH_Inside_Dia.Text, dia) Then
            Return VesselSize.None
        End If

        Select Case dia
            Case 900 To 1500
                Return VesselSize.Small

            Case 1501 To 2200
                Return VesselSize.Medium

            Case 2201 To 3000
                Return VesselSize.Large

            Case Else
                Return VesselSize.None
        End Select

    End Function

    Private Sub ApplyVesselDefaultsFromEH()

        If isLoadingNozzles Then Exit Sub

        Select Case GetVesselSizeFromEHInsideDia()

            Case VesselSize.Small

                If SelectedClient = "ARAMCO" Then
                    ApplySmallVesselDefaults()
                ElseIf SelectedClient = "ADNOC" Then
                    ApplySmallVesselDefaults_ADNOC()
                ElseIf SelectedClient = "QATAR" Then
                    ApplySmallVesselDefaults_QATAR()
                End If


            Case VesselSize.Medium

                If SelectedClient = "ARAMCO" Then
                    ApplyMediumVesselDefaults()
                ElseIf SelectedClient = "ADNOC" Then
                    ApplyMediumVesselDefaults_ADNOC()
                ElseIf SelectedClient = "QATAR" Then
                    ApplyMediumVesselDefaults_QATAR()
                End If


            Case VesselSize.Large

                If SelectedClient = "ARAMCO" Then
                    ApplyLargeVesselDefaults()
                ElseIf SelectedClient = "ADNOC" Then
                    ApplyLargeVesselDefaults_ADNOC()
                ElseIf SelectedClient = "QATAR" Then
                    ApplyLargeVesselDefaults_QATAR()
                End If

        End Select

    End Sub

