    Public Sub UpdateGroundingLugParameters(invApp As Inventor.Application, GroundingLugPath As String)
        '==================================================
        ' VALIDATION
        '==================================================
        If invApp Is Nothing Then Exit Sub
        If String.IsNullOrWhiteSpace(GroundingLugPath) Then Exit Sub
        If Not IO.File.Exists(GroundingLugPath) Then Exit Sub

        '==================================================
        ' DECLARE VARIABLES
        '==================================================
        Dim lengthMm As Double
        Dim heightMm As Double
        Dim thkMm As Double
        Dim holeDiaMm As Double
        Dim horDistMm As Double
        Dim vertDistMm As Double
        Dim filletMm As Double
        Dim distBaseMm As Double
        Dim noofholes As Single
        Dim holedistmm As Double
        Dim matName As String = ""

        '==================================================
        ' READ VALUES FROM FORM
        '==================================================
        Double.TryParse(txt_EL_LENGTH.Text, lengthMm)
        Double.TryParse(txt_EL_HEIGHT.Text, heightMm)
        Double.TryParse(txt_EL_THK.Text, thkMm)
        Double.TryParse(txt_EL_HOLE_DIA.Text, holeDiaMm)
        Double.TryParse(txt_EL_HOR_DIST.Text, horDistMm)
        Double.TryParse(txt_EL_VERT_DIST.Text, vertDistMm)
        Double.TryParse(txt_EL_FILLET.Text, filletMm)
        Double.TryParse(txt_EL_DIST_BASE.Text, distBaseMm)
        Double.TryParse(txt_EL_HOLE_NO.Text, noofholes)
        Double.TryParse(txt_EL_HOLE_DIST.Text, holedistmm)

        matName = txt_EL_MAT.Text

        '==================================================
        ' UPDATE INVENTOR PART
        '==================================================
        Try

            Dim doc As PartDocument = CType(invApp.Documents.Open(GroundingLugPath, False), PartDocument)

            Dim params As Parameters = doc.ComponentDefinition.Parameters

            '------------------------------------------
            ' UPDATE PARAMETERS
            '------------------------------------------
            params.Item("LENGTH").Expression = $"{lengthMm} mm"
            params.Item("HEIGHT").Expression = $"{heightMm} mm"
            params.Item("THK").Expression = $"{thkMm} mm"
            params.Item("HOLE_DIA").Expression = $"{holeDiaMm} mm"
            params.Item("HOLE_DIST_HOR").Expression = $"{horDistMm} mm"
            params.Item("HOLE_DIST_VERT").Expression = $"{vertDistMm} mm"
            params.Item("FILLET").Expression = $"{filletMm} mm"
