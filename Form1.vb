               IO.File.Exists(gasketPath) AndAlso ringFlangeOcc IsNot Nothing Then
                        gasketOcc = PlaceAndConstrainGasket(invApp, asmDoc, shellOcc, ringFlangeOcc, gasketPath)
                    End If
