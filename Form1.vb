                                                                   gasketOcc, topCoverPath)
                    End If
                Catch ex As Exception
                    Debug.WriteLine(ex.Message)
                End Try

            ElseIf SelectedClient = "QATAR" Then

                Dim ringFlangeOcc As ComponentOccurrence = Nothing
                Dim gasketOcc As ComponentOccurrence = Nothing

                Try
                    If asmDoc IsNot Nothing AndAlso ringFlangePath <> "" AndAlso
               IO.File.Exists(ringFlangePath) Then
                        ringFlangeOcc = PlaceAndConstrainRingFlange(invApp, asmDoc, shellOcc, ringFlangePath)
                    End If
                Catch ex As Exception
                    Debug.WriteLine(ex.Message)
                End Try

                Try
                    If asmDoc IsNot Nothing AndAlso gasketPath <> "" AndAlso
               IO.File.Exists(gasketPath) AndAlso ringFlangeOcc IsNot Nothing Then
                        gasketOcc = PlaceAndConstrainGasket(invApp, asmDoc, shellOcc, ringFlangeOcc, gasketPath)
                    End If
                Catch ex As Exception
