    Public Sub UpdatePipeSupportAngle(invApp As Inventor.Application, PipeSupportAnglePath As String)
        '==================================================
        ' Validate file path
        '==================================================
        If Not IO.File.Exists(PipeSupportAnglePath) Then
            Throw New Exception("❌ Pipe Support Part not found: " & PipeSupportAnglePath)
        End If

        '==================================================
        ' Open part document (silent)
        '==================================================
        Dim PipeSuppAnglepDoc As PartDocument = CType(invApp.Documents.Open(PipeSupportAnglePath, False), PartDocument)
        Dim compDef As PartComponentDefinition = PipeSuppAnglepDoc.ComponentDefinition
        Dim params As Parameters = compDef.Parameters

        '==================================================
        ' Update parameters safely
        '==================================================
        Dim ID As Double = Val(txt_Shell_Inside_Dia.Text)
        Dim lengthVal As Double

        If ID >= 900 AndAlso ID <= 1500 Then
            lengthVal = (ID / 2) - 332
        ElseIf ID <= 2200 Then
            lengthVal = (ID / 2) - 526
        ElseIf ID <= 3000 Then
            lengthVal = (ID / 2) - 826
        End If

        params.Item("LENGTH").Expression = lengthVal & " mm"

        '==================================================
        ' Update & close
        '==================================================
        PipeSuppAnglepDoc.Update()
        PipeSuppAnglepDoc.Save()
        PipeSuppAnglepDoc.Close(True)

    End Sub

    Public Sub UpdatePipeSupportAssmbly(invApp As Inventor.Application, PipeSupportAssmblyPath As String)
        '==================================================
        ' 1) Validate file path
        '==================================================
        If Not System.IO.File.Exists(PipeSupportAssmblyPath) Then
            Throw New Exception("❌ Pipe Support Angle part not found: " & PipeSupportAssmblyPath)
        End If

        '==================================================
        ' 2) Get ACTIVE ASSEMBLY
        '==================================================
        If invApp.ActiveDocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then
            Throw New Exception("❌ Active document is not an Assembly.")
        End If

        Dim asmDoc As AssemblyDocument = CType(invApp.Documents.Open(PipeSupportAssmblyPath, False), AssemblyDocument)
        Dim asmParams As Parameters = asmDoc.ComponentDefinition.Parameters

        '==================================================
        ' 3) Read ASSEMBLY PARAMETER
        '==================================================
        Dim shellID As Double = CDbl(txt_Shell_Inside_Dia.Text)

        '==================================================
        ' 4) Decide LENGTH based on Shell ID
        '==================================================
        Dim supportLength As Double

        If shellID >= 900 AndAlso shellID <= 1500 Then
            supportLength = (shellID / 2) - 597
        ElseIf shellID <= 2200 Then
            supportLength = (shellID / 2) - 591
        ElseIf shellID <= 3000 Then
            supportLength = (shellID / 2) - 591
        Else
            Throw New Exception("Unsupported Shell Inside Dia: " & shellID)
        End If

        asmParams.Item("DISTANCE").Expression = supportLength & " mm"

        asmDoc.Update()
        asmDoc.Save()
        asmDoc.Close(True)

    End Sub

    Private Sub UpdateSingleNozzlePipeAndPad(invApp As Inventor.Application, folderPath As String, row As DataGridViewRow, isShell As Boolean, shellIDmm As Double, shellThkMm As Double)

        '==================================================
        ' NOZZLE NAME
        '==================================================
        Dim nozzleName As String = If(isShell, row.Cells("NOZZLE_MARK_TEXT").Value.ToString(), row.Cells("Nozzle_Mark").Value.ToString()).Trim().ToUpper()
        Dim nozAsmPath As String = IO.Path.Combine(folderPath, "Nozzle_" & nozzleName & ".iam")
        If Not IO.File.Exists(nozAsmPath) Then Exit Sub

        '==================================================
        ' PIPE LENGTH
        '==================================================
        Dim pipeLengthMm As Double = 0

        If isShell Then
            ' 🔥 CALCULATE ONLY FOR SHELL
            Dim nps As String = row.Cells("SIZE_TEXT").Value.ToString().Trim()
            Dim outsideProjMm As Double = CDbl(row.Cells("OUTSIDE_PROJECTION_SHELL").Value)

            Dim remarks As String = row.Cells("REMARKS_SHELL").Value.ToString().ToUpper()
            Dim isManway As Boolean = nozzleName.StartsWith("M") OrElse remarks.Contains("MANWAY")
            Dim includeElbow As Boolean = CBool(row.Cells("ELBOW").Value)
            Dim includeMidPipe As Boolean = If(IsDBNull(row.Cells("Inc_Pipe").Value), False, CBool(row.Cells("Inc_Pipe").Value))
            Dim midPipeLengthMm As Double = SafeDouble(row.Cells("Pipe_Length").Value)
            Dim flangeClass As String = row.Cells("NOZZLE_FLANGE_CLASS_SHELL").Value.ToString().Trim()

            pipeLengthMm = CalculatePipeLength_Shell(nps, outsideProjMm, flangeClass, isManway, includeElbow)

            'If includeMidPipe AndAlso midPipeLengthMm > 0 Then

            '    pipeLengthMm = midPipeLengthMm

            'Else

            '    '==================================================
            '    ' PRIORITY 2️⃣ NORMAL SHELL CALCULATION
            '    '==================================================
            '    pipeLengthMm = CalculatePipeLength_Shell(nps, outsideProjMm, isManway, includeElbow)

            'End If

            ' Store for reference
            row.Tag = pipeLengthMm

            'Else
            '    ' 🟢 HEAD → already calculated earlier
            '    If row.Tag IsNot Nothing Then
            '        pipeLengthMm = CDbl(row.Tag)
            '    End If
        End If

        '==================================================
        ' RF PAD VALUES (SAFE READ)
        '==================================================
        Dim padODmm As Double = 0
        Dim padThkMm As Double = 0

        Dim odCell As Object
        Dim thkCell As Object

        If isShell Then
            odCell = row.Cells("RF_PAD_OD_1").Value
            thkCell = row.Cells("RF_PAD_THK_1").Value
        Else
            odCell = row.Cells("RF_PAD_OD").Value
            thkCell = row.Cells("RF_PAD_THK").Value
        End If


        '----------------------------------------------
        ' SAFE OD READ
        '----------------------------------------------
        If odCell IsNot Nothing Then

            Dim odText As String = odCell.ToString.Trim

            If odText <> "" AndAlso odText <> "-" Then
                Double.TryParse(odText, padODmm)
            End If

        End If


        '----------------------------------------------
        ' SAFE THK READ
        '----------------------------------------------
        If thkCell IsNot Nothing Then

            Dim thkText As String = thkCell.ToString.Trim

            If thkText <> "" AndAlso thkText <> "-" Then
                Double.TryParse(thkText, padThkMm)
            End If

        End If

        '==================================================
        ' FLANGE OUTSIDE PROJECTION (FROM DGV)
        '==================================================
        Dim flangeOutsideProjMm As Double = 0

        If isShell Then
            flangeOutsideProjMm = CDbl(If(row.Cells("OUTSIDE_PROJECTION_SHELL").Value, 0))
        Else
            flangeOutsideProjMm = CDbl(If(row.Cells("OUTSIDE_PROJECTION").Value, 0))
        End If

        '==================================================
        ' OPEN NOZZLE ASSEMBLY (HIDDEN)
        '==================================================
        Dim nozAsm As AssemblyDocument = CType(invApp.Documents.Open(nozAsmPath, False), AssemblyDocument)

        '==================================================
        ' 5️⃣ UPDATE PIPE & PAD
        '==================================================
        For Each occ As ComponentOccurrence In nozAsm.ComponentDefinition.Occurrences

            If occ.Name.ToUpper().Contains("PIPE") AndAlso Not occ.Name.ToUpper().Contains("MID_PIPE") AndAlso pipeLengthMm > 0 Then
                UpdatePipeParameters(occ, pipeLengthMm)
            End If

            If occ.Name.ToUpper().Contains("PAD") Then
                UpdatePadParameters(occ, padODmm, padThkMm, shellIDmm, shellThkMm)
            End If

            If occ.Name.ToUpper().Contains("FLANGE") AndAlso flangeOutsideProjMm > 0 Then
                UpdateFlangeOutsideProjection(occ, flangeOutsideProjMm)
            End If

        Next

        If isShell Then

            Dim distFromBaseMm As Double = GetDistanceFromBase(row)

            If distFromBaseMm > 0 Then

                UpdateShellPartNozzleDist(invApp, IO.Path.Combine(folderPath, "PT_NO_1_TANK_SHELL_PLATE.ipt"), nozzleName, distFromBaseMm)
                UpdateMainAssemblyNozzleDist(invApp, nozzleName, distFromBaseMm)

            End If

        End If

        nozAsm.Update()
        nozAsm.Save()
        nozAsm.Close(True)

    End Sub

    Private Function IsNozzleAlreadyPlaced(asmDoc As AssemblyDocument, nozzleName As String) As Boolean
        If asmDoc Is Nothing Then Return False

        Dim targetFileName As String = ("NOZZLE_" & nozzleName & ".IAM").ToUpper()

        For Each occ As ComponentOccurrence In asmDoc.ComponentDefinition.Occurrences

            Try
                Dim occFileName As String = IO.Path.GetFileName(occ.Definition.Document.FullFileName).ToUpper()
                If occFileName = targetFileName Then
                    Return True
                End If
            Catch
                ' Ignore suppressed / unresolved components
            End Try
        Next

        Return False

    End Function

    Private Sub UpdateFlangeOutsideProjection(flangeOcc As Inventor.ComponentOccurrence, outsideProjMm As Double)

        If flangeOcc Is Nothing Then Exit Sub

        '==================================================
        ' Get Part Definition
        '==================================================
        Dim partDef As Inventor.PartComponentDefinition = TryCast(flangeOcc.Definition, Inventor.PartComponentDefinition)
        If partDef Is Nothing Then Exit Sub
        Dim params As Inventor.Parameters = partDef.Parameters

        '==================================================
        ' Update parameter WITH UNITS
        '==================================================
        params.Item("OUTSIDE_PROJECTION").Expression = outsideProjMm

        '==================================================
        ' Update document
        '==================================================
        partDef.Document.Update()

    End Sub

    Private Sub UpdatePipeParameters(pipeOcc As ComponentOccurrence, pipeLengthMm As Double, Optional outsideProjMm As Double = -1)

        If pipeOcc Is Nothing OrElse pipeLengthMm <= 0 Then Exit Sub

        '==================================================
        ' Get PIPE PartDocument
        '==================================================
        Dim pipeDoc As PartDocument = TryCast(pipeOcc.Definition.Document, PartDocument)

        If pipeDoc Is Nothing Then Exit Sub

        Dim compDef As PartComponentDefinition = pipeDoc.ComponentDefinition
        Dim params As Parameters = compDef.Parameters

        '==================================================
        ' 1️⃣ PIPE LENGTH
        '==================================================
        params.Item("LENGTH").Value = pipeLengthMm / 10.0   ' mm → cm

        '==================================================
        ' Update pipe part
        '==================================================
        pipeDoc.Update()

    End Sub

    Private Sub UpdatePipeAndPadInsideNozzle(nozAsm As AssemblyDocument, pipeLengthMm As Double, padODmm As Double, padThkMm As Double, shellIDmm As Double, shellThkMm As Double)

        For Each occ As ComponentOccurrence In nozAsm.ComponentDefinition.Occurrences

            '================ PIPE =================
            If occ.Name.ToUpper().Contains("PIPE") Then

                Dim pipeDoc As PartDocument = CType(occ.Definition.Document, PartDocument)
                Dim params = pipeDoc.ComponentDefinition.Parameters

                'If params.NameIsUsed("PIPE_LENGTH") Then
                '    params.Item("PIPE_LENGTH").Value = pipeLengthMm / 10.0   ' mm → cm
                'End If

                pipeDoc.Update()

            End If

            '================ RF PAD =================
            If occ.Name.ToUpper().Contains("PAD") Then
                UpdatePadParameters(occ, padODmm, padThkMm, shellIDmm, shellThkMm)
            End If

        Next

    End Sub

    Private Sub UpdatePadParameters(padOcc As ComponentOccurrence, padODmm As Double, padThkMm As Double, shellIDmm As Double, shellThkMm As Double)

        If padODmm <= 0 OrElse padThkMm <= 0 Then Exit Sub
        Dim padDoc As PartDocument = CType(padOcc.Definition.Document, PartDocument)
        Dim params As Parameters = padDoc.ComponentDefinition.Parameters


        '==================================================
        ' BASIC RF PAD PARAMETERS
        '==================================================
        Try
            params.Item("PAD_OD").Value = padODmm / 10.0
        Catch
        End Try

        Try
            params.Item("PAD_THK").Value = padThkMm / 10.0
        Catch
        End Try

        Try
            params.Item("ID").Value = shellIDmm / 10.0
        Catch
        End Try

        Try
            params.Item("THK").Value = shellThkMm / 10.0
        Catch
        End Try


        '==================================================
        ' AUTO-DETECT NOZZLE NAME FROM OCCURRENCE
        ' Example: N2_RF_PAD → N2
        '==================================================
        Dim occName As String = padOcc.Name.ToUpper()
        Dim nozzleName As String = occName.Replace("_RF_PAD", "").Trim()

        '==================================================
        ' FIND MATCHING ROW IN DGV
        '==================================================
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For
            Dim dgvNozzle = row.Cells("Nozzle_Mark").Value?.ToString().Trim().ToUpper()
            If dgvNozzle <> nozzleName Then Continue For
            Dim placementType As String = row.Cells("PLACEMENT_TYPE_1").Value?.ToString.Trim.ToUpper()

            '==================================================
            ' XY DIRECTION PAD POSITION
            '==================================================
            If placementType = "XY DIRECTION" Then

                Dim xVal = row.Cells("X_MM").Value
                Dim yVal = row.Cells("Y_MM").Value

                If xVal IsNot Nothing AndAlso yVal IsNot Nothing AndAlso xVal.ToString <> "-" AndAlso yVal.ToString <> "-" Then
                    Try
                        params.Item("PAD_DIST_X").Expression = xVal & " mm"
                    Catch
                        Debug.Print("Missing parameter: PAD_DIST_X")
                    End Try

                    Try
                        params.Item("PAD_DIST_Y").Expression = yVal & " mm"
                    Catch
                        Debug.Print("Missing parameter: PAD_DIST_Y")
                    End Try
                End If
            End If

            '==================================================
            ' RADIAL PAD POSITION (Optional Support)
            '==================================================
            If placementType = "RADIAL" Then

                Dim radVal = row.Cells("RADIUS_MM").Value
                Dim angVal = row.Cells("ANGLE_DEG").Value

                If radVal IsNot Nothing AndAlso angVal IsNot Nothing AndAlso radVal.ToString <> "-" AndAlso angVal.ToString <> "-" Then
                    Try
                        params.Item("PAD_RAD").Expression = radVal & " mm"
                    Catch
                        Debug.Print("Missing parameter: PAD_RAD")
                    End Try

                    Try
                        params.Item("PAD_ANG").Expression = angVal & " deg"
                    Catch
                        Debug.Print("Missing parameter: PAD_ANG")
                    End Try

                End If
            End If
            Exit For
        Next

        '==================================================
        ' UPDATE DOCUMENT
        '==================================================
        padDoc.Update()

    End Sub

    Private Function GetDistanceFromBase(row As DataGridViewRow) As Double

        If row.Cells("DIST_FROM_BASE_TEXT").Value Is Nothing Then Return 0

        Dim val As Double = 0
        Double.TryParse(row.Cells("DIST_FROM_BASE_TEXT").Value.ToString(), val)

        Return val
    End Function

    Private Sub UpdateMainAssemblyNozzleDist(invApp As Inventor.Application, nozzleMark As String, distMm As Double)

        If distMm <= 0 Then Exit Sub
        If invApp.ActiveDocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then Exit Sub

        Dim asmDoc As AssemblyDocument = CType(invApp.ActiveDocument, AssemblyDocument)
        Dim asmParams As Parameters = asmDoc.ComponentDefinition.Parameters


        Dim paramName As String = nozzleMark & "_DIST"
        Dim ehSf As Double = CDbl(txt_EH_SF.Text)
        Dim finalDistMm As Double = distMm - ehSf
        asmParams.Item(paramName).Expression = finalDistMm & " mm"

        asmDoc.Update()
    End Sub

    Private Sub UpdateShellPartNozzleDist(invApp As Inventor.Application, shellPartPath As String, nozzleMark As String, distMm As Double)

        If distMm <= 0 Then Exit Sub
        If Not IO.File.Exists(shellPartPath) Then Exit Sub

        Dim shellDoc As PartDocument = CType(invApp.Documents.Open(shellPartPath, False), PartDocument)
        Dim params As Parameters = shellDoc.ComponentDefinition.Parameters
        Dim paramName As String = nozzleMark & "_DIST"
        Dim ehSf As Double = CDbl(txt_EH_SF.Text)
        Dim finalDistMm As Double = distMm - ehSf

        params.Item(paramName).Expression = finalDistMm & " mm"

        shellDoc.Update()
        shellDoc.Save()
        shellDoc.Close(True)
    End Sub

    Public Sub UpdateStiffenerPlateParameters(invApp As Inventor.Application, stiffPath As String)

        If invApp Is Nothing Then Exit Sub
        If String.IsNullOrWhiteSpace(stiffPath) Then Exit Sub
        If Not IO.File.Exists(stiffPath) Then Exit Sub

        Dim idMm As Double
        Dim thkMm As Double
        Dim lengthMm As Double
        Dim heightMm As Double

        Dim nd1Mm As Double
        Dim nd2Mm As Double
        Dim nd3Mm As Double
        Dim nd4Mm As Double

        Dim minDistMm As Double
        Dim nozRadMm As Double

        'Check if Form6 is open
        Dim frm As Form6 = System.Windows.Forms.Application.OpenForms.OfType(Of Form6)().FirstOrDefault()

        If frm IsNot Nothing Then

            Double.TryParse(frm.txt_SP_ID.Text, idMm)
            Double.TryParse(frm.txt_SP_THK.Text, thkMm)
            Double.TryParse(frm.txt_SP_Length.Text, lengthMm)
            Double.TryParse(frm.txt_SP_Height.Text, heightMm)

            Double.TryParse(frm.txt_SP_ND1.Text, nd1Mm)
            Double.TryParse(frm.txt_SP_ND2.Text, nd2Mm)
            Double.TryParse(frm.txt_SP_ND3.Text, nd3Mm)
            Double.TryParse(frm.txt_SP_ND4.Text, nd4Mm)

            Double.TryParse(frm.txt_SP_Min_Dist.Text, minDistMm)
            Double.TryParse(frm.txt_SP_Noz_Rad.Text, nozRadMm)

        Else

            idMm = StiffenerData.SP_ID
            thkMm = StiffenerData.SP_THK
            lengthMm = StiffenerData.SP_LENGTH
            heightMm = StiffenerData.SP_HEIGHT

            nd1Mm = StiffenerData.SP_ND1
            nd2Mm = StiffenerData.SP_ND2
            nd3Mm = StiffenerData.SP_ND3
            nd4Mm = StiffenerData.SP_ND4

            minDistMm = StiffenerData.SP_MIN_DIST
            nozRadMm = StiffenerData.SP_NOZ_RAD

        End If


        Try

            Dim doc As PartDocument = CType(invApp.Documents.Open(stiffPath, False), PartDocument)

            Dim params As Parameters = doc.ComponentDefinition.Parameters

            params.Item("ID").Expression = idMm & " mm"
            params.Item("THK").Expression = thkMm & " mm"
            params.Item("LENGTH").Expression = lengthMm & " mm"
            params.Item("HEIGHT").Expression = heightMm & " mm"

            params.Item("ND1").Expression = nd1Mm & " mm"
            params.Item("ND2").Expression = nd2Mm & " mm"
            params.Item("ND3").Expression = nd3Mm & " mm"
            params.Item("ND4").Expression = nd4Mm & " mm"

            params.Item("MIN_DIST").Expression = minDistMm & " mm"
            params.Item("NOZ_RAD").Expression = nozRadMm & " mm"

            doc.Update()
            doc.Save()
            doc.Close(True)

        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try

    End Sub

    '==========================================================================================
    ' RESOLVE AND UPDATE BODY FLANGE COMPONENTS
    ' Called from the CLIENT-SPECIFIC COMPONENTS block for all three clients.
    '
    ' Components resolved:
    '   1. BODY FLANGE  → parameter B updated from schedule
    '   2. BLIND FLANGE → path resolved only (no parameter update)
    '   3. GASKET       → path resolved only (no parameter update)
    '
    ' Folder structure (all three follow same pattern):
    '   <projectRoot>\Body Flange\Class 150\{inch}_INCH\BODY_FLANGE_CL_150_{inch}_INCH.IPT
    '   <projectRoot>\Blind Flange\Class 150\{inch}_INCH\BLIND_FLANGE_CL_150_{inch}_INCH.IPT
    '   <projectRoot>\Gasket for Body Flange\Class 150\{inch}_INCH\GASKET_CL_150_{inch}_INCH.IPT
    '
    ' flangeInch   : Integer — nozzle size e.g. 10, 12, 14, 16, 18, 20, 24
    ' flangeSch    : String  — schedule e.g. "STD", "XS", "40", from ComboBox/TextBox
    ' projectRoot  : String  — IO.Path.GetDirectoryName(activeProject.FullFileName)
    ' RB_RT_BF     : RadioButton on form — if Checked = Ring Bolt type, else Ring Type
    '==========================================================================================
    Public Sub ResolveAndUpdateBodyFlangeComponents(invApp As Inventor.Application, flangeInch As Integer, flangeSch As String, projectRoot As String,
        ByRef bodyFlangePath As String, ByRef blindFlangePath As String, ByRef gasketBFPath As String)

        '--------------------------------------------------
        ' 1️⃣ Validate flange size
        '--------------------------------------------------
        Dim validSizes() As Integer = {10, 12, 14, 16, 18, 20, 24}
        If Not validSizes.Contains(flangeInch) Then
            'MessageBox.Show($"❌ Flange size {flangeInch}"" is not supported (10–24 inch only).", "Body Flange")
            Exit Sub
        End If

        '--------------------------------------------------
        ' 2️⃣ Determine flange type from RadioButton
        '--------------------------------------------------
        Dim flangeType As String = If(RB_RT_BF.Checked, "RB", "RT")

        '--------------------------------------------------
        ' 3️⃣ Build size folder name
        '--------------------------------------------------
        Dim inchFolder As String = $"{flangeInch}_INCH"

        '--------------------------------------------------
        ' 4️⃣ BODY FLANGE path
        '    Flat under Class 150\ — no per-size subfolder
        '--------------------------------------------------
        Dim bfFileName As String = $"BODY_FLANGE_CL_150_{flangeInch}_INCH.IPT"
        bodyFlangePath = IO.Path.Combine(projectRoot, "Body Flange", "Class 150", bfFileName)

        If Not IO.File.Exists(bodyFlangePath) Then
            bodyFlangePath = SelectInventorFile($"Select Body Flange {flangeInch}"" IPT")
        End If

        '--------------------------------------------------
        ' 5️⃣ BLIND FLANGE path
        '--------------------------------------------------
        Dim blFileName As String = $"BLIND_FLANGE_CL_150_{flangeInch}_INCH.IPT"
        blindFlangePath = IO.Path.Combine(projectRoot, "Blind Flange", "Class 150", blFileName)

        If Not IO.File.Exists(blindFlangePath) Then
            blindFlangePath = SelectInventorFile($"Select Blind Flange {flangeInch}"" IPT")
        End If

        '--------------------------------------------------
        ' 6️⃣ GASKET path
        '--------------------------------------------------
        Dim gsFileName As String = $"GASKET_CL_150_{flangeInch}_INCH.IPT"
        gasketBFPath = IO.Path.Combine(projectRoot, "Gasket for Body Flange", "Class 150", gsFileName)

        If Not IO.File.Exists(gasketBFPath) Then
            gasketBFPath = SelectInventorFile($"Select Gasket {flangeInch}"" IPT")
        End If

        '--------------------------------------------------
        ' 7️⃣ UPDATE PARAMETER "B" ON BODY FLANGE ONLY
        '--------------------------------------------------
        If Not String.IsNullOrWhiteSpace(bodyFlangePath) AndAlso
       IO.File.Exists(bodyFlangePath) AndAlso
       Not String.IsNullOrWhiteSpace(flangeSch) Then

            Dim schedule As Dictionary(Of String, Double) = GetBodyFlangeSchedule()
            Dim lookupKey As String = $"{flangeInch}_{flangeSch.Trim().ToUpper()}"
            Dim bValue As Double

            If schedule.TryGetValue(lookupKey, bValue) Then

                ' Open IPT (or reuse if already open)
                Dim partDoc As PartDocument = Nothing

                For Each doc As Document In invApp.Documents
                    If String.Equals(doc.FullFileName, bodyFlangePath,
                                 StringComparison.OrdinalIgnoreCase) Then
                        partDoc = CType(doc, PartDocument)
                        Exit For
                    End If
                Next

                If partDoc Is Nothing Then
                    partDoc = CType(invApp.Documents.Open(bodyFlangePath, False), PartDocument)
                End If

                ' Update parameter B
                Try
                    partDoc.ComponentDefinition.Parameters.Item("B").Expression = $"{bValue} mm"
                    partDoc.Update()
                    partDoc.Save()
                Catch ex As Exception
                    MessageBox.Show($"❌ Could not update parameter 'B':" & vbCrLf & ex.Message,
                                "Body Flange Update")
                End Try

            Else
                MessageBox.Show($"❌ Schedule '{flangeSch}' not found for {flangeInch}"" flange." &
                            vbCrLf & $"Key attempted: {lookupKey}",
                            "Body Flange Update")
            End If

        End If

    End Sub

