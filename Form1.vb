        ElseIf SelectedClient = "QATAR" Then

            If IO.File.Exists(plate1Path) Then
                plate1Occ = asmDef.Occurrences.Add(plate1Path, tg.CreateMatrix())
                plate1Occ.Name = "VORTEX_BREAKER_PLATE_1"
                Dim p1Def = plate1Occ.Definition

                Dim p1XY = p1Def.WorkPlanes.Item("XY Plane")
                Dim p1YZ = p1Def.WorkPlanes.Item("YZ Plane")
                Dim p1XZ = p1Def.WorkPlanes.Item("XZ Plane")

                Dim p1XYp, p1YZp, p1XZp As Object

                plate1Occ.CreateGeometryProxy(p1XY, p1XYp)
                plate1Occ.CreateGeometryProxy(p1YZ, p1YZp)
                plate1Occ.CreateGeometryProxy(p1XZ, p1XZp)

                cons.AddMateConstraint(pipeXYp, p1XYp, 0)
                cons.AddMateConstraint(pipeYZp, p1YZp, 0)
                cons.AddFlushConstraint(pipeEndp, p1XZp, 7.5) '--> Offset Distance

            End If

        End If


        '==================================================
        ' PLATE-2 (QTY = 2)
        '==================================================

        If SelectedClient = "ARAMCO" Then

            If IO.File.Exists(plate2Path) Then

                For i As Integer = 1 To 2

                    Dim plate2Occ = asmDef.Occurrences.Add(plate2Path, tg.CreateMatrix())

                    plate2Occ.Name = $"VORTEX_BREAKER_PLATE_2_{i}"

                    Dim p2Def = plate2Occ.Definition

                    Dim p2XY = p2Def.WorkPlanes.Item("XY Plane")
                    Dim p2WP1 = p2Def.WorkPlanes.Item("Work Plane1")
                    Dim p2WP2 = p2Def.WorkPlanes.Item("Work Plane2")

                    Dim p2XYp, p2WP1p, p2WP2p As Object

                    plate2Occ.CreateGeometryProxy(p2XY, p2XYp)
                    plate2Occ.CreateGeometryProxy(p2WP1, p2WP1p)
                    plate2Occ.CreateGeometryProxy(p2WP2, p2WP2p)

                    If i = 1 Then

                        cons.AddFlushConstraint(pipeYZp, p2XYp, 0)
                        cons.AddFlushConstraint(pipeXYp, p2WP1p, 3.0 / 10.0)
                        cons.AddFlushConstraint(pipeEndp, p2WP2p, 60.0 / 10.0)

                    Else

                        cons.AddMateConstraint(pipeYZp, p2XYp, 0)
                        cons.AddMateConstraint(pipeXYp, p2WP1p, -3.0 / 10.0)
                        cons.AddFlushConstraint(pipeEndp, p2WP2p, 60.0 / 10.0)

                    End If

                Next

            End If

        ElseIf SelectedClient = "ADNOC" Then

            If IO.File.Exists(plate2Path) Then

                For i As Integer = 1 To 2

                    Dim plate2Occ = asmDef.Occurrences.Add(plate2Path, tg.CreateMatrix())

                    plate2Occ.Name = $"VORTEX_BREAKER_PLATE_2_{i}"

                    Dim p2Def = plate2Occ.Definition

                    Dim p2XY = p2Def.WorkPlanes.Item("XY Plane")
                    Dim p2WP1 = p2Def.WorkPlanes.Item("Work Plane1")
                    Dim p2WP2 = p2Def.WorkPlanes.Item("Work Plane2")

                    Dim p2XYp, p2WP1p, p2WP2p As Object

                    plate2Occ.CreateGeometryProxy(p2XY, p2XYp)
                    plate2Occ.CreateGeometryProxy(p2WP1, p2WP1p)
                    plate2Occ.CreateGeometryProxy(p2WP2, p2WP2p)

                    If i = 1 Then

                        cons.AddFlushConstraint(pipeYZp, p2XYp, 0)
                        cons.AddFlushConstraint(pipeXYp, p2WP1p, 3.0 / 10.0)
                        cons.AddFlushConstraint(pipeEndp, p2WP2p, 50.0 / 10.0)

                    Else

                        cons.AddMateConstraint(pipeYZp, p2XYp, 0)
                        cons.AddMateConstraint(pipeXYp, p2WP1p, -3.0 / 10.0)
                        cons.AddFlushConstraint(pipeEndp, p2WP2p, 50.0 / 10.0)

                    End If

                Next

            End If

        End If

        '==================================================
        ' ADNOC ONLY – PLATE-3 (RELATIVE TO PLATE-1)
        '==================================================
        If SelectedClient = "ADNOC" AndAlso plate1Occ IsNot Nothing AndAlso IO.File.Exists(plate3Path) Then

            Dim plate3Occ = asmDef.Occurrences.Add(plate3Path, tg.CreateMatrix())
            plate3Occ.Name = "VORTEX_BREAKER_PLATE_3"

            Dim p3Def = plate3Occ.Definition
            Dim p1Def = plate1Occ.Definition

            Dim p3XY = p3Def.WorkPlanes.Item("XY Plane")
            Dim p3YZ = p3Def.WorkPlanes.Item("YZ Plane")
            Dim p3XZ = p3Def.WorkPlanes.Item("XZ Plane")

            Dim p1XY = p1Def.WorkPlanes.Item("XY Plane")
            Dim p1YZ = p1Def.WorkPlanes.Item("YZ Plane")
            Dim p1XZ = p1Def.WorkPlanes.Item("XZ Plane")

            Dim p3XYp, p3YZp, p3XZp As Object
            Dim p1XYp, p1YZp, p1XZp As Object

            plate3Occ.CreateGeometryProxy(p3XY, p3XYp)
            plate3Occ.CreateGeometryProxy(p3YZ, p3YZp)
            plate3Occ.CreateGeometryProxy(p3XZ, p3XZp)

            plate1Occ.CreateGeometryProxy(p1XY, p1XYp)
            plate1Occ.CreateGeometryProxy(p1YZ, p1YZp)
            plate1Occ.CreateGeometryProxy(p1XZ, p1XZp)

            'XZ ↔ XZ  → FLUSH
            cons.AddFlushConstraint(p3XZp, p1XZp, 0)

            'YZ ↔ YZ  → MATE
            cons.AddMateConstraint(p3YZp, p1YZp, 0)

            'XY ↔ XY  → MATE
            cons.AddMateConstraint(p3XYp, p1XYp, 0)

        End If


        '==================================================
        ' FINAL UPDATE
        '==================================================
        nozAsm.Update()

    End Sub

