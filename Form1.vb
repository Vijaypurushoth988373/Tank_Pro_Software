    Public Sub ConstrainPadToPipe_Shell(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, padOcc As ComponentOccurrence, isManway As Boolean)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints
        pipeOcc.Grounded = True
        padOcc.Grounded = False

        '==================================================
        ' 1️0 Pipe XY ↔ Pad XY (COMMON)
        '==================================================
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim padXY As WorkPlane = padOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim pipeXYp, padXYp As Object

        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        padOcc.CreateGeometryProxy(padXY, padXYp)
        cons.AddMateConstraint(pipeXYp, padXYp, 0)

        '==================================================
        ' 2️⃣ Pipe YZ ↔ Pad YZ (COMMON)
        '==================================================
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim padYZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim pipeYZp, padYZp As Object

        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        padOcc.CreateGeometryProxy(padYZ, padYZp)
        cons.AddFlushConstraint(pipeYZp, padYZp, 0)

        '==================================================
        ' 3️⃣ CLIENT-SPECIFIC CONSTRAINT
        '==================================================
        If SelectedClient = "ARAMCO" OrElse isManway Then

            '----------------------------------
            ' ARAMCO → Flange Work Plane2 ↔ Pad XZ
            '----------------------------------
            Dim flangeOcc As ComponentOccurrence = Nothing

            For Each occ As ComponentOccurrence In nozAsm.ComponentDefinition.Occurrences

                If occ.Name.ToUpper().Contains("FLANGE") Then
                    flangeOcc = occ
                    Exit For
                End If

            Next

            If flangeOcc Is Nothing Then
                Throw New Exception("Flange occurrence not found.")
            End If


            Dim flangeWP2 As WorkPlane = Nothing

            For Each wp As WorkPlane In flangeOcc.Definition.WorkPlanes

                If wp.Name = "Work Plane2" Then
                    flangeWP2 = wp
                    Exit For
                End If

            Next

            If flangeWP2 Is Nothing Then
                Throw New Exception("Flange Work Plane2 not found.")
            End If


            Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")

            Dim flangeWP2p, padXZp As Object

            flangeOcc.CreateGeometryProxy(flangeWP2, flangeWP2p)
            padOcc.CreateGeometryProxy(padXZ, padXZp)

            cons.AddFlushConstraint(flangeWP2p, padXZp, 0)


        ElseIf SelectedClient = "ADNOC" Then

            '----------------------------------
            ' ADNOC → Pipe End_Plane ↔ Pad XZ
            '----------------------------------
            Dim pipeEndPlane As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("End_Plane")

            Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")

            Dim pipeEndPlaneP, padXZp As Object

            pipeOcc.CreateGeometryProxy(pipeEndPlane, pipeEndPlaneP)
            padOcc.CreateGeometryProxy(padXZ, padXZp)

            cons.AddMateConstraint(pipeEndPlaneP, padXZp, 0)

        ElseIf SelectedClient = "QATAR" Then

            '----------------------------------
            ' ADNOC → Pipe End_Plane ↔ Pad XZ
            '----------------------------------
            Dim pipeEndPlane As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("End_Plane")

            Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")

            Dim pipeEndPlaneP, padXZp As Object

            pipeOcc.CreateGeometryProxy(pipeEndPlane, pipeEndPlaneP)
            padOcc.CreateGeometryProxy(padXZ, padXZp)

            cons.AddMateConstraint(pipeEndPlaneP, padXZp, 0)

        End If



    End Sub

    Public Function GetShellAngle(x As Double, y As Double) As Double
        Return Math.Atan2(y, x) * 180.0 / Math.PI
    End Function

    Public Sub ConstrainNozzleToShell(asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, nozzleOcc As ComponentOccurrence, xMm As Double, yMm As Double,
                                 angleDeg As Double, nozzleName As String, SelectedClient As String, isManway As Boolean)

        Dim cons = asmDoc.ComponentDefinition.Constraints
        Dim xCm = xMm / 10.0
        Dim yCm = yMm / 10.0

        '=========================
        ' SHELL BASE PLANES
        '=========================
        Dim shellDef = shellOcc.Definition
        Dim shellXZ = shellDef.WorkPlanes.Item("XZ Plane")
        Dim shellXY = shellDef.WorkPlanes.Item("XY Plane")
        Dim shellYZ = shellDef.WorkPlanes.Item("YZ Plane")

        Dim shellXZp, shellXYp, shellYZp As Object
        shellOcc.CreateGeometryProxy(shellXZ, shellXZp)
        shellOcc.CreateGeometryProxy(shellXY, shellXYp)
        shellOcc.CreateGeometryProxy(shellYZ, shellYZp)

        '=========================
        ' NOZZLE BASE PLANES
        '=========================
        Dim nozDef = nozzleOcc.Definition
        Dim nozXY = nozDef.WorkPlanes.Item("XY Plane")
        Dim nozYZ = nozDef.WorkPlanes.Item("YZ Plane")

        Dim nozXYp, nozYZp As Object
        nozzleOcc.CreateGeometryProxy(nozXY, nozXYp)
        nozzleOcc.CreateGeometryProxy(nozYZ, nozYZp)

        '=========================
        ' PIPE OCCURRENCE (INSIDE NOZZLE)
        '=========================
        Dim pipeOcc As ComponentOccurrence = Nothing

        For Each occ As ComponentOccurrence In nozzleOcc.SubOccurrences
            If occ.Name.ToUpper().Contains("PIPE") Then
                pipeOcc = occ
                Exit For
            End If
        Next

        If pipeOcc Is Nothing Then
            Throw New Exception("Pipe not found inside nozzle assembly!")
        End If

        Dim pipeEndPlane = pipeOcc.Definition.WorkPlanes.Item("End_Plane")
        Dim pipeEndPlaneP As Object
        pipeOcc.CreateGeometryProxy(pipeEndPlane, pipeEndPlaneP)


        '=========================
        ' CLIENT SWITCH
        '=========================
        If SelectedClient = "ADNOC" AndAlso Not isManway Then

            '=========================================
            ' ADNOC CONSTRAINT STRATEGY
            '=========================================
            Dim compDefShell As PartComponentDefinition = CType(shellOcc.Definition.Document, PartDocument).ComponentDefinition

            Dim anglePlaneName = $"NZ_{nozzleName}_Angle"
            Dim perpPlaneName = $"NZ_{nozzleName}_Angle_Perp"

            Dim shellAnglePlane As WorkPlane = Nothing
            Dim shellPerpPlane As WorkPlane = Nothing

            For Each wp As WorkPlane In compDefShell.WorkPlanes

                If wp.Name.Equals(anglePlaneName,
                          StringComparison.OrdinalIgnoreCase) Then
                    shellAnglePlane = wp

                ElseIf wp.Name.Equals(perpPlaneName,
                              StringComparison.OrdinalIgnoreCase) Then
                    shellPerpPlane = wp
                End If

            Next

            If shellAnglePlane Is Nothing Then
                Throw New Exception($"{anglePlaneName} not found on shell!")
            End If

            If shellPerpPlane Is Nothing Then
                Throw New Exception($"{perpPlaneName} not found on shell!")
            End If


            Dim shellAnglePlaneP, shellPerpPlaneP As Object

            shellOcc.CreateGeometryProxy(shellAnglePlane, shellAnglePlaneP)
            shellOcc.CreateGeometryProxy(shellPerpPlane, shellPerpPlaneP)


            ' 1️⃣ Shell XZ ↔ Nozzle XY
            cons.AddFlushConstraint(shellXZp, nozXYp, xCm)

            ' 2️⃣ Shell Angle_Perp ↔ Pipe End Plane
            cons.AddFlushConstraint(shellPerpPlaneP, pipeEndPlaneP, 0)

            ' 3️⃣ Shell Angle ↔ Nozzle YZ
            cons.AddMateConstraint(shellAnglePlaneP, nozYZp, yCm)

        ElseIf SelectedClient = "QATAR" AndAlso Not isManway Then

            '=========================================
            ' ADNOC CONSTRAINT STRATEGY
            '=========================================
            Dim compDefShell As PartComponentDefinition = CType(shellOcc.Definition.Document, PartDocument).ComponentDefinition

            Dim anglePlaneName = $"NZ_{nozzleName}_Angle"
            Dim perpPlaneName = $"NZ_{nozzleName}_Angle_Perp"

            Dim shellAnglePlane As WorkPlane = Nothing
            Dim shellPerpPlane As WorkPlane = Nothing

            For Each wp As WorkPlane In compDefShell.WorkPlanes

                If wp.Name.Equals(anglePlaneName,
                              StringComparison.OrdinalIgnoreCase) Then
                    shellAnglePlane = wp

                ElseIf wp.Name.Equals(perpPlaneName,
                                  StringComparison.OrdinalIgnoreCase) Then
                    shellPerpPlane = wp
                End If

            Next

            If shellAnglePlane Is Nothing Then
                Throw New Exception($"{anglePlaneName} not found on shell!")
            End If

            If shellPerpPlane Is Nothing Then
                Throw New Exception($"{perpPlaneName} not found on shell!")
            End If


            Dim shellAnglePlaneP, shellPerpPlaneP As Object

            shellOcc.CreateGeometryProxy(shellAnglePlane, shellAnglePlaneP)
            shellOcc.CreateGeometryProxy(shellPerpPlane, shellPerpPlaneP)


            ' 1️⃣ Shell XZ ↔ Nozzle XY
            cons.AddFlushConstraint(shellXZp, nozXYp, xCm)

            ' 2️⃣ Shell Angle_Perp ↔ Pipe End Plane
            cons.AddFlushConstraint(shellPerpPlaneP, pipeEndPlaneP, 0)

            ' 3️⃣ Shell Angle ↔ Nozzle YZ
            cons.AddMateConstraint(shellAnglePlaneP, nozYZp, yCm)

        Else

            '=========================================
            ' ARAMCO CONSTRAINT STRATEGY (UNCHANGED)
            '=========================================

            Dim flangeOcc As ComponentOccurrence = Nothing

            For Each occ As ComponentOccurrence In nozzleOcc.SubOccurrences
                If occ.Name.ToUpper().Contains("FLANGE") Then
                    flangeOcc = occ
                    Exit For
                End If
            Next

            If flangeOcc Is Nothing Then
                Throw New Exception("Flange not found inside nozzle assembly!")
            End If

            Dim flangeWP2 = flangeOcc.Definition.WorkPlanes.Item("Work Plane2")
            Dim wp2Proxy As Object
            flangeOcc.CreateGeometryProxy(flangeWP2, wp2Proxy)
            Dim compDefShell As PartComponentDefinition = CType(shellOcc.Definition.Document, PartDocument).ComponentDefinition

            Dim mainName = $"NZ_{nozzleName}_Angle"
            Dim perpName = $"NZ_{nozzleName}_Angle_Perp"

            Dim angledPlane = FindOrCreatePlane(compDefShell, mainName)
            Dim angledPerp = FindOrCreatePlane(compDefShell, perpName)

            Dim angledPlaneP, angledPerpP As Object
            shellOcc.CreateGeometryProxy(angledPlane, angledPlaneP)
            shellOcc.CreateGeometryProxy(angledPerp, angledPerpP)

            ' 1️ Seating
            cons.AddMateConstraint(angledPerpP, wp2Proxy, 0)

            ' 2️ Vertical offset
            cons.AddMateConstraint(angledPlaneP, nozYZp, yCm)

            ' 3️ Rotation lock
            cons.AddFlushConstraint(shellXZp, nozXYp, xCm)

        End If

    End Sub

    Public Sub SetElbowDimensions(elbowOcc As ComponentOccurrence, pipeODmm As Double, pipeThkMm As Double, elbowAmm As Double)

        Dim partDoc As PartDocument = elbowOcc.Definition.Document
        Dim compDef As PartComponentDefinition = partDoc.ComponentDefinition
        Dim params As Parameters = compDef.Parameters

        ' Pipe outside diameter
        Try
            params.Item("OD").Expression = pipeODmm & " mm"
        Catch
        End Try

        ' Pipe thickness
        Try
            params.Item("T").Expression = pipeThkMm & " mm"
        Catch
        End Try

        ' Pipe inside diameter
        Try
            params.Item("ID").Expression = (pipeODmm - 2 * pipeThkMm) & " mm"
        Catch
        End Try

        ' Center-to-face distance (A)
        Try
            params.Item("A").Expression = elbowAmm & " mm"
        Catch
        End Try

        partDoc.Update()

    End Sub

