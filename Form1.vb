    Private previousBaseToTL As Double = 0

    Private Sub txt_LLA_Base_To_TL_TextChanged(sender As Object, e As EventArgs) Handles txt_LLA_Base_To_TL.TextChanged

        Dim newBaseToTL As Double
        Dim legLength As Double

        If Not Double.TryParse(txt_LLA_Base_To_TL.Text, newBaseToTL) Then Exit Sub
        If Not Double.TryParse(txt_LLA_Leg_Length.Text, legLength) Then Exit Sub

        'Calculate difference
        Dim diff As Double = newBaseToTL - previousBaseToTL

        'Update Leg Length
        txt_LLA_Leg_Length.Text = (legLength + diff).ToString()

        'Store new value
        previousBaseToTL = newBaseToTL

    End Sub

