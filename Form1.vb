    Private Sub CollectNozzleRowsForFinal(sourceGrid As DataGridView,
                                     nozzleRows As List(Of String()))

        For Each row As DataGridViewRow In sourceGrid.Rows

            If row.IsNewRow Then Continue For

            Dim tag As String = Convert.ToString(row.Cells(0).Value)
            If String.IsNullOrWhiteSpace(tag) Then Continue For

            nozzleRows.Add(New String() {
            Convert.ToString(row.Cells(0).Value),   ' MARK
            Convert.ToString(row.Cells(1).Value),   ' SERVICE
            Convert.ToString(row.Cells(2).Value),   ' QTY
            Convert.ToString(row.Cells(3).Value),   ' SIZE
            Convert.ToString(row.Cells(4).Value),   ' SCH
            Convert.ToString(row.Cells(5).Value),   ' THK
            NormalizeFlangeClass(Convert.ToString(row.Cells(6).Value)),  ' CLASS
            Convert.ToString(row.Cells(7).Value),   ' FLANGE TYPE
            Convert.ToString(row.Cells(9).Value),   ' RF PAD OD
            Convert.ToString(row.Cells(10).Value),  ' RF PAD THK
            Convert.ToString(row.Cells(11).Value)   ' REMARKS
        })

        Next

    End Sub

    Private Function GetNozzleSortKey(tag As String) As Tuple(Of Integer, Integer, String)

        tag = tag.ToUpper().Trim()

        Dim prefixRank As Integer = 99
        If tag.StartsWith("N") Then prefixRank = 1
        If tag.StartsWith("M") Then prefixRank = 2

        Dim numPart As String = ""
        Dim suffixPart As String = ""

        For i As Integer = 1 To tag.Length - 1
            Dim ch As Char = tag(i)

            If Char.IsDigit(ch) Then
                numPart &= ch
            Else
                suffixPart = tag.Substring(i)
                Exit For
            End If
        Next

        Dim nozzleNum As Integer = 0
        Integer.TryParse(numPart, nozzleNum)

        Return Tuple.Create(prefixRank, nozzleNum, suffixPart)

    End Function

    Public Shared Sub AddNozzleScheduleTableFromFinalDGV(oSheet As Inventor.Sheet, dgvFinal As DataGridView)

        '=========================================================
        ' STEP 1 — Connect Inventor
        '=========================================================
        Dim inv As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
        Dim oTG As Inventor.TransientGeometry = inv.TransientGeometry

        '=========================================================
        ' STEP 2 — Table Setup (14 Columns)
        '=========================================================
        Dim colno As Integer = 14
        Dim TableContents As New List(Of String)

        '=========================================================
        ' STEP 3 — Header Row (Same as Final Grid)
        '=========================================================
        TableContents.Add("NOZZLE MARK")
        TableContents.Add("SERVICE")
        TableContents.Add("QTY")
        TableContents.Add("SIZE NPS")
        TableContents.Add("NOZZLE SCH")
        TableContents.Add("NOZZLE THK")
        TableContents.Add("FLANGE CLASS")
        TableContents.Add("FLANGE TYPE")
        TableContents.Add("RF PAD OD")
        TableContents.Add("RF PAD THK")
        TableContents.Add("WELD SIZE A")
        TableContents.Add("WELD SIZE B")
        TableContents.Add("WELD SIZE C")
        TableContents.Add("REMARKS")


        '=========================================================
        ' STEP 4 — Read All Data Rows from Final DataGridView
        '=========================================================
        For Each row As DataGridViewRow In dgvFinal.Rows

            If row.IsNewRow Then Continue For

            Dim tag As String = Convert.ToString(row.Cells(0).Value)

            If String.IsNullOrWhiteSpace(tag) Then Continue For

            ' Add all 14 column values into TableContents
            For c As Integer = 0 To 13
                TableContents.Add(Convert.ToString(row.Cells(c).Value))
            Next

        Next


        '=========================================================
        ' STEP 5 — Delete Old Table if Exists
        '=========================================================
        For Each T As Inventor.CustomTable In oSheet.CustomTables
            If T.Title.Trim() = "NOZZLE SCHEDULE" Then
                T.Delete()
                Exit For
            End If
        Next


        '=========================================================
        ' STEP 6 — Insert Position (Bottom Left)
        '=========================================================
        Dim insertPt As Inventor.Point2d = oTG.CreatePoint2d(18.5, 10.05)

        '=========================================================
        ' STEP 7 — Column Widths for A2 Sheet
        '=========================================================
        Dim widths() As Double = {1.6, 4.5, 1.0, 1.0, 1.7, 1.7, 1.7, 1.7, 1.7, 1.7, 1.5, 1.5, 1.5, 2.2}

        '=========================================================
        ' STEP 8 — Create Custom Table
        '========================================================
        Dim nozTable As Inventor.CustomTable = oSheet.CustomTables.Add("NOZZLE SCHEDULE", insertPt,
                colno, TableContents.Count / colno, Enumerable.Repeat(" ", colno).ToArray(),
                TableContents.ToArray(), widths)

        nozTable.HeadingPlacement = HeadingPlacementEnum.kNoHeading
        nozTable.Style.TableDirection = TableDirectionEnum.kTopDownDirection

    End Sub

