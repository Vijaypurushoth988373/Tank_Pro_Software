            End If

            If gasketPath <> "" AndAlso IO.File.Exists(gasketPath) Then
                UpdateGasketParameters(invApp, gasketPath)
            End If

            If topCoverPath <> "" AndAlso IO.File.Exists(topCoverPath) Then
                UpdateTopPlateparameters(invApp, topCoverPath)
