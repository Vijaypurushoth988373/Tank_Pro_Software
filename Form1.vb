    Private Function SafeDouble(value As Object) As Double

        If value Is Nothing OrElse value Is DBNull.Value Then
            Return 0
        End If

        Dim txt As String = value.ToString.Trim()

        If txt = "" OrElse txt = "-" OrElse txt = "0" Then
            Return 0
        End If

        Dim result As Double

        If Double.TryParse(txt, result) Then
            Return result
        End If

        Return 0

    End Function

    Function FindPartInProject(projectRoot As String, searchPattern As String) As String

        Dim files As String() = Directory.GetFiles(projectRoot, searchPattern, SearchOption.AllDirectories)

        If files.Length = 0 Then
            Throw New FileNotFoundException("File not found with pattern: " & searchPattern)
        End If

        ' Return FIRST match (or apply additional filtering if needed)
        Return files(0)

    End Function

    Public Function GetNozzleComponentPaths(invApp As Inventor.Application, projectFolder As String, nozzleName As String, nps As String, remarks As String, isTopHead As Boolean, isBottomHead As Boolean,
    isManway As Boolean, xMm As Double, yMm As Double, Optional includePad As Boolean = True, Optional includeElbow As Boolean = False, Optional flangeClass As String = "150#") As Dictionary(Of String, String)


        Dim result As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)
        remarks = If(remarks, "").ToUpper().Trim()

        '==================================================
        ' ENSURE NOZZLES FOLDER EXISTS
        '==================================================
        Dim nozzleFolder As String = IO.Path.Combine(projectFolder, "Nozzles")

        If Not IO.Directory.Exists(nozzleFolder) Then
            IO.Directory.CreateDirectory(nozzleFolder)
        End If

        '==================================================
        ' GET COMMON FLANGE MASTER (USED FOR ALL FLANGES)
        '==================================================
        Dim flangeMaster As String = ResolveFlangeMaster_ByNPS(projectFolder, nps, flangeClass)

        If Not IO.File.Exists(flangeMaster) Then
            Throw New Exception($"❌ No flange found for NPS {nps} Class {flangeClass}")
        End If


        '==================================================
        ' ADNOC DIP PIPE STRUCTURE
        '==================================================
        If remarks.Contains("DIP PIPE") AndAlso SelectedClient = "ADNOC" Then

            Dim pipeMasterDip As String = IO.Path.Combine(projectFolder, "PIPE.ipt")
            Dim gasketMaster As String = IO.Path.Combine(projectFolder, "GASKET.ipt")

            If Not IO.File.Exists(pipeMasterDip) Then
                Throw New Exception("❌ Pipe master missing.")
            End If

            If Not IO.File.Exists(gasketMaster) Then
                Throw New Exception("❌ Gasket master missing.")
            End If


            '-------------------------------
            ' CREATE FLANGE1 / FLANGE2 / FLANGE3
            '-------------------------------
            For i As Integer = 1 To 3

                Dim flangePath = IO.Path.Combine(nozzleFolder, $"{nozzleName}_FLANGE{i}.ipt")
                If Not IO.File.Exists(flangePath) Then
                    IO.File.Copy(flangeMaster, flangePath, True)
                End If
                EnsureFlangeEndPlane(invApp, flangePath, nozzleName)
                result($"FLANGE{i}") = flangePath

            Next


            '-------------------------------
            ' CREATE PIPE1 / PIPE2
            '-------------------------------
            For i As Integer = 1 To 2

                Dim pipePath = IO.Path.Combine(nozzleFolder, $"{nozzleName}_PIPE{i}.ipt")
                If Not IO.File.Exists(pipePath) Then
                    IO.File.Copy(pipeMasterDip, pipePath, True)
                End If
                result($"PIPE{i}") = pipePath

            Next


            '-------------------------------
            ' CREATE GASKET
            '-------------------------------
            Dim gasketPath = IO.Path.Combine(nozzleFolder, $"{nozzleName}_GASKET.ipt")
            If Not IO.File.Exists(gasketPath) Then
                IO.File.Copy(gasketMaster, gasketPath, True)
            End If

            result("GASKET") = gasketPath


            '-------------------------------
            ' OPTIONAL RF PAD
            '-------------------------------
            If includePad Then

                Dim rfPadMaster = IO.Path.Combine(projectFolder, "RF_PAD_TOP_HEAD.ipt")

                If IO.File.Exists(rfPadMaster) Then

                    Dim padPath = IO.Path.Combine(nozzleFolder, $"{nozzleName}_RF_PAD.ipt")
                    If Not IO.File.Exists(padPath) Then
                        IO.File.Copy(rfPadMaster, padPath, True)
                    End If
                    result("PAD") = padPath

                End If

            End If

            Return result

        End If


        '==================================================
        ' STANDARD NOZZLE STRUCTURE (ARAMCO / NORMAL ADNOC)
        '==================================================

        Dim pipeMaster As String = If(isManway, IO.Path.Combine(projectFolder, "MW_PIPE.ipt"), IO.Path.Combine(projectFolder, "PIPE.ipt"))
        If Not IO.File.Exists(pipeMaster) Then
            Throw New Exception("❌ Pipe master missing.")
        End If

        Dim nozzlePipe = IO.Path.Combine(nozzleFolder, nozzleName & "_PIPE.ipt")

        If Not IO.File.Exists(nozzlePipe) Then
            IO.File.Copy(pipeMaster, nozzlePipe, True)
        End If

        result("PIPE") = nozzlePipe
        'SetPipeDimensions(pipeOcc, pipeODmm, pipeThkMm, pipeLengthMm)

        Dim nozzleFlange = IO.Path.Combine(nozzleFolder, nozzleName & "_FLANGE.ipt")
        If Not IO.File.Exists(nozzleFlange) Then
            IO.File.Copy(flangeMaster, nozzleFlange, True)
        End If
        EnsureFlangeEndPlane(invApp, nozzleFlange, nozzleName)
        result("FLANGE") = nozzleFlange

        '-------------------------------
        ' OPTIONAL ELBOW
        '-------------------------------
        If includeElbow AndAlso Not isManway Then

            Dim elbowMaster = IO.Path.Combine(projectFolder, "Elbow_90.ipt")
            If Not IO.File.Exists(elbowMaster) Then
                Throw New Exception("❌ Elbow master missing.")
            End If

            Dim elbowPath = IO.Path.Combine(nozzleFolder, nozzleName & "_ELBOW.ipt")
            If Not IO.File.Exists(elbowPath) Then
                IO.File.Copy(elbowMaster, elbowPath, True)
            End If

            result("ELBOW") = elbowPath

        End If


        '-------------------------------
        ' OPTIONAL RF PAD
        '-------------------------------
        If includePad Then

            Dim rfPadMaster As String = ""
            If isBottomHead Then
                rfPadMaster = ResolveBottomHeadRFPadMaster(projectFolder, xMm, yMm)
            ElseIf isTopHead Then
                rfPadMaster = IO.Path.Combine(projectFolder, "RF_PAD_TOP_HEAD.ipt")
            Else
                rfPadMaster = IO.Path.Combine(projectFolder, "RF_PAD_SHELL.ipt")
            End If

            If IO.File.Exists(rfPadMaster) Then

                Dim padPath = IO.Path.Combine(nozzleFolder, nozzleName & "_RF_PAD.ipt")
                If Not IO.File.Exists(padPath) Then
                    IO.File.Copy(rfPadMaster, padPath, True)
                End If
                result("PAD") = padPath
            End If

        End If

        Return result

    End Function

    Public Sub EnsureFlangeEndPlane(invApp As Inventor.Application, flangePath As String, nozzleName As String)

        '==================================================
        ' OPEN FLANGE PART DOCUMENT
        '==================================================
        Dim partDoc As PartDocument = CType(invApp.Documents.Open(flangePath, False), PartDocument)
        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

        '==================================================
        ' DYNAMIC PLANE NAME
        ' Example: N6A_End_Plane
        '==================================================
        Dim planeName As String = nozzleName & "_End_Plane"

        '==================================================
        ' REUSE IF ALREADY EXISTS (CLASS 150 CASE)
        '==================================================
        For Each wp As WorkPlane In partDef.WorkPlanes

            If wp.Name.Equals(planeName, StringComparison.OrdinalIgnoreCase) Then

                wp.Visible = False
                partDoc.Close(True)
                Exit Sub

            End If

        Next


        '==================================================
        ' CREATE TEMP OCCURRENCE CONTEXT
        ' (Required for GetFlangeThicknessCm)
        '==================================================
        Dim tempAsm As AssemblyDocument =
        CType(invApp.Documents.Add(DocumentTypeEnum.kAssemblyDocumentObject,
                                   ,
                                   False),
              AssemblyDocument)

        Dim asmDef = tempAsm.ComponentDefinition
        Dim tg = invApp.TransientGeometry

        Dim flangeOcc As ComponentOccurrence =
        asmDef.Occurrences.Add(flangePath,
                               tg.CreateMatrix())


        '==================================================
        ' GET FLANGE THICKNESS USING YOUR FUNCTION
        '==================================================
        Dim flangeThkCm As Double =
        GetFlangeThicknessCm(flangeOcc)

        tempAsm.Close(True)


        If flangeThkCm <= 0 Then
            Throw New Exception("❌ Invalid flange thickness detected.")
        End If


        '==================================================
        ' BASE PLANE = YZ PLANE
        '==================================================
        Dim yzPlane As WorkPlane =
        partDef.WorkPlanes.Item("YZ Plane")


        '==================================================
        ' CREATE OFFSET END PLANE
        '==================================================
        Dim endPlane As WorkPlane =
        partDef.WorkPlanes.AddByPlaneAndOffset(yzPlane,
                                               flangeThkCm)

        endPlane.Name = planeName
        endPlane.Visible = False


        '==================================================
        ' UPDATE + SAVE PART
        '==================================================
        partDoc.Update()
        partDoc.Save()
        partDoc.Close(True)

    End Sub

    Private Function ResolveFlangeMaster_ByNPS(projectFolder As String, npsRaw As String, flangeClass As String) As String

        '==================================================
        ' 1️⃣ CLEAN NPS TEXT
        ' Example:
        ' "2''" → "2"
        '==================================================
        Dim nps As String = npsRaw.Replace("'", "").Replace("""", "").Trim()
        If nps = "" Then
            Throw New Exception("❌ Invalid NPS value for flange")
        End If


        '==================================================
        ' 2️⃣ BUILD FILE NAME BASED ON CLASS
        '==================================================
        Dim flangeFileName As String
        Select Case flangeClass.Trim().ToUpper()
            Case "150", "150#"
                flangeFileName = $"FLANGE_{nps}_INCH.ipt"
            Case "300", "300#"
                flangeFileName = $"FLANGE_{nps}_INCH_CL300.ipt"
            Case Else
                Throw New Exception($"❌ Unsupported flange class: {flangeClass}")
        End Select

        '==================================================
        ' 3️⃣ VALIDATE FILE EXISTS
        '==================================================
        Dim flangeFullPath As String = IO.Path.Combine(projectFolder, flangeFileName)
        If Not IO.File.Exists(flangeFullPath) Then
            Throw New Exception($"❌ Flange file not found: {flangeFileName}")
        End If
        Return flangeFullPath

    End Function

    Public Sub BuildNozzleAssembly_EllipsoidalHead(invApp As Inventor.Application, nozAsm As AssemblyDocument, pipePath As String, flangePath As String, Optional padPath As String = "",
    Optional nozzleName As String = "", Optional xMm As Double = 0, Optional yMm As Double = 0, Optional outsideProjectionMm As Double = 0, Optional pipeODmm As Double = 0,
    Optional pipeThkMm As Double = 0, Optional pipeLengthMm As Double = 0, Optional rfPadODmm As Double = 0, Optional rfPadThkMm As Double = 0)

        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' 1️⃣ PIPE (MASTER COMPONENT)
        '==================================================
        Dim pipeOcc As ComponentOccurrence = asmDef.Occurrences.Add(pipePath, tg.CreateMatrix())
        pipeOcc.Name = nozzleName & "_PIPE"
        pipeOcc.Grounded = True

        ' 🔑 SET PIPE DIMENSIONS
        If pipeODmm > 0 AndAlso pipeThkMm > 0 AndAlso pipeLengthMm > 0 Then
            SetPipeDimensions(pipeOcc, pipeODmm, pipeThkMm, pipeLengthMm)
        End If

        ' Align pipe to sub-assembly origin
        ConstrainPipeToNozzleOriginPlanes(nozAsm, pipeOcc)

        '==================================================
        ' 2️⃣ FLANGE
        '==================================================
        Dim flangeOcc As ComponentOccurrence = asmDef.Occurrences.Add(flangePath, tg.CreateMatrix())
        flangeOcc.Name = nozzleName & "_FLANGE"

        ConstrainFlangeToPipe_EH(nozAsm, pipeOcc, flangeOcc, nozzleName)

        If outsideProjectionMm > 0 Then
            SetFlangeOutsideProjection(flangeOcc, outsideProjectionMm)
        End If

        '==================================================
        ' 3️⃣ RF PAD (BOTTOM HEAD)
        '==================================================
        If padPath <> "" Then

            Dim padOcc As ComponentOccurrence = asmDef.Occurrences.Add(padPath, tg.CreateMatrix())
            padOcc.Name = nozzleName & "_RF_PAD"

            ' 🔑 RF PAD PARAMETERS
            ' Pipe OD = RF Pad ID
            If rfPadODmm > 0 AndAlso rfPadThkMm > 0 Then
                SetRFPadParameters(padOcc, rfPadODmm, rfPadThkMm, pipeODmm, padDistXmm:=xMm, padDistYmm:=yMm)
            End If

            ' 🔁 Constraint logic (Diagonal vs Normal)
            If (xMm <> 0 AndAlso yMm <> 0) Then
                ConstrainPadToPipe_EH_Diagonal(nozAsm, pipeOcc, padOcc, flangeOcc)
            Else
                ConstrainPadToPipe_EH(nozAsm, pipeOcc, padOcc, flangeOcc)
            End If

            SetRFPadParameters_BottomHead(padOcc, rfPadODmm, rfPadThkMm, pipeODmm, xMm, yMm)

        End If

        '==================================================
        ' 4️⃣ MANWAY COVER (M1 ONLY)
        '==================================================
        If nozzleName.Equals("M1", StringComparison.OrdinalIgnoreCase) Then
            Dim coverFile As String = Directory.GetFiles(IO.Path.GetDirectoryName(pipePath), "PT_NO_15_COVER_PLATE_FOR_MANWAY.ipt", SearchOption.TopDirectoryOnly).FirstOrDefault()
            If Not String.IsNullOrEmpty(coverFile) Then
                Dim coverOcc As ComponentOccurrence = asmDef.Occurrences.Add(coverFile, tg.CreateMatrix())
                coverOcc.Name = nozzleName & "_COVER_PLATE"
                ConstrainCoverPlateToManway(nozAsm, pipeOcc, coverOcc)
            End If
        End If

        nozAsm.Update()

    End Sub

    Private Function GetParameterSafe(pDef As PartComponentDefinition, paramName As String) As Parameter

        ' 1️⃣ Try User Parameters
        For Each p As Parameter In pDef.Parameters.UserParameters
            If p.Name.Equals(paramName, StringComparison.OrdinalIgnoreCase) Then
                Return p
            End If
        Next

        ' 2️⃣ Try Model Parameters
        For Each p As Parameter In pDef.Parameters.ModelParameters
            If p.Name.Equals(paramName, StringComparison.OrdinalIgnoreCase) Then
                Return p
            End If
        Next

        Debug.Print($"⚠ Parameter not found (skipped): {paramName}")
        Return Nothing
    End Function

    ''' Sets a parameter's value if it exists; silently skips (logging via
    ''' GetParameterSafe) if it doesn't, instead of throwing.
    Private Sub SetParamSafe(pDef As PartComponentDefinition, paramName As String, value As Double)
        Dim p As Parameter = GetParameterSafe(pDef, paramName)
        If p IsNot Nothing Then p.Value = value
    End Sub

    Public Sub SetRFPadParameters(padOcc As ComponentOccurrence, rfPadODmm As Double, rfPadThkMm As Double, pipeODmm As Double, Optional padDistXmm As Double = 0, Optional padDistYmm As Double = 0)

        Dim pDef As PartComponentDefinition = CType(padOcc.Definition, PartComponentDefinition)

        '--------------------------------------------------
        ' RF PAD OD
        '--------------------------------------------------
        SetParamSafe(pDef, "PAD_OD", rfPadODmm / 10.0)

        '--------------------------------------------------
        ' RF PAD THICKNESS
        '--------------------------------------------------
        SetParamSafe(pDef, "PAD_THK", rfPadThkMm / 10.0)

        '--------------------------------------------------
        ' 🔑 RF PAD ID = PIPE OD
        '--------------------------------------------------
        SetParamSafe(pDef, "PAD_ID", pipeODmm / 10.0)

        '--------------------------------------------------
        ' 🔑 RF PAD ID = SHELL ID
        '--------------------------------------------------
        SetParamSafe(pDef, "ID", CDbl(txt_Shell_Inside_Dia.Text) / 10)

        '--------------------------------------------------
        ' 🔑 RF PAD ID = SHELL THK
        '--------------------------------------------------
        SetParamSafe(pDef, "THK", CDbl(txt_Shell_Nom_Thk.Text) / 10)

        '==================================================
        ' 🔑 BOTTOM HEAD ONLY PARAMETERS
        '==================================================
        If padDistXmm <> 0 Then
            SetParamSafe(pDef, "PAD_DIST_X", padDistXmm / 10.0)
        End If

        If padDistYmm <> 0 Then
            SetParamSafe(pDef, "PAD_DIST_Y", padDistYmm / 10.0)
        End If

    End Sub

    Sub ConstrainFlangeToPipe_EH(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, flangeOcc As ComponentOccurrence, nozzleName As String)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints

        Dim invApp As Inventor.Application = nozAsm.Parent

        '==================================================
        ' 1️⃣ Pipe XZ ↔ Flange End_Plane (FLUSH)
        '==================================================
        Dim pipeXZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim flangeEndPlane As WorkPlane = GetOrCreateFlangeEndPlane(invApp, flangeOcc, nozzleName)

        Dim pipeXZp, flangeEndPlaneP As Object
        pipeOcc.CreateGeometryProxy(pipeXZ, pipeXZp)
        flangeOcc.CreateGeometryProxy(flangeEndPlane, flangeEndPlaneP)

        cons.AddFlushConstraint(pipeXZp, flangeEndPlaneP, 0)

        '==================================================
        ' 2️⃣ Pipe YZ ↔ Flange XZ (FLUSH)
        '==================================================
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim flangeXZ As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim pipeYZp, flangeXZp As Object
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        flangeOcc.CreateGeometryProxy(flangeXZ, flangeXZp)

        cons.AddFlushConstraint(pipeYZp, flangeXZp, 0)

        '==================================================
        ' 3️⃣ Pipe XY ↔ Flange XY (MATE)
        '==================================================
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim flangeXY As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim pipeXYp, flangeXYp As Object
        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        flangeOcc.CreateGeometryProxy(flangeXY, flangeXYp)

        cons.AddMateConstraint(pipeXYp, flangeXYp, 0)

    End Sub

    Public Sub ConstrainPadToPipe_EH_Diagonal(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, padOcc As ComponentOccurrence, flangeOcc As ComponentOccurrence)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints

        '===========================
        ' PIPE & PAD PLANES
        '===========================
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")

        '===========================
        ' PAD CUSTOM PLANES
        '===========================
        Dim padWP6 As WorkPlane = Nothing
        Dim padCentre As WorkPlane = Nothing

        For Each wp As WorkPlane In padOcc.Definition.WorkPlanes
            If wp.Name.ToUpper().Contains("WORK PLANE6") Or wp.Name.ToUpper().Contains("PLANE6") Then
                padWP6 = wp
            End If
            If wp.Name.ToUpper().Contains("RF_PAD_CENTRE") Then
                padCentre = wp
            End If
        Next

        If padWP6 Is Nothing Then Throw New Exception("❌ RF PAD WorkPlane6 not found")
        If padCentre Is Nothing Then Throw New Exception("❌ RF_PAD_Centre not found")

        '===========================
        ' FLANGE PLANE
        '===========================
        Dim flangeWP2 As WorkPlane = Nothing
        For Each wp As WorkPlane In flangeOcc.Definition.WorkPlanes
            If wp.Name.ToUpper().Contains("WORK PLANE2") Then
                flangeWP2 = wp
                Exit For
            End If
        Next
        If flangeWP2 Is Nothing Then Throw New Exception("❌ Flange Work Plane2 not found")

        '===========================
        ' CREATE PROXIES
        '===========================
        Dim pipeXYp, pipeYZp, padWP6p, padCentreP, flangeWP2p, padXZp As Object

        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        padOcc.CreateGeometryProxy(padWP6, padWP6p)
        padOcc.CreateGeometryProxy(padCentre, padCentreP)
        padOcc.CreateGeometryProxy(padXZ, padXZp)
        flangeOcc.CreateGeometryProxy(flangeWP2, flangeWP2p)

        '===========================
        ' APPLY CONSTRAINTS
        '===========================

        ' 1️⃣ PIPE (XY) ↔ PAD WorkPlane6 → FLUSH
        cons.AddFlushConstraint(pipeXYp, padWP6p, 0)

        ' 2️⃣ PIPE (YZ) ↔ PAD RF_Pad_Centre → FLUSH
        cons.AddFlushConstraint(pipeYZp, padCentreP, 0)

        ' 3️⃣ FLANGE (WorkPlane2) ↔ PAD (XZ) → MATE
        cons.AddMateConstraint(flangeWP2p, padXZp, -5)

    End Sub

    Sub ConstrainPadToPipe_EH(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, padOcc As ComponentOccurrence, flangeOcc As ComponentOccurrence)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints

        '==================================================
        ' 1️⃣ Pipe XY ↔ Pad XY (FLUSH)
        '==================================================
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim padXY As WorkPlane = padOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim pipeXYp, padXYp As Object
        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        padOcc.CreateGeometryProxy(padXY, padXYp)

        cons.AddFlushConstraint(pipeXYp, padXYp, 0)

        '==================================================
        ' 2️⃣ Pipe YZ ↔ RF Pad RF_Pad_Centre (FLUSH)
        '==================================================
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim padCentrePlane As WorkPlane = padOcc.Definition.WorkPlanes.Item("RF_Pad_Centre")

        Dim pipeYZp, padCentreP As Object
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        padOcc.CreateGeometryProxy(padCentrePlane, padCentreP)

        cons.AddFlushConstraint(pipeYZp, padCentreP, 0)

        '==================================================
        ' 3️⃣ Flange Work Plane2 ↔ Pad XZ (MATE)
        '==================================================
        Dim flangeWP2 As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("Work Plane2")

        Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim flangeWP2p, padXZp As Object
        flangeOcc.CreateGeometryProxy(flangeWP2, flangeWP2p)
        padOcc.CreateGeometryProxy(padXZ, padXZp)

        cons.AddMateConstraint(flangeWP2p, padXZp, -5)

    End Sub

    Sub CreateShellNozzle_CircleCut(invApp As Inventor.Application, shellOcc As ComponentOccurrence, nozzleIndex As String, nozzleHeightMm As Double, nozzleDiaMm As Double, angleDeg As Double, OffsetDistMm As Double)

        '==================================================
        ' Units (mm → cm)
        '==================================================
        Dim heightCm As Double = nozzleHeightMm / 10.0
        Dim nozzleDiaCm As Double = nozzleDiaMm / 10.0
        Dim offsetCm As Double = OffsetDistMm / 10.0

        '==================================================
        ' Get shell part
        '==================================================
        Dim partDoc As PartDocument = CType(shellOcc.Definition.Document, PartDocument)
        Dim compDef As PartComponentDefinition = partDoc.ComponentDefinition
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' ASSIGN NAMED PARAMETERS
        '==================================================
        Dim params As Parameters = compDef.Parameters
        Dim paramDiaName As String = $"NZ_{nozzleIndex}_DIA"
        Dim paramHeightName As String = $"NZ_{nozzleIndex}_HEIGHT"
        Dim paramOffsetName As String = $"NZ_{nozzleIndex}_OFFSET_DIST"

        '----------------------------------------------
        ' CREATE / UPDATE DIA PARAMETER
        '----------------------------------------------
        Try
            params.Item(paramDiaName).Expression = $"{nozzleDiaCm} cm"
        Catch
            params.UserParameters.AddByExpression(paramDiaName, $"{nozzleDiaCm} cm", UnitsTypeEnum.kCentimeterLengthUnits)
        End Try

        '----------------------------------------------
        ' CREATE / UPDATE HEIGHT PARAMETER
        '----------------------------------------------
        Try
            params.Item(paramHeightName).Expression = $"{heightCm} cm"
        Catch
            params.UserParameters.AddByExpression(paramHeightName, $"{heightCm} cm", UnitsTypeEnum.kCentimeterLengthUnits)
        End Try

        '----------------------------------------------
        ' CREATE / UPDATE OFFSET PARAMETER
        '----------------------------------------------
        Try
            params.Item(paramOffsetName).Expression = $"{offsetCm} cm"
        Catch
            params.UserParameters.AddByExpression(paramOffsetName, $"{offsetCm} cm", UnitsTypeEnum.kCentimeterLengthUnits)
        End Try

        '==================================================
        ' 1️⃣ CREATE ANGLE-BASED WORK PLANES
        '==================================================
        Dim sketchPlane As WorkPlane
        Dim perpPlane As WorkPlane

        Dim wpMain As String = $"NZ_{nozzleIndex}_Angle"
        Dim wpPerp As String = $"NZ_{nozzleIndex}_Angle_Perp"

        Dim paramAngleMain As String = $"NZ_{nozzleIndex}_ANGLE"
        Dim paramAnglePerp As String = $"NZ_{nozzleIndex}_ANGLE_PERP"

        ' MAIN plane → drives NZ_{nozzleIndex}_ANGLE (negative sign convention)
        Dim mainPlane As WorkPlane = CreateAngledWorkPlane(compDef, nozzleIndex, -angleDeg, wpMain, paramAngleMain)

        ' PERP plane → drives NZ_{nozzleIndex}_ANGLE_PERP e.g. -(180+90) = -270
        perpPlane = CreateAngledWorkPlane(compDef, nozzleIndex, -(angleDeg + 90), wpPerp, paramAnglePerp)

        ' Use perpendicular plane for sketch
        sketchPlane = perpPlane

        ' Center position on sketch plane
        Dim centerPt As Point2d = tg.CreatePoint2d(heightCm, -offsetCm)

        '==================================================
        ' 2️⃣ REMOVE EXISTING FEATURE + ALL MATCHING SKETCHES
        '    Safe match: exact name OR exact name + numeric suffix
        '    e.g. "NZ_N1_Sketch", "NZ_N1_Sketch1", "NZ_N1_Sketch2"
        '    Will NOT match "NZ_N11A_Sketch" even though N11A starts with N1
        '==================================================
        Dim skName As String = $"NZ_{nozzleIndex}_Sketch"
        Dim cutName As String = $"NZ_{nozzleIndex}_Cut"

        ' Remove extrude feature first (must go before its sketch)
        For Each ef As ExtrudeFeature In compDef.Features.ExtrudeFeatures
            If ef.Name = cutName Then
                ef.Delete()
                Exit For
            End If
        Next

        ' Collect sketches to delete — never modify COM collection while iterating
        Dim sketchesToDelete As New List(Of PlanarSketch)

        For Each skCheck As PlanarSketch In compDef.Sketches

            Dim sketchName As String = skCheck.Name

            ' Case 1: exact match → "NZ_N1_Sketch"
            If String.Equals(sketchName, skName, StringComparison.OrdinalIgnoreCase) Then
                sketchesToDelete.Add(skCheck)
                Continue For
            End If

            ' Case 2: exact name + numeric suffix Inventor auto-appended
            '         → "NZ_N1_Sketch1", "NZ_N1_Sketch12", etc.
            '         Check: starts with skName AND the remainder is purely numeric
            If sketchName.StartsWith(skName, StringComparison.OrdinalIgnoreCase) Then
                Dim suffix As String = sketchName.Substring(skName.Length)
                If suffix.Length > 0 AndAlso suffix.All(Function(c) Char.IsDigit(c)) Then
                    sketchesToDelete.Add(skCheck)
                End If
            End If

        Next

        ' Delete collected sketches
        For Each skDel As PlanarSketch In sketchesToDelete
            Try
                skDel.Delete()
            Catch ex As Exception
                Debug.WriteLine($"Could not delete sketch '{skDel.Name}': {ex.Message}")
            End Try
        Next

        '==================================================
        ' 3️⃣ CREATE NEW SKETCH
        '==================================================
        Dim sk As PlanarSketch = compDef.Sketches.Add(sketchPlane)
        sk.Name = skName

        '==================================================
        ' 4️⃣ DRAW CIRCLE
        '==================================================
        Dim circ As SketchCircle = sk.SketchCircles.AddByCenterRadius(centerPt, nozzleDiaCm / 2.0)

        '==================================================
        ' 5️⃣ DIAMETER DIMENSION → paramDiaName
        '==================================================
        sk.DimensionConstraints.AddDiameter(
        circ,
        tg.CreatePoint2d(centerPt.X + nozzleDiaCm / 2.0, centerPt.Y)
    ).Parameter.Expression = paramDiaName

        '==================================================
        ' 6️⃣ HEIGHT DIMENSION → paramHeightName
        '    Distance from projected Center Point to circle center (horizontal)
        '==================================================
        sk.DimensionConstraints.AddTwoPointDistance(
        sk.AddByProjectingEntity(compDef.WorkPoints.Item("Center Point")),
        circ.CenterSketchPoint,
        DimensionOrientationEnum.kHorizontalDim,
        tg.CreatePoint2d(centerPt.X / 2.0, centerPt.Y - nozzleDiaCm)
    ).Parameter.Expression = paramHeightName

        '==================================================
        ' 7️⃣ OFFSET DIMENSION → paramOffsetName
        '    Distance from projected Center Point to circle center (vertical)
        '==================================================
        sk.DimensionConstraints.AddTwoPointDistance(
        sk.AddByProjectingEntity(compDef.WorkPoints.Item("Center Point")),
        circ.CenterSketchPoint,
        DimensionOrientationEnum.kVerticalDim,
        tg.CreatePoint2d(centerPt.X + nozzleDiaCm, centerPt.Y / 2.0)
    ).Parameter.Expression = paramOffsetName

        '==================================================
        ' 8️⃣ CREATE PROFILE AND CUT
        '==================================================
        Dim prof As Profile = sk.Profiles.AddForSolid()
        Dim cutDef = compDef.Features.ExtrudeFeatures.CreateExtrudeDefinition(prof, PartFeatureOperationEnum.kCutOperation)

        Dim a As Double = angleDeg Mod 360

        ' All cases currently use kNegativeExtentDirection
        ' Kept as Select Case for future per-angle direction control
        Select Case a
            Case 90, 180
                cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
            Case 0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75, 80, 85,
             95, 100, 105, 110, 115, 120, 125, 130, 135, 140, 145, 150, 155, 160,
             165, 170, 175, 185, 190, 195, 200, 205, 210, 215, 220, 225, 230, 235,
             240, 245, 250, 255, 260, 265, 270
                cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
            Case 275, 280, 285, 290, 295, 300, 305, 310, 315, 320, 325, 330, 335, 340,
             345, 350, 355
                cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
            Case Else
                cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kNegativeExtentDirection)
        End Select

        Dim cutFeat = compDef.Features.ExtrudeFeatures.Add(cutDef)
        cutFeat.Name = cutName

        partDoc.Update()

    End Sub

    Private Sub SetDefaultStiffenerHeadSelection()

        If DGV_Nozzle_Tab_Head.Rows.Count = 0 Then Exit Sub

        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For

            Dim nozzleMark As String = ""

            '👉 Read Nozzle Mark column
            If row.Cells("Nozzle_Mark").Value IsNot Nothing Then
                nozzleMark = row.Cells("Nozzle_Mark").Value.ToString().Trim().ToUpper()
            End If

            '👉 Check required nozzles
            If nozzleMark = "N1" OrElse
           nozzleMark = "N4" OrElse
           nozzleMark = "N5" OrElse
           nozzleMark = "N8" Then

                row.Cells("Stiffener_Head").Value = True

            Else
                row.Cells("Stiffener_Head").Value = False
            End If

        Next

    End Sub

    Public Sub BuildNozzleAssembly_Shell(invApp As Inventor.Application, nozAsm As AssemblyDocument, pipePath As String, flangePath As String, rfPadPath As String, elbowPath As String, includeElbow As Boolean, elbowAngleDeg As Double,
    SelectedClient As String, nozzleName As String, pipeODmm As Double, pipeThkMm As Double, pipeLengthMm As Double, outsideProjMm As Double, rfPadODmm As Double, rfPadThkMm As Double, nps As String, isManway As Boolean, includeMidPipe As Boolean, midPipeLengthMm As Double)

        Dim asmDef = nozAsm.ComponentDefinition
        Dim tg = invApp.TransientGeometry

        '================ PIPE =================
        Dim pipeOcc = asmDef.Occurrences.Add(pipePath, tg.CreateMatrix())
        pipeOcc.Name = nozzleName & "_PIPE"
        pipeOcc.Grounded = True

        SetPipeDimensions(pipeOcc, pipeODmm, pipeThkMm, pipeLengthMm)

        '================ ELBOW (ADNOC ONLY) =================
        Dim elbowOcc As ComponentOccurrence = Nothing

        If SelectedClient = "ADNOC" AndAlso includeElbow AndAlso Not isManway AndAlso IO.File.Exists(elbowPath) Then
            elbowOcc = asmDef.Occurrences.Add(elbowPath, tg.CreateMatrix())
            elbowOcc.Name = nozzleName & "_ELBOW"

            SetElbowDimensions(elbowOcc, pipeODmm, pipeThkMm, GetElbowAmm(nps))
            ConstrainElbowToPipe_ADNOC(nozAsm, pipeOcc, elbowOcc, elbowAngleDeg)

        End If

        If SelectedClient = "QATAR" AndAlso includeElbow AndAlso Not isManway AndAlso IO.File.Exists(elbowPath) Then
            elbowOcc = asmDef.Occurrences.Add(elbowPath, tg.CreateMatrix())
            elbowOcc.Name = nozzleName & "_ELBOW"

            SetElbowDimensions(elbowOcc, pipeODmm, pipeThkMm, GetElbowAmm(nps))
            ConstrainElbowToPipe_ADNOC(nozAsm, pipeOcc, elbowOcc, elbowAngleDeg)

        End If

        '================ INTERMEDIATE PIPE =================
        Dim midPipeOcc As ComponentOccurrence = Nothing

        If elbowOcc IsNot Nothing AndAlso includeMidPipe AndAlso midPipeLengthMm > 0 Then

            ' 🔑 Create independent pipe copy
            Dim midPipePath As String = CreateMidPipeCopy(pipePath, IO.Path.GetDirectoryName(pipePath), nozzleName)
            midPipeOcc = asmDef.Occurrences.Add(midPipePath, tg.CreateMatrix())
            midPipeOcc.Name = nozzleName & "_MID_PIPE"
            midPipeOcc.Grounded = False

            SetPipeDimensions(midPipeOcc, pipeODmm, pipeThkMm, midPipeLengthMm)

            ' Elbow → MidPipe constraint
            ConstrainMidPipeToElbow_ADNOC(nozAsm, elbowOcc, midPipeOcc)
        End If


        '================ FLANGE =================
        Dim flangeOcc = asmDef.Occurrences.Add(flangePath, tg.CreateMatrix())
        flangeOcc.Name = nozzleName & "_FLANGE"

        If midPipeOcc IsNot Nothing Then

            ' MidPipe → Flange
            ConstrainFlangeToMidPipe_Shell(nozAsm, midPipeOcc, flangeOcc, nozzleName)

        ElseIf elbowOcc IsNot Nothing Then

            ' Elbow → Flange
            ConstrainFlangeToElbow_ADNOC(nozAsm, elbowOcc, flangeOcc)
        Else

            ' Pipe → Flange
            ConstrainFlangeToPipe_Shell(nozAsm, pipeOcc, flangeOcc, nozzleName)

        End If

        SetFlangeOutsideProjection(flangeOcc, outsideProjMm)

        '================ RF PAD =================
        If rfPadPath <> "" Then

            Dim padOcc = asmDef.Occurrences.Add(rfPadPath, tg.CreateMatrix())
            padOcc.Name = nozzleName & "_RF_PAD"

            SetRFPadParameters(padOcc, rfPadODmm, rfPadThkMm, pipeODmm)
            ConstrainPadToPipe_Shell(nozAsm, pipeOcc, padOcc, isManway)

        End If

        nozAsm.Update()

    End Sub

    Public Sub ConstrainFlangeToMidPipe_Shell(nozAsm As AssemblyDocument, midPipeOcc As ComponentOccurrence, flangeOcc As ComponentOccurrence, nozzleName As String)

        Dim cons = nozAsm.ComponentDefinition.Constraints

        '==============================
        ' MID PIPE REFERENCES
        '==============================
        Dim pipeXZ = midPipeOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim pipeXY = midPipeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim pipeYZ = midPipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim pipeXZp, pipeXYp, pipeYZp As Object

        midPipeOcc.CreateGeometryProxy(pipeXZ, pipeXZp)
        midPipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        midPipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)

        '==============================
        ' FLANGE REFERENCES
        '==============================
        Dim flangeEndPlane As WorkPlane = Nothing

        ' Dynamic plane like: N6A_End_Plane
        For Each wp As WorkPlane In flangeOcc.Definition.WorkPlanes
            If wp.Name.ToUpper().Contains("_END_PLANE") Then
                flangeEndPlane = wp
                Exit For
            End If
        Next

        If flangeEndPlane Is Nothing Then
            Throw New Exception("Dynamic flange End_Plane not found.")
        End If

        Dim flangeXY = flangeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim flangeXZ = flangeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim flangeEndPlanep, flangeXYp, flangeXZp As Object

        flangeOcc.CreateGeometryProxy(flangeEndPlane, flangeEndPlanep)
        flangeOcc.CreateGeometryProxy(flangeXY, flangeXYp)
        flangeOcc.CreateGeometryProxy(flangeXZ, flangeXZp)

        '==============================
        ' APPLY CONSTRAINTS
        '==============================
        ' 1️ MID PIPE XZ ↔ FLANGE End_Plane → FLUSH
        cons.AddFlushConstraint(pipeXZp, flangeEndPlanep, 0)
        ' 2️ MID PIPE XY ↔ FLANGE XY → FLUSH
        cons.AddFlushConstraint(pipeXYp, flangeXYp, 0)
        ' 3️ MID PIPE YZ ↔ FLANGE XZ → MATE
        cons.AddMateConstraint(pipeYZp, flangeXZp, 0)

    End Sub

    Public Sub ConstrainMidPipeToElbow_ADNOC(nozAsm As AssemblyDocument, elbowOcc As ComponentOccurrence, midPipeOcc As ComponentOccurrence)

        Dim cons = nozAsm.ComponentDefinition.Constraints

        '==============================
        ' ELBOW REFERENCES
        '==============================
        Dim elbowBottom = elbowOcc.Definition.WorkPlanes.Item("Bottom_End")
        Dim elbowAxis2 = elbowOcc.Definition.WorkAxes.Item("Work Axis2")
        Dim elbowYZ = elbowOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim elbowBottomP, elbowAxis2P, elbowYZP As Object

        elbowOcc.CreateGeometryProxy(elbowBottom, elbowBottomP)
        elbowOcc.CreateGeometryProxy(elbowAxis2, elbowAxis2P)
        elbowOcc.CreateGeometryProxy(elbowYZ, elbowYZP)

        '==============================
        ' MID PIPE REFERENCES
        '==============================
        Dim pipeEndPlane = midPipeOcc.Definition.WorkPlanes.Item("End_Plane")
        Dim pipeYAxis = midPipeOcc.Definition.WorkAxes.Item("Y Axis")
        Dim pipeYZ = midPipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim pipeEndPlaneP, pipeYAxisP, pipeYZP As Object

        midPipeOcc.CreateGeometryProxy(pipeEndPlane, pipeEndPlaneP)
        midPipeOcc.CreateGeometryProxy(pipeYAxis, pipeYAxisP)
        midPipeOcc.CreateGeometryProxy(pipeYZ, pipeYZP)

        '==============================
