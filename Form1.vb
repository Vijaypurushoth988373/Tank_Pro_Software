    Private Sub UpdateSkirtSupportParts(invApp As Inventor.Application, folderPath As String)

        Try

            '===============================
            ' SKIRT
            '===============================
            Dim skirtPath As String = ""

            If Rbn_SS_Type_1.Checked Then
                skirtPath = IO.Path.Combine(folderPath, "Skirt - 1\Skirt_Type_1.ipt")

            ElseIf Rbn_SS_Type_2.Checked Then
                skirtPath = IO.Path.Combine(folderPath, "Skirt - 2\Skirt_Type_2.ipt")

            ElseIf Rbn_SS_Type_3.Checked Then
                skirtPath = IO.Path.Combine(folderPath, "Skirt - 3\Skirt_Type_3.ipt")

            ElseIf Rbn_SS_Type_4.Checked Then
                skirtPath = IO.Path.Combine(folderPath, "Skirt - 4\Skirt_Type_4.ipt")
            End If

            If IO.File.Exists(skirtPath) Then
                UpdateSkirtParameters(invApp, skirtPath)
            End If


            '===============================
            ' BASE PLATE
            '===============================
            Dim basePlatePath As String = skirtPath.Replace("Skirt_Type", "Base_Plate_Type")

            If IO.File.Exists(basePlatePath) Then
                UpdateSkirtBasePlateParameters(invApp, basePlatePath)
            End If


            '===============================
            ' GUSSET PLATE 1
            '===============================
            Dim gussetPath1 As String = skirtPath.Replace("Skirt_Type", "Support_plate_Type")

            If IO.File.Exists(gussetPath1) Then
                UpdateSkirtGussetPlateParameters(invApp, gussetPath1)
            End If


            '===============================
            ' GUSSET PLATE 2
            '===============================
            Dim gussetPath2 As String = skirtPath.Replace("Skirt_Type", "Support_plate_1_Type")

            If IO.File.Exists(gussetPath2) Then
                UpdateSkirtGussetPlateParameters(invApp, gussetPath2)
            End If


            '===============================
            ' ANCHOR LUG
            '===============================
            Dim anchorPath As String = skirtPath.Replace("Skirt_Type", "Anchor_Lug_Type")

            If IO.File.Exists(anchorPath) Then
                UpdateSkirtAnchorLugParameters(invApp, anchorPath)
            End If


        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try

    End Sub

