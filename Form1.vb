                missingFiles.Add("Ellipsoidal Head")
            End If

            If shellPath = "" OrElse Not IO.File.Exists(shellPath) Then
                missingFiles.Add("Shell Plate")
            End If


            If SelectedClient = "ARAMCO" Then

                If curbPath = "" OrElse Not IO.File.Exists(curbPath) Then
                    missingFiles.Add("Curb Angle")
                End If

                If topCoverPath = "" OrElse Not IO.File.Exists(topCoverPath) Then
                    missingFiles.Add("Top Cover Plate")
                End If


            ElseIf SelectedClient = "ADNOC" Then

                If ringFlangePath = "" OrElse Not IO.File.Exists(ringFlangePath) Then
                    missingFiles.Add("Ring Flange")
                End If

                If gasketPath = "" OrElse Not IO.File.Exists(gasketPath) Then
                    missingFiles.Add("Gasket")
                End If

                If topCoverPath = "" OrElse Not IO.File.Exists(topCoverPath) Then
                    missingFiles.Add("Top Cover Plate")
                End If

            ElseIf SelectedClient = "QATAR" Then

                If ringFlangePath = "" OrElse Not IO.File.Exists(ringFlangePath) Then
                    missingFiles.Add("Ring Flange")
                End If

                If gasketPath = "" OrElse Not IO.File.Exists(gasketPath) Then
                    missingFiles.Add("Gasket")
                End If

                If topCoverPath = "" OrElse Not IO.File.Exists(topCoverPath) Then
                    missingFiles.Add("Top Cover Plate")
                End If

            End If

        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try

        '==================================================
        ' F) Place Ellipsoidal Head (SAFE – WILL NOT STOP)
        '==================================================
        Dim headOcc As ComponentOccurrence = Nothing

        '------------------------------------------
        ' Place Ellipsoidal Head
        '------------------------------------------
        Try
            If asmDoc IsNot Nothing AndAlso headPath <> "" AndAlso IO.File.Exists(headPath) Then
                headOcc = PlaceEllipsoidalHead(invApp, asmDoc, headPath)
            End If
        Catch ex As Exception
            headOcc = Nothing
        End Try

        '------------------------------------------
        ' Constrain to origin planes
        '------------------------------------------
        Try
            If asmDoc IsNot Nothing AndAlso headOcc IsNot Nothing Then
                ConstrainToOriginPlanes(asmDoc, headOcc)
            End If
        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try


        '==================================================
        ' G) Place Shell (SAFE – WILL NOT STOP)
        '==================================================
        Dim shellOcc As ComponentOccurrence = Nothing

        Try
            If asmDoc IsNot Nothing AndAlso shellPath <> "" AndAlso IO.File.Exists(shellPath) Then
                shellOcc = PlaceAndAssembleShell(invApp, asmDoc, headOcc, shellPath, 0)
            End If
        Catch ex As Exception
            shellOcc = Nothing
            Debug.WriteLine(ex.Message)
        End Try

        Dim shellLength As Double = 0.0

        '------------------------------------------
        ' Read Shell Length safely
        '------------------------------------------
        Try
            Double.TryParse(txt_Shell_Length.Text, shellLength)
        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try

        '=============================================
        ' PLACEMENT IS BASED UPON COMBOBOX SELECTION"
        '=============================================

        If RB_RT_BF.Checked Then

            ' No Dim here — already declared at top of Sub
            bodyFlangeOcc = Nothing
            gasketBFOcc = Nothing
            blindFlangeOcc = Nothing

            '==========================================================
            ' RB_RT_BF MODE — Place Body Flange / Gasket / Blind Flange
            '==========================================================
            Try
                If asmDoc IsNot Nothing AndAlso Not String.IsNullOrWhiteSpace(bodyFlangePath) AndAlso IO.File.Exists(bodyFlangePath) AndAlso
           Not String.IsNullOrWhiteSpace(blindFlangePath) AndAlso IO.File.Exists(blindFlangePath) AndAlso Not String.IsNullOrWhiteSpace(gasketBFPath) AndAlso IO.File.Exists(gasketBFPath) Then
                    PlaceBodyFlangeComponents(invApp, asmDoc, bodyFlangePath, blindFlangePath, gasketBFPath, bodyFlangeOcc, gasketBFOcc, blindFlangeOcc)
                    ConstrainBodyFlangeComponents(invApp, asmDoc, bodyFlangeOcc, gasketBFOcc, blindFlangeOcc, shellOcc)
                End If
            Catch ex As Exception
                MessageBox.Show("❌ Body Flange placement failed: " & ex.Message, "RB/RT Body Flange")
            End Try

            ' TODO: ConstrainBodyFlangeComponents(...) goes here next

        Else

            '==================================================
            ' STANDARD MODE — Top Cover / Curb Angle / Ring Flange
            '==================================================
            If SelectedClient = "ARAMCO" Then

                Try
                    If asmDoc IsNot Nothing AndAlso curbPath <> "" AndAlso IO.File.Exists(curbPath) Then
                        PlaceAndAssembleCurbAngle(invApp, asmDoc, curbPath, shellLength)
                    End If
                Catch ex As Exception
                    Debug.WriteLine(ex.Message)
                End Try

                Dim stiffPath As String = IO.Path.Combine(folderPath, "TANK_SHELL_PLATE_BASE_TEST.ipt")
                Call Stiffener_Parameters(invApp, stiffPath)

                topCoverOcc = PlaceTopCoverPlate(invApp, asmDoc, topCoverPath)
                Dim topCoverStiffOcc As ComponentOccurrence = Nothing

                Try
                    topCoverStiffOcc = PlaceAndConstrainTopCoverStiffener(invApp, asmDoc, topCoverOcc, folderPath)
                    topCoverStiffOcc.Name = "TOP_COVER_STIFFENER"
                Catch ex As Exception
                    MessageBox.Show("Stiffener failed: " & ex.Message)
                End Try

                For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows
                    If row.IsNewRow Then Continue For

                    Dim remarks As String = ""
                    If row.Cells("REMARKS").Value IsNot Nothing Then
                        remarks = row.Cells("REMARKS").Value.ToString().Trim().ToUpper()
                    End If

                    If remarks.Contains("DIP PIPE") Then
                        Dim dipAngleDeg As Double = 0
                        If row.Cells("ANGLE_DEG").Value IsNot Nothing Then
                            dipAngleDeg = CDbl(row.Cells("ANGLE_DEG").Value)
                        Else
                            Throw New Exception("❌ DIP PIPE nozzle requires ANGLE_DEG value")
                        End If
                        CreateTopCoverAngledPlane(invApp, topCoverOcc, dipAngleDeg,
                    "TOP_COVER_PLANE_" & dipAngleDeg.ToString("0"))
                    End If
                Next

                FlushTopCoverPlate_UsingPlanes(asmDoc, topCoverOcc,
            CDbl(txt_Shell_Length.Text) + CDbl(txt_CA_Length.Text))

            ElseIf SelectedClient = "ADNOC" Then

                Dim ringFlangeOcc As ComponentOccurrence = Nothing
                Dim gasketOcc As ComponentOccurrence = Nothing

                Try
                    If asmDoc IsNot Nothing AndAlso ringFlangePath <> "" AndAlso
               IO.File.Exists(ringFlangePath) Then
                        ringFlangeOcc = PlaceAndConstrainRingFlange(invApp, asmDoc, shellOcc, ringFlangePath)
