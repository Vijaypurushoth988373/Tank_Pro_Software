    Public Function GetPipeSupportCopyByNozzle(folderPath As String, nozzleName As String) As String

        '==================================================
        ' CREATE PIPE SUPPORT FOLDER
        '==================================================
        Dim supportFolder As String = IO.Path.Combine(folderPath, "PipeSupports")
        If Not IO.Directory.Exists(supportFolder) Then
            IO.Directory.CreateDirectory(supportFolder)
        End If

        '==================================================
        ' MASTER SUPPORT FILE
        '==================================================
        Dim masterPath As String = IO.Path.Combine(folderPath, "NEW_PIPE_SUPPORT.iam")
        If Not IO.File.Exists(masterPath) Then
            Throw New Exception("Master Pipe Support file missing.")
        End If

        '==================================================
        ' NEW SUPPORT FILE NAME (BASED ON NOZZLE)
        '==================================================
        Dim supportPath As String = IO.Path.Combine(supportFolder, $"PIPE_SUPPORT_{nozzleName}.iam")

        '==================================================
        ' COPY ONLY IF NOT EXISTS
        '==================================================
        If Not IO.File.Exists(supportPath) Then
            IO.File.Copy(masterPath, supportPath, True)
        End If

        Return supportPath

    End Function

