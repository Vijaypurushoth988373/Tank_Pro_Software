    Private Function GetProjectFolderFromEHInsideDia(invApp As Inventor.Application) As String

        Dim dia As Double
        If Not Double.TryParse(txt_EH_Inside_Dia.Text, dia) Then
            Return String.Empty
        End If

        Dim baseProjectsPath As String = GetInventorProjectsRoot(invApp)
        If String.IsNullOrWhiteSpace(baseProjectsPath) Then
            Return String.Empty
        End If

        Dim projectFolderName As String = ""

        Select Case dia
            Case 900 To 1500
                projectFolderName = "CD.24.12_3D_Model - 1200"

            Case 1501 To 2200
                projectFolderName = "CD.24.12_3D_Model - 1900"

            Case 2201 To 3000
                projectFolderName = "CD.24.12_3D_Model - 2800"

            Case Else
                Return String.Empty
        End Select

        Dim fullProjectPath As String =
        IO.Path.Combine(baseProjectsPath, projectFolderName)

        ' Absolute safety check
        If IO.Directory.Exists(fullProjectPath) Then
            Return fullProjectPath
        End If

        Return String.Empty

    End Function

