                End Try

                Try
                    If asmDoc IsNot Nothing AndAlso topCoverPath <> "" AndAlso
               IO.File.Exists(topCoverPath) Then
                        topCoverOcc = PlaceandConstrainTopCoverPlateAdnoc(invApp, asmDoc, shellOcc,
                                                                   gasketOcc, topCoverPath)
                    End If
                Catch ex As Exception
                    Debug.WriteLine(ex.Message)
                End Try

            End If

        End If


        '==================================================
        ' LIFTING LUG ANGLES (SAFE)
        '==================================================
        Dim angle1 As Double = 0.0
        Dim angle2 As Double = 0.0

        Try
            Double.TryParse(txt_LL_Ang.Text, angle1)
            angle2 = (angle1 + 90.0) Mod 360.0
        Catch ex As Exception
            angle1 = 0.0
            angle2 = 90.0
        End Try

        '==================================================
        ' LEG SUPPORT ANGLES (SAFE)
        '==================================================
        Dim angle_LS_1 As Double = 0.0
        Dim angle_LS_2 As Double = 0.0

        Try
            Double.TryParse(txt_LSA_Angle.Text, angle_LS_1)
            angle_LS_2 = (angle_LS_1 + 90.0) Mod 360.0
        Catch ex As Exception
