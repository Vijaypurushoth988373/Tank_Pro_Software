    Private Function OpenMainAssembly(invApp As Inventor.Application, projectFolder As String, legType As String) As Inventor.AssemblyDocument

        If invApp Is Nothing Then Return Nothing
        If String.IsNullOrWhiteSpace(projectFolder) Then Return Nothing

        Dim fileName As String = If(legType.ToUpper() = "BEAM", "Main_Assembly_.iam", "Main_Assembly.iam")
        Dim asmPath As String = IO.Path.Combine(projectFolder, fileName)

        If Not IO.File.Exists(asmPath) Then Return Nothing
        Return CType(invApp.Documents.Open(asmPath, True), Inventor.AssemblyDocument)

    End Function

    Public Function PrepareInventorProjectAndAssembly(invApp As Inventor.Application) As Inventor.AssemblyDocument

        If invApp Is Nothing Then Return Nothing
        Dim projectFolder As String = GetProjectFolderFromEHInsideDia(invApp)

        If String.IsNullOrWhiteSpace(projectFolder) Then
            Return Nothing
        End If

        Dim legType As String = ""

        If Rbn_Angle.Checked Then
            legType = "ANGLE"
        ElseIf Rbn_Beam.Checked Then
            legType = "BEAM"
        Else
            MessageBox.Show("Select Leg Type")
        End If

        'ActivateInventorProjectByFolder(invApp, projectFolder)
        Return OpenMainAssembly(invApp, projectFolder, legType)

    End Function

