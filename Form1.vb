                        '--------------------------------------
                        'Dim ipjPath As String = "D:\Projects\Inventor\CD.24.12_3D_Model - Test\CD.24.012.007_Test.ipj"
                        'Dim ipjPath As String = "Z:\Projects\Inventor\CD.24.12_3D_Model - Test\CD.24.012.007_Test.ipj"
