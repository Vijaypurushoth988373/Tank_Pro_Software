    Public Function GetPipeDim_BySizeAndSchedule(pipeTable As List(Of PipeDim), nps As String, schedule As String) As PipeDim

        Dim result As PipeDim = pipeTable.FirstOrDefault(Function(p) _
        p.ND.Trim().ToUpper() = nps.Trim().ToUpper() AndAlso
        p.SCH.Trim().ToUpper() = schedule.Trim().ToUpper()
    )

        If result Is Nothing Then
            Throw New Exception("Pipe size " & nps & " with schedule " & schedule & " not found in pipe table")
        End If

        Return result

    End Function

    Public Class NozzleComponentPaths
        Public PipePath As String
        Public FlangePath As String
        Public RFPadPath As String
    End Class

    Public Function PrepareNozzleComponentFiles(projectFolder As String, nozzleName As String, flangeSizeInch As String, includeRFPad As Boolean) As NozzleComponentPaths

        Dim res As New NozzleComponentPaths()

        Dim pipeSrc = IO.Path.Combine(projectFolder, "PIPE.ipt")
        Dim flangeSrc = IO.Path.Combine(projectFolder, $"FLANGE_{flangeSizeInch}_INCH.ipt")
        Dim padSrc = IO.Path.Combine(projectFolder, "RF_PAD_SHELL.ipt")

        Dim pipeDst = IO.Path.Combine(projectFolder, $"{nozzleName}_PIPE.ipt")
        Dim flangeDst = IO.Path.Combine(projectFolder, $"{nozzleName}_FLANGE.ipt")
        Dim padDst = IO.Path.Combine(projectFolder, $"{nozzleName}_RF_PAD.ipt")

        SafeCopy(pipeSrc, pipeDst)
        SafeCopy(flangeSrc, flangeDst)

        res.PipePath = pipeDst
        res.FlangePath = flangeDst

        If includeRFPad Then
            SafeCopy(padSrc, padDst)
            res.RFPadPath = padDst
        Else
            res.RFPadPath = ""
        End If

        Return res
    End Function

    Private Sub SafeCopy(src As String, dst As String)
        If IO.File.Exists(dst) Then IO.File.Delete(dst)
        IO.File.Copy(src, dst)
    End Sub

#End Region

    Private Function DegToRad(deg As Double) As Double
        Return deg * Math.PI / 180.0
    End Function

    Sub CreateNozzleCut(invApp As Inventor.Application, topCoverOcc As ComponentOccurrence, nozzleName As String, cutDiaMm As Double, radiusMm As Double, angleDeg As Double, sketchPlaneName As String)   ' ← added

        '--------------------------------------------------
        ' Safety
        '--------------------------------------------------
        If topCoverOcc Is Nothing Then
            Throw New Exception("Top cover occurrence is Nothing")
        End If

        If Not TypeOf topCoverOcc.Definition.Document Is PartDocument Then
            Throw New Exception("Top cover is not a PartDocument")
        End If

        '--------------------------------------------------
        ' Unit conversion (mm → cm)
        '--------------------------------------------------
        Dim cutDiaCm As Double = cutDiaMm / 10.0
        Dim radiusCm As Double = radiusMm / 10.0

        '--------------------------------------------------
        ' Angle handling (XZ plane reference)
        ' 0° = +Z direction
        '--------------------------------------------------
        Dim angRad As Double
        Dim x As Double
        Dim z As Double

        If RB_RT_BF.Checked Then
            angRad = angleDeg * Math.PI / 180.0
            x = radiusCm * Math.Sin(angRad)   ' negated → right at 90°
            z = -radiusCm * Math.Cos(angRad)   ' negated → up at 0°
        Else
            angRad = (angleDeg + 90.0) * Math.PI / 180.0
            x = radiusCm * Math.Cos(angRad)
            z = -radiusCm * Math.Sin(angRad)
        End If


        '--------------------------------------------------
        ' Get part definition
        '--------------------------------------------------
        Dim partDoc As PartDocument = CType(topCoverOcc.Definition.Document, PartDocument)
        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

        '--------------------------------------------------
        ' Sketch Plane
        '--------------------------------------------------
        Dim xzPlane As WorkPlane = partDef.WorkPlanes.Item(sketchPlaneName)   ' ← changed

        '--------------------------------------------------
        ' Names
        '--------------------------------------------------
        Dim sketchName As String = nozzleName & "_Sketch"
        Dim cutName As String = nozzleName & "_Cut"

        '--------------------------------------------------
        ' 1️⃣ DELETE EXISTING CUT
        '--------------------------------------------------
        For Each feat As ExtrudeFeature In partDef.Features.ExtrudeFeatures
            If feat.Name = cutName Then
                feat.Delete()
                Exit For
            End If
        Next

        '--------------------------------------------------
        ' 2️⃣ DELETE EXISTING SKETCH
        '--------------------------------------------------
        For Each sk As PlanarSketch In partDef.Sketches
            If sk.Name = sketchName Then
                sk.Delete()
                Exit For
            End If
        Next

        '--------------------------------------------------
        ' 3️⃣ CREATE FRESH SKETCH
        '--------------------------------------------------
        Dim sketch As PlanarSketch = partDef.Sketches.Add(xzPlane)
        sketch.Name = sketchName
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim centerPt As Point2d = tg.CreatePoint2d(x, z)
        sketch.SketchCircles.AddByCenterRadius(centerPt, cutDiaCm / 2.0)
        sketch.Visible = False

        '--------------------------------------------------
        ' 4️⃣ THROUGH-ALL CUT (SYMMETRIC)
        '--------------------------------------------------
        Dim profile As Profile = sketch.Profiles.AddForSolid()
        Dim cutDef As ExtrudeDefinition = partDef.Features.ExtrudeFeatures.CreateExtrudeDefinition(profile, PartFeatureOperationEnum.kCutOperation)
        cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kSymmetricExtentDirection)
        Dim cutFeat As ExtrudeFeature = partDef.Features.ExtrudeFeatures.Add(cutDef)
        cutFeat.Name = cutName

        '--------------------------------------------------
        ' Final update
        '--------------------------------------------------
        partDoc.Update()

    End Sub



    Sub CreateAllNozzleCuts(invApp As Inventor.Application, topOcc As ComponentOccurrence)

        '--------------------------------------------------
        ' Create TOP COVER nozzle cuts from DGV
        '--------------------------------------------------
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For

            Dim headLocation As String = row.Cells("NOZZLE_LOCATION").Value.ToString().Trim().ToUpper()
            Dim placementType As String = row.Cells("PLACEMENT_TYPE_1").Value.ToString().Trim().ToUpper()

            If headLocation <> "TOP" OrElse placementType <> "RADIAL" Then Continue For

            '---------------------------------------------
            ' Read nozzle data
            '---------------------------------------------
            Dim nozzleName As String = row.Cells("Nozzle_Mark").Value.ToString().Trim().ToUpper()
            Dim nps As String = row.Cells("Size_NPS").Value.ToString().Trim()
            Dim radiusMm As Double = CDbl(row.Cells("RADIUS_MM").Value)
            Dim angleDeg As Double = CDbl(row.Cells("ANGLE_DEG").Value)

            '---------------------------------------------
            ' Derive nozzle OD
            '---------------------------------------------
            Dim nozzleODmm As Double = GetPipeOD_mm(nps)

            '---------------------------------------------
            ' Create nozzle cut on top cover
            '---------------------------------------------
            CreateNozzleCut(invApp, topOcc, nozzleName, nozzleODmm, radiusMm, angleDeg, "XZ Plane")

        Next

    End Sub

    Public Sub ConstrainPipeToElbow_ADNOC(nozAsm As AssemblyDocument, elbowOcc As ComponentOccurrence, midPipeOcc As ComponentOccurrence)

        Dim cons = nozAsm.ComponentDefinition.Constraints
        '==============================
        ' ELBOW REFERENCES
        '==============================
        Dim elbowBottom = elbowOcc.Definition.WorkPlanes.Item("Bottom_End")
        Dim elbowAxis2 = elbowOcc.Definition.WorkAxes.Item("Work Axis2")
        Dim elbowXZ = elbowOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim elbowBottomP, elbowAxis2P, elbowXZP As Object

        elbowOcc.CreateGeometryProxy(elbowBottom, elbowBottomP)
        elbowOcc.CreateGeometryProxy(elbowAxis2, elbowAxis2P)
        elbowOcc.CreateGeometryProxy(elbowXZ, elbowXZP)

        '==============================
        ' PIPE REFERENCES
        '==============================
        Dim pipeEnd = midPipeOcc.Definition.WorkPlanes.Item("End_Plane")
        Dim pipeAxis = midPipeOcc.Definition.WorkAxes.Item("Y Axis")
        Dim pipeXZ = midPipeOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim pipeEndP, pipeAxisP, pipeXZP As Object

        midPipeOcc.CreateGeometryProxy(pipeEnd, pipeEndP)
        midPipeOcc.CreateGeometryProxy(pipeAxis, pipeAxisP)
        midPipeOcc.CreateGeometryProxy(pipeXZ, pipeXZP)

        '==============================
        ' APPLY CONSTRAINTS
        '==============================
        cons.AddMateConstraint(elbowBottomP, pipeEndP, 0)
        cons.AddMateConstraint(elbowAxis2P, pipeAxisP, 0)
        cons.AddMateConstraint(elbowXZP, pipeXZP, 0)

    End Sub

    Sub CreateNozzleCutOnEllipsoidalHead_XY(invApp As Inventor.Application, headOcc As ComponentOccurrence, nozzleName As String, cutDiaMm As Double, xMm As Double, yMm As Double)

        '----------------------------------------------
        ' Units (mm → cm)
        '----------------------------------------------
        Dim cutDiaCm As Double = cutDiaMm / 10.0
        Dim xCm As Double = -xMm / 10.0
        Dim zCm As Double = -yMm / 10.0   ' head orientation

        '----------------------------------------------
        ' Get part definition
        '----------------------------------------------
        Dim partDoc As PartDocument = CType(headOcc.Definition.Document, PartDocument)

        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

        '----------------------------------------------
        ' Remove existing cut feature (SAFE)
        '----------------------------------------------
        Dim cutName As String = nozzleName & "_Cut"

        For Each feat As ExtrudeFeature In partDef.Features.ExtrudeFeatures
            If feat.Name = cutName Then
                feat.Delete()
                Exit For
            End If
        Next

        '----------------------------------------------
        ' Create sketch (DO NOT NAME IT)
        '----------------------------------------------
        Dim xzPlane As WorkPlane = partDef.WorkPlanes.Item("XZ Plane")

        Dim sketch As PlanarSketch = partDef.Sketches.Add(xzPlane)

        '----------------------------------------------
        ' Draw cut circle
        '----------------------------------------------
        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim centerPt As Point2d = tg.CreatePoint2d(xCm, zCm)

        sketch.SketchCircles.AddByCenterRadius(centerPt, cutDiaCm / 2.0)

        '----------------------------------------------
        ' Create profile
        '----------------------------------------------
        Dim profile As Profile = sketch.Profiles.AddForSolid()

        '----------------------------------------------
        ' Through-all cut (symmetric)
        '----------------------------------------------
        Dim cutDef As ExtrudeDefinition = partDef.Features.ExtrudeFeatures.CreateExtrudeDefinition(profile, PartFeatureOperationEnum.kCutOperation)

        cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kSymmetricExtentDirection)

        Dim cutFeat As ExtrudeFeature = partDef.Features.ExtrudeFeatures.Add(cutDef)

        cutFeat.Name = cutName   ' ✅ SAFE TO NAME FEATURES

        partDoc.Update()

    End Sub

    Sub CreateAllNozzleCuts_EllipsoidalHead_XY(invApp As Inventor.Application, headOcc As ComponentOccurrence)

        '--------------------------------------------------
        ' Create BOTTOM HEAD nozzle cuts from DGV
        '--------------------------------------------------
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For

            Dim headLocation As String = row.Cells("NOZZLE_LOCATION").Value.ToString().Trim().ToUpper()

            Dim placementType As String = row.Cells("PLACEMENT_TYPE_1").Value.ToString().Trim().ToUpper()

            ' Only BOTTOM + XY nozzles apply here
            If headLocation <> "BOTTOM" OrElse placementType <> "XY DIRECTION" Then Continue For

            '---------------------------------------------
            ' Read nozzle data
            '---------------------------------------------
            Dim nozzleName As String = row.Cells("Nozzle_Mark").Value.ToString().Trim().ToUpper()
            Dim nps As String = row.Cells("Size_NPS").Value.ToString().Trim()
            Dim xMm As Double = CDbl(row.Cells("X_MM").Value)
            Dim yMm As Double = CDbl(row.Cells("Y_MM").Value)

            '---------------------------------------------
            ' Derive nozzle OD
            '---------------------------------------------
            Dim nozzleODmm As Double = GetPipeOD_mm(nps)

            '---------------------------------------------
            ' Create nozzle cut on ellipsoidal head (XY)
            '---------------------------------------------
            CreateNozzleCutOnEllipsoidalHead_XY(invApp, headOcc, nozzleName, nozzleODmm, xMm, yMm)

        Next

    End Sub

    Function GetNozzleCenterPointCm(invApp As Inventor.Application, radiusMm As Double, angleDeg As Double) As Inventor.Point

        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim rCm As Double = radiusMm / 10
        Dim angleRad As Double = (angleDeg + 90) * Math.PI / 180

        Dim x As Double = -rCm * Math.Cos(angleRad)
        Dim y As Double = 0
        Dim z As Double = -rCm * Math.Sin(angleRad)

        Return tg.CreatePoint(x, y, z)

    End Function

    Sub CreateYAxisAtNozzleCutCenter(invApp As Inventor.Application, topCoverOcc As ComponentOccurrence, nozzleName As String, radiusMm As Double, angleDeg As Double)

        Dim partDoc As PartDocument = CType(topCoverOcc.Definition.Document, PartDocument)

        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

        Dim axisName As String = nozzleName & "_Y_Axis"

        ' Avoid duplicate axis
        For Each ax As WorkAxis In partDef.WorkAxes
            If ax.Name = axisName Then Exit Sub
        Next

        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim centerPt As Point = GetNozzleCenterPointCm(invApp, radiusMm, angleDeg)

        Dim yzPlane As WorkPlane

        If RB_RT_BF.Checked Then
            yzPlane = partDef.WorkPlanes.Item("XZ Plane")
        Else
            yzPlane = partDef.WorkPlanes.Item("YZ Plane")
        End If

        Dim xyPlane As WorkPlane = partDef.WorkPlanes.Item("XY Plane")

        Dim xPlane As WorkPlane = partDef.WorkPlanes.AddByPlaneAndOffset(yzPlane, centerPt.X)

        xPlane.Visible = False

        Dim zPlane As WorkPlane = partDef.WorkPlanes.AddByPlaneAndOffset(xyPlane, centerPt.Z)

        zPlane.Visible = False

        Dim axis As WorkAxis = partDef.WorkAxes.AddByTwoPlanes(xPlane, zPlane)

        axis.Name = axisName
        axis.Visible = False

        partDoc.Update()

    End Sub

    Sub CreateXAxisAtNozzleCutCenter(invApp As Inventor.Application, topCoverOcc As ComponentOccurrence, nozzleName As String, radiusMm As Double, angleDeg As Double, sketchPlaneName As String)

        '--------------------------------------------------
        ' Get part document — use ReferencedDocumentDescriptor
        ' for blindFlangeOcc which returns Nothing from
        ' Definition.Document directly
        '--------------------------------------------------
        Dim partDoc As PartDocument = Nothing

        Try
            partDoc = CType(topCoverOcc.Definition.Document, PartDocument)
        Catch
        End Try

        If partDoc Is Nothing Then
            Try
                partDoc = CType(topCoverOcc.ReferencedDocumentDescriptor.ReferencedDocument, PartDocument)
            Catch ex As Exception
                Debug.WriteLine("CreateXAxisAtNozzleCutCenter: Could not get part doc: " & ex.Message)
                Exit Sub
            End Try
        End If

        If partDoc Is Nothing Then Exit Sub

        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition
        Dim axisName As String = nozzleName & "_X_Axis"

        ' Avoid duplicate axis
        For Each ax As WorkAxis In partDef.WorkAxes
            If ax.Name.Equals(axisName, StringComparison.OrdinalIgnoreCase) Then
                Exit Sub
            End If
        Next

        Dim tg As TransientGeometry = invApp.TransientGeometry

        '--------------------------------------------------
        ' Get nozzle center point — use correct convention
        ' based on which plane the cut was made on
        '--------------------------------------------------
        Dim centerPt As Point = GetNozzleCenterPointCm(invApp, radiusMm, angleDeg)

        Dim xyPlane As WorkPlane = partDef.WorkPlanes.Item("XY Plane")

        '--------------------------------------------------
        ' Offset planes based on sketch plane
        ' XZ Plane (standard) → offset XY by Z, offset XZ by Y
        ' YZ Plane (RB_RT_BF) → offset XY by Z, offset YZ by X
        '--------------------------------------------------
        Dim xPlane As WorkPlane = partDef.WorkPlanes.AddByPlaneAndOffset(xyPlane, centerPt.Z)
        xPlane.Visible = False

        Dim refPlane As WorkPlane
        Dim offsetVal As Double

        If sketchPlaneName = "YZ Plane" Then
            refPlane = partDef.WorkPlanes.Item("BOTTOM_PLANE")
            offsetVal = centerPt.Y
        Else
            refPlane = partDef.WorkPlanes.Item("XZ Plane")
            offsetVal = centerPt.Y
        End If

        Dim zPlane As WorkPlane = partDef.WorkPlanes.AddByPlaneAndOffset(refPlane, offsetVal)
        zPlane.Visible = False

        Dim axis As WorkAxis = partDef.WorkAxes.AddByTwoPlanes(xPlane, zPlane)
        axis.Name = axisName
        axis.Visible = False

        partDoc.Update()

    End Sub

    Sub CreateNozzleCutOnShell_ByAngleAndHeight(invApp As Inventor.Application, shellOcc As ComponentOccurrence, nozzleName As String, cutDiaMm As Double, heightFromBottomMm As Double, angleDeg As Double)

        '--------------------------------------------------
        ' Unit conversion (mm → cm)
        '--------------------------------------------------
        Dim cutDiaCm As Double = cutDiaMm / 10
        Dim heightCm As Double = heightFromBottomMm / 10
        Dim angleRad As Double = (angleDeg + 90) * Math.PI / 180

        '--------------------------------------------------
        ' Get shell part
        '--------------------------------------------------
        Dim partDoc As PartDocument = CType(shellOcc.Definition.Document, PartDocument)

        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

        '--------------------------------------------------
        ' Get shell outer radius (geometry-based)
        '--------------------------------------------------
        Dim shellRadiusCm As Double = partDef.SurfaceBodies.Item(1).RangeBox.MaxPoint.X

        '--------------------------------------------------
        ' Compute X position from angle
        '--------------------------------------------------
        Dim xPosCm As Double = shellRadiusCm * Math.Cos(angleRad)

        '--------------------------------------------------
        ' XZ Plane
        '--------------------------------------------------
        Dim xzPlane As WorkPlane = partDef.WorkPlanes.Item(1)

        '--------------------------------------------------
        ' Create sketch
        '--------------------------------------------------
        Dim sketch As PlanarSketch = partDef.Sketches.Add(xzPlane)

        sketch.Name = nozzleName & "_Sketch"

        Dim tg As TransientGeometry =
        invApp.TransientGeometry

        '--------------------------------------------------
        ' Place circle at correct angular & axial location
        '--------------------------------------------------
        Dim centerPt As Point2d = tg.CreatePoint2d(xPosCm, heightCm)

        Dim circle As SketchCircle = sketch.SketchCircles.AddByCenterRadius(centerPt, cutDiaCm / 2)

        '--------------------------------------------------
        ' Create profile
        '--------------------------------------------------
        Dim profile As Profile = sketch.Profiles.AddForSolid()

        '--------------------------------------------------
        ' EXTRUDE CUT – THROUGH ALL (BOTH SIDES)
        '--------------------------------------------------
        Dim cutDef As ExtrudeDefinition = partDef.Features.ExtrudeFeatures.CreateExtrudeDefinition(profile, PartFeatureOperationEnum.kCutOperation)

        cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kSymmetricExtentDirection)

        Dim cutFeat As ExtrudeFeature = partDef.Features.ExtrudeFeatures.Add(cutDef)

        cutFeat.Name = nozzleName & "_Cut"

        partDoc.Update()

    End Sub

    Private Sub CleanExistingNozzleData(projectFolder As String)

        If String.IsNullOrWhiteSpace(projectFolder) Then Exit Sub
        If Not IO.Directory.Exists(projectFolder) Then Exit Sub

        '==================================================
        ' 1️⃣ DELETE ALL FILES STARTING WITH "Nozzle_"
        '==================================================
        For Each filePath As String In IO.Directory.GetFiles(projectFolder)
            Dim fileName As String = IO.Path.GetFileName(filePath).ToUpper()
            If fileName.StartsWith("NOZZLE_") Then
                Try
                    IO.File.Delete(filePath)
                Catch ex As Exception
                    Throw New Exception("❌ Unable to delete file: " & filePath & vbCrLf & ex.Message)
                End Try
            End If
        Next

        '==================================================
        ' 2️⃣ DELETE ENTIRE "Nozzles" FOLDER
        '==================================================
        Dim nozzleFolder As String = IO.Path.Combine(projectFolder, "Nozzles")
        If IO.Directory.Exists(nozzleFolder) Then
            Try
                IO.Directory.Delete(nozzleFolder, True)
            Catch ex As Exception
                Throw New Exception("❌ Unable to delete Nozzles folder: " & nozzleFolder & vbCrLf & ex.Message)
            End Try
        End If

        '==================================================
        ' 3️⃣ DELETE "OldVersions" FOLDER
        '==================================================
        Dim oldVersionsFolder As String = IO.Path.Combine(projectFolder, "OldVersions")
        If IO.Directory.Exists(oldVersionsFolder) Then
            Try
                IO.Directory.Delete(oldVersionsFolder, True)
            Catch ex As Exception
                Throw New Exception("❌ Unable to delete OldVersions folder: " & oldVersionsFolder & vbCrLf & ex.Message)
            End Try
        End If

    End Sub

    Function CreateNozzleSubAssembly(invApp As Inventor.Application, projectFolder As String, nozzleName As String) As AssemblyDocument

        Dim asmTemplate As String = invApp.FileManager.GetTemplateFile(DocumentTypeEnum.kAssemblyDocumentObject, SystemOfMeasureEnum.kMetricSystemOfMeasure)
        Dim nozAsm As AssemblyDocument = invApp.Documents.Add(DocumentTypeEnum.kAssemblyDocumentObject, asmTemplate, False)
        nozAsm.DisplayName = nozzleName
        Dim nozPath As String = System.IO.Path.Combine(projectFolder, nozzleName & ".iam")
        nozAsm.SaveAs(nozPath, False)
        Return nozAsm

    End Function

    Function GetFlangeThicknessCm(flangeOcc As ComponentOccurrence) As Double

        Dim partDoc As PartDocument = CType(flangeOcc.Definition.Document, PartDocument)

        Dim body As SurfaceBody = partDoc.ComponentDefinition.SurfaceBodies.Item(1)

        ' Assuming flange axis is along Y
        Dim minY As Double = body.RangeBox.MinPoint.X
        Dim maxY As Double = body.RangeBox.MaxPoint.X

        Return Math.Abs(maxY - minY)

    End Function

    Public Function MeasureBlindFlangeThickness(invApp As Inventor.Application, blindFlangeOcc As ComponentOccurrence) As Double

        If blindFlangeOcc Is Nothing Then
            MessageBox.Show("❌ Blind Flange occurrence is Nothing.", "Measure Thickness")
            Return 0
        End If

        '--------------------------------------------------
        ' Get part document
        '--------------------------------------------------
        Dim partDoc As PartDocument = Nothing

        Try
            partDoc = CType(blindFlangeOcc.Definition.Document, PartDocument)
        Catch
        End Try

        If partDoc Is Nothing Then
            Try
                partDoc = CType(blindFlangeOcc.ReferencedDocumentDescriptor.ReferencedDocument, PartDocument)
            Catch ex As Exception
                Debug.WriteLine("MeasureBlindFlangeThickness: " & ex.Message)
                Return 0
            End Try
        End If

        If partDoc Is Nothing Then Return 0

        Try
            Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

            '--------------------------------------------------
            ' Get BOTTOM_PLANE
            '--------------------------------------------------
            Dim bottomPlane As WorkPlane = Nothing
            For Each wp As WorkPlane In partDef.WorkPlanes
                If wp.Name.Equals("BOTTOM_PLANE", StringComparison.OrdinalIgnoreCase) Then
                    bottomPlane = wp
                    Exit For
                End If
            Next

            If bottomPlane Is Nothing Then
                MessageBox.Show("❌ BOTTOM_PLANE not found in Blind Flange.", "Measure Thickness")
                Return 0
            End If

            '--------------------------------------------------
            ' Get TOP_PLANE
            '--------------------------------------------------
            Dim topPlane As WorkPlane = Nothing
            For Each wp As WorkPlane In partDef.WorkPlanes
                If wp.Name.Equals("TOP_PLANE", StringComparison.OrdinalIgnoreCase) Then
                    topPlane = wp
                    Exit For
                End If
            Next

            If topPlane Is Nothing Then
                MessageBox.Show("❌ TOP_PLANE not found in Blind Flange.", "Measure Thickness")
                Return 0
            End If

            '--------------------------------------------------
            ' Measure distance using MeasureTools
            ' Inventor internal units = cm → convert to mm
            '--------------------------------------------------
            Dim doc As Inventor.Document = CType(partDoc, Inventor.Document)
            Dim mt As Inventor.MeasureTools = doc.MeasureTools

            Dim distanceCm As Double = mt.GetMinimumDistance(bottomPlane, topPlane)
            Dim distanceMm As Double = distanceCm * 10.0

            Return distanceMm

        Catch ex As Exception
            MessageBox.Show("❌ Measurement failed: " & ex.Message, "Measure Thickness")
            Return 0
        End Try

    End Function

    ''' Measures a Blind Flange's height (e.g. BLIND_FLANGE_CL_150_24_INCH.IPT) as its
    ''' bounding-box extent along X, in mm — same approach as GetFlangeThicknessCm.
    Public Function MeasureBlindFlangeHeight(invApp As Inventor.Application, blindFlangeOcc As ComponentOccurrence) As Double

        If blindFlangeOcc Is Nothing Then
            MessageBox.Show("❌ Blind Flange occurrence is Nothing.", "Measure Height")
            Return 0
        End If

        '--------------------------------------------------
        ' Get part document
        '--------------------------------------------------
        Dim partDoc As PartDocument = Nothing

        Try
            partDoc = CType(blindFlangeOcc.Definition.Document, PartDocument)
        Catch
        End Try

        If partDoc Is Nothing Then
            Try
                partDoc = CType(blindFlangeOcc.ReferencedDocumentDescriptor.ReferencedDocument, PartDocument)
            Catch ex As Exception
                Debug.WriteLine("MeasureBlindFlangeHeight: " & ex.Message)
                Return 0
            End Try
        End If

        If partDoc Is Nothing Then Return 0

        Try
            '--------------------------------------------------
            ' Bounding-box height (same approach as GetFlangeThicknessCm)
            ' Inventor internal units = cm → convert to mm
            '--------------------------------------------------
            Dim body As SurfaceBody = partDoc.ComponentDefinition.SurfaceBodies.Item(1)

            ' Assuming blind flange axis is along X
            Dim minX As Double = body.RangeBox.MinPoint.X
            Dim maxX As Double = body.RangeBox.MaxPoint.X

            Dim distanceCm As Double = Math.Abs(maxX - minX)
            Dim distanceMm As Double = distanceCm * 10.0

            Return distanceMm

        Catch ex As Exception
            MessageBox.Show("❌ Measurement failed: " & ex.Message, "Measure Height")
            Return 0
        End Try

    End Function

    Public Sub ConstrainPadToPipe(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, padOcc As ComponentOccurrence, nozzleName As String, Optional remarks As String = "", Optional blindFlangeOcc As ComponentOccurrence = Nothing)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints
        Dim isDipPipe As Boolean = False

        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows
            If row.IsNewRow Then Continue For
            If row.Cells("REMARKS").Value Is Nothing Then Continue For
            Dim gridNozzleName As String = row.Cells("NOZZLE_MARK").Value.ToString().Trim().ToUpper()
            If gridNozzleName <> nozzleName.ToUpper() Then Continue For
            Dim rowRemark As String = row.Cells("REMARKS").Value.ToString().Trim().ToUpper()
            If rowRemark.Contains("DIP PIPE") Then
                isDipPipe = True
            End If
            Exit For
        Next
        '==================================================
        ' 1️⃣ Pipe YZ ↔ Pad YZ  (COMMON)
        '==================================================
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim padYZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim pipeYZp, padYZp As Object
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        padOcc.CreateGeometryProxy(padYZ, padYZp)

        cons.AddFlushConstraint(pipeYZp, padYZp, 0)

        '==================================================
        ' 2️⃣ Pipe XZ ↔ Pad XZ  (OFFSET VARIES)
        '==================================================
        Dim pipeXZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim padXZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim pipeXZp, padXZp As Object
        pipeOcc.CreateGeometryProxy(pipeXZ, pipeXZp)
        padOcc.CreateGeometryProxy(padXZ, padXZp)

        '==================================================
        ' ✅ OFFSET DECISION (NO POPUP)
        '==================================================
        Dim offsetCm As Double = CDbl(txt_DP_Offset_Length1.Text)

        If RB_RT_BF.Checked Then

            If blindFlangeOcc Is Nothing Then
                MessageBox.Show("❌ Blind Flange occurrence is Nothing — cannot measure blind flange height.",
                            "ConstrainPadToPipe")
            Else
                Dim invApp As Inventor.Application = nozAsm.Parent
                offsetCm = MeasureBlindFlangeHeight(invApp, blindFlangeOcc) / 10.0
            End If

        ElseIf SelectedClient = "ARAMCO" Then

            If isDipPipe Then
                offsetCm = txt_DP_Offset_Length1.Text / 10.0   '✅ Stored value
            Else
                offsetCm = CDbl(txt_TP_THK.Text) / 10.0
            End If

        ElseIf SelectedClient = "ADNOC" Then

            If isDipPipe Then
                offsetCm = DipPadOffsetMm / 10.0   '✅ Stored value
            Else
                offsetCm = CDbl(txt_RF_THK.Text) / 10.0
            End If

        End If

        cons.AddFlushConstraint(pipeXZp, padXZp, offsetCm)

        '==================================================
        ' 3️⃣ Pipe XY ↔ Pad XY  (COMMON)
        '==================================================
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim padXY As WorkPlane = padOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim pipeXYp, padXYp As Object
        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        padOcc.CreateGeometryProxy(padXY, padXYp)

        cons.AddFlushConstraint(pipeXYp, padXYp, 0)

    End Sub

    Function GetPipeLengthCm(pipeOcc As ComponentOccurrence) As Double

        Dim partDoc As PartDocument = CType(pipeOcc.Definition.Document, PartDocument)

        Dim body As SurfaceBody = partDoc.ComponentDefinition.SurfaceBodies.Item(1)

        ' Assuming pipe axis is along Y
        Dim minY As Double = body.RangeBox.MinPoint.Y
        Dim maxY As Double = body.RangeBox.MaxPoint.Y

        Return Math.Abs(maxY - minY)

    End Function

    Function GetOrCreatePipeEndPlane(invApp As Inventor.Application, pipeOcc As ComponentOccurrence, nozzleName As String) As WorkPlane

        Dim partDoc As PartDocument = CType(pipeOcc.Definition.Document, PartDocument)

        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

        Dim planeName As String = nozzleName & "_End_Plane"

        '--------------------------------------
        ' Reuse if already exists
        '--------------------------------------
        For Each wp As WorkPlane In partDef.WorkPlanes
            If wp.Name = planeName Then
                wp.Visible = False
                Return wp
            End If
        Next

        '--------------------------------------
        ' Get pipe length (cm)
        '--------------------------------------
        Dim pipeLengthCm As Double = GetPipeLengthCm(pipeOcc)

        '--------------------------------------
        ' Base plane: XZ Plane (pipe axis along Y)
        '--------------------------------------
        Dim xzPlane As WorkPlane = partDef.WorkPlanes.Item("XZ Plane")

        '--------------------------------------
        ' Create offset plane at pipe end
        '--------------------------------------
        Dim endPlane As WorkPlane = partDef.WorkPlanes.AddByPlaneAndOffset(xzPlane, pipeLengthCm)

        endPlane.Name = planeName
        endPlane.Visible = False

        partDoc.Update()

        Return endPlane

    End Function

    Sub ConstrainFlangeToPipe(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, flangeOcc As ComponentOccurrence, nozzleName As String)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints

        Dim invApp As Inventor.Application = nozAsm.Parent

        Dim pipeEndPlane As WorkPlane = GetOrCreatePipeEndPlane(invApp, pipeOcc, nozzleName)

        Dim flangeEndPlane As WorkPlane = GetOrCreateFlangeEndPlane(invApp, flangeOcc, nozzleName)

        Dim pipeEndPlaneP, flangeEndPlaneP As Object
        pipeOcc.CreateGeometryProxy(pipeEndPlane, pipeEndPlaneP)
        flangeOcc.CreateGeometryProxy(flangeEndPlane, flangeEndPlaneP)

        cons.AddMateConstraint(pipeEndPlaneP, flangeEndPlaneP, 0)

        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim flangeXZ As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim pipeYZp, flangeXZp As Object
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        flangeOcc.CreateGeometryProxy(flangeXZ, flangeXZp)

        cons.AddMateConstraint(pipeYZp, flangeXZp, 0)

        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim flangeXY As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim pipeXYp, flangeXYp As Object
        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        flangeOcc.CreateGeometryProxy(flangeXY, flangeXYp)

        cons.AddMateConstraint(pipeXYp, flangeXYp, 0)

    End Sub

    Function GetOrCreateFlangeEndPlane(invApp As Inventor.Application, flangeOcc As ComponentOccurrence, nozzleName As String) As WorkPlane

        Dim partDoc As PartDocument = CType(flangeOcc.Definition.Document, PartDocument)

        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

        Dim planeName As String = nozzleName & "_End_Plane"

        '--------------------------------------
        ' Reuse if already exists
        '--------------------------------------
        For Each wp As WorkPlane In partDef.WorkPlanes
            If wp.Name = planeName Then
                wp.Visible = False
                Return wp
            End If
        Next

        '--------------------------------------
        ' Measure flange thickness (cm)
        '--------------------------------------
        Dim flangeThkCm As Double = GetFlangeThicknessCm(flangeOcc)

        '--------------------------------------
        ' Base plane: YZ Plane
        ' (flange axis assumed along Y)
        '--------------------------------------
        Dim yzPlane As WorkPlane = partDef.WorkPlanes.Item("YZ Plane")

        '--------------------------------------
        ' Create End Plane using thickness
        '--------------------------------------
        Dim endPlane As WorkPlane = partDef.WorkPlanes.AddByPlaneAndOffset(yzPlane, flangeThkCm)

        endPlane.Name = planeName
        endPlane.Visible = False

        partDoc.Update()

        Return endPlane

    End Function

    Public Sub BuildNozzleAssembly_TopPlate(invApp As Inventor.Application, nozAsm As AssemblyDocument, pipePath As String, flangePath As String, Optional rfPadPath As String = "", Optional nozzleName As String = "",
    Optional outsideProjectionMm As Double = 0, Optional pipeODmm As Double = 0, Optional pipeThkMm As Double = 0, Optional pipeLengthMm As Double = 0, Optional rfPadODmm As Double = 0, Optional rfPadThkMm As Double = 0, Optional blindFlangeOcc As ComponentOccurrence = Nothing)

        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' 1️⃣ PIPE
        '==================================================
        Dim pipeOcc As ComponentOccurrence = asmDef.Occurrences.Add(pipePath, tg.CreateMatrix())
        pipeOcc.Name = nozzleName & "_PIPE"
        pipeOcc.Grounded = True

        ' 🔑 PIPE PARAMETERS (OD, THK, LENGTH)
        If pipeODmm > 0 AndAlso pipeThkMm > 0 AndAlso pipeLengthMm > 0 Then
            SetPipeDimensions(pipeOcc, pipeODmm, pipeThkMm, pipeLengthMm)
        End If

        '==================================================
        ' 2️⃣ FLANGE
        '==================================================
        Dim flangeOcc As ComponentOccurrence = asmDef.Occurrences.Add(flangePath, tg.CreateMatrix())
        flangeOcc.Name = nozzleName & "_FLANGE"
        ConstrainFlangeToPipe(nozAsm, pipeOcc, flangeOcc, nozzleName)

        If outsideProjectionMm > 0 Then
            SetFlangeOutsideProjection(flangeOcc, outsideProjectionMm)
        End If

        '==================================================
        ' 3️⃣ RF PAD (TOP HEAD)
        '==================================================
        If rfPadPath <> "" Then

            Dim padOcc As ComponentOccurrence = asmDef.Occurrences.Add(rfPadPath, tg.CreateMatrix())
            padOcc.Name = nozzleName & "_RF_PAD"

            ' 🔑 RF PAD ID = PIPE OD
            If rfPadODmm <= 0 Then
                rfPadODmm = pipeODmm
            End If

            SetRFPadParameters(padOcc, rfPadODmm, rfPadThkMm, pipeODmm)

            ConstrainPadToPipe(nozAsm, pipeOcc, padOcc, nozzleName, blindFlangeOcc:=blindFlangeOcc)
        End If

        nozAsm.Update()

    End Sub

    Function PlaceNozzleSubAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, nozzleAsmPath As String) As ComponentOccurrence

        Dim asmDef = asmDoc.ComponentDefinition
        Dim tg = invApp.TransientGeometry

        Dim nozOcc = asmDef.Occurrences.Add(nozzleAsmPath, tg.CreateMatrix())

        Return nozOcc

    End Function

