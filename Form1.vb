    Public Function PlaceandConstrainTopCoverPlateAdnoc(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, gasketOcc As ComponentOccurrence, topCoverPath As String) As ComponentOccurrence


        '==================================================
        ' VALIDATE FILE
        '==================================================
        If Not IO.File.Exists(topCoverPath) Then
            Throw New Exception("Top Cover Plate ADNOC file not found: " & topCoverPath)
        End If


        '==================================================
        ' PLACE TOP COVER PLATE
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim topCoverOcc As ComponentOccurrence = asmDef.Occurrences.Add(topCoverPath, tg.CreateMatrix())
        topCoverOcc.Grounded = False

        '==================================================
        ' SHELL REFERENCES
        '==================================================
        Dim shellDef As PartComponentDefinition = shellOcc.Definition
        Dim shellYZ As WorkPlane = shellDef.WorkPlanes.Item("YZ Plane")
        Dim shellXY As WorkPlane = shellDef.WorkPlanes.Item("XY Plane")

        '==================================================
        ' GASKET REFERENCES
        '==================================================
        Dim gasketDef As PartComponentDefinition = gasketOcc.Definition
        Dim gasketTopPlane As WorkPlane = gasketDef.WorkPlanes.Item("TOP_PLANE")

        '==================================================
        ' TOP COVER REFERENCES
        '==================================================
        Dim topDef As PartComponentDefinition = topCoverOcc.Definition
        Dim topEndPlane As WorkPlane = topDef.WorkPlanes.Item("END_PLANE")
        Dim topYZ As WorkPlane = topDef.WorkPlanes.Item("YZ Plane")
        Dim topXY As WorkPlane = topDef.WorkPlanes.Item("XY Plane")

        '==================================================
        ' CREATE PROXIES – SHELL
        '==================================================
        Dim shellYZProxy As Object
        Dim shellXYProxy As Object

        shellOcc.CreateGeometryProxy(shellYZ, shellYZProxy)
        shellOcc.CreateGeometryProxy(shellXY, shellXYProxy)

        '==================================================
        ' CREATE PROXIES – GASKET
        '==================================================
        Dim gasketTopProxy As Object
        gasketOcc.CreateGeometryProxy(gasketTopPlane, gasketTopProxy)

        '==================================================
        ' CREATE PROXIES – TOP COVER
        '==================================================
        Dim topEndProxy As Object
        Dim topYZProxy As Object
        Dim topXYProxy As Object

        topCoverOcc.CreateGeometryProxy(topEndPlane, topEndProxy)
        topCoverOcc.CreateGeometryProxy(topYZ, topYZProxy)
        topCoverOcc.CreateGeometryProxy(topXY, topXYProxy)

        '==================================================
        ' APPLY ADNOC CONSTRAINTS
        '==================================================

        '1️⃣ Gasket TOP_PLANE ↔ TopCover END_PLANE
        cons.AddFlushConstraint(gasketTopProxy, topEndProxy, 0)

        '2️⃣ Shell YZ Plane ↔ TopCover YZ Plane
        cons.AddFlushConstraint(shellYZProxy, topYZProxy, 0)

        '3️⃣ Shell XY Plane ↔ TopCover XY Plane
        cons.AddFlushConstraint(shellXYProxy, topXYProxy, 0)

        '==================================================
        ' UPDATE
        '==================================================
        asmDoc.Update()

        Return topCoverOcc

