    Public Sub SetPipeDimensions(pipeOcc As ComponentOccurrence, pipeODmm As Double, pipeThkMm As Double, pipeLengthMm As Double)

        If pipeOcc Is Nothing Then
            Throw New Exception("❌ Pipe occurrence is Nothing")
        End If

        Dim partDef As PartComponentDefinition = CType(pipeOcc.Definition, PartComponentDefinition)

        Dim params As Parameters = partDef.Parameters

        '==================================================
        ' 1️⃣ Fetch parameters safely
        '==================================================
        Dim pOD As Parameter = params.Item("OD")
        Dim pTHK As Parameter = params.Item("THK")
        Dim pLEN As Parameter = params.Item("LENGTH")
        Dim pID As Parameter = params.Item("ID")

        '==================================================
        ' 2️⃣ Set OD & THK (mm → cm)
        '==================================================
        pOD.Value = pipeODmm / 10.0
        pTHK.Value = pipeThkMm / 10.0
        pID.Expression = txt_EH_Inside_Dia.Text & " mm"

        '==================================================
        ' 4️⃣ Set length (mm → cm)
        '==================================================
        pLEN.Value = pipeLengthMm / 10.0

        '==================================================
        ' 5️⃣ Update part
        '==================================================
        partDef.Document.Update()

    End Sub

    Public Sub PlaceFlangeWithOptionalMidPipe(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, elbowOcc As ComponentOccurrence, midPipeOcc As ComponentOccurrence,
    flangeOcc As ComponentOccurrence, includeElbow As Boolean, includeMidPipe As Boolean, nozzleName As String)

        If includeElbow Then
            If includeMidPipe Then
                ConstrainPipeToElbow_ADNOC(nozAsm, elbowOcc, midPipeOcc)
                ConstrainFlangeToPipe_Shell(nozAsm, midPipeOcc, flangeOcc, nozzleName)
            Else
                ConstrainFlangeToElbow_ADNOC(nozAsm, elbowOcc, flangeOcc)
            End If
        Else
            ConstrainFlangeToPipe_Shell(nozAsm, pipeOcc, flangeOcc, nozzleName)
        End If

    End Sub

    Public Function InsertIntermediatePipe(invApp As Inventor.Application, asmDef As AssemblyComponentDefinition, pipePath As String, nozzleName As String,
                                       pipeODmm As Double, pipeThkMm As Double, midPipeLengthMm As Double) As ComponentOccurrence

        Dim tg = invApp.TransientGeometry
        Dim midPipeOcc = asmDef.Occurrences.Add(pipePath, tg.CreateMatrix())

        midPipeOcc.Name = nozzleName & "_MID_PIPE"
        SetPipeDimensions(midPipeOcc, pipeODmm, pipeThkMm, midPipeLengthMm)
        Return midPipeOcc

    End Function

    Public Function CalculateADNOCPipeLength(outsideProjMm As Double, includeElbow As Boolean, includeMidPipe As Boolean, elbowAmm As Double,
                                         midPipeLengthMm As Double) As Double

        Dim pipeLengthMm = outsideProjMm
        If includeElbow Then
            pipeLengthMm -= elbowAmm
        End If

        If includeMidPipe Then
            pipeLengthMm = 94
        End If

        Return pipeLengthMm

    End Function

    Public Sub SetFlangeOutsideProjection(flangeOcc As ComponentOccurrence, outsideProjectionMm As Double)

        Dim flangeDef As PartComponentDefinition = CType(flangeOcc.Definition, PartComponentDefinition)
        Dim p As Parameter

        Try
            p = flangeDef.Parameters.Item("OUTSIDE_PROJECTION")
        Catch
            'Throw New Exception("❌ Parameter 'OUTSIDE_PROJECTION' not found in flange part")
        End Try

        ' mm → cm
        p.Expression = (outsideProjectionMm).ToString()
        flangeDef.Document.Update()

    End Sub

    Public Sub ConstrainFlangeToPipe_Shell(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, flangeOcc As ComponentOccurrence, nozzleName As String)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints
        Dim invApp As Inventor.Application = nozAsm.Parent

        ' Safety
        pipeOcc.Grounded = True
        flangeOcc.Grounded = False

        '==================================================
        ' 1️⃣ Pipe XZ ↔ Flange End Plane (FLUSH or OFFSET)
        '==================================================
        Dim pipeXZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XZ Plane")
        Dim flangeEndPlane As WorkPlane = GetOrCreateFlangeEndPlane(invApp, flangeOcc, nozzleName)
        flangeEndPlane.Visible = False

        Dim pipeXZp, flangeEndPlaneP As Object
        pipeOcc.CreateGeometryProxy(pipeXZ, pipeXZp)
        flangeOcc.CreateGeometryProxy(flangeEndPlane, flangeEndPlaneP)

        ' 🌟 Special rule: Manway (M1) needs flange offset by 16 mm → 1.6 cm
        Dim offsetCm As Double = 0
        If nozzleName.Trim().ToUpper() = "M1" Then
            offsetCm = 1.6      ' 16 mm → 1.6 cm
        End If

        cons.AddFlushConstraint(pipeXZp, flangeEndPlaneP, offsetCm)

        '==================================================
        ' 2️⃣ Pipe YZ ↔ Flange XZ (MATE)
        '==================================================
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")
        Dim flangeXZ As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim pipeYZp, flangeXZp As Object
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        flangeOcc.CreateGeometryProxy(flangeXZ, flangeXZp)

        cons.AddMateConstraint(pipeYZp, flangeXZp, 0)

        '==================================================
        ' 3️⃣ Pipe XY ↔ Flange XY (FLUSH)
        '==================================================
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim flangeXY As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim pipeXYp, flangeXYp As Object
        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        flangeOcc.CreateGeometryProxy(flangeXY, flangeXYp)

        cons.AddFlushConstraint(pipeXYp, flangeXYp, 0)

    End Sub

