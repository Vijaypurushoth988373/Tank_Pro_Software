    Private Sub DGV_Nozzle_Tab_Head_CellValueChanged(sender As Object, e As DataGridViewCellEventArgs) Handles DGV_Nozzle_Tab_Head.CellValueChanged

        If e.RowIndex < 0 Then Exit Sub
        If e.ColumnIndex < 0 Then Exit Sub

        Dim row As DataGridViewRow = DGV_Nozzle_Tab_Head.Rows(e.RowIndex)
        Dim colName As String = DGV_Nozzle_Tab_Head.Columns(e.ColumnIndex).Name
        Dim flangeClass As String = If(row.Cells("Flange_Class").Value, "").ToString().Trim()

        '==================================================
        ' ✅ READ REMARKS SAFELY
        '==================================================
        Dim remarks As String = ""
        If row.Cells("REMARKS").Value IsNot Nothing Then
            remarks = row.Cells("REMARKS").Value.ToString().Trim().ToUpper()
        End If

        If DGV_Nozzle_Tab_Head.Columns(e.ColumnIndex).Name = "REMARKS" Then
            UpdateDipPipeTabs()
            UpdateDipPipeTabsAdnoc()
            UpdateVortexBreakerTabs()
        End If

        '==================================================
        ' ✅ 1) SIZE CHANGED → FILTER SCHEDULES
        '==================================================
        If colName = "Size_NPS" Then

            Dim sizeVal = row.Cells("Size_NPS").Value
            If sizeVal Is Nothing Then Exit Sub

            Dim nps As String = sizeVal.ToString().Trim()

            ' Fill schedules for that size
            FillSchedulesForSize(e.RowIndex, nps)

            ' Clear schedule + thickness
            RemoveHandler DGV_Nozzle_Tab_Head.CellValueChanged, AddressOf DGV_Nozzle_Tab_Head_CellValueChanged

            row.Cells("Nozzle_Sch").Value = Nothing
            row.Cells("Nozzle_THK").Value = ""

            AddHandler DGV_Nozzle_Tab_Head.CellValueChanged, AddressOf DGV_Nozzle_Tab_Head_CellValueChanged

            Exit Sub
        End If

        '==================================================
        ' ✅ 2) SCHEDULE CHANGED → AUTO THICKNESS
        '==================================================
        If colName = "Nozzle_Sch" Then

            Dim sizeVal = row.Cells("Size_NPS").Value
            Dim schVal = row.Cells("Nozzle_Sch").Value

            If sizeVal Is Nothing OrElse schVal Is Nothing Then Exit Sub

            Dim nps As String = sizeVal.ToString().Trim()
            Dim sch As String = schVal.ToString().Trim()

            ' Fill thickness
            FillThickness(e.RowIndex, nps, sch)

            Exit Sub
        End If

        '==================================================
        ' ✅ 3) PLACEMENT TYPE CHANGED → LOCK COLUMNS
        '==================================================
        If colName = "PLACEMENT_TYPE_1" Then

            Dim placementVal = row.Cells("PLACEMENT_TYPE_1").Value
            If placementVal Is Nothing Then Exit Sub

            Dim placementType As String = placementVal.ToString().Trim().ToUpper()

            ' Reset all first
            UnlockCell(row, "X_MM")
            UnlockCell(row, "Y_MM")
            UnlockCell(row, "RADIUS_MM")
            UnlockCell(row, "ANGLE_DEG")

            '-----------------------------
            ' ✅ RADIAL MODE
            '-----------------------------
            If placementType = "RADIAL" Then

                LockCell(row, "X_MM", "-")
                LockCell(row, "Y_MM", "-")

                UnlockCell(row, "RADIUS_MM")
                UnlockCell(row, "ANGLE_DEG")

            End If

            '-----------------------------
            ' ✅ XY DIRECTION MODE
            '-----------------------------
            If placementType = "XY DIRECTION" Then

                LockCell(row, "RADIUS_MM", "-")
                LockCell(row, "ANGLE_DEG", "-")

                UnlockCell(row, "X_MM")
                UnlockCell(row, "Y_MM")

            End If

            Exit Sub
        End If

        '==================================================
        ' ✅ 4) OUTSIDE PROJECTION CHANGED → PIPE LENGTH BACKEND
        '==================================================
        If colName = "OUTSIDE_PROJECTION" Then

            ' Skip auto pipe length for DIP PIPE / VORTEX BREAKER
            If remarks.Contains("DIP") OrElse remarks.Contains("VORTEX") Then Exit Sub

            Dim sizeVal = row.Cells("Size_NPS").Value
            Dim projVal = row.Cells("OUTSIDE_PROJECTION").Value

            If sizeVal Is Nothing OrElse projVal Is Nothing Then Exit Sub

            Dim nps As String = sizeVal.ToString().Trim()
            Dim outsideProjMm As Double = CDbl(projVal)

            ' Backend pipe length calculation
            Dim pipeLengthMm As Double = CalculatePipeLength_Head(row, nps, outsideProjMm, flangeClass, remarks)

            ' Store pipe length internally (optional)
            row.Tag = pipeLengthMm

        End If

        '✅ Only when stiffener checkbox changes
        If colName = "Stiffener_Head" Then
            CopyNozzleMarkToForm3(row)
        End If

    End Sub

    Private Sub DGV_Nozzle_Tab_Shell_CellValueChanged(sender As Object, e As DataGridViewCellEventArgs) Handles DGV_Nozzle_Tab_Shell.CellValueChanged
