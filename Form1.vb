            angle_LS_2 = 90.0
        End Try

        '==================================================
        ' CREATE REFERENCE PLANES (SAFE)
        '==================================================
        Try
            If shellOcc IsNot Nothing Then
                CreateLiftingLugReferencePlanes(invApp, shellOcc, angle1, angle2)
