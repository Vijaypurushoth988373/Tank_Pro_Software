        flange2Occ.CreateGeometryProxy(flangeAxis, fAxisP)
        gasketOcc.CreateGeometryProxy(gasketAxis, gAxisP)

        flange2Occ.CreateGeometryProxy(flangeXZ, fXZP)
        gasketOcc.CreateGeometryProxy(gasketXY, gXYP)

        cons.AddFlushConstraint(fYZP, gXZP, 0)
        cons.AddMateConstraint(fAxisP, gAxisP, 0)
        cons.AddFlushConstraint(fXZP, gXYP, 0)

    End Sub

    Private Sub ConstrainGasketToFlange3(nozAsm As AssemblyDocument, gasketOcc As ComponentOccurrence, flange3Occ As ComponentOccurrence)

