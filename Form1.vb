    Public Sub CreateNamePlateReferencePlanes(invApp As Inventor.Application, shellOcc As ComponentOccurrence, angle1Deg As Double, angle2Deg As Double)

        Dim shellDoc As PartDocument = CType(shellOcc.Definition.Document, PartDocument)
        Dim compDef As PartComponentDefinition = shellDoc.ComponentDefinition

        Dim angles As Double() = {angle1Deg, angle2Deg}

        For Each ang As Double In angles

            Dim planeName As String = $"NP_Plane_{ang}"

            ' Skip if exists
            For Each wp As WorkPlane In compDef.WorkPlanes
                If wp.Name = planeName Then
                    wp.Visible = False
                    GoTo NextAngle
                End If
            Next

            Dim angleRad As Double = ang * Math.PI / 180.0
            Dim rotAxis As WorkAxis = compDef.WorkAxes.Item("Y Axis")
            Dim basePlane As WorkPlane = compDef.WorkPlanes.Item("YZ Plane")
            Dim newPlane As WorkPlane = compDef.WorkPlanes.AddByLinePlaneAndAngle(rotAxis, basePlane, -angleRad)

            newPlane.Name = planeName
            newPlane.Visible = False

NextAngle:
        Next

        shellDoc.Update()

    End Sub

