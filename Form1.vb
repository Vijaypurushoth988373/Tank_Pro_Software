    Public Sub UpdateNozzleParametersOnly(invApp As Inventor.Application, nozzleMark As String, stiffInfo As StiffenerInfo, folderPath As String)

        '==================================================
        ' VALIDATION
        '==================================================
        If invApp Is Nothing Then Exit Sub
        If String.IsNullOrWhiteSpace(nozzleMark) Then Exit Sub
        If stiffInfo Is Nothing Then Exit Sub
        If String.IsNullOrWhiteSpace(folderPath) Then Exit Sub

        Dim nozzlePath As String =
        IO.Path.Combine(folderPath, $"Nozzle_{nozzleMark}.iam")

        If Not IO.File.Exists(nozzlePath) Then Exit Sub

        Try
            '========================================
            ' OPEN ASSEMBLY
            '========================================
            Dim asmDoc As AssemblyDocument = CType(invApp.Documents.Open(nozzlePath, False), AssemblyDocument)
            Dim compDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition

            '========================================
            ' UPDATE PARAMETERS
            '========================================
            Dim params As Parameters = compDef.Parameters
            params.Item("NO_OF_STIFF").Expression = stiffInfo.Count
            params.Item("ANG_BW_STIFF").Expression = stiffInfo.anglebwstiffener & " deg"
            params.Item("TOP_COVER_THK").Expression = CDbl(txt_TP_THK.Text)
            params.Item("HT_FROM_TOP").Expression = stiffInfo.HeightMm & " mm"

            '========================================
            ' UPDATE PIPE ANGLE
            '========================================
            For Each occ As ComponentOccurrence In compDef.Occurrences

                If occ.Name.ToUpper().Contains(nozzleMark & "_PIPE") Then

                    Dim pipeDoc As PartDocument = CType(occ.Definition.Document, PartDocument)
                    Dim pipeParams As Parameters = pipeDoc.ComponentDefinition.Parameters
                    pipeParams.Item("STIFF_ANGLE").Expression = stiffInfo.AngleDeg & " deg"
                    pipeDoc.Update()
                    pipeDoc.Save()

                End If

            Next

            asmDoc.Update()
            asmDoc.Save()
            asmDoc.Close(True)

        Catch ex As Exception
            MessageBox.Show("Error updating nozzle " & nozzleMark)
        End Try

    End Sub

