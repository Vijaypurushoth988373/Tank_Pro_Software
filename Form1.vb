    Private Sub UpdateEllipsoidalHeadParameters(invApp As Inventor.Application, headPath As String)

        '==================================================
        ' Validate file path
        '==================================================
        If Not IO.File.Exists(headPath) Then
            Throw New Exception("❌ Ellipsoidal Head part not found: " & headPath)
        End If

        '==================================================
        ' Open part (editable)
        '==================================================
        Dim headDoc As PartDocument = CType(invApp.Documents.Open(headPath, False), PartDocument)
        Dim params As Parameters = headDoc.ComponentDefinition.Parameters

        '==================================================
        ' WRITE values from UI → IPT
        '==================================================
        params.Item("ID").Expression = txt_EH_Inside_Dia.Text
        params.Item("SF").Expression = txt_EH_SF.Text
        params.Item("THK").Expression = txt_EH_Nom_Thk.Text
        params.Item("MIN_THK").Expression = txt_EH_Min_Thk.Text
        params.Item("MATERIAL").Value = cmb_EH_Mat_Name.Text

        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For


            '----------------------------------------------
            ' Read nozzle mark
            '----------------------------------------------
            Dim nozzleVal = row.Cells("Nozzle_Mark").Value
            If nozzleVal Is Nothing Then Continue For

            Dim nozzleMark As String = nozzleVal.ToString.Trim.ToUpper()

            '----------------------------------------------
            ' Placement type detection
            '----------------------------------------------
            Dim placementType As String = row.Cells("PLACEMENT_TYPE_1").Value?.ToString.Trim.ToUpper()

            '==================================================
            ' CASE 1️⃣ RADIAL PLACEMENT
            ' Uses: N?_RAD, N?_ANG
            '==================================================
            If placementType = "RADIAL" Then

                Dim radVal = row.Cells("RADIUS_MM").Value
                Dim angVal = row.Cells("ANGLE_DEG").Value

                If radVal Is Nothing Or angVal Is Nothing Then Continue For

                If radVal.ToString = "-" Or angVal.ToString = "-" Then Continue For

                Dim radParam As String = nozzleMark & "_RAD"
                Dim angParam As String = nozzleMark & "_ANG"

                Try
                    If params.NameIsUsed(radParam) Then
                        params.Item(radParam).Expression = radVal & " mm"
                    End If

                    If params.NameIsUsed(angParam) Then
                        params.Item(angParam).Expression = angVal & " deg"
                    End If
                Catch EX As Exception
                    Debug.Print(EX.Message)
                End Try

            End If

            '==================================================
            ' CASE 2️⃣ XY DIRECTION PLACEMENT
            ' Uses: N?_X_DIST, N?_Y_DIST
            '==================================================
            If placementType = "XY DIRECTION" Then

                Dim xVal = row.Cells("X_MM").Value
                Dim yVal = row.Cells("Y_MM").Value

                If xVal Is Nothing Or yVal Is Nothing Then Continue For

                Dim xParam As String = nozzleMark & "_X_DIST"
                Dim yParam As String = nozzleMark & "_Y_DIST"

                Try
                    params.Item(xParam).Expression = xVal & " mm"
                Catch ex As Exception
                    Debug.Print("Parameter not found: " & xParam)
                End Try

                Try
                    params.Item(yParam).Expression = yVal & " mm"
                Catch ex As Exception
                    Debug.Print(ex.Message)
                End Try

            End If

        Next

        '==================================================
        ' Update, Save, Close
        '==================================================
        headDoc.Update()
        headDoc.Save()
        headDoc.Close(False)

    End Sub

