#Region "SHELL NOZZLES – CUT + PLACE + CONSTRAIN (FROM DGV)"

        '==================================================
        ' Load Master Pipe Table (NPS + SCH)
        '==================================================
        Dim pipeTable As List(Of PipeDim) = LoadPipeTable()

        '==================================================
        ' Loop through Shell Nozzle DataGridView
        '==================================================
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Shell.Rows

            If row.IsNewRow Then Continue For

            '==================================================
            ' 1️ READ VALUES FROM SHELL DGV
            '==================================================
            Dim nozzleName As String = row.Cells("NOZZLE_MARK_TEXT").Value.ToString().Trim().ToUpper()
            Dim nps As String = row.Cells("SIZE_TEXT").Value.ToString().Trim()
            Dim schedule As String = row.Cells("NOZZLE_SCH_SHELL").Value.ToString().Trim().ToUpper()
            Dim remarks As String = row.Cells("REMARKS_SHELL").Value.ToString().Trim().ToUpper()
            Dim nozzleHeightMm As Double = CDbl(row.Cells("DIST_FROM_BASE_TEXT").Value) - CDbl(txt_EH_SF.Text)
            Dim angleDeg As Double = CDbl(row.Cells("ORIENTATION_TEXT").Value)
            Dim outsideProjMm As Double = CDbl(row.Cells("OUTSIDE_PROJECTION_SHELL").Value)
            Dim pipeThkMm As Double = CDbl(row.Cells("NOZZLE_THK_SHELL").Value)
            Dim flangeClass As String = row.Cells("NOZZLE_FLANGE_CLASS_SHELL").Value.ToString().Trim()

            ' RF PAD
            Dim rfPadODmm As Double = SafeDouble(row.Cells("RF_PAD_OD_1").Value)
            Dim rfPadThkMm As Double = SafeDouble(row.Cells("RF_PAD_THK_1").Value)
            Dim includePad As Boolean = (rfPadODmm > 0 AndAlso rfPadThkMm > 0)

            Dim includeElbow As Boolean = CBool(row.Cells("ELBOW").Value)
            Dim elbowAngleDeg As Double = SafeDouble(row.Cells("ELBOW_ANGLE").Value)

            Dim includeMidPipe As Boolean = If(IsDBNull(row.Cells("Inc_Pipe").Value), False, CBool(row.Cells("Inc_Pipe").Value))
            Dim midPipeLengthMm As Double = SafeDouble(row.Cells("Pipe_Length").Value)

            Dim placementType As String = row.Cells("PLACEMENT_TYPE").Value.ToString().Trim().ToUpper()
            Dim offsetDistMm As Double = 0

            If placementType = "OFFSET" Then
                If Not IsDBNull(row.Cells("Y_Dist").Value) Then
                    offsetDistMm = CDbl(row.Cells("Y_Dist").Value)
                End If
            End If

            '==================================================
            ' MANWAY DETECTION
            '=================================================
            Dim isManway As Boolean = nozzleName.StartsWith("M") OrElse remarks.Contains("MANWAY")

            '==================================================
            ' ✅ PIPE LENGTH CALCULATED IN BACKEND (NO COLUMN)
            '==================================================
            Dim pipeLengthMm As Double = CalculatePipeLength_Shell(nps, outsideProjMm, flangeClass, isManway, includeElbow)

            ' Store internally for reference
            row.Tag = pipeLengthMm

            '==================================================
            ' 3️ DERIVE PIPE / NOZZLE DIMENSIONS
            '==================================================
            Dim nozzleODmm As Double
            Dim pipeIDmm As Double = 0.0

            If isManway Then
                '------------------------------------------
                ' 🟢 MANWAY → NO SCHEDULE
                '------------------------------------------
                nozzleODmm = GetPipeOD_mm(nps)
            Else
                '------------------------------------------
                ' 🟢 PIPE NOZZLE → SIZE + SCH
                '------------------------------------------
                Dim pipe As PipeDim = GetPipeDim_BySizeAndSchedule(pipeTable, nps, schedule)

                nozzleODmm = pipe.OD
                pipeIDmm = pipe.ID
            End If

            ' RF Pad ID = Pipe OD
            Dim rfPadIDmm As Double = nozzleODmm

            '==================================================
            '4 CREATE SHELL NOZZLE CUT
            '==================================================
            CreateShellNozzle_CircleCut(invApp, shellOcc, nozzleIndex:=nozzleName, nozzleHeightMm:=nozzleHeightMm, nozzleDiaMm:=nozzleODmm, angleDeg:=angleDeg, offsetDistMm)

            '==================================================
            ' CREATE & BUILD NOZZLE SUB-ASSEMBLY
            '==================================================
            Dim nozAsm As AssemblyDocument = CreateNozzleSubAssembly(invApp, folderPath, "Nozzle_" & nozzleName)

            Dim parts As Dictionary(Of String, String) = GetNozzleComponentPaths(invApp, projectFolder:=folderPath, nozzleName:=nozzleName, nps:=nps, remarks,
            isTopHead:=False, isBottomHead:=False, isManway:=isManway, xMm:=0, yMm:=0, includePad:=includePad, includeElbow:=includeElbow, flangeClass:=flangeClass)

            If Not parts.ContainsKey("PIPE") OrElse Not parts.ContainsKey("FLANGE") Then
                Throw New Exception("❌ Missing PIPE or FLANGE for nozzle " & nozzleName)
            End If

            Dim pipePath As String = parts("PIPE")
            Dim flangePath As String = parts("FLANGE")
            Dim padPath As String = If(parts.ContainsKey("PAD"), parts("PAD"), "")
            Dim elbowPath As String = If(parts.ContainsKey("ELBOW"), parts("ELBOW"), "")

            '--------------------------------------------------
            ' Build nozzle sub-assembly (SHELL)
            '--------------------------------------------------
            BuildNozzleAssembly_Shell(invApp, nozAsm, pipePath, flangePath, padPath, elbowPath, includeElbow, elbowAngleDeg, SelectedClient, nozzleName,
                         nozzleODmm, pipeThkMm, pipeLengthMm, outsideProjMm, rfPadODmm, rfPadThkMm, nps, isManway, includeMidPipe, midPipeLengthMm)

            nozAsm.Update()

            '==================================================
            ' PLACE & CONSTRAIN NOZZLE TO SHELL
            '==================================================
            Dim nozOcc As ComponentOccurrence = PlaceNozzleSubAssembly(invApp, asmDoc, nozAsm.FullFileName)

            ' Shell radial nozzle → Y offset = 0
            ConstrainNozzleToShell(asmDoc, shellOcc, nozOcc, nozzleHeightMm, offsetDistMm, angleDeg, nozzleName, SelectedClient, isManway)

        Next

#End Region

#Region "HEAD NOZZLES – CUT + PLACE + CONSTRAIN (FROM DGV)"

        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            If row.IsNewRow Then Continue For

            '==================================================
            ' 1️⃣ READ VALUES FROM DGV
            '==================================================
            Dim nozzleName As String = row.Cells("Nozzle_Mark").Value.ToString().Trim().ToUpper()
            Dim nps As String = row.Cells("Size_NPS").Value.ToString().Trim()
            Dim headLocation As String = row.Cells("NOZZLE_LOCATION").Value.ToString().Trim().ToUpper()
            Dim schedule As String = row.Cells("Nozzle_Sch").Value.ToString().Trim().ToUpper()
            Dim placementType As String = row.Cells("PLACEMENT_TYPE_1").Value.ToString().Trim().ToUpper()
            Dim remarks As String = row.Cells("REMARKS").Value.ToString().Trim().ToUpper()
            Dim outsideProjMm As Double = If(IsDBNull(row.Cells("OUTSIDE_PROJECTION").Value), 0.0, CDbl(row.Cells("OUTSIDE_PROJECTION").Value))
            Dim flangeClass As String = row.Cells("Flange_Class").Value.ToString().Trim()

            ' RF PAD
            Dim rfPadODmm As Double = SafeDouble(row.Cells("RF_PAD_OD").Value)
            Dim rfPadThkMm As Double = SafeDouble(row.Cells("RF_PAD_THK").Value)

            Dim includePad As Boolean = (rfPadODmm > 0 AndAlso rfPadThkMm > 0)

            ' STIFFENER OPTIONS
            Dim addStiffener As Boolean = If(IsDBNull(row.Cells("Stiffener_Head").Value), False, CBool(row.Cells("Stiffener_Head").Value))
            'Dim flipPattern As Boolean = If(IsDBNull(row.Cells("FLIP").Value), False, CBool(row.Cells("FLIP").Value))

            Dim pipeLengthMm As Double = CalculatePipeLength_Head(row, nps, outsideProjMm, flangeClass, remarks, invApp, blindFlangeOcc)
            Dim pipeThkMm As Double = If(IsDBNull(row.Cells("Nozzle_THK").Value), 0.0, CDbl(row.Cells("Nozzle_THK").Value))

            Dim xMm As Double = SafeDouble(row.Cells("X_MM").Value)
            Dim yMm As Double = SafeDouble(row.Cells("Y_MM").Value)

            '==================================================
            ' 2️⃣ MANWAY DETECTION
            '=================================================
            Dim isManway As Boolean = nozzleName.StartsWith("M") OrElse remarks.Contains("MANWAY")

            '==================================================
            ' 3️⃣ DERIVE PIPE / NOZZLE DIMENSIONS
            '==================================================
            Dim nozzleODmm As Double
            Dim pipeIDmm As Double = 0.0

            If isManway Then
                '------------------------------------------
                ' 🟢 MANWAY → NO SCHEDULE
                '------------------------------------------
                nozzleODmm = GetPipeOD_mm(nps)
            Else
                '------------------------------------------
                ' 🟢 PIPE NOZZLE → SIZE + SCH
                '------------------------------------------
                Dim pipe As PipeDim = GetPipeDim_BySizeAndSchedule(pipeTable, nps, schedule)

                nozzleODmm = pipe.OD
                pipeIDmm = pipe.ID
            End If

            ' RF Pad ID = Pipe OD
            Dim rfPadIDmm As Double = nozzleODmm

            '==================================================
            ' 3️⃣ TOP COVER NOZZLES (RADIAL)
            '==================================================
            If headLocation = "TOP" AndAlso placementType = "RADIAL" Then

                Dim radiusMm As Double = CDbl(row.Cells("RADIUS_MM").Value)
                Dim angleDeg As Double = CDbl(row.Cells("ANGLE_DEG").Value)

                '--------------------------------------------------
                ' Determine target occurrence and sketch plane
                ' RB_RT_BF checked → Blind Flange + YZ Plane
                ' Otherwise        → Top Cover   + XZ Plane
                '--------------------------------------------------
                Dim targetRadialOcc As ComponentOccurrence = Nothing
                Dim radialSketchPlane As String = "XZ Plane"

                If RB_RT_BF.Checked Then
                    If blindFlangeOcc Is Nothing Then
                        MessageBox.Show("❌ Blind Flange occurrence is not placed. Cannot create nozzle cut.",
                            "Nozzle Cut")
                        Exit Sub
                    End If
                    targetRadialOcc = blindFlangeOcc
                    radialSketchPlane = "YZ Plane"
                Else
                    If topCoverOcc Is Nothing Then
                        MessageBox.Show("❌ Top Cover occurrence is Nothing. Cannot create nozzle cut.",
                            "Nozzle Cut")
                        Exit Sub
                    End If
                    targetRadialOcc = topCoverOcc
                    radialSketchPlane = "XZ Plane"
                End If

                '----------------------------------------------
                ' A) CUT — pass sketch plane name
                '----------------------------------------------
                CreateNozzleCut(invApp, targetRadialOcc, nozzleName, nozzleODmm, radiusMm, angleDeg, radialSketchPlane)

                '----------------------------------------------
                ' B) CREATE AXES AT CUT CENTER
                '----------------------------------------------
                CreateXAxisAtNozzleCutCenter(invApp, targetRadialOcc, nozzleName, radiusMm, angleDeg, radialSketchPlane)
                CreateYAxisAtNozzleCutCenter(invApp, targetRadialOcc, nozzleName, radiusMm, angleDeg)

                '----------------------------------------------
                ' C) CREATE NOZZLE SUB-ASSEMBLY
                '----------------------------------------------
                Dim nozAsm As AssemblyDocument = CreateNozzleSubAssembly(invApp, folderPath, "Nozzle_" & nozzleName)

                '----------------------------------------------
                ' D) GET COMPONENT PATHS
                '----------------------------------------------
                Dim isTopHead As Boolean = (headLocation = "TOP")
                Dim parts As Dictionary(Of String, String) = GetNozzleComponentPaths(invApp, projectFolder:=folderPath, nozzleName:=nozzleName, nps:=nps, remarks, isTopHead:=True, isBottomHead:=False,
                            isManway:=isManway, xMm:=0, yMm:=0, includePad:=includePad)

                Dim pipePath As String = parts("PIPE")
                Dim flangePath As String = parts("FLANGE")
                Dim padPath As String = If(parts.ContainsKey("PAD"), parts("PAD"), "")

                '----------------------------------------------
                ' E) BUILD NOZZLE (TOP COVER)
                '----------------------------------------------
                BuildNozzleAssembly_TopPlate(invApp, nozAsm, pipePath, flangePath, padPath, nozzleName, outsideProjMm, nozzleODmm, pipeThkMm, pipeLengthMm, rfPadODmm, rfPadThkMm, blindFlangeOcc:=blindFlangeOcc)

                nozAsm.Update()

                '----------------------------------------------
                ' F) PLACE NOZZLE INTO MAIN ASSEMBLY
                '----------------------------------------------
                Dim nozOcc As ComponentOccurrence = PlaceNozzleSubAssembly(invApp, asmDoc, nozAsm.FullFileName)

                '----------------------------------------------
                ' G) CONSTRAIN TO TOP COVER
                '----------------------------------------------
                Dim targetConstrainOcc As ComponentOccurrence = Nothing

                If RB_RT_BF.Checked Then
                    targetConstrainOcc = blindFlangeOcc
                Else
                    targetConstrainOcc = topCoverOcc
                End If

                ConstrainNozzleToTopCover(asmDoc, targetConstrainOcc, nozOcc, radiusMm, angleDeg, nozzleName, remarks)

                '----------------------------------------------
                ' H) ADD STIFFENER (OPTIONAL)
                '----------------------------------------------
                If addStiffener Then

                    '==================================================
                    ' ✅ Get stiffener starting angle from Form3 DGV
                    '==================================================
                    Dim info As StiffenerInfo = GetStiffenerInfoFromForm3(nozzleName)

                    Dim ang1 As Double = -info.AngleDeg
                    Dim ang2 As Double = -(info.AngleDeg + 90)

                    '==================================================
                    ' ✅ Create 2 stiffener reference planes
                    '==================================================
                    CreateNozzleStiffenerReferencePlanes(invApp, nozOcc, ang1, ang2)

                    Dim stiffOcc As ComponentOccurrence = PlaceAndConstrainNozzleStiffener_InNozzleAsm(invApp, nozAsm, folderPath, nozzleName, ang1, ang2, info.HeightMm, info.DistanceMm)

                    CreateCircularPattern_NozzleStiffener(invApp, nozOcc, stiffOcc, info.Count, info.AngleDeg, info.Direction, info.anglebwstiffener)

                End If

            End If


            If headLocation = "TOP" AndAlso placementType = "XY DIRECTION" Then

                '--------------------------------------------------
                ' Determine target occurrence for nozzle cut + constraint
                ' RB_RT_BF checked → Blind Flange
                ' Otherwise        → Top Cover (headOcc / topCoverOcc)
                '--------------------------------------------------
                Dim targetHeadOcc As ComponentOccurrence = Nothing
                Dim sketchPlaneName As String

                If RB_RT_BF.Checked Then
                    If blindFlangeOcc Is Nothing Then
                        MessageBox.Show("❌ Blind Flange occurrence is not placed. Cannot create nozzle cut.", "Nozzle Cut")
                        Exit Sub
                    End If
                    targetHeadOcc = blindFlangeOcc
                    sketchPlaneName = "YZ Plane"
                Else
                    If headOcc Is Nothing Then
                        MessageBox.Show("❌ Head occurrence is Nothing. Cannot create nozzle cut.", "Nozzle Cut")
                        Exit Sub
                    End If
                    targetHeadOcc = headOcc
                    sketchPlaneName = "XZ Plane"
                End If

                'A) Cut opening
                ' Standard call sites — add "XZ Plane" at the end
                CreateNozzleCutOnTopFlatHead_XY(invApp, targetHeadOcc, nozzleName, nozzleODmm, xMm, yMm, sketchPlaneName)

                'B) Create nozzle subassembly
                Dim nozAsm As AssemblyDocument = CreateNozzleSubAssembly(invApp, folderPath, "Nozzle_" & nozzleName)

                'C) Get component paths
                Dim parts = GetNozzleComponentPaths(invApp, projectFolder:=folderPath, nozzleName:=nozzleName, nps:=nps, remarks, isTopHead:=True, isBottomHead:=False, isManway:=isManway, xMm, yMm, includePad:=includePad)

                Dim pipePath As String = ""
                Dim flangePath As String = ""
                Dim padPath As String = ""

                If remarks.ToUpper().Contains("DIP PIPE") AndAlso SelectedClient = "ADNOC" Then

                    pipePath = parts("PIPE1")
                    flangePath = parts("FLANGE1")

                Else

                    pipePath = parts("PIPE")
                    flangePath = parts("FLANGE")

                End If


                If parts.ContainsKey("PAD") Then
                    padPath = parts("PAD")
                End If

                'D) Build nozzle assembly
                BuildNozzleAssembly_TopFlatHead(invApp, nozAsm, parts, remarks, nozzleName, xMm, yMm, outsideProjMm, nozzleODmm, pipeThkMm, pipeLengthMm, rfPadODmm, rfPadThkMm)
                nozAsm.Update()

                'E) Place into main assembly
                Dim nozOcc = PlaceNozzleSubAssembly(invApp, asmDoc, nozAsm.FullFileName)

                'F) Constrain to top flat head
                ConstrainNozzleToTopFlatHead_XY(invApp, asmDoc, targetHeadOcc, nozOcc, xMm, yMm, remarks)

                If addStiffener Then

                    '==================================================
                    ' ✅ Get stiffener starting angle from Form3 DGV
                    '==================================================
                    Dim info As StiffenerInfo = GetStiffenerInfoFromForm3(nozzleName)

                    Dim ang1 As Double = -info.AngleDeg
                    Dim ang2 As Double = -(info.AngleDeg + 90)

                    '==================================================
                    ' ✅ Create 2 stiffener reference planes
                    '==================================================
                    CreateNozzleStiffenerReferencePlanes(invApp, nozOcc, ang1, ang2)

                    Dim stiffOcc As ComponentOccurrence = PlaceAndConstrainNozzleStiffener_InNozzleAsm(invApp, nozAsm, folderPath, nozzleName, ang1, ang2, info.HeightMm, info.DistanceMm)

                    CreateCircularPattern_NozzleStiffener(invApp, nozOcc, stiffOcc, info.Count, info.AngleDeg, info.Direction, info.anglebwstiffener)

                End If

            End If

            If headLocation = "BOTTOM" AndAlso placementType = "XY DIRECTION" Then

                'Dim xMm As Double = CDbl(row.Cells("X_MM").Value)
                'Dim yMm As Double = CDbl(row.Cells("Y_MM").Value)

                '----------------------------------------------
                ' A) CUT ELLIPSOIDAL HEAD
                '----------------------------------------------
                CreateNozzleCutOnEllipsoidalHead_XY(invApp, headOcc, nozzleName, nozzleODmm, xMm, yMm)

                '----------------------------------------------
                ' B) CREATE NOZZLE SUB-ASSEMBLY
                '----------------------------------------------
                Dim nozAsm As AssemblyDocument = CreateNozzleSubAssembly(invApp, folderPath, "Nozzle_" & nozzleName)

                '----------------------------------------------
                ' C) GET COMPONENT PATHS
                '----------------------------------------------
                Dim isTopHead As Boolean = False


                Dim parts As Dictionary(Of String, String) = GetNozzleComponentPaths(invApp, projectFolder:=folderPath, nozzleName:=nozzleName, nps:=nps, remarks,
                            isTopHead:=False, isBottomHead:=True, isManway:=isManway, xMm, yMm, includePad:=includePad)

                Dim pipePath As String = parts("PIPE")
                Dim flangePath As String = parts("FLANGE")
                Dim padPath As String = If(parts.ContainsKey("PAD"), parts("PAD"), "")

                '----------------------------------------------
                ' D) BUILD NOZZLE (ELLIPSOIDAL HEAD)
                '----------------------------------------------
                BuildNozzleAssembly_EllipsoidalHead(invApp, nozAsm, pipePath, flangePath, padPath, nozzleName, xMm, yMm, outsideProjMm, nozzleODmm, pipeThkMm, pipeLengthMm, rfPadODmm, rfPadThkMm)
                nozAsm.Update()

                '----------------------------------------------
                ' E) PLACE INTO MAIN ASSEMBLY
                '----------------------------------------------
                Dim nozOcc As ComponentOccurrence = PlaceNozzleSubAssembly(invApp, asmDoc, nozAsm.FullFileName)

                '----------------------------------------------
                ' F) CONSTRAIN TO BOTTOM HEAD
                '----------------------------------------------
                ConstrainNozzleToEllipsoidalHead_XY(asmDoc, headOcc, nozOcc, xMm, yMm)

                '----------------------------------------------
                ' G) ADD STIFFENER (OPTIONAL)
                '----------------------------------------------
                'If addStiffener Then

                '    Dim stiffOcc As ComponentOccurrence = PlaceAndConstrainNozzleStiffener(invApp, asmDoc, nozOcc, folderPath, nozzleName)
                '    stiffOcc.Name = nozzleName & "_STIFFENER"
                '    Dim isSymmetric As Boolean = Not flipPattern
                '    CreateCircularPattern_NozzleStiffener(asmDoc, stiffOcc, nozOcc, occurrenceCount:=2, totalAngleDeg:=90, isSymmetric:=isSymmetric)

                'End If

            End If

        Next

#End Region

#Region "VORTEX BREAKER"

        '==================================================
        ' AFTER ALL NOZZLES ARE CREATED
        '==================================================
        AddVortexBreaker_NozzleFromDGV(invApp, folderPath, DGV_Nozzle_Tab_Head)

#End Region

#Region "MANWAY GASKET & COVER"

        '==================================================
        ' 🟢 PLACE & CONSTRAIN MANWAY GASKET AND COVER (M1 ONLY)
        '==================================================
        Dim nozzleOcc_M1 As ComponentOccurrence = Nothing
        Dim gasketOcc_M1 As ComponentOccurrence = Nothing
        Dim coverOcc_M1 As ComponentOccurrence = Nothing

        ' Find nozzle M1 in shell assembly
        For Each occ As ComponentOccurrence In asmDoc.ComponentDefinition.Occurrences
            If occ.Name.ToUpper().Contains("NOZZLE_M1") Then
                nozzleOcc_M1 = occ
                Exit For
            End If
        Next

        If nozzleOcc_M1 IsNot Nothing Then

            '----------------------------
            ' 1️⃣ Place & Constrain Gasket
            '----------------------------
            gasketPath = IO.Path.Combine(folderPath, "PT_NO_20_GASKET_FOR_MANWAY.ipt")

            If IO.File.Exists(gasketPath) Then
                gasketOcc_M1 = asmDoc.ComponentDefinition.Occurrences.Add(gasketPath, invApp.TransientGeometry.CreateMatrix())
                PlaceAndConstrainManwayGasket(asmDoc, nozzleOcc_M1, gasketOcc_M1)
            End If

            '----------------------------
            ' 2️⃣ Place & Constrain Cover Plate
            '----------------------------
            Dim coverPath As String = IO.Path.Combine(folderPath, "PT_NO_15_COVER_PLATE_FOR_MANWAY.ipt")

            If IO.File.Exists(coverPath) AndAlso gasketOcc_M1 IsNot Nothing Then
                coverOcc_M1 = asmDoc.ComponentDefinition.Occurrences.Add(coverPath, invApp.TransientGeometry.CreateMatrix())
                PlaceAndConstrainManwayCover(asmDoc, gasketOcc_M1, coverOcc_M1)
            End If

            CreateManwayCoverPlate_AnglePlane_6Deg(invApp, coverOcc_M1)

        End If

#End Region

#Region "DAVIT ARM ASSEMBLY"

        '==================================================
        ' 🟢 PLACE & CONSTRAIN DAVIT (M1 ONLY)
        '==================================================
        If SelectedClient = "ARAMCO" Then

            Dim davitAsmPath As String = IO.Path.Combine(folderPath, "MANWAY_DAVIT_ASSM.iam")

            If IO.File.Exists(davitAsmPath) AndAlso nozzleOcc_M1 IsNot Nothing Then
                Dim davitOcc As ComponentOccurrence = asmDoc.ComponentDefinition.Occurrences.Add(davitAsmPath, invApp.TransientGeometry.CreateMatrix())
                PlaceAndConstrainManwayDavit(asmDoc, nozzleOcc_M1, davitOcc)
            End If

        ElseIf SelectedClient = "ADNOC" Then

            Dim davitAsmPath As String = IO.Path.Combine(folderPath, "Adnoc\MANWAY_DAVIT_ASSEMBLY_NEW.iam")

            If IO.File.Exists(davitAsmPath) AndAlso nozzleOcc_M1 IsNot Nothing Then
                Dim davitOcc As ComponentOccurrence = asmDoc.ComponentDefinition.Occurrences.Add(davitAsmPath, invApp.TransientGeometry.CreateMatrix())
                PlaceAndConstrainManwayDavit_ADNOC(asmDoc, nozzleOcc_M1, davitOcc)
            End If

        ElseIf SelectedClient = "QATAR" Then

            Dim davitAsmPath As String = IO.Path.Combine(folderPath, "Qatar\MANWAY_DAVIT_ASSM_QATAR.iam")

            If IO.File.Exists(davitAsmPath) AndAlso nozzleOcc_M1 IsNot Nothing Then
                Dim davitOcc As ComponentOccurrence = asmDoc.ComponentDefinition.Occurrences.Add(davitAsmPath, invApp.TransientGeometry.CreateMatrix())
                PlaceAndConstrainManwayDavitQATAR(asmDoc, nozzleOcc_M1, davitOcc)
            End If

        End If


#End Region

#Region "MANWAY HANDLE"

        Dim handlePath As String = IO.Path.Combine(folderPath, "PT_NO_33_MANWAY_HANDLE.ipt")

        If IO.File.Exists(handlePath) AndAlso coverOcc_M1 IsNot Nothing Then
            PlaceAndConstrainManwayHandles(asmDoc, coverOcc_M1, handlePath, invApp)
        End If

#End Region

#Region "LIFTING LUG"

        Dim angle_1 As Double = CDbl(txt_LL_Ang.Text)
        Dim angle_2 As Double = CDbl(txt_LL_Ang.Text) + 90
        Dim liftingLugOcc As ComponentOccurrence = PlaceAndConstrainLiftingLugAssembly(invApp, asmDoc, shellOcc, folderPath, angle_1, angle_2)
        CreateCircularPattern_LiftingLugs(invApp, asmDoc, liftingLugOcc)

#End Region

#Region "TOP COVER LIFTING LUG"

        '==================================================
        ' LIFTING LUG ANGLES (SAFE)
        '==================================================
        Dim angle1_TCLL As Double = 0.0
        Dim angle2_TCLL As Double = 0.0

        Try
            Double.TryParse(33, angle1_TCLL)
            angle2_TCLL = (angle1_TCLL + 90.0) Mod 360.0
        Catch ex As Exception
            angle1_TCLL = 0.0
            angle2_TCLL = 90.0
        End Try

        '==================================================
        ' CREATE REFERENCE PLANES (SAFE)
        '==================================================
        Try
            If topCoverOcc IsNot Nothing Then
                CreateLiftingLugReferencePlanes(invApp, topCoverOcc, angle1_TCLL, angle2_TCLL)
            End If
        Catch ex As Exception
            Debug.WriteLine(ex.Message)
        End Try

        If SelectedClient = "ADNOC" Then
            Dim llOcc As ComponentOccurrence
            llOcc = PlaceAndConstrainTopCoverLLAssembly(invApp, asmDoc, topCoverOcc, folderPath, angle1_TCLL, angle2_TCLL, -380)
            llOcc = PlaceAndConstrainTopCoverLLAssembly(invApp, asmDoc, topCoverOcc, folderPath, angle1_TCLL, angle2_TCLL, 380)
        ElseIf SelectedClient = "QATAR" Then
            Dim llOcc As ComponentOccurrence
            llOcc = PlaceAndConstrainTopCoverLLAssembly(invApp, asmDoc, topCoverOcc, folderPath, angle1_TCLL, angle2_TCLL, -380)
            llOcc = PlaceAndConstrainTopCoverLLAssembly(invApp, asmDoc, topCoverOcc, folderPath, angle1_TCLL, angle2_TCLL, 380)
        End If

#End Region

#Region "VESSEL SUPPORT SYSTEM"

        '==================================================
        ' Decide Support Type
        '==================================================
        Dim supportType As String = ""

        If RB_VS_Leg.Checked Then
            supportType = "LEG"

        ElseIf RB_VS_Lug.Checked Then
            supportType = "LUG"

        ElseIf RB_VS_Skirt.Checked Then
            supportType = "SKIRT"

        Else
            MessageBox.Show("Please select Vessel Support Type", "Support Selection")
            Exit Sub
        End If

        '==================================================
        ' Execute Support Placement
        '==================================================
        Select Case supportType

                        '-----------------------------------------------
                        ' LEG SUPPORT
                        '-----------------------------------------------
            Case "LEG"

                Dim legType As String

                If Rbn_Angle.Checked Then
                    legType = "ANGLE"
                ElseIf Rbn_Beam.Checked Then
                    legType = "BEAM"
                Else
                    MessageBox.Show("Please select Leg Support Type", "Leg Support")
                    Exit Sub
                End If

                Dim legOcc As ComponentOccurrence = PlaceAndConstrainTankLegSupportAssembly(invApp, asmDoc, shellOcc, folderPath, legType)

                'Create 4 legs around vessel
                CreateCircularPattern_TankLegSupports(invApp, asmDoc, legOcc)

                        '-----------------------------------------------
                        ' LUG SUPPORT
                        '-----------------------------------------------
            Case "LUG"

                '----------------------------------
                ' Decide Lug Type
                '----------------------------------
                Dim lugType As String = ""

                If Rbn_Lug_type1.Checked Then
                    lugType = "TYPE1"

                ElseIf Rbn_Lug_type2.Checked Then
                    lugType = "TYPE2"

                ElseIf Rbn_Lug_type3.Checked Then
                    lugType = "TYPE3"

                Else
                    MessageBox.Show("Please select Lug Support Type", "Lug Support")
                    Exit Sub
                End If

                '----------------------------------
                ' Place Lug Support
                '----------------------------------
                Dim Angle As Double = txt_LugS_Angle.Text
                Dim lugOcc As ComponentOccurrence = PlaceAndConstrainLugSupportAssembly(invApp, asmDoc, shellOcc, folderPath, Angle)

                'Create opposite lug
                CreateCircularPattern_LugSupports(invApp, asmDoc, lugOcc)

            '-----------------------------------------------
