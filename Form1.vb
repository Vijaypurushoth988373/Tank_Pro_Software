        '==========================================
        ' ✅ READ VALUES SAFELY
        '==========================================
        Dim placementType As String = If(row.Cells("PLACEMENT_TYPE_1").Value, "").ToString().Trim().ToUpper()
        Dim nps As String = If(row.Cells("Size_NPS").Value, "").ToString().Trim()
        Dim sch As String = If(row.Cells("Nozzle_Sch").Value, "").ToString().Trim()
        Dim remarks As String = If(row.Cells("REMARKS").Value, "").ToString().Trim().ToUpper()

