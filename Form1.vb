    Private Sub PlaceBodyFlangeComponents(invApp As Inventor.Application, asmDoc As AssemblyDocument, bodyFlangePath As String, blindFlangePath As String, gasketBFPath As String,
        ByRef bodyFlangeOcc As ComponentOccurrence, ByRef gasketBFOcc As ComponentOccurrence, ByRef blindFlangeOcc As ComponentOccurrence)

        Dim compDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim tg As TransientGeometry = invApp.TransientGeometry

        ' Explicitly qualify as Inventor.Matrix to avoid ambiguity
        ' with System.Drawing.Drawing2D.Matrix
        Dim identityMatrix As Inventor.Matrix = tg.CreateMatrix()

        '----------------------------------------------
        ' Validate all three paths before placing anything
        '----------------------------------------------
        If String.IsNullOrWhiteSpace(bodyFlangePath) OrElse
       Not IO.File.Exists(bodyFlangePath) Then
            MessageBox.Show("❌ Body Flange file not found:" &
                        vbCrLf & bodyFlangePath, "Place Components")
            Exit Sub
        End If

        If String.IsNullOrWhiteSpace(blindFlangePath) OrElse
       Not IO.File.Exists(blindFlangePath) Then
            MessageBox.Show("❌ Blind Flange file not found:" &
                        vbCrLf & blindFlangePath, "Place Components")
            Exit Sub
        End If

        If String.IsNullOrWhiteSpace(gasketBFPath) OrElse
       Not IO.File.Exists(gasketBFPath) Then
            MessageBox.Show("❌ Gasket file not found:" &
                        vbCrLf & gasketBFPath, "Place Components")
            Exit Sub
        End If

        '----------------------------------------------
        ' 1️⃣ PLACE BODY FLANGE
        '----------------------------------------------
        Try
            bodyFlangeOcc = compDef.Occurrences.Add(bodyFlangePath, identityMatrix)
            bodyFlangeOcc.Name = "BODY_FLANGE"
        Catch ex As Exception
            MessageBox.Show("❌ Failed to place Body Flange:" &
                        vbCrLf & ex.Message, "Place Components")
            Exit Sub
        End Try

        '----------------------------------------------
        ' 2️⃣ PLACE GASKET
        '----------------------------------------------
        Try
            gasketBFOcc = compDef.Occurrences.Add(gasketBFPath, identityMatrix)
            gasketBFOcc.Name = "GASKET_BF"
        Catch ex As Exception
            MessageBox.Show("❌ Failed to place Gasket:" &
                        vbCrLf & ex.Message, "Place Components")
            Exit Sub
        End Try

        '----------------------------------------------
        ' 3️⃣ PLACE BLIND FLANGE
        '----------------------------------------------
        Try
            blindFlangeOcc = compDef.Occurrences.Add(blindFlangePath, identityMatrix)
            blindFlangeOcc.Name = "BLIND_FLANGE"
        Catch ex As Exception
            MessageBox.Show("❌ Failed to place Blind Flange:" &
                        vbCrLf & ex.Message, "Place Components")
            Exit Sub
        End Try

        asmDoc.Update()

    End Sub
    Private Sub FillThickness(rowIndex As Integer, nps As String, sch As String)

        '==================================================
        ' Load pipe master table
        '==================================================
        Dim pipeTable As List(Of PipeDim) = LoadPipeTable()

        '==================================================
        ' Find matching pipe
        '==================================================
        Dim pipe As PipeDim = GetPipeDim_BySizeAndSchedule(pipeTable, nps, sch)
        Dim thkValue As Double = pipe.THK

        '==================================================
        ' Set Thickness in DGV
        '==================================================
        Dim row As DataGridViewRow = DGV_Nozzle_Tab_Head.Rows(rowIndex)
        row.Cells("Nozzle_THK").Value = thkValue.ToString("0.00")

        '==================================================
        ' ✅ Lock Thickness cell after auto-fill
        '==================================================
        With row.Cells("Nozzle_THK")
            .ReadOnly = True
            .Style.BackColor = System.Drawing.Color.LightGray
        End With

    End Sub

    Private Function HasDipPipeInNozzleSchedule() As Boolean

        ' Find the REMARKS column index by header name (case-insensitive)
        Dim remarksColIndex As Integer = -1

        For Each col As DataGridViewColumn In DGV_Nozzle_Tab_Head.Columns
            If String.Equals(col.HeaderText.Trim(), "REMARKS", StringComparison.OrdinalIgnoreCase) Then
                remarksColIndex = col.Index
                Exit For
            End If
        Next

        ' If column not found, can't determine — skip to be safe
        If remarksColIndex < 0 Then
            Return False
        End If

        ' Scan every row for "DIP PIPE" in the REMARKS column
        For Each row As DataGridViewRow In DGV_Nozzle_Tab_Head.Rows

            ' Skip the new-row placeholder (last empty row in DGV)
            If row.IsNewRow Then Continue For

            Dim cellValue As String = ""

            If row.Cells(remarksColIndex).Value IsNot Nothing Then
                cellValue = row.Cells(remarksColIndex).Value.ToString().Trim()
            End If

            If String.Equals(cellValue, "DIP PIPE", StringComparison.OrdinalIgnoreCase) Then
                Return True
            End If

        Next

        Return False

    End Function

    Private Function GetElbowAmm(nps As String) As Double

        Select Case nps.Trim()

            Case "1/2''" : Return 38
            Case "3/4''" : Return 38
            Case "1''" : Return 38
            Case "1 1/4''" : Return 48
            Case "1 1/2''" : Return 57
            Case "2''" : Return 76
            Case "2 1/2''" : Return 95
            Case "3''" : Return 114
            Case "3 1/2''" : Return 133
            Case "4''" : Return 152
            Case "5''" : Return 190
            Case "6''" : Return 229
            Case "8''" : Return 305
            Case "10''" : Return 381
            Case "12''" : Return 457
            Case "14''" : Return 533
            Case "16''" : Return 610
            Case "18''" : Return 686
            Case "20''" : Return 762
            Case "22''" : Return 838
            Case "24''" : Return 914

            Case Else
                Return 0.0

        End Select

