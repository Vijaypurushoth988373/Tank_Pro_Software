    Private Sub PopulateHeadNozzleDGV(defaultNozzles As Object(,))

        isLoadingNozzles = True
        DGV_Nozzle_Tab_Head.Rows.Clear()

        For i As Integer = 0 To defaultNozzles.GetLength(0) - 1

            Dim rowIndex As Integer = DGV_Nozzle_Tab_Head.Rows.Add()
            Dim row As DataGridViewRow = DGV_Nozzle_Tab_Head.Rows(rowIndex)

            Dim nps As String = defaultNozzles(i, 3).ToString()
            Dim sch As String = defaultNozzles(i, 4).ToString()

            '----------------------------------
            ' BASIC VALUES
            '----------------------------------
            row.Cells("Nozzle_Mark").Value = defaultNozzles(i, 0)
            row.Cells("SERVICE").Value = defaultNozzles(i, 1)
            row.Cells("QTY").Value = defaultNozzles(i, 2)

            '----------------------------------
            ' SIZE → SCHEDULE → THK
            '----------------------------------
            row.Cells("Size_NPS").Value = nps
            FillSchedulesForSize(rowIndex, nps)

            Dim comboCell As DataGridViewComboBoxCell = CType(row.Cells("Nozzle_Sch"), DataGridViewComboBoxCell)

            If comboCell.Items.Contains(sch) Then
                comboCell.Value = sch
            Else
                comboCell.Items.Add(sch)
                comboCell.Value = sch
            End If

            FillThickness(rowIndex, nps, sch)

            '----------------------------------
            ' OTHER VALUES
            '----------------------------------
            row.Cells("FLANGE_CLASS").Value = defaultNozzles(i, 6)
            row.Cells("FLANGE_TYPE").Value = defaultNozzles(i, 7)

            row.Cells("OUTSIDE_PROJECTION").Value = defaultNozzles(i, 8)
            row.Cells("RF_PAD_OD").Value = defaultNozzles(i, 9)
            row.Cells("RF_PAD_THK").Value = defaultNozzles(i, 10)

            row.Cells("REMARKS").Value = defaultNozzles(i, 11)
            row.Cells("NOZZLE_LOCATION").Value = defaultNozzles(i, 12)
            row.Cells("PLACEMENT_TYPE_1").Value = defaultNozzles(i, 13)

            row.Cells("RADIUS_MM").Value = defaultNozzles(i, 14)
            row.Cells("ANGLE_DEG").Value = defaultNozzles(i, 15)

            row.Cells("X_MM").Value = defaultNozzles(i, 16)
            row.Cells("Y_MM").Value = defaultNozzles(i, 17)

            ApplyNozzleRowRules(row)

        Next

        isLoadingNozzles = False

    End Sub

    Private Sub PopulateShellNozzleDGV(defaultShellNozzles As Object(,))

        isLoadingNozzles = True
        DGV_Nozzle_Tab_Shell.Rows.Clear()

        For i As Integer = 0 To defaultShellNozzles.GetLength(0) - 1

            Dim rowIndex As Integer = DGV_Nozzle_Tab_Shell.Rows.Add()
            Dim row As DataGridViewRow = DGV_Nozzle_Tab_Shell.Rows(rowIndex)

            Dim nps As String = defaultShellNozzles(i, 3).ToString()
            Dim sch As String = defaultShellNozzles(i, 4).ToString().Trim()

            '=================================================
            ' BASIC VALUES
            '=================================================
            row.Cells("NOZZLE_MARK_TEXT").Value = defaultShellNozzles(i, 0)
            row.Cells("NOZZLE_SERVICE_TEXT").Value = defaultShellNozzles(i, 1)
            row.Cells("NOZZLE_QTY_TEXT").Value = defaultShellNozzles(i, 2)

            '=================================================
            ' SIZE → SCHEDULE → THICKNESS
            '=================================================
            row.Cells("SIZE_TEXT").Value = nps

            If sch <> "-" Then

                FillSchforSize_Shell(rowIndex, nps)
                row.Cells("NOZZLE_SCH_SHELL").Value = sch
                FillThicknessShell(rowIndex, nps, sch)

            Else

                row.Cells("NOZZLE_SCH_SHELL").Value = "-"
                row.Cells("NOZZLE_THK_SHELL").ReadOnly = False

            End If

            '=================================================
            ' STANDARD VALUES (COMMON)
            '=================================================
            row.Cells("NOZZLE_FLANGE_CLASS_SHELL").Value = defaultShellNozzles(i, 6)
            row.Cells("NOZZLE_FLANGE_TYPE_SHELL").Value = defaultShellNozzles(i, 7)

            row.Cells("OUTSIDE_PROJECTION_SHELL").Value = defaultShellNozzles(i, 8)
            row.Cells("RF_PAD_OD_1").Value = defaultShellNozzles(i, 9)
            row.Cells("RF_PAD_THK_1").Value = defaultShellNozzles(i, 10)

            row.Cells("REMARKS_SHELL").Value = defaultShellNozzles(i, 11)
            row.Cells("NOZZLE_LOCATION_SHELL").Value = defaultShellNozzles(i, 12)
            row.Cells("PLACEMENT_TYPE").Value = defaultShellNozzles(i, 13)

            row.Cells("DIST_FROM_BASE_TEXT").Value = defaultShellNozzles(i, 14)
            row.Cells("Y_Dist").Value = defaultShellNozzles(i, 15)
            row.Cells("ORIENTATION_TEXT").Value = defaultShellNozzles(i, 16)

            '=================================================
            ' ADNOC EXTRA FIELDS (ONLY IF AVAILABLE)
            '=================================================
            If defaultShellNozzles.GetLength(1) >= 22 Then
                row.Cells("Stiffener_Shell").Value = defaultShellNozzles(i, 17)
                row.Cells("Elbow").Value = defaultShellNozzles(i, 18)
                row.Cells("Elbow_Angle").Value = defaultShellNozzles(i, 19)
                row.Cells("Inc_Pipe").Value = defaultShellNozzles(i, 20)
                row.Cells("Pipe_Length").Value = defaultShellNozzles(i, 21)
            End If
        Next

        isLoadingNozzles = False

    End Sub

