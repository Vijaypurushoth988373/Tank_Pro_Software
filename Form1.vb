    Public Function PlaceAndConstrainNamePlateAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String, angle1Deg As Double, angle2Deg As Double) As ComponentOccurrence

        '==================================================
        ' 1️⃣ NAME PLATE ASSEMBLY PATH
        '==================================================
        Dim namePlateAsmPath As String = IO.Path.Combine(folderPath, "NAME_PLATE_ASSEMBLY.iam")

        If Not IO.File.Exists(namePlateAsmPath) Then
            Throw New Exception("❌ Name Plate Assembly not found: " & namePlateAsmPath)
        End If

        '==================================================
        ' 2️⃣ PLACE NAME PLATE ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim namePlateOcc As ComponentOccurrence = asmDef.Occurrences.Add(namePlateAsmPath, tg.CreateMatrix())
        namePlateOcc.Grounded = False
        namePlateOcc.Name = "NAME_PLATE"

        '==================================================
        ' 3️⃣ SHELL DYNAMIC NP PLANES
        '==================================================
        Dim shellDef = shellOcc.Definition

        Dim planeName1 As String = "NP_Plane_" & angle1Deg.ToString("0")  '15
        Dim planeName2 As String = "NP_Plane_" & angle2Deg.ToString("0")  '105

        Dim shellNP1 As WorkPlane = shellDef.WorkPlanes.Item(planeName1)
        Dim shellNP2 As WorkPlane = shellDef.WorkPlanes.Item(planeName2)

        Dim shellXZ As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' 4️⃣ NAME PLATE PLANES
        '==================================================
        Dim npDef = namePlateOcc.Definition

        Dim npYZ As WorkPlane = npDef.WorkPlanes.Item("YZ Plane")
        Dim npCentre As WorkPlane = npDef.WorkPlanes.Item("Centre_Plane")
        Dim npXZ As WorkPlane = npDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' 5️⃣ CREATE GEOMETRY PROXIES – SHELL
        '==================================================
        Dim shellNP1p, shellNP2p, shellXZp As Object

        shellOcc.CreateGeometryProxy(shellNP1, shellNP1p)
        shellOcc.CreateGeometryProxy(shellNP2, shellNP2p)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZp)

        '==================================================
        ' 6️⃣ CREATE GEOMETRY PROXIES – NAME PLATE
        '==================================================
        Dim npYZp, npCentreP, npXZp As Object

        namePlateOcc.CreateGeometryProxy(npYZ, npYZp)
        namePlateOcc.CreateGeometryProxy(npCentre, npCentreP)
        namePlateOcc.CreateGeometryProxy(npXZ, npXZp)

        '==================================================
        ' 7️⃣ APPLY CONSTRAINTS (UPDATED)
        '==================================================

        '--------------------------------------------------
        ' ✅ 1) Shell NP_Plane_45 → Name Plate XZ → MATE
        '--------------------------------------------------
        cons.AddFlushConstraint(shellNP1p, npXZp, 0)

        '--------------------------------------------------
        ' ✅ 2) Shell NP_Plane_135 → Name Plate Centre_Plane → MATE
        '--------------------------------------------------
        cons.AddMateConstraint(shellNP2p, npCentreP, 0)

        '--------------------------------------------------
        ' ✅ 3) Shell XZ → Name Plate YZ → OFFSET FROM BASE
        '--------------------------------------------------
        Dim offsetCm As Double = (CDbl(txt_NP_Dist_Base.Text) / 10.0) - (CDbl(txt_EH_SF.Text) / 10.0)
        cons.AddFlushConstraint(shellXZp, npYZp, offsetCm)

        '==================================================
        ' 8️⃣ FINAL UPDATE
        '==================================================
        asmDoc.Update()

        Return namePlateOcc

    End Function

    Public Function PlaceAndConstrainNamePlateAssembly_QATAR(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String, angle1Deg As Double, angle2Deg As Double) As ComponentOccurrence

        '==================================================
        ' 1️ NAME PLATE ASSEMBLY PATH
        '==================================================
        Dim namePlateAsmPath As String = IO.Path.Combine(folderPath, "Qatar\QATAR_NAME_PLATE_ASSEMBLY.iam")

        If Not IO.File.Exists(namePlateAsmPath) Then
            Throw New Exception("❌ Name Plate Assembly not found: " & namePlateAsmPath)
        End If


        '==================================================
        ' 2️ PLACE NAME PLATE ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        Dim namePlateOcc As ComponentOccurrence = asmDef.Occurrences.Add(namePlateAsmPath, tg.CreateMatrix())
        namePlateOcc.Grounded = False
        namePlateOcc.Name = "NAME_PLATE"

        ' 3️⃣ GET SHELL PLANES (DYNAMIC)
        '==================================================
        Dim shellDef As PartComponentDefinition =
        shellOcc.Definition

        Dim planeName1 As String =
        "NP_Plane_" & angle1Deg.ToString("0")

        Dim planeName2 As String =
        "NP_Plane_" & angle2Deg.ToString("0")

        Dim shellPlane1 As WorkPlane =
        shellDef.WorkPlanes.Item(planeName1)

        Dim shellPlane2 As WorkPlane =
        shellDef.WorkPlanes.Item(planeName2)

        Dim shellXZ As WorkPlane =
        shellDef.WorkPlanes.Item("XZ Plane")


        '==================================================
        ' 4️⃣ GET NAME PLATE PLANES
        '==================================================
        Dim npDef As AssemblyComponentDefinition =
        namePlateOcc.Definition

        Dim npXY As WorkPlane =
        npDef.WorkPlanes.Item("XY Plane")

        Dim npYZ As WorkPlane =
        npDef.WorkPlanes.Item("YZ Plane")

        Dim npXZ As WorkPlane =
        npDef.WorkPlanes.Item("XZ Plane")


        '==================================================
        ' 5️⃣ CREATE GEOMETRY PROXIES – SHELL
        '==================================================
        Dim shellPlane1p, shellPlane2p, shellXZp As Object

        shellOcc.CreateGeometryProxy(shellPlane1, shellPlane1p)
        shellOcc.CreateGeometryProxy(shellPlane2, shellPlane2p)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZp)


        '==================================================
        ' 6️⃣ CREATE GEOMETRY PROXIES – NAME PLATE
        '==================================================
        Dim npXYp, npYZp, npXZp As Object

        namePlateOcc.CreateGeometryProxy(npXY, npXYp)
        namePlateOcc.CreateGeometryProxy(npYZ, npYZp)
        namePlateOcc.CreateGeometryProxy(npXZ, npXZp)


        '==================================================
        ' 7️⃣ APPLY QATAR CONSTRAINTS
        '==================================================

        '--------------------------------------------------
        ' 1️⃣ Shell NP_Plane_angle1 ↔ NP XY → FLUSH
        '--------------------------------------------------
        cons.AddFlushConstraint(shellPlane1p, npXYp, 0)


        '--------------------------------------------------
        ' 2️⃣ Shell NP_Plane_angle2 ↔ NP YZ → MATE
        '--------------------------------------------------
        cons.AddMateConstraint(shellPlane2p, npYZp, 0)


        '--------------------------------------------------
        ' 3️⃣ Shell XZ ↔ NP XZ → OFFSET
        '--------------------------------------------------
        Dim offsetCm As Double =
        (CDbl(txt_NP_Dist_Base_QTR.Text) / 10.0) -
        (CDbl(txt_EH_SF.Text) / 10.0)

        cons.AddFlushConstraint(shellXZp, npXZp, offsetCm)


        '==================================================
        ' 8️⃣ UPDATE ASSEMBLY
        '==================================================
        asmDoc.Update()

        Return namePlateOcc

    End Function

    '==========================================================================================
    ' CONSTRAIN BODY FLANGE COMPONENTS
    '
    ' SHELL → BODY FLANGE:
    '   1) SHELL_TOP_PLANE  → BOTTOM_PLANE  : MATE
    '   2) YZ Plane         → XZ Plane      : FLUSH
    '   3) XY Plane         → XY Plane      : FLUSH
    '
    ' BODY FLANGE → GASKET:
    '   1) YZ Plane         → XZ Plane      : MATE
    '   2) XZ Plane         → YZ Plane      : FLUSH
    '   3) XY Plane         → XY Plane      : FLUSH
    '
    ' GASKET → BLIND FLANGE:
    '   1) TOP_PLANE        → BOTTOM_PLANE  : MATE
    '   2) YZ Plane         → XZ Plane      : FLUSH
    '   3) XY Plane         → XY Plane      : FLUSH
    '==========================================================================================
    Public Sub ConstrainBodyFlangeComponents(invApp As Inventor.Application, asmDoc As AssemblyDocument, bodyFlangeOcc As ComponentOccurrence,
        gasketBFOcc As ComponentOccurrence, blindFlangeOcc As ComponentOccurrence, shellOcc As ComponentOccurrence)

        Dim constraints As AssemblyConstraints = asmDoc.ComponentDefinition.Constraints

        '==================================================
        ' SHELL → BODY FLANGE
        '==================================================

        ' 1) SHELL (SHELL_TOP_PLANE) → BODY FLANGE (BOTTOM_PLANE) : MATE
        Try
            constraints.AddMateConstraint(GetWorkPlaneProxy(shellOcc, "SHELL_TOP_PLANE"), GetWorkPlaneProxy(bodyFlangeOcc, "BOTTOM_PLANE"), 0)
        Catch ex As Exception
            Debug.WriteLine("Shell→BF Mate SHELL_TOP_PLANE/BOTTOM_PLANE failed: " & ex.Message)
        End Try

        ' 2) SHELL (YZ Plane) → BODY FLANGE (XZ Plane) : FLUSH
        Try
            constraints.AddFlushConstraint(GetWorkPlaneProxy(shellOcc, "YZ Plane"), GetWorkPlaneProxy(bodyFlangeOcc, "XZ Plane"), 0)
        Catch ex As Exception
            Debug.WriteLine("Shell→BF Flush YZ/XZ failed: " & ex.Message)
        End Try

        ' 3) SHELL (XY Plane) → BODY FLANGE (XY Plane) : FLUSH
        Try
            constraints.AddFlushConstraint(GetWorkPlaneProxy(shellOcc, "XY Plane"), GetWorkPlaneProxy(bodyFlangeOcc, "XY Plane"), 0)
        Catch ex As Exception
            Debug.WriteLine("Shell→BF Flush XY/XY failed: " & ex.Message)
        End Try

        '==================================================
        ' BODY FLANGE → GASKET
        '==================================================

        ' 1) BODY FLANGE (YZ Plane) → GASKET (XZ Plane) : MATE
        Try
            constraints.AddMateConstraint(GetWorkPlaneProxy(bodyFlangeOcc, "YZ Plane"), GetWorkPlaneProxy(gasketBFOcc, "XZ Plane"), 0)
        Catch ex As Exception
            Debug.WriteLine("BF→Gasket Mate YZ/XZ failed: " & ex.Message)
        End Try

        ' 2) BODY FLANGE (XZ Plane) → GASKET (YZ Plane) : FLUSH
        Try
            constraints.AddFlushConstraint(GetWorkPlaneProxy(bodyFlangeOcc, "XZ Plane"), GetWorkPlaneProxy(gasketBFOcc, "YZ Plane"), 0)
        Catch ex As Exception
            Debug.WriteLine("BF→Gasket Flush XZ/YZ failed: " & ex.Message)
        End Try

        ' 3) BODY FLANGE (XY Plane) → GASKET (XY Plane) : FLUSH
        Try
            constraints.AddFlushConstraint(GetWorkPlaneProxy(bodyFlangeOcc, "XY Plane"), GetWorkPlaneProxy(gasketBFOcc, "XY Plane"), 0)
        Catch ex As Exception
            Debug.WriteLine("BF→Gasket Flush XY/XY failed: " & ex.Message)
        End Try

        '==================================================
        ' GASKET → BLIND FLANGE
        '==================================================

        ' 1) GASKET (TOP_PLANE) → BLIND FLANGE (BOTTOM_PLANE) : MATE
        Try
            constraints.AddMateConstraint(GetWorkPlaneProxy(gasketBFOcc, "TOP_PLANE"), GetWorkPlaneProxy(blindFlangeOcc, "BOTTOM_PLANE"), 0)
        Catch ex As Exception
            Debug.WriteLine("Gasket→BLF Mate TOP_PLANE/BOTTOM_PLANE failed: " & ex.Message)
        End Try

        ' 2) GASKET (YZ Plane) → BLIND FLANGE (XZ Plane) : FLUSH
        Try
            constraints.AddFlushConstraint(GetWorkPlaneProxy(gasketBFOcc, "YZ Plane"), GetWorkPlaneProxy(blindFlangeOcc, "XZ Plane"), 0)
        Catch ex As Exception
            Debug.WriteLine("Gasket→BLF Flush YZ/XZ failed: " & ex.Message)
        End Try

        ' 3) GASKET (XY Plane) → BLIND FLANGE (XY Plane) : FLUSH
        Try
            constraints.AddFlushConstraint(GetWorkPlaneProxy(gasketBFOcc, "XY Plane"), GetWorkPlaneProxy(blindFlangeOcc, "XY Plane"), 0)
        Catch ex As Exception
            Debug.WriteLine("Gasket→BLF Flush XY/XY failed: " & ex.Message)
        End Try

        asmDoc.Update()

    End Sub


    '==========================================================================================
    ' HELPER: Get work plane proxy from an occurrence by plane name
    ' Returns the geometry proxy of the work plane for use in assembly constraints.
    '==========================================================================================
    Private Function GetWorkPlaneProxy(occ As ComponentOccurrence, planeName As String) As Object

        Dim partDoc As PartDocument = CType(occ.Definition.Document, PartDocument)
        Dim compDef As PartComponentDefinition = partDoc.ComponentDefinition

        For Each wp As WorkPlane In compDef.WorkPlanes
            If String.Equals(wp.Name, planeName, StringComparison.OrdinalIgnoreCase) Then
                Dim proxy As WorkPlaneProxy = Nothing
                occ.CreateGeometryProxy(wp, proxy)
                Return proxy
            End If
        Next

        Throw New Exception($"Work plane '{planeName}' not found in '{occ.Name}'")

    End Function

    Public Function PlaceAndConstrainNozzleStiffener_InNozzleAsm(invApp As Inventor.Application, nozAsm As AssemblyDocument, folderPath As String, nozzleName As String, angle1Deg As Double, angle2Deg As Double, heightMm As Double, distanceMm As Double) As ComponentOccurrence

        '==================================================
        ' 1️ STIFFENER PART PATH
        '==================================================
        Dim stiffenerPath As String

        If SelectedClient = "ARAMCO" Then
            stiffenerPath = IO.Path.Combine(folderPath, "PT_NO_55_NOZZLE_STIFFENER.ipt")
        ElseIf SelectedClient = "ADNOC" Then
            stiffenerPath = IO.Path.Combine(folderPath, "Adnoc\ADNOC_NOZZLE_STIFFENER.ipt")
        ElseIf SelectedClient = "QATAR" Then
            stiffenerPath = IO.Path.Combine(folderPath, "PT_NO_55_NOZZLE_STIFFENER.ipt")
        End If

        If Not IO.File.Exists(stiffenerPath) Then
            Throw New Exception("❌ Stiffener part not found: " & stiffenerPath)
        End If

        '==================================================
        ' 2️ NOZZLE ASSEMBLY DEFINITION
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '==================================================
        ' 3️ PLACE STIFFENER INSIDE NOZZLE ASSEMBLY
        '==================================================
        Dim stiffOcc As ComponentOccurrence = asmDef.Occurrences.Add(stiffenerPath, tg.CreateMatrix())
        stiffOcc.Grounded = False
        stiffOcc.Name = nozzleName & "_STIFFENER"

        '==================================================
        ' 4️ FIND PIPE + FLANGE INSIDE NOZZLE ASSEMBLY
        '==================================================
        Dim pipeOcc As ComponentOccurrence = Nothing
        Dim flangeOcc As ComponentOccurrence = Nothing

        For Each occ As ComponentOccurrence In asmDef.Occurrences

            If pipeOcc Is Nothing AndAlso occ.Name.ToUpper().Contains("PIPE") Then
                pipeOcc = occ
            End If

            If flangeOcc Is Nothing AndAlso occ.Name.ToUpper().Contains("FLANGE") Then
                flangeOcc = occ
            End If

            ' Exit once both found
            If pipeOcc IsNot Nothing AndAlso
       flangeOcc IsNot Nothing Then Exit For

        Next

        If pipeOcc Is Nothing Then
            Throw New Exception("❌ PIPE not found inside nozzle assembly")
        End If

        If flangeOcc Is Nothing Then
            Throw New Exception("❌ FLANGE not found inside nozzle assembly")
        End If

        '==================================================
        ' 5️ DYNAMIC PIPE PLANE NAMES (FROM ANGLES)
        '==================================================
        Dim planeName1 As String = "STIFFENER_PLANE_" & CInt(angle1Deg)
        Dim planeName2 As String = "STIFFENER_PLANE_" & CInt(angle2Deg)

        '==================================================
        ' 6️ GET PIPE + FLANGE PLANES
        '==================================================

        '---------------- PIPE PLANES ----------------
        Dim pipeDef As PartComponentDefinition = CType(pipeOcc.Definition, PartComponentDefinition)
        Dim pipePlane1 As WorkPlane = Nothing
        Dim pipePlane2 As WorkPlane = Nothing

        '✅ Safe dynamic search
        For Each wp As WorkPlane In pipeDef.WorkPlanes
            If wp.Name.Equals(planeName1, StringComparison.OrdinalIgnoreCase) Then
                pipePlane1 = wp
            End If
            If wp.Name.Equals(planeName2, StringComparison.OrdinalIgnoreCase) Then
                pipePlane2 = wp
            End If
        Next

        If pipePlane1 Is Nothing Then
            Throw New Exception("❌ Pipe plane not found: " & planeName1)
        End If

        If pipePlane2 Is Nothing Then
            Throw New Exception("❌ Pipe plane not found: " & planeName2)
        End If

        '---------------- FLANGE PLANE ----------------
        Dim flangeDef As PartComponentDefinition = CType(flangeOcc.Definition, PartComponentDefinition)
        Dim flangeYZ As WorkPlane = flangeDef.WorkPlanes.Item("YZ Plane")

        '==================================================
        ' 7️ STIFFENER PLANES
        '==================================================
        Dim stiffDef As PartComponentDefinition = CType(stiffOcc.Definition, PartComponentDefinition)
        Dim stiffWP1 As WorkPlane = stiffDef.WorkPlanes.Item("Work Plane1")
        Dim stiffXY As WorkPlane = stiffDef.WorkPlanes.Item("XY Plane")
        Dim stiffYZ As WorkPlane = stiffDef.WorkPlanes.Item("YZ Plane")

        '==================================================
        ' 8️ CREATE PROXIES
        '==================================================
        Dim flangeYZp, pipePlane1p, pipePlane2p As Object
        Dim stiffWP1p, stiffXYp, stiffYZp As Object

        flangeOcc.CreateGeometryProxy(flangeYZ, flangeYZp)

        pipeOcc.CreateGeometryProxy(pipePlane1, pipePlane1p)
        pipeOcc.CreateGeometryProxy(pipePlane2, pipePlane2p)

        stiffOcc.CreateGeometryProxy(stiffWP1, stiffWP1p)
        stiffOcc.CreateGeometryProxy(stiffXY, stiffXYp)
        stiffOcc.CreateGeometryProxy(stiffYZ, stiffYZp)

        '==================================================
        ' ✅ APPLY YOUR 3 CONSTRAINTS
        '==================================================
        Dim distOffsetCm As Double = heightMm / 10.0
        Dim offset3015Cm As Double = -30.15 / 10.0

        If SelectedClient = "ARAMCO" Then
            cons.AddMateConstraint(flangeYZp, stiffWP1p, distOffsetCm)
            cons.AddMateConstraint(pipePlane1p, stiffXYp, 0)
            cons.AddFlushConstraint(pipePlane2p, stiffYZp, offset3015Cm)
        ElseIf SelectedClient = "ADNOC" Then
            cons.AddMateConstraint(flangeYZp, stiffWP1p, distOffsetCm)
            cons.AddMateConstraint(pipePlane1p, stiffXYp, 0)
            cons.AddMateConstraint(pipePlane2p, stiffYZp, -offset3015Cm)
        ElseIf SelectedClient = "QATAR" Then
            cons.AddMateConstraint(flangeYZp, stiffWP1p, distOffsetCm)
            cons.AddFlushConstraint(pipePlane1p, stiffXYp, 0)
            cons.AddFlushConstraint(pipePlane2p, stiffYZp, offset3015Cm)
        End If

        '==================================================
        ' 9️ FINAL UPDATE
        '==================================================
        nozAsm.Update()

        Return stiffOcc

    End Function

    Public Sub CreateCircularPattern_NozzleStiffener(invApp As Inventor.Application, nozzleAsmOcc As ComponentOccurrence, seedStiffenerOcc As ComponentOccurrence, occurrenceCount As Integer, totalAngleDeg As Double, isSymmetric As String, anglebwstiffener As Double)

        '==================================================
        ' Safety Checks
        '==================================================
        If nozzleAsmOcc Is Nothing Then
            Throw New Exception("❌ Nozzle assembly occurrence is Nothing")
        End If

        If seedStiffenerOcc Is Nothing Then
            Throw New Exception("❌ Seed stiffener occurrence is Nothing")
        End If

        '==================================================
        ' Get Nozzle Assembly Document (Nozzle_N1.iam)
        '==================================================
        Dim nozAsmDoc As AssemblyDocument = CType(nozzleAsmOcc.Definition.Document, AssemblyDocument)
        Dim nozAsmDef As AssemblyComponentDefinition = nozAsmDoc.ComponentDefinition

        '==================================================
        ' Seed Occurrence Collection (inside nozzle assembly)
        '==================================================
        Dim seedOccs As ObjectCollection = invApp.TransientObjects.CreateObjectCollection()
        seedOccs.Add(seedStiffenerOcc)

        '==================================================
        ' Pattern Axis → Nozzle Assembly Y Axis
        '==================================================
        Dim patternAxis As WorkAxis = nozAsmDef.WorkAxes.Item("Y Axis")

        '==================================================
        ' Convert Angle (Deg → Rad)
        '==================================================
        Dim angleRad As Double = anglebwstiffener * Math.PI / 180.0

        Dim Direction As Double
        If isSymmetric = "NORMAL" Then
            Direction = False
        ElseIf isSymmetric = "FLIP" Then
            Direction = True
        End If

        '==================================================
        ' ✅ Create Circular Pattern INSIDE Nozzle Assembly
        '==================================================
        Dim patt As CircularOccurrencePattern
        patt = nozAsmDef.OccurrencePatterns.AddCircularPattern(seedOccs, patternAxis, Direction, angleRad, occurrenceCount)
        patt.Name = seedStiffenerOcc.Name & "_PATTERN"

        '==================================================
        ' Update Nozzle Assembly
        '==================================================
        nozAsmDoc.Update()

    End Sub

    Sub CreateNozzleCutOnTopFlatHead_XY(invApp As Inventor.Application, headOcc As ComponentOccurrence, nozzleName As String, cutDiaMm As Double, xMm As Double, yMm As Double, sketchPlaneName As String)

        '--------------------------------------------------
        ' Safety — validate occurrence before any API call
        '--------------------------------------------------
        If headOcc Is Nothing Then
            Throw New Exception($"❌ [{nozzleName}] headOcc is Nothing — occurrence was not placed correctly.")
        End If

        If headOcc.Definition Is Nothing Then
            Throw New Exception($"❌ [{nozzleName}] headOcc.Definition is Nothing.")
        End If

        If Not TypeOf headOcc.Definition.Document Is PartDocument Then
            Throw New Exception($"❌ [{nozzleName}] headOcc document is not a PartDocument.")
        End If

        '--------------------------------------------------
        ' Unit conversion (mm → cm)
        ' X — no negation: positive X = right ✅
        ' Y — negated:     positive Y = up ✅
        '--------------------------------------------------
        Dim cutDiaCm As Double = cutDiaMm / 10.0
        Dim xCm As Double = xMm / 10.0
        Dim yCm As Double = -yMm / 10.0

        '--------------------------------------------------
        ' Get part definition
        '--------------------------------------------------
        Dim partDoc As PartDocument = CType(headOcc.Definition.Document, PartDocument)
        Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition
        Dim tg As TransientGeometry = invApp.TransientGeometry

        '--------------------------------------------------
        ' Names
        '--------------------------------------------------
        Dim sketchName As String = nozzleName & "_Sketch"
        Dim cutName As String = nozzleName & "_Cut"

        '--------------------------------------------------
        ' DELETE EXISTING CUT
        '--------------------------------------------------
        For Each feat As ExtrudeFeature In partDef.Features.ExtrudeFeatures
            If feat.Name = cutName Then
                feat.Delete()
                Exit For
            End If
        Next

        '--------------------------------------------------
        ' DELETE EXISTING SKETCHES
        ' Safe: exact name OR exact name + numeric suffix only
        '--------------------------------------------------
        Dim sketchesToDelete As New List(Of PlanarSketch)

        For Each skCheck As PlanarSketch In partDef.Sketches
            Dim sName As String = skCheck.Name
            If String.Equals(sName, sketchName, StringComparison.OrdinalIgnoreCase) Then
                sketchesToDelete.Add(skCheck)
                Continue For
            End If
            If sName.StartsWith(sketchName, StringComparison.OrdinalIgnoreCase) Then
                Dim suffix As String = sName.Substring(sketchName.Length)
                If suffix.Length > 0 AndAlso suffix.All(Function(c) Char.IsDigit(c)) Then
                    sketchesToDelete.Add(skCheck)
                End If
            End If
        Next

        For Each skDel As PlanarSketch In sketchesToDelete
            Try
                skDel.Delete()
            Catch ex As Exception
                Debug.WriteLine($"Could not delete sketch '{skDel.Name}': {ex.Message}")
            End Try
        Next

        '--------------------------------------------------
        ' CREATE SKETCH ON CORRECT PLANE
        ' "XZ Plane" → headOcc (standard mode)
        ' "YZ Plane" → blindFlangeOcc (RB_RT_BF mode)
        '--------------------------------------------------
        Dim sketch As PlanarSketch = partDef.Sketches.Add(partDef.WorkPlanes.Item(sketchPlaneName))
        sketch.Name = sketchName

        '--------------------------------------------------
        ' DRAW CIRCLE AT (xCm, yCm)
        '--------------------------------------------------
        Dim circ As SketchCircle = sketch.SketchCircles.AddByCenterRadius(tg.CreatePoint2d(xCm, yCm), cutDiaCm / 2.0)

        '--------------------------------------------------
        ' ASSIGN NAMED PARAMETERS
        '--------------------------------------------------
        Dim params As Parameters = partDef.Parameters
        Dim paramDiaName As String = nozzleName & "_DIA"
        Dim paramXName As String = nozzleName & "_X"
        Dim paramYName As String = nozzleName & "_Y"

        Try
            params.Item(paramDiaName).Expression = $"{cutDiaCm} cm"
        Catch
            params.UserParameters.AddByExpression(paramDiaName, $"{cutDiaCm} cm",
            UnitsTypeEnum.kCentimeterLengthUnits)
        End Try

        Try
            params.Item(paramXName).Expression = $"{xCm} cm"
        Catch
            params.UserParameters.AddByExpression(paramXName, $"{xCm} cm",
            UnitsTypeEnum.kCentimeterLengthUnits)
        End Try

        Try
            params.Item(paramYName).Expression = $"{yCm} cm"
        Catch
            params.UserParameters.AddByExpression(paramYName, $"{yCm} cm",
            UnitsTypeEnum.kCentimeterLengthUnits)
        End Try

        '--------------------------------------------------
        ' WIRE DIMENSIONS TO PARAMETERS
        '--------------------------------------------------

        ' Diameter dimension → paramDiaName
        sketch.DimensionConstraints.AddDiameter(circ, tg.CreatePoint2d(xCm + cutDiaCm / 2.0, yCm)).Parameter.Expression = paramDiaName

        '--------------------------------------------------
        ' FIX DIMENSIONS TO CENTER POINT
        ' Use sketch origin point at (0,0) — but fix it
        ' to the actual part origin by adding a coincident
        ' constraint with the projected Center Point.
        ' Then use it as dimension reference.
        '--------------------------------------------------

        ' Project Center Point — fixes position but don't use directly in AddTwoPointDistance
        Dim centerWP As WorkPoint = partDef.WorkPoints.Item("Center Point")
        Dim projCenter As SketchPoint = sketch.AddByProjectingEntity(centerWP)

        ' Add a regular sketch point AT the same location as the projected center
        Dim originPt As SketchPoint = sketch.SketchPoints.Add(tg.CreatePoint2d(0, 0))

        ' Coincident constraint fixes originPt TO the projected center point
        ' This anchors the free point to the actual part origin
        sketch.GeometricConstraints.AddCoincident(
    CType(originPt, SketchPoint),
    CType(projCenter, SketchPoint))

        ' X distance (horizontal) — from anchored origin to circle center
        sketch.DimensionConstraints.AddTwoPointDistance(
    originPt,
    circ.CenterSketchPoint,
    DimensionOrientationEnum.kHorizontalDim,
    tg.CreatePoint2d(xCm / 2.0, yCm - cutDiaCm)
).Parameter.Expression = paramXName

        ' Y distance (vertical) — from anchored origin to circle center
        sketch.DimensionConstraints.AddTwoPointDistance(
    originPt,
    circ.CenterSketchPoint,
    DimensionOrientationEnum.kVerticalDim,
    tg.CreatePoint2d(xCm + cutDiaCm, yCm / 2.0)
).Parameter.Expression = paramYName
        '--------------------------------------------------
        ' CREATE PROFILE AND CUT
        '--------------------------------------------------
        Dim prof As Profile = sketch.Profiles.AddForSolid()
        Dim cutDef As ExtrudeDefinition = partDef.Features.ExtrudeFeatures.CreateExtrudeDefinition(prof, PartFeatureOperationEnum.kCutOperation)
        cutDef.SetThroughAllExtent(PartFeatureExtentDirectionEnum.kSymmetricExtentDirection)

        Dim cutFeat As ExtrudeFeature = partDef.Features.ExtrudeFeatures.Add(cutDef)
        cutFeat.Name = cutName

        '--------------------------------------------------
        ' Final update
        '--------------------------------------------------
        partDoc.Update()

    End Sub

    Public Sub BuildNozzleAssembly_TopFlatHead(invApp As Inventor.Application, nozAsm As AssemblyDocument, parts As Dictionary(Of String, String), remarks As String, Optional nozzleName As String = "", Optional xMm As Double = 0,
    Optional yMm As Double = 0, Optional outsideProjectionMm As Double = 0, Optional pipeODmm As Double = 0, Optional pipeThkMm As Double = 0, Optional pipeLengthMm As Double = 0, Optional rfPadODmm As Double = 0, Optional rfPadThkMm As Double = 0)

        Dim asmDef = nozAsm.ComponentDefinition
        Dim tg = invApp.TransientGeometry
        remarks = remarks.ToUpper()

        '==================================================
        ' ADNOC DIP PIPE STRUCTURE
        '==================================================
        If remarks.Contains("DIP PIPE") AndAlso SelectedClient = "ADNOC" Then

            '==================================================
            ' READ DIP PIPE LENGTHS USING COUNTER
            '==================================================
            Dim pipe1LenMm As Double = 0
            Dim pipe2LenMm As Double = 0

            Dim dipPipeCount As Integer = 0
            If remarks.ToUpper().Contains("DIP PIPE") Then
                dipPipeCount += 1
            End If

            Select Case dipPipeCount

                Case 1

                    If Not Double.TryParse(txt_adn_DP1_Length1.Text, pipe1LenMm) Then
                        Throw New Exception("Invalid DP1 Pipe1 length")
                    End If

                    If Not Double.TryParse(txt_adn_DP1_Length2.Text, pipe2LenMm) Then
                        Throw New Exception("Invalid DP1 Pipe2 length")
                    End If


                Case 2

                    If Not Double.TryParse(txt_adn_DP2_Length1.Text, pipe1LenMm) Then
                        Throw New Exception("Invalid DP2 Pipe1 length")
                    End If

                    If Not Double.TryParse(txt_adn_DP2_Length2.Text, pipe2LenMm) Then
                        Throw New Exception("Invalid DP2 Pipe2 length")
                    End If


                Case 3

                    If Not Double.TryParse(txt_adn_DP3_Length1.Text, pipe1LenMm) Then
                        Throw New Exception("Invalid DP3 Pipe1 length")
                    End If

                    If Not Double.TryParse(txt_adn_DP3_Length2.Text, pipe2LenMm) Then
                        Throw New Exception("Invalid DP3 Pipe2 length")
                    End If


                Case 4

                    If Not Double.TryParse(txt_adn_DP4_Length1.Text, pipe1LenMm) Then
                        Throw New Exception("Invalid DP4 Pipe1 length")
                    End If

                    If Not Double.TryParse(txt_adn_DP4_Length2.Text, pipe2LenMm) Then
                        Throw New Exception("Invalid DP4 Pipe2 length")
                    End If


                Case Else

                    Throw New Exception("Dip Pipe count exceeds supported range (1–4)")

            End Select

            '--------------------------------------------------
            ' FLANGE 1
            '--------------------------------------------------
            Dim flange1Occ = asmDef.Occurrences.Add(parts("FLANGE1"), tg.CreateMatrix())
            flange1Occ.Name = nozzleName & "_FLANGE1"
            flange1Occ.Grounded = False
            SetFlangeOutsideProjection(flange1Occ, outsideProjectionMm)

            '--------------------------------------------------
            ' PIPE 1
            '--------------------------------------------------
            Dim pipe1Occ = asmDef.Occurrences.Add(parts("PIPE1"), tg.CreateMatrix())
            pipe1Occ.Name = nozzleName & "_PIPE1"

            SetPipeDimensions(pipe1Occ, pipeODmm, pipeThkMm, pipe1LenMm)

            ConstrainOriginToFlange1(nozAsm, flange1Occ, nozzleName)
            ConstrainFlange1ToPipe1(nozAsm, flange1Occ, pipe1Occ, nozzleName)


            '--------------------------------------------------
            ' OPTIONAL RF PAD
            '--------------------------------------------------
            Dim padOcc As ComponentOccurrence = Nothing

            If parts.ContainsKey("PAD") Then

                padOcc =
            asmDef.Occurrences.Add(parts("PAD"), tg.CreateMatrix())

                padOcc.Name = nozzleName & "_RF_PAD"

                If rfPadODmm <= 0 Then rfPadODmm = pipeODmm

                SetRFPadParameters(padOcc, rfPadODmm, rfPadThkMm, pipeODmm)

                ConstrainPadToPipe_TopFlat(nozAsm, pipe1Occ, padOcc)

            End If


            '--------------------------------------------------
            ' FLANGE 2
            '--------------------------------------------------
            Dim flange2Occ =
        asmDef.Occurrences.Add(parts("FLANGE2"), tg.CreateMatrix())

            flange2Occ.Name = nozzleName & "_FLANGE2"

            ConstrainPipe1ToFlange2(nozAsm, pipe1Occ, flange2Occ, nozzleName)


            '--------------------------------------------------
            ' GASKET
            '--------------------------------------------------
            Dim gasketOcc =
        asmDef.Occurrences.Add(parts("GASKET"), tg.CreateMatrix())

            gasketOcc.Name = nozzleName & "_GASKET"

            ConstrainFlange2ToGasket(nozAsm, flange2Occ, gasketOcc)


            '--------------------------------------------------
            ' FLANGE 3
            '--------------------------------------------------
            Dim flange3Occ =
        asmDef.Occurrences.Add(parts("FLANGE3"), tg.CreateMatrix())

            flange3Occ.Name = nozzleName & "_FLANGE3"

            ConstrainGasketToFlange3(nozAsm, gasketOcc, flange3Occ)


            '--------------------------------------------------
            ' PIPE 2
            '--------------------------------------------------
            Dim pipe2Occ =
        asmDef.Occurrences.Add(parts("PIPE2"), tg.CreateMatrix())

            pipe2Occ.Name = nozzleName & "_PIPE2"

            SetPipeDimensions(pipe2Occ, pipeODmm, pipeThkMm, pipe2LenMm)

            ConstrainFlange3ToPipe2(nozAsm, flange3Occ, pipe2Occ, nozzleName)


            nozAsm.Update()
            Exit Sub

        End If

        '==================================================
        ' STANDARD ARAMCO / NORMAL NOZZLE STRUCTURE
        '==================================================

        ' PIPE
        Dim pipeOcc = asmDef.Occurrences.Add(parts("PIPE"), tg.CreateMatrix())
        pipeOcc.Name = nozzleName & "_PIPE"
        pipeOcc.Grounded = True

        If pipeODmm > 0 Then
            SetPipeDimensions(pipeOcc, pipeODmm, pipeThkMm, pipeLengthMm)
        End If
        ConstrainPipeToNozzleOriginPlanes(nozAsm, pipeOcc)

        ' FLANGE
        Dim flangeOcc = asmDef.Occurrences.Add(parts("FLANGE"), tg.CreateMatrix())
        flangeOcc.Name = nozzleName & "_FLANGE"
        ConstrainFlangeToPipe_TopFlat(nozAsm, pipeOcc, flangeOcc, nozzleName)

        If outsideProjectionMm > 0 Then
            SetFlangeOutsideProjection(flangeOcc, outsideProjectionMm)
        End If


        ' RF PAD
        If parts.ContainsKey("PAD") Then

            Dim padOcc = asmDef.Occurrences.Add(parts("PAD"), tg.CreateMatrix())
            padOcc.Name = nozzleName & "_RF_PAD"

            If rfPadODmm <= 0 Then rfPadODmm = pipeODmm
            SetRFPadParameters(padOcc, rfPadODmm, rfPadThkMm, pipeODmm)
            ConstrainPadToPipe_TopFlat(nozAsm, pipeOcc, padOcc)

        End If

        nozAsm.Update()

    End Sub

    Public Function GetAdnocDipPipeLengths(
    tabControl As TabControl,
    dpIndex As Integer) _
    As (Pipe1Len As Double, Pipe2Len As Double)

        Dim len1 As Double
        Dim len2 As Double

        Dim tb1Name As String = $"txt_adn_DP{dpIndex}_Length1"
        Dim tb2Name As String = $"txt_adn_DP{dpIndex}_Length2"

        Dim tb1 As TextBox =
        TryCast(tabControl.Controls.Find(tb1Name, True).FirstOrDefault(), TextBox)

        Dim tb2 As TextBox =
        TryCast(tabControl.Controls.Find(tb2Name, True).FirstOrDefault(), TextBox)

        If tb1 Is Nothing Then
            Throw New Exception($"Textbox not found: {tb1Name}")
        End If

        If tb2 Is Nothing Then
            Throw New Exception($"Textbox not found: {tb2Name}")
        End If

        If Not Double.TryParse(tb1.Text, len1) Then
            Throw New Exception($"Invalid PIPE1 length in {tb1Name}")
        End If

        If Not Double.TryParse(tb2.Text, len2) Then
            Throw New Exception($"Invalid PIPE2 length in {tb2Name}")
        End If

        Return (len1, len2)

    End Function

    Public Sub ConstrainFlangeToPipe_TopFlat(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, flangeOcc As ComponentOccurrence, nozzleName As String)

        Dim cons As AssemblyConstraints = nozAsm.ComponentDefinition.Constraints

        Dim invApp As Inventor.Application = nozAsm.Parent

        '==================================================
        ' 1️⃣ Pipe XZ ↔ Flange End_Plane (FLUSH)
        '==================================================
        Dim pipeXZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim flangeEndPlane As WorkPlane = GetOrCreateFlangeEndPlane(invApp, flangeOcc, nozzleName)

        Dim pipeXZp, flangeEndPlaneP As Object
        pipeOcc.CreateGeometryProxy(pipeXZ, pipeXZp)
        flangeOcc.CreateGeometryProxy(flangeEndPlane, flangeEndPlaneP)

        cons.AddFlushConstraint(pipeXZp, flangeEndPlaneP, 0)

        '==================================================
        ' 2️⃣ Pipe YZ ↔ Flange XZ (FLUSH)
        '==================================================
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim flangeXZ As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XZ Plane")

        Dim pipeYZp, flangeXZp As Object
        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        flangeOcc.CreateGeometryProxy(flangeXZ, flangeXZp)

        cons.AddFlushConstraint(pipeYZp, flangeXZp, 0)

        '==================================================
        ' 3️⃣ Pipe XY ↔ Flange XY (MATE)
        '==================================================
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim flangeXY As WorkPlane = flangeOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim pipeXYp, flangeXYp As Object
        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        flangeOcc.CreateGeometryProxy(flangeXY, flangeXYp)

        cons.AddMateConstraint(pipeXYp, flangeXYp, 0)

    End Sub

    Public Sub ConstrainPadToPipe_TopFlat(nozAsm As AssemblyDocument, pipeOcc As ComponentOccurrence, padOcc As ComponentOccurrence)

        Dim asmDef As AssemblyComponentDefinition = nozAsm.ComponentDefinition

        Dim cons As AssemblyConstraints = asmDef.Constraints


        '--------------------------------------
        ' 1️⃣ PIPE (YZ) ↔ RF PAD (YZ) → FLUSH
        '--------------------------------------
        Dim pipeYZ As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim padYZ As WorkPlane = padOcc.Definition.WorkPlanes.Item("YZ Plane")

        Dim pipeYZp As Object
        Dim padYZp As Object

        pipeOcc.CreateGeometryProxy(pipeYZ, pipeYZp)
        padOcc.CreateGeometryProxy(padYZ, padYZp)

        cons.AddFlushConstraint(pipeYZp, padYZp, 0)


        '--------------------------------------
        ' 2️⃣ PIPE (XY) ↔ RF PAD (XY) → FLUSH
        '--------------------------------------
        Dim pipeXY As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("XY Plane")
        Dim padXY As WorkPlane = padOcc.Definition.WorkPlanes.Item("XY Plane")

        Dim pipeXYp As Object
        Dim padXYp As Object

        pipeOcc.CreateGeometryProxy(pipeXY, pipeXYp)
        padOcc.CreateGeometryProxy(padXY, padXYp)

        cons.AddFlushConstraint(pipeXYp, padXYp, 0)


        '--------------------------------------
        ' 3️⃣ PIPE (END_PLANE) ↔ RF PAD (TOP_PLANE)
        ' → FLUSH WITH OFFSET
        '--------------------------------------
        Dim pipeEndPlane As WorkPlane = pipeOcc.Definition.WorkPlanes.Item("End_Plane")
        Dim padTopPlane As WorkPlane = padOcc.Definition.WorkPlanes.Item("TOP_PLANE")

        Dim pipeEndPlaneP As Object
        Dim padTopPlaneP As Object

        pipeOcc.CreateGeometryProxy(pipeEndPlane, pipeEndPlaneP)
        padOcc.CreateGeometryProxy(padTopPlane, padTopPlaneP)

        ' Convert mm → cm (Inventor internal units)
        Dim offsetCm As Double

        If SelectedClient = "ARAMCO" Then
            offsetCm = CDbl(txt_TP_THK.Text) / 10
            cons.AddFlushConstraint(pipeEndPlaneP, padTopPlaneP, offsetCm)
        ElseIf SelectedClient = "ADNOC" Then
            offsetCm = CDbl(txt_RF_THK.Text) / 10
            cons.AddFlushConstraint(pipeEndPlaneP, padTopPlaneP, -offsetCm)
        ElseIf SelectedClient = "QATAR" Then
            offsetCm = CDbl(txt_RF_THK.Text) / 10
            cons.AddFlushConstraint(pipeEndPlaneP, padTopPlaneP, -offsetCm)
        End If

    End Sub

