    Private Sub UpdateLugSupportParts(invApp As Inventor.Application, folderPath As String)

        '====================================
        ' DETERMINE LUG FOLDER
        '====================================
        Dim lugFolder As String = ""

        If Rbn_Lug_type1.Checked Then
            lugFolder = "Lug_Support_1"
        ElseIf Rbn_Lug_type2.Checked Then
            lugFolder = "Lug_Support_2"
        ElseIf Rbn_Lug_type3.Checked Then
            lugFolder = "Lug_Support_3"
        End If

        If String.IsNullOrEmpty(lugFolder) Then Exit Sub

        Dim basePath As String = IO.Path.Combine(folderPath, lugFolder)

        '====================================
        ' RF PAD
        '====================================
        Dim rfPadPath As String = IO.Path.Combine(basePath, $"Pad_For_Lug_Support_TYPE_{GetLugType()}.ipt")

        If IO.File.Exists(rfPadPath) Then
            UpdateLugRFPadParameters(invApp, rfPadPath)
        End If


        '====================================
        ' GUSSET PLATE 1 (TYPE 1)
        '====================================
        Dim gussetPath1 As String = IO.Path.Combine(basePath, $"Gusset_Plate_For_LS_TYPE_{GetLugType()}.ipt")

        If IO.File.Exists(gussetPath1) Then
            UpdateLugGussetPlateParameters(invApp, gussetPath1, 1)
        End If


        '====================================
        ' GUSSET PLATE 2 (TYPE 2)
        '====================================
        Dim gussetPath2 As String = IO.Path.Combine(basePath, $"Gusset_Plate_For_LS_1_TYPE_{GetLugType()}.ipt")

        If IO.File.Exists(gussetPath2) Then
            UpdateLugGussetPlateParameters(invApp, gussetPath2, 2)
        End If


        '====================================
        ' TOP PLATE (ONLY TYPE 2 & 3)
        '====================================
        If Rbn_Lug_type2.Checked Or Rbn_Lug_type3.Checked Then

            Dim topPlatePath As String = IO.Path.Combine(basePath, $"Lug_Support_Top_Plate_TYPE_{GetLugType()}.ipt")

            If IO.File.Exists(topPlatePath) Then
                UpdateLugTopPlateParameters(invApp, topPlatePath)
            End If

        End If

    End Sub

    Private Function GetLugType() As Integer

        If Rbn_Lug_type1.Checked Then Return 1
        If Rbn_Lug_type2.Checked Then Return 2
        If Rbn_Lug_type3.Checked Then Return 3

        Return 0

    End Function

    Public Sub UpdateReinforcementRingDimensions()

        '==================================================
        ' READ INPUT VALUES
        '==================================================
        Dim shellID As Double
        Dim shellThk As Double

        If Not Double.TryParse(txt_Shell_Inside_Dia.Text, shellID) Then Exit Sub
        If Not Double.TryParse(txt_Shell_Finished_Thk.Text, shellThk) Then Exit Sub

        '==================================================
        ' CALCULATE SHELL OD
        '==================================================
        Dim shellOD As Double = shellID + (2 * shellThk)


        '==================================================
        ' CALCULATE BCD & RING OD
        '==================================================
        Dim bcd As Double = shellOD + 70
        Dim ringOD As Double = shellOD + 130

        '==================================================
        ' UPDATE TEXTBOXES
        '==================================================
        txt_RF_OD.Text = shellOD.ToString("0")
        txt_RF_BCD.Text = bcd.ToString("0")
        txt_RF_R_OD.Text = ringOD.ToString("0")

    End Sub

    Private Function SafeDouble(value As String, defaultVal As Double) As Double
        Dim result As Double
        If Double.TryParse(value, result) Then Return result
        Return defaultVal
    End Function

