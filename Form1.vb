    Public Sub UpdateGroundingLugVisibility()

        Dim invApp As Inventor.Application

        Try
            invApp = Marshal.GetActiveObject("Inventor.Application")
        Catch
            'MessageBox.Show("Inventor not running")
            Exit Sub
        End Try

        Try
            If invApp Is Nothing Then Exit Sub
            If invApp.ActiveDocument Is Nothing Then Exit Sub
            If Not TypeOf invApp.ActiveDocument Is AssemblyDocument Then Exit Sub

            Dim asmDoc As AssemblyDocument = CType(invApp.ActiveDocument, AssemblyDocument)

            Dim compDef = asmDoc.ComponentDefinition

            Dim checks = {CB_STIFF_1, CB_STIFF_2, CB_STIFF_3, CB_STIFF_4}

            For i = 1 To 4
                Dim occName = $"PT_NO_14_GROUNDING_LUG:{i}"

                For Each occ As ComponentOccurrence In compDef.Occurrences
                    If occ.Name.ToUpper().Contains(occName) Then
                        occ.Visible = checks(i - 1).Checked
                    End If
                Next
            Next

            asmDoc.Update()

        Catch
            MessageBox.Show("Error updating visibility")
        End Try

    End Sub

    Private Sub CB_STIFF_1_CheckedChanged(sender As Object, e As EventArgs) Handles CB_STIFF_1.CheckedChanged
        UpdateGroundingLugVisibility()
    End Sub

