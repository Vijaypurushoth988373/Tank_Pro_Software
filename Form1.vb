    Public Function PlaceAndConstrainLugSupportAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String, angleDeg As Double) As ComponentOccurrence

        '==================================================
        ' SAFETY CHECK
        '==================================================
        If invApp Is Nothing OrElse asmDoc Is Nothing OrElse shellOcc Is Nothing Then
            Throw New Exception("Invalid inputs for Lug Support placement")
        End If

        '==================================================
        ' SELECT LUG TYPE
        '==================================================
        Dim lugType As Integer

        If Rbn_Lug_type1.Checked Then
            lugType = 1
        ElseIf Rbn_Lug_type2.Checked Then
            lugType = 2
        ElseIf Rbn_Lug_type3.Checked Then
            lugType = 3
        Else
            Throw New Exception("Please select Lug Support Type")
        End If

        '==================================================
        ' FILE PATHS
        '==================================================
        Dim lugAsmPath As String = IO.Path.Combine(folderPath, "Lug_Support_" & lugType, "Lug_Support_Assembly_TYPE_" & lugType & ".iam")
        Dim basePlateName As String = "Lug_Support_Base_Plate_TYPE_" & lugType

        '==================================================
        ' CHECK FILE
        '==================================================
        If Not IO.File.Exists(lugAsmPath) Then
            Throw New Exception("Lug Assembly not found : " & lugAsmPath)
        End If

        '==================================================
        ' PLACE ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim cons As AssemblyConstraints = asmDef.Constraints

        Dim lugAsmOcc As ComponentOccurrence =
        asmDef.Occurrences.Add(lugAsmPath, tg.CreateMatrix())
        lugAsmOcc.Grounded = False

        '==================================================
        ' FIND BASE PLATE
        '==================================================
        Dim basePlateOcc As ComponentOccurrence = Nothing
        For Each occ As ComponentOccurrence In lugAsmOcc.SubOccurrences
            Dim nameUpper As String = occ.Definition.Document.DisplayName.ToUpper()
            If nameUpper.Contains(basePlateName.ToUpper()) Then
                basePlateOcc = occ
                Exit For
            End If
        Next

        If basePlateOcc Is Nothing Then
            Throw New Exception("Base plate not found in Lug Assembly")
        End If

        '==================================================
        ' SHELL REFERENCES
        '==================================================
        Dim shellDef As PartComponentDefinition = shellOcc.Definition
        Dim shellXZ As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")
        Dim shellXY As WorkPlane = shellDef.WorkPlanes.Item("XY Plane")
        Dim shellYAxis As WorkAxis = shellDef.WorkAxes.Item("Y Axis")

        '==================================================
        ' LUG REFERENCES
        '==================================================
        Dim lugAsmDef As AssemblyComponentDefinition = lugAsmOcc.Definition
        Dim lugYZ As WorkPlane = lugAsmDef.WorkPlanes.Item("YZ Plane")
        Dim lugYAxis As WorkAxis = lugAsmDef.WorkAxes.Item("Y Axis")
        Dim baseDef As PartComponentDefinition = basePlateOcc.Definition
        Dim baseTopPlane As WorkPlane = baseDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' CREATE GEOMETRY PROXIES
        '==================================================
        Dim shellXZp, shellXYp, shellYAxisP As Object
        Dim lugYZp, lugYAxisP As Object
        Dim baseTopPlaneP, baseTopMainP As Object

        shellOcc.CreateGeometryProxy(shellXZ, shellXZp)
        shellOcc.CreateGeometryProxy(shellXY, shellXYp)
        shellOcc.CreateGeometryProxy(shellYAxis, shellYAxisP)

        lugAsmOcc.CreateGeometryProxy(lugYZ, lugYZp)
        lugAsmOcc.CreateGeometryProxy(lugYAxis, lugYAxisP)
        basePlateOcc.CreateGeometryProxy(baseTopPlane, baseTopPlaneP)
        lugAsmOcc.CreateGeometryProxy(baseTopPlaneP, baseTopMainP)

        '==================================================
        ' ANGLE CONVERSION
        '==================================================
        Dim angleRad As Double = angleDeg * Math.PI / 180.0

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================

        '1️⃣ Shell XZ → Base Plate Top
        cons.AddFlushConstraint(shellXZp, baseTopMainP, txt_LugS_Dist.Text / 10)

        '2️⃣ Axis alignment
        cons.AddMateConstraint(shellYAxisP, lugYAxisP, 0)

        '3️⃣ Angular positioning
        cons.AddAngleConstraint(shellXYp, lugYZp, angleRad)

        '==================================================
        ' UPDATE
        '==================================================
        asmDoc.Update()
        Return lugAsmOcc

    End Function

