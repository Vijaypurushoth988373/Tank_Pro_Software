    Public Function PlaceAndConstrainNamePlateAssembly_ADNOC(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String, angle1Deg As Double, angle2Deg As Double) As ComponentOccurrence

        '==================================================
        ' 1️⃣ ADNOC NAME PLATE ASSEMBLY PATH
        '==================================================
        Dim namePlateAsmPath As String = IO.Path.Combine(folderPath, "Adnoc\ADNOC_NAME_PLATE_ASSEMBLY.iam")

        If Not IO.File.Exists(namePlateAsmPath) Then
            Throw New Exception("❌ ADNOC Name Plate Assembly not found: " & namePlateAsmPath)
        End If


        '==================================================
        ' 2️⃣ PLACE NAME PLATE ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim namePlateOcc As ComponentOccurrence = asmDef.Occurrences.Add(namePlateAsmPath, tg.CreateMatrix())

        namePlateOcc.Grounded = False
        namePlateOcc.Name = "ADNOC_NAME_PLATE"

        '==================================================
        ' 3️⃣ SHELL REFERENCES (DYNAMIC PLANES)
        '==================================================
        Dim shellDef = shellOcc.Definition
        Dim shellYAxis As WorkAxis = shellDef.WorkAxes.Item("Y Axis")
        Dim planeName1 As String = "NP_Plane_" & angle1Deg.ToString("0")
        Dim planeName2 As String = "NP_Plane_" & angle2Deg.ToString("0")
        Dim shellNP1 As WorkPlane = shellDef.WorkPlanes.Item(planeName1)
        Dim shellXZ As WorkPlane = shellDef.WorkPlanes.Item("XZ Plane")


        '==================================================
        ' 4️⃣ NAME PLATE REFERENCES
        '==================================================
        Dim npDef = namePlateOcc.Definition
        Dim npYAxis As WorkAxis = npDef.WorkAxes.Item("Y Axis")
        Dim npXY As WorkPlane = npDef.WorkPlanes.Item("XY Plane")
        Dim npXZ As WorkPlane = npDef.WorkPlanes.Item("XZ Plane")

        '==================================================
        ' 5️⃣ CREATE GEOMETRY PROXIES – SHELL
        '==================================================
        Dim shellYAxisProxy As Object
        Dim shellNP1Proxy As Object
        Dim shellXZProxy As Object

        shellOcc.CreateGeometryProxy(shellYAxis, shellYAxisProxy)
        shellOcc.CreateGeometryProxy(shellNP1, shellNP1Proxy)
        shellOcc.CreateGeometryProxy(shellXZ, shellXZProxy)

        '==================================================
        ' 6️⃣ CREATE GEOMETRY PROXIES – NAME PLATE
        '==================================================
        Dim npYAxisProxy As Object
        Dim npXYProxy As Object
        Dim npXZProxy As Object

        namePlateOcc.CreateGeometryProxy(npYAxis, npYAxisProxy)
        namePlateOcc.CreateGeometryProxy(npXY, npXYProxy)
        namePlateOcc.CreateGeometryProxy(npXZ, npXZProxy)

        '==================================================
        ' 7️⃣ APPLY CONSTRAINTS
        '==================================================

        '1️⃣ Y-Axis alignment
        cons.AddMateConstraint(shellYAxisProxy, npYAxisProxy, 0)

        '2️⃣ Angular positioning
        cons.AddFlushConstraint(shellNP1Proxy, npXYProxy, 0)

        '3️⃣ Height offset positioning
        Dim offsetCm As Double = (CDbl(txt_NP_DFB_AD.Text) / 10.0) - (CDbl(txt_EH_SF.Text) / 10.0)
        cons.AddFlushConstraint(shellXZProxy, npXZProxy, offsetCm)

        '==================================================
        ' 8️⃣ FINAL UPDATE
        '==================================================
        asmDoc.Update()

        Return namePlateOcc

    End Function

