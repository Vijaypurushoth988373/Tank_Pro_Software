    Public Function PlaceAndConstrainLiftingLugAssembly(invApp As Inventor.Application, asmDoc As AssemblyDocument, shellOcc As ComponentOccurrence, folderPath As String, angle1Deg As Double, angle2Deg As Double) As ComponentOccurrence

        '==================================================
        ' CONSTANTS
        '==================================================
        Dim lugAsmPath As String = IO.Path.Combine(folderPath, "Lifting_Lug.iam")
        Dim verticalOffsetCm As Double = -(txt_LL_Dist.Text / 10.0)   ' mm → cm

        '==================================================
        ' PLACE LIFTING LUG ASSEMBLY
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition
        Dim cons As AssemblyConstraints = asmDef.Constraints
        Dim tg As TransientGeometry = invApp.TransientGeometry

        If Not IO.File.Exists(lugAsmPath) Then
            Throw New Exception("❌ Lifting Lug Assembly not found: " & lugAsmPath)
        End If

        Dim lugOcc As ComponentOccurrence = asmDef.Occurrences.Add(lugAsmPath, tg.CreateMatrix())

        lugOcc.Grounded = False

        '==================================================
        ' SHELL REFERENCE PLANES (DYNAMIC)
        '==================================================
        Dim shellDef = shellOcc.Definition

        Dim planeName1 As String = $"LL_Plane_{angle1Deg}"
        Dim planeName2 As String = $"LL_Plane_{angle2Deg}"

        Dim shellPlane1 As WorkPlane
        Dim shellPlane2 As WorkPlane

        Try
            shellPlane1 = shellDef.WorkPlanes.Item(planeName1)
            shellPlane2 = shellDef.WorkPlanes.Item(planeName2)
        Catch
            Throw New Exception($"❌ Required lifting lug planes not found: {planeName1}, {planeName2}")
        End Try

        Dim shellEndPlane As WorkPlane

        If SelectedClient = "ARAMCO" Then

            shellEndPlane = shellDef.WorkPlanes.Item("CURB_ANGLE_TOP_END")

        ElseIf SelectedClient = "ADNOC" Then

            shellEndPlane = shellDef.WorkPlanes.Item("SHELL_TOP_PLANE")

        ElseIf SelectedClient = "QATAR" Then

            shellEndPlane = shellDef.WorkPlanes.Item("SHELL_TOP_PLANE")

        End If

        '==================================================
        ' LIFTING LUG ASSEMBLY PLANES
        '==================================================
        Dim lugDef = lugOcc.Definition

        Dim lugXZ As WorkPlane = lugDef.WorkPlanes.Item("XZ Plane")
        Dim lugYZ As WorkPlane = lugDef.WorkPlanes.Item("YZ Plane")
        Dim lugWP1 As WorkPlane = lugDef.WorkPlanes.Item("Work Plane1")

        '==================================================
        ' CREATE GEOMETRY PROXIES (SHELL)
        '==================================================
        Dim shellPlane1P, shellPlane2P, shellEndPlaneP As Object

        shellOcc.CreateGeometryProxy(shellPlane1, shellPlane1P)
        shellOcc.CreateGeometryProxy(shellPlane2, shellPlane2P)
        shellOcc.CreateGeometryProxy(shellEndPlane, shellEndPlaneP)

        '==================================================
        ' CREATE GEOMETRY PROXIES (LUG)
        '==================================================
        Dim lugXZp, lugYZp, lugWP1p As Object

        lugOcc.CreateGeometryProxy(lugXZ, lugXZp)
        lugOcc.CreateGeometryProxy(lugYZ, lugYZp)
        lugOcc.CreateGeometryProxy(lugWP1, lugWP1p)

        '==================================================
        ' APPLY CONSTRAINTS
        '==================================================

        ' 1️⃣ Shell (LL_Plane_angle2) → Lug (XZ Plane) → MATE
        cons.AddMateConstraint(shellPlane2P, lugXZp, 0)

        ' 2️⃣ Shell (LL_Plane_angle1) → Lug (YZ Plane) → MATE
        cons.AddMateConstraint(shellPlane1P, lugYZp, 0)

        ' 3️⃣ Shell (CURB_ANGLE_TOP_END) → Lug (Work Plane1) → FLUSH
        cons.AddFlushConstraint(shellEndPlaneP, lugWP1p, verticalOffsetCm)

        '==================================================
        ' FINAL UPDATE
        '==================================================
        asmDoc.Update()

        Return lugOcc

    End Function

    Public Sub CreateCircularPattern_LiftingLugs(invApp As Inventor.Application, asmDoc As AssemblyDocument, seedLugOcc As ComponentOccurrence)

        '==================================================
        ' Safety checks
        '==================================================
        If asmDoc Is Nothing Then
            Throw New Exception("AssemblyDocument is Nothing")
        End If

        If seedLugOcc Is Nothing Then
            Throw New Exception("Seed lifting lug occurrence is Nothing")
        End If

        '==================================================
        ' Assembly definition
        '==================================================
        Dim asmDef As AssemblyComponentDefinition = asmDoc.ComponentDefinition

        '==================================================
        ' Create ObjectCollection for pattern seed
        '==================================================
        Dim tg As TransientGeometry = invApp.TransientGeometry
        Dim objCol As ObjectCollection = invApp.TransientObjects.CreateObjectCollection()
        objCol.Add(seedLugOcc)

        '==================================================
        ' Pattern axis (GLOBAL vertical axis)
        '==================================================
        Dim patternAxis As WorkAxis = asmDef.WorkAxes.Item("Y Axis")

        '==================================================
        ' Pattern parameters
        '==================================================
        Dim occurrenceCount As Integer = txt_LL_Number.Text

        Dim angleDeg As Double = CDbl(txt_LL_Ang_Bw.Text)
        Dim totalAngleRad As Double = angleDeg * Math.PI / 180.0

        '==================================================
        ' Create circular occurrence pattern (CORRECT CALL)
        '==================================================
        Dim patt As CircularOccurrencePattern = asmDef.OccurrencePatterns.AddCircularPattern(objCol, patternAxis, True, totalAngleRad, occurrenceCount)

        patt.Name = "Lifting_Lug_Circular_Pattern"

        '==================================================
        ' Final update
        '==================================================
        asmDoc.Update()

    End Sub

